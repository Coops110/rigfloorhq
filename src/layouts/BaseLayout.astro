---
import fs from 'node:fs';
import path from 'node:path';
import ConsentBanner from '../components/ConsentBanner.astro';
import { GA_ID, CONSENT_REQUIRED_REGIONS, CONSENT_STORAGE_KEY } from '../lib/site.js';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  articleTag?: boolean;
  publishDate?: string;
  modifiedDate?: string;
  breadcrumbs?: { label: string; href: string }[];
  jsonLd?: Record<string, any>;
  /** Additional JSON-LD blocks alongside `jsonLd` (e.g. TechArticle next
      to an existing BlogPosting) without disturbing what each page already passes. */
  extraJsonLd?: Record<string, any>[];
  lang?: 'en' | 'es';
  alternateHref?: string;
  noindex?: boolean;
  /** Skips the canonical tag entirely. For pages with no real canonical URL
      of their own - the 404 page being the only current case, where a
      self-canonical on an error response is a contradictory signal. */
  noCanonical?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  articleTag = false,
  publishDate,
  modifiedDate,
  breadcrumbs = [],
  jsonLd,
  extraJsonLd = [],
  lang = 'en',
  alternateHref,
  noindex = false,
  noCanonical = false
} = Astro.props;

const siteUrl = 'https://rigfloorhq.com';
const canonicalURL = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;

// Per-page OG image, generated by scripts/generate-og-images.mjs (runs before
// `astro build`). A page that passes ogImage explicitly (blog posts with a
// custom post.data.image) keeps that. Everything else is resolved from the
// URL path: strip the leading/trailing slash and turn internal slashes into
// hyphens, so /calculators/annular-velocity -> calculators-annular-velocity,
// /es/blog/foo -> es-blog-foo, / -> home. If no matching file was generated
// for this path (static/utility pages: terms, privacy, about, search, and
// any content not yet covered by this pass), fall back to the one shared
// og-default.png exactly as before — never claim an image that isn't there.
const autoSlug = (() => {
  const trimmed = Astro.url.pathname.replace(/^\/|\/$/g, '');
  return trimmed === '' ? 'home' : trimmed.replace(/\//g, '-');
})();
const autoOgDiskPath = path.join(process.cwd(), 'public', 'og', `${autoSlug}.png`);
const resolvedOgImage = ogImage || (fs.existsSync(autoOgDiskPath) ? `/og/${autoSlug}.png` : '/og-default.png');
// The brand suffix is 13 characters and Google truncates near 60, so it is only
// appended when it still fits — a cut-off target phrase costs more than the brand.
const fullTitle = title.includes('RigFloorHQ') || title.length + 13 > 60 ? title : `${title} | RigFloorHQ`;

const otherLang = lang === 'es' ? 'en' : 'es';
const alternateURL = alternateHref ? `${siteUrl}${alternateHref}` : null;
// x-default always points to the English version (the site's default language)
const englishURL = lang === 'en' ? canonicalURL : alternateURL;
const homeHref = lang === 'es' ? '/es' : '/';
const homeLabel = lang === 'es' ? 'Inicio' : 'Home';

const breadcrumbJsonLd = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": homeLabel, "item": `${siteUrl}${homeHref}` },
    ...breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": b.label,
      "item": `${siteUrl}${b.href}`
    }))
  ]
} : null;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {!noCanonical && <link rel="canonical" href={canonicalURL} />}
  {/* All three are gated on alternateURL. A page with no translation should
      emit no hreflang at all — x-default on its own says nothing, since it
      only means "use this when no other listed language matches" and there
      are no other languages listed. */}
  {alternateURL && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
  {alternateURL && <link rel="alternate" hreflang={otherLang} href={alternateURL} />}
  {alternateURL && englishURL && <link rel="alternate" hreflang="x-default" href={englishURL} />}
  {/* follow is kept on noindexed pages: they should stay out of the index but
      still pass their links on, so anything they point at is not orphaned. */}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="author" content="RigFloorHQ" />

  <!-- Open Graph -->
  <meta property="og:type" content={articleTag ? 'article' : 'website'} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="RigFloorHQ" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  {alternateURL && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />}
  <meta property="og:image" content={`${siteUrl}${resolvedOgImage}`} />
  {publishDate && <meta property="article:published_time" content={publishDate} />}
  {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${resolvedOgImage}`} />

  <!-- Favicon -->
  {/* No /favicon.ico link: the file does not exist and every modern browser
      uses the SVG. Browsers still probe /favicon.ico automatically, which 404s
      harmlessly — declaring it would just be a link to a missing file. */}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Fonts -->
  {/* Self-hosted, not Google Fonts. The CDN version put a render-blocking
      stylesheet on fonts.googleapis.com in front of first paint, which then
      discovered six woff2 files on fonts.gstatic.com — a three-level critical
      chain ahead of an LCP that is only text. The @font-face rules now live in
      src/styles/fonts.css, bundled into the same stylesheet as global.css, so
      they cost no request of their own. Regenerate with scripts/fetch-fonts.py.

      The two preconnects that used to be here are gone with the origins they
      pointed at. Preconnecting to a host we no longer talk to just opens a
      connection that is never used.

      Only these two faces are preloaded: Barlow Condensed 900 is the hero h1,
      which is the LCP element, and Inter 400 is body copy. Preloading the rest
      would compete with them for bandwidth on the slow connections this audit
      models, which is the opposite of the point.

      Dropping the Inter preload (leaving only the LCP face) was tried and
      measured on 2026-10-17: Lighthouse mobile FCP got ~300-450ms WORSE on
      both / and /calculators/ecd (1.21s -> 1.66s, 1.36s -> 1.66s), LCP
      unchanged, because Inter is then discovered only after layout and
      lands on the simulated critical path. Keep it. The metric-matched
      fallbacks in src/styles/font-fallbacks.css are what stop the swap
      re-flowing the page. */}
  <link rel="preload" href="/fonts/barlow-condensed-900-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />

  {/* Google Analytics 4 (optional) — production builds only, so local
      `npm run dev` sessions never reach the property.

      Consent Mode v2: the `consent default` command MUST reach dataLayer
      before gtag.js processes it, so this inline block comes first and the
      library loads async after. In UK/EEA/CH storage starts denied (GA sends
      cookieless pings until the visitor accepts); elsewhere it starts granted,
      since opt-in consent isn't required there. Region is resolved by Google
      server-side from IP, which is far more reliable than guessing location in
      the browser.

      Written as an Astro comment, not an HTML one, so these notes don't ship
      to every page — and so a disabled setup doesn't advertise itself. */}
  {GA_ID && import.meta.env.PROD && (
    <>
      <script is:inline define:vars={{ GA_ID, CONSENT_REQUIRED_REGIONS, CONSENT_STORAGE_KEY }}>
        // ── PERSONAL OPT-OUT ────────────────────────────────────────
        // Visiting any page with ?ga-optout=1 permanently excludes this
        // browser from analytics. ?ga-optout=0 undoes it.
        //
        // This exists because the operator's own visits distort a low-traffic
        // property badly — a handful of sessions a day is a large share of the
        // total, which makes the numbers actively misleading.
        //
        // Preferred over a GA4 internal-traffic IP filter because residential
        // IPs are dynamic: the filter silently stops working when the ISP
        // changes the address, and nothing tells you. This survives that.
        // Use both if you like — they do not conflict.
        //
        // ga-disable-<ID> is Google's own documented opt-out flag. Setting it
        // suppresses measurement even though gtag.js still loads.
        var GA_OPTOUT_KEY = 'rigfloorhq_ga_optout';
        try {
          var params = new URLSearchParams(window.location.search);
          if (params.has('ga-optout')) {
            if (params.get('ga-optout') === '0') window.localStorage.removeItem(GA_OPTOUT_KEY);
            else window.localStorage.setItem(GA_OPTOUT_KEY, '1');
          }
        } catch (e) { /* private mode — fall through and measure normally */ }

        var gaOptedOut = false;
        try { gaOptedOut = window.localStorage.getItem(GA_OPTOUT_KEY) === '1'; } catch (e) {}
        window['ga-disable-' + GA_ID] = gaOptedOut;

        // Assign to window explicitly: Astro wraps define:vars scripts in an
        // IIFE, so a bare `function gtag(){}` would be function-scoped and
        // custom gtag('event', ...) calls elsewhere would throw.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag(){ window.dataLayer.push(arguments); };

        // 1. Consent-required regions: deny until the visitor chooses.
        //    wait_for_update holds tags briefly so a fast click still counts.
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          region: CONSENT_REQUIRED_REGIONS,
          wait_for_update: 500,
        });

        // 2. Everywhere else: granted. A more specific region always wins over
        //    this, regardless of command order.
        gtag('consent', 'default', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });

        // 3. Re-apply a previously saved choice on repeat visits.
        try {
          var saved = JSON.parse(localStorage.getItem(CONSENT_STORAGE_KEY) || 'null');
          if (saved && saved.choice) {
            var state = saved.choice === 'accepted' ? 'granted' : 'denied';
            gtag('consent', 'update', {
              ad_storage: state,
              ad_user_data: state,
              ad_personalization: state,
              analytics_storage: state,
            });
          }
        } catch (e) { /* private mode / storage disabled — defaults stand */ }

        // Skip config entirely when opted out. ga-disable already suppresses
        // measurement, but not sending the pageview at all is cleaner and
        // means an opted-out browser produces no property traffic whatsoever.
        if (!gaOptedOut) {
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
      </script>
      {/* The gtag.js library itself (~176 KiB) is the single biggest chunk of
          page weight and the main driver of mobile TBT/INP risk. The
          consent/dataLayer stub above is already set up and queues calls fine
          before the real library arrives, so there is no correctness reason
          to fetch it eagerly. It loads on the first real interaction or
          scroll, or else 3s after the load event and then only in idle time.
          Plain idle scheduling still ran it inside the initial render window
          on a throttled phone: two 130-340ms long tasks at ~2.9s, the largest
          share of mobile TBT. Consent is unaffected: the consent
          default/update calls above sit in dataLayer and are processed in
          order whenever the library arrives.

          This block is hashed into vercel.json's script-src and into
          scripts/check-no-inline-scripts.mjs. Any edit to it, comments
          included, changes the hash: rebuild, run the check, and update
          both. This explanation lives in an Astro comment so it does not
          ship in every page. */}
      <script is:inline define:vars={{ GA_ID }}>
        function loadGtagScript() {
          if (window.__gtagScriptLoading) return;
          window.__gtagScriptLoading = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        function afterLoad() {
          setTimeout(function () {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadGtagScript, { timeout: 2000 });
            } else {
              loadGtagScript();
            }
          }, 3000);
        }
        if (document.readyState === 'complete') afterLoad();
        else window.addEventListener('load', afterLoad, { once: true });
        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
          window.addEventListener(evt, loadGtagScript, { once: true, passive: true });
        });
      </script>
    </>
  )}

  <!-- Structured Data: Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "RigFloorHQ",
    "url": siteUrl,
    "description": lang === 'es'
      ? "La referencia completa del campo petrolero para operaciones de perforación, soldadura y control de pozos."
      : "The complete oil and gas field reference for drilling, welding, and well control operations.",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logo-512.png`,
      "width": 512,
      "height": 512
    },
    "founder": {
      "@type": "Person",
      "@id": `${siteUrl}/about/chris-cooper#person`,
      "name": "Chris Cooper",
      "url": `${siteUrl}/about/chris-cooper`,
      "jobTitle": "Founder"
    },
    "sameAs": [
      "https://www.facebook.com/1215544864984509",
      "https://www.tiktok.com/@rigfloorhq",
      "https://www.youtube.com/@RigFloorHQ",
      "https://www.linkedin.com/company/rigfloorhq"
    ]
  })} />

  {breadcrumbJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )}

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  {extraJsonLd.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}

  <style is:global>
    @import "../styles/fonts.css";
    @import "../styles/font-fallbacks.css";
    @import "../styles/global.css";
  </style>
</head>
<body>
  <slot name="nav" />

  {breadcrumbs.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={homeHref}>{homeLabel}</a>
      {breadcrumbs.map((b, i) => (
        <>
          <span class="sep">/</span>
          {i === breadcrumbs.length - 1
            ? <span class="current">{b.label}</span>
            : <a href={b.href}>{b.label}</a>}
        </>
      ))}
    </nav>
  )}

  <main>
    <slot />
  </main>

  <slot name="footer" />

  <ConsentBanner lang={lang} />

  {/* Mobile number-input steppers, site-wide. Desktop already gets native
      up/down spinners on type="number" for free from the browser; mobile
      (iOS Safari especially) doesn't render a usable version of those, so
      this wraps every number input with real tap targets instead. Runs
      once on load, no-ops on pages with no number inputs. step="any"
      inputs (unit converters) are skipped deliberately — an "any" step
      has no sensible increment to tap, same as native browser behavior. */}
  <script is:inline>
    (function () {
      function enhance(input) {
        if (input.closest('.number-stepper')) return; // already wrapped
        if ((input.getAttribute('step') || '').toLowerCase() === 'any') return;
        var wrap = document.createElement('div');
        wrap.className = 'number-stepper';
        input.parentNode.insertBefore(wrap, input);
        wrap.appendChild(input);

        var btns = document.createElement('div');
        btns.className = 'number-stepper-btns';
        var up = document.createElement('button');
        up.type = 'button';
        up.className = 'number-stepper-btn';
        up.setAttribute('aria-label', 'Increase');
        up.textContent = '▲';
        var down = document.createElement('button');
        down.type = 'button';
        down.className = 'number-stepper-btn';
        down.setAttribute('aria-label', 'Decrease');
        down.textContent = '▼';
        btns.appendChild(up);
        btns.appendChild(down);
        wrap.appendChild(btns);

        function step(dir) {
          var before = input.value;
          if (typeof input.stepUp === 'function' && typeof input.stepDown === 'function') {
            try {
              dir > 0 ? input.stepUp() : input.stepDown();
            } catch (e) {
              // stepUp/stepDown throw if the resulting value violates min/max
              // step alignment — fall back to plain arithmetic below.
              var stepSize = parseFloat(input.getAttribute('step') || '1') || 1;
              var cur = parseFloat(input.value) || 0;
              input.value = String(cur + dir * stepSize);
            }
          } else {
            var stepSize2 = parseFloat(input.getAttribute('step') || '1') || 1;
            var cur2 = parseFloat(input.value) || 0;
            input.value = String(cur2 + dir * stepSize2);
          }
          if (input.value !== before) {
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
        up.addEventListener('click', function () { step(1); });
        down.addEventListener('click', function () { step(-1); });
      }

      function run() {
        document.querySelectorAll('input[type="number"]').forEach(enhance);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    })();
  </script>
</body>
</html>
