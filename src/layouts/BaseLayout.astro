---
import ConsentBanner from '../components/ConsentBanner.astro';
import { GA_ID, CONSENT_REQUIRED_REGIONS, CONSENT_STORAGE_KEY } from '../lib/site.js';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  articleTag?: boolean;
  publishDate?: string;
  modifiedDate?: string;
  breadcrumbs?: { label: string; href: string }[];
  jsonLd?: Record<string, any>;
  lang?: 'en' | 'es';
  alternateHref?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  articleTag = false,
  publishDate,
  modifiedDate,
  breadcrumbs = [],
  jsonLd,
  lang = 'en',
  alternateHref,
  noindex = false
} = Astro.props;

const siteUrl = 'https://rigfloorhq.com';
const canonicalURL = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const fullTitle = title.includes('RigFloorHQ') ? title : `${title} | RigFloorHQ`;

const otherLang = lang === 'es' ? 'en' : 'es';
const alternateURL = alternateHref ? `${siteUrl}${alternateHref}` : null;
// x-default always points to the English version (the site's default language)
const englishURL = lang === 'en' ? canonicalURL : alternateURL;
const homeHref = lang === 'es' ? '/es' : '/';
const homeLabel = lang === 'es' ? 'Inicio' : 'Home';

const breadcrumbJsonLd = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": homeLabel, "item": `${siteUrl}${homeHref}` },
    ...breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": b.label,
      "item": `${siteUrl}${b.href}`
    }))
  ]
} : null;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {/* All three are gated on alternateURL. A page with no translation should
      emit no hreflang at all — x-default on its own says nothing, since it
      only means "use this when no other listed language matches" and there
      are no other languages listed. */}
  {alternateURL && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
  {alternateURL && <link rel="alternate" hreflang={otherLang} href={alternateURL} />}
  {alternateURL && englishURL && <link rel="alternate" hreflang="x-default" href={englishURL} />}
  {/* follow is kept on noindexed pages: they should stay out of the index but
      still pass their links on, so anything they point at is not orphaned. */}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="author" content="RigFloorHQ" />

  <!-- Open Graph -->
  <meta property="og:type" content={articleTag ? 'article' : 'website'} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="RigFloorHQ" />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  {publishDate && <meta property="article:published_time" content={publishDate} />}
  {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Favicon -->
  {/* No /favicon.ico link: the file does not exist and every modern browser
      uses the SVG. Browsers still probe /favicon.ico automatically, which 404s
      harmlessly — declaring it would just be a link to a missing file. */}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=IBM+Plex+Mono:wght@400;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  {/* Google Analytics 4 (optional) — production builds only, so local
      `npm run dev` sessions never reach the property.

      Consent Mode v2: the `consent default` command MUST reach dataLayer
      before gtag.js processes it, so this inline block comes first and the
      library loads async after. In UK/EEA/CH storage starts denied (GA sends
      cookieless pings until the visitor accepts); elsewhere it starts granted,
      since opt-in consent isn't required there. Region is resolved by Google
      server-side from IP, which is far more reliable than guessing location in
      the browser.

      Written as an Astro comment, not an HTML one, so these notes don't ship
      to every page — and so a disabled setup doesn't advertise itself. */}
  {GA_ID && import.meta.env.PROD && (
    <>
      <script is:inline define:vars={{ GA_ID, CONSENT_REQUIRED_REGIONS, CONSENT_STORAGE_KEY }}>
        // ── PERSONAL OPT-OUT ────────────────────────────────────────
        // Visiting any page with ?ga-optout=1 permanently excludes this
        // browser from analytics. ?ga-optout=0 undoes it.
        //
        // This exists because the operator's own visits distort a low-traffic
        // property badly — a handful of sessions a day is a large share of the
        // total, which makes the numbers actively misleading.
        //
        // Preferred over a GA4 internal-traffic IP filter because residential
        // IPs are dynamic: the filter silently stops working when the ISP
        // changes the address, and nothing tells you. This survives that.
        // Use both if you like — they do not conflict.
        //
        // ga-disable-<ID> is Google's own documented opt-out flag. Setting it
        // suppresses measurement even though gtag.js still loads.
        var GA_OPTOUT_KEY = 'rigfloorhq_ga_optout';
        try {
          var params = new URLSearchParams(window.location.search);
          if (params.has('ga-optout')) {
            if (params.get('ga-optout') === '0') window.localStorage.removeItem(GA_OPTOUT_KEY);
            else window.localStorage.setItem(GA_OPTOUT_KEY, '1');
          }
        } catch (e) { /* private mode — fall through and measure normally */ }

        var gaOptedOut = false;
        try { gaOptedOut = window.localStorage.getItem(GA_OPTOUT_KEY) === '1'; } catch (e) {}
        window['ga-disable-' + GA_ID] = gaOptedOut;

        // Assign to window explicitly: Astro wraps define:vars scripts in an
        // IIFE, so a bare `function gtag(){}` would be function-scoped and
        // custom gtag('event', ...) calls elsewhere would throw.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag(){ window.dataLayer.push(arguments); };

        // 1. Consent-required regions: deny until the visitor chooses.
        //    wait_for_update holds tags briefly so a fast click still counts.
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          region: CONSENT_REQUIRED_REGIONS,
          wait_for_update: 500,
        });

        // 2. Everywhere else: granted. A more specific region always wins over
        //    this, regardless of command order.
        gtag('consent', 'default', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });

        // 3. Re-apply a previously saved choice on repeat visits.
        try {
          var saved = JSON.parse(localStorage.getItem(CONSENT_STORAGE_KEY) || 'null');
          if (saved && saved.choice) {
            var state = saved.choice === 'accepted' ? 'granted' : 'denied';
            gtag('consent', 'update', {
              ad_storage: state,
              ad_user_data: state,
              ad_personalization: state,
              analytics_storage: state,
            });
          }
        } catch (e) { /* private mode / storage disabled — defaults stand */ }

        // Skip config entirely when opted out. ga-disable already suppresses
        // measurement, but not sending the pageview at all is cleaner and
        // means an opted-out browser produces no property traffic whatsoever.
        if (!gaOptedOut) {
          gtag('js', new Date());
          gtag('config', GA_ID);
        }
      </script>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    </>
  )}

  <!-- Structured Data: Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "RigFloorHQ",
    "url": siteUrl,
    "description": "The complete oil and gas field reference for drilling, welding, and well control operations.",
    "logo": `${siteUrl}/favicon.svg`
  })} />

  {breadcrumbJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  )}

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <style is:global>
    @import "../styles/global.css";
  </style>
</head>
<body>
  <slot name="nav" />

  {breadcrumbs.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={homeHref}>{homeLabel}</a>
      {breadcrumbs.map((b, i) => (
        <>
          <span class="sep">/</span>
          {i === breadcrumbs.length - 1
            ? <span class="current">{b.label}</span>
            : <a href={b.href}>{b.label}</a>}
        </>
      ))}
    </nav>
  )}

  <main>
    <slot />
  </main>

  <slot name="footer" />

  <ConsentBanner lang={lang} />
</body>
</html>
