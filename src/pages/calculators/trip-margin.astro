---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { calculatorWebPage } from '../../lib/techarticle.js';

const faq = [
  {
    q: 'What is a trip margin actually protecting against?',
    a: 'Swabbing — the tendency of pipe movement, especially pulling out of hole, to momentarily reduce bottomhole pressure below the static hydrostatic value. A trip margin adds a small extra mud weight on top of the minimum needed to balance formation pressure, so that swabbing during a normal trip doesn\'t let the well flow.',
  },
  {
    q: 'How is the safety margin figure chosen?',
    a: 'It\'s typically set as a company or well-specific policy figure — commonly in the 100-200 psi surface-equivalent range — based on expected swab pressures for the string and trip speed being used, not calculated fresh for every trip. Check your operator\'s well control policy for the actual figure to use on a real well.',
  },
];



const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/calculators/trip-margin#app",
  "name": "Trip Margin / Safety Factor Calculator",
  "url": "https://rigfloorhq.com/calculators/trip-margin",
  "description": "Free trip margin (safety factor) calculator: the extra mud weight carried above formation balance to protect against swabbing in a kick while tripping.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Drilling engineering calculator",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'en' });

---
<BaseLayout
  title="Trip Margin / Safety Factor Calculator"
  description="Free trip margin (safety factor) calculator: the extra mud weight carried above formation balance to protect against swabbing in a kick while tripping."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'Trip Margin', href: '/calculators/trip-margin' }]}
  lang="en"
  alternateHref="/es/calculators/trip-margin"
>
  <Nav slot="nav" lang="en" alternateHref="/es/calculators/trip-margin" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>Trip Margin <span>/ Safety Factor</span></h1>
    <p class="page-hero-sub">The mud weight carried above formation balance so that swab pressure while tripping out doesn't let the well flow.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🧭 Trip Margin Inputs</div>
          <div class="input-row">
            <div class="input-group">
              <label for="tm-mw">Base Mud Weight (ppg)</label>
              <input type="number" id="tm-mw" value="9" step="0.1">
            </div>
            <div class="input-group">
              <label for="tm-sm">Safety Margin (psi)</label>
              <input type="number" id="tm-sm" value="415" step="1">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="tm-tvd">TVD (ft)</label>
              <input type="number" id="tm-tvd" value="8197" step="1">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Trip Margin / Safety Factor</span><span class="output-value" id="out-tmsf">—</span></div>
          </div>
        </div>

        <div class="danger-box mt-24" style="max-width:700px;">
          <strong>This is a reference tool, not an operational authority.</strong> The actual safety margin figure and trip margin policy for a real well belong to your operator's approved well control procedures.
        </div>
      </div>

      <div class="prose">
        <h2>The Formula Used</h2>
        <dl class="formula-block">
          <dt class="formula-label">Trip Margin / Safety Factor</dt>
          <dd class="formula-eq"><code>TM/SF = Base Mud Weight + [Safety Margin ÷ (0.052 × TVD)]</code></dd>
          <dd class="formula-note">Base mud weight in ppg, safety margin in psi, TVD in feet, result in ppg.</dd>
        </dl>

        <h3>Worked Example</h3>
        <p>A well balanced at 10.0 ppg at 9,000 ft TVD, carrying a 200 psi company safety margin for tripping:</p>
        <dl class="formula-block">
          <dt class="formula-label">Trip Margin / Safety Factor</dt>
          <dd class="formula-eq"><code>TM/SF = 10.0 + [200 ÷ (0.052 × 9,000)] = 10.0 + [200 ÷ 468] = 10.0 + 0.43 = 10.43 ppg</code></dd>
          <dd class="formula-note">The crew runs 10.43 ppg rather than the bare 10.0 ppg balance point — the extra 0.43 ppg is the cushion against swab pressure while pulling out of the hole.</dd>
        </dl>

        <h3>Where This Fits</h3>
        <p>Trip margin converts a policy safety-margin pressure into an actual mud weight you can carry in the hole, on top of whatever weight is needed to balance formation pressure alone. It's the mud-weight-side answer to the same swab risk that the <a href="/calculators/pipe-pull-margin">wet and dry pipe pull margin calculator</a> addresses from the pulled-footage side — trip margin says how much heavier to run the mud, pull margin says how far pipe can come out before hydrostatic drops too far, and a real trip plan checks both. If the calculated trip margin comes out barely above the base mud weight, that's a sign the safety margin figure itself, or the well's actual overbalance, needs a second look before pulling pipe. For the full pressure-drop and mud-level math behind a specific trip, see the <a href="/calculators/tripping-pressure-effects">tripping pressure effects calculator</a>. For the hydrostatic theory behind overbalance itself, see the <a href="/pillars/hydrostatic-pressure">hydrostatic pressure pillar</a>. Carrying the right trip margin, and topping the mud system up to it, is where a <a href="/careers/derrickhand">derrickhand's</a> mud-system responsibility and a driller's console judgment meet — pay and the full derrickhand job picture are in the <a href="/careers/derrickhand">career guide</a>.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p set:html={item.a} />
          </div>
        ))}
      </div>
    </div>
    <NewsletterSignup lang="en" />
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/trip-margin.js" defer></script>
