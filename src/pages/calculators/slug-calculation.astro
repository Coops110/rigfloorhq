---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { calculatorWebPage } from '../../lib/techarticle.js';

const faq = [
  {
    q: 'Why pump a slug before pulling out of hole?',
    a: 'A slug is a small volume of heavier mud pumped into the top of the drill string before tripping, so that once the string is broken and drained at surface, the pipe comes out with a known dry section instead of dumping mud onto the rig floor at every connection. It\'s a housekeeping and safety measure, not a well control barrier.',
  },
  {
    q: 'Why does pumping a slug cause a pit gain?',
    a: 'The slug is heavier than the mud already in the pits, so pumping it in and displacing an equal volume of lighter mud back to the pits — the U-tubing effect — shows up as a real, expected pit gain. Confirming this expected gain matches what the calculator predicts is exactly how a crew rules out a real kick showing up at the same moment a slug is pumped.',
  },
  {
    q: "What if the actual pit gain doesn't match the predicted figure?",
    a: 'A small discrepancy from mixing losses or trapped air at surface is normal, but a gain noticeably larger than predicted should always be treated as a possible influx first, not written off as a calculation quirk — stop and flow-check per well control procedure before resuming the trip.',
  },
];



const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/calculators/slug-calculation#app",
  "name": "Slug Volume & Pit Gain Calculator",
  "url": "https://rigfloorhq.com/calculators/slug-calculation",
  "description": "Free calculator for the slug volume needed for a desired dry pipe length, and the expected pit gain from pumping that slug.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Drilling engineering calculator",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'en' });

---
<BaseLayout
  title="Slug Volume & Pit Gain Calculator"
  description="Free calculator for the slug volume needed for a desired dry pipe length, and the expected pit gain from pumping that slug."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'Slug Calculation', href: '/calculators/slug-calculation' }]}
  lang="en"
  alternateHref="/es/calculators/slug-calculation"
>
  <Nav slot="nav" lang="en" alternateHref="/es/calculators/slug-calculation" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>Slug Volume &amp; <span>Pit Gain</span></h1>
    <p class="page-hero-sub">The slug volume needed for a desired length of dry pipe before tripping, and the pit gain that slug will cause once it's pumped.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🧭 Slug Volume</div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-len">Desired Length of Dry Pipe (ft)</label>
              <input type="number" id="slug-len" value="255.75" step="0.01">
            </div>
            <div class="input-group">
              <label for="slug-cap">Drill Pipe Capacity (bbl/ft)</label>
              <input type="number" id="slug-cap" value="0.0207" step="0.0001">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-mw">Mud Weight (ppg)</label>
              <input type="number" id="slug-mw" value="10.2" step="0.1">
            </div>
            <div class="input-group">
              <label for="slug-sw">Slug Weight (ppg)</label>
              <input type="number" id="slug-sw" value="12" step="0.1">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Slug Volume</span><span class="output-value" id="out-slugvol">—</span></div>
          </div>
        </div>

        <div class="calc-box mt-24">
          <div class="calc-title">🧭 Pit Gain Due to U-Tubing</div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-vol2">Slug Volume (bbl)</label>
              <input type="number" id="slug-vol2" value="30" step="0.1">
            </div>
            <div class="input-group">
              <label for="slug-mw2">Mud Weight (ppg)</label>
              <input type="number" id="slug-mw2" value="10" step="0.1">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-sw2">Slug Weight (ppg)</label>
              <input type="number" id="slug-sw2" value="11.3" step="0.1">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Expected Pit Gain</span><span class="output-value" id="out-pitgain">—</span></div>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Reference only.</strong> This assumes a clean, fully displaced slug. Real surface equipment lag, trapped air, and mixing losses mean an actual gain should be read as a sanity check against this figure, not an exact substitute for watching the pits during the job.
        </div>
      </div>

      <div class="prose">
        <h2>The Formulas Used</h2>
        <dl class="formula-block">
          <dt class="formula-label">Slug Volume</dt>
          <dd class="formula-eq"><code>V = (Length × Pipe Capacity × Mud Weight) ÷ (Slug Weight − Mud Weight)</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Pit Gain Due to Slug U-Tubing</dt>
          <dd class="formula-eq"><code>Pit Gain = Slug Volume × (Slug Weight − Mud Weight) ÷ Mud Weight</code></dd>
        </dl>

        <h3>Worked Example</h3>
        <p>Pumping a 12.0 ppg slug into a string carrying 10.0 ppg mud, aiming for 200 ft of dry pipe with 5" 19.5 lb/ft drill pipe (capacity 0.01776 bbl/ft):</p>
        <dl class="formula-block">
          <dt class="formula-label">Slug Volume</dt>
          <dd class="formula-eq"><code>V = (200 × 0.01776 × 10.0) ÷ (12.0 − 10.0) = 35.52 ÷ 2 = 17.76 bbl</code></dd>
        </dl>
        <p>Feeding that same 17.76 bbl slug volume into the pit gain formula:</p>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Pit Gain Due to Slug U-Tubing</dt>
          <dd class="formula-eq"><code>Pit Gain = 17.76 × (12.0 − 10.0) ÷ 10.0 = 17.76 × 0.2 = 3.55 bbl</code></dd>
          <dd class="formula-note">The crew expects to see roughly a 3.55 bbl pit gain right after pumping — the number the actual pit-level reading gets checked against.</dd>
        </dl>

        <h3>Where This Fits</h3>
        <p>The slug volume figure feeds directly into the pit gain calculation — pump the slug volume from the first box, then use that same figure in the second box to know exactly how much pit gain to expect from the U-tubing effect alone. That expected number is what a crew checks the actual pit-level reading against right after pumping a slug, on any trip, which is also the same routine sanity-check habit that matters on the <a href="/pillars/stuck-pipe-and-fishing-operations">stuck pipe and fishing operations</a> page's broader trip-monitoring discussion — an unexplained gain beyond this predicted figure is the first real sign something else is happening in the well at the same time. For the swab-side mud weight most trips also carry, see the <a href="/calculators/trip-margin">trip margin calculator</a>, and for the hydrostatic theory behind why pit level reacts at all, see the <a href="/pillars/hydrostatic-pressure">hydrostatic pressure pillar</a>.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/slug-calculation.js" defer></script>
