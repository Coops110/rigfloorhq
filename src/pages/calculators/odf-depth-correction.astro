---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const faq = [
  {
    q: 'What does ODF stand for and why does rig floor elevation change?',
    a: 'ODF is the original datum from which depths on a well are referenced — usually rig floor elevation above sea level or ground level. It can change between operations on the same well: a workover rig with a different substructure height, a platform deck modification, or simply moving to a different rig on a re-entry all shift where "zero" actually sits.',
  },
  {
    q: 'Why does this need two separate corrections?',
    a: 'The first correction reconciles a physical change in rig floor height, so drill pipe tally and wireline depths are both talking about the same reference point again. The second reconciles drill pipe tally against a wireline run at that same reference point, since drill pipe stretch and wireline stretch drift apart from each other over depth and time even when the datum hasn\'t moved.',
  },
  {
    q: 'Which correction do I apply if only the rig floor changed?',
    a: 'Just the first one — leave both wireline fields at zero and the calculator applies only the elevation-change correction. The second correction is a separate, optional cross-check for whenever you actually have a fresh wireline depth to compare against your pipe tally.',
  },
  {
    q: 'Does a positive or negative correction mean the depth is deeper or shallower?',
    a: 'A positive final correction means the drill pipe tally under-reads the true depth relative to the new reference — add it to get true depth. A negative correction means the tally over-reads. Always apply the sign as calculated rather than assuming which direction it should go.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Rig Floor (ODF) Depth Correction Calculator"
  description="Free ODF depth correction calculator: reconcile drill pipe tally depth against wireline depth after a rig floor elevation change."
  jsonLd={jsonLd}
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'ODF Depth Correction', href: '/calculators/odf-depth-correction' }]}
  lang="en"
  alternateHref="/es/calculators/odf-depth-correction"
>
  <Nav slot="nav" lang="en" alternateHref="/es/calculators/odf-depth-correction" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>Rig Floor (ODF) <span>Depth Correction</span></h1>
    <p class="page-hero-sub">Reconcile drill pipe tally depth against wireline depth after a rig floor elevation change, with an optional cross-check against a fresh wireline run.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">📐 1st Correction — Rig Floor Elevation Change</div>
          <div class="input-row">
            <div class="input-group">
              <label for="odf-orig">Original Rig Floor Elevation (ft)</label>
              <input type="number" id="odf-orig" value="45">
            </div>
            <div class="input-group">
              <label for="odf-present">Present Rig Floor Elevation (ft)</label>
              <input type="number" id="odf-present" value="35">
            </div>
          </div>

          <div class="calc-title" style="margin-top:24px;">🔗 2nd Correction — Cross-Check Against Wireline (optional)</div>
          <div class="input-row">
            <div class="input-group">
              <label for="odf-dp">Drill Pipe Tally Depth (ft)</label>
              <input type="number" id="odf-dp" value="0">
            </div>
            <div class="input-group">
              <label for="odf-wl">Wireline Measured Depth (ft)</label>
              <input type="number" id="odf-wl" value="0">
            </div>
          </div>

          <div class="calc-output visible" style="margin-top:20px;">
            <div class="output-line headline"><span class="output-label">1st Correction (rig floor change)</span><span class="output-value" id="out-c1">—</span></div>
            <div class="output-line"><span class="output-label">2nd Correction (drill pipe vs wireline)</span><span class="output-value" id="out-c2">—</span></div>
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Final Correction to Apply</span><span class="output-value" id="out-final">—</span></div>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Reference only.</strong> Confirm both elevations against the actual rig documentation before applying a correction to a live well's depth records.
        </div>
      </div>

      <div class="prose">
        <h2>The Formulas Used</h2>
        <div class="formula-block">
          <div class="formula-label">1st Correction</div>
          <div class="formula-eq">C1 = Original Rig Floor Elevation − Present Rig Floor Elevation</div>
          <div class="formula-note">Applied to both drill pipe and wireline depths, since both were referenced to the original elevation.</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">2nd Correction</div>
          <div class="formula-eq">C2 = Drill Pipe Tally Depth − Wireline Measured Depth</div>
          <div class="formula-note">Only meaningful once both depths are read from the same reference point — apply C1 first if the rig floor also changed.</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">Final Correction</div>
          <div class="formula-eq">Final = C1 + C2</div>
          <div class="formula-note">The total correction to apply to the drill pipe tally to get true depth against the new reference.</div>
        </div>

        <p>This is a datum reconciliation, not a stretch calculation — it doesn't account for drill pipe or wireline stretch over depth on its own. For the capacity and volume math that depth feeds into elsewhere, see the <a href="/drilling/formulas">drilling formulas cheat sheet</a>.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script>
  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    const v = parseFloat(el?.value ?? '');
    return isFinite(v) ? v : 0;
  }
  function fmt(n: number, d: number): string {
    if (!isFinite(n)) return '0';
    return n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  function calc() {
    const orig = num('odf-orig'), present = num('odf-present');
    const dp = num('odf-dp'), wl = num('odf-wl');

    const c1 = orig - present;
    const c2 = (dp !== 0 || wl !== 0) ? (dp - wl) : 0;
    const final = c1 + c2;

    (document.getElementById('out-c1') as HTMLElement).textContent = fmt(c1, 1) + ' ft';
    (document.getElementById('out-c2') as HTMLElement).textContent = fmt(c2, 1) + ' ft';
    (document.getElementById('out-final') as HTMLElement).textContent = (final >= 0 ? '+' : '') + fmt(final, 1) + ' ft';
  }

  document.querySelectorAll('.calc-box input').forEach((el) => el.addEventListener('input', calc));
  calc();
</script>
