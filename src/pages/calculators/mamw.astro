---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SourcesStandards from '../../components/SourcesStandards.astro';
import { calculatorWebPage } from '../../lib/techarticle.js';

const faq = [
  {
    q: 'How is MAMW different from MAASP?',
    a: 'They express the same shoe limit in two different units. <a href="/calculators/maasp">MAASP</a> restates the limit as a live surface pressure in psi at today\'s mud weight. MAMW restates it as an equivalent mud weight in ppg — the heaviest mud the shoe could take with zero surface pressure showing. Converted to the same units, both should agree.',
  },
  {
    q: 'Why does New MAASP need the kill mud weight, not the current mud weight?',
    a: 'Once a kill is underway, the mud weight in the hole is changing on purpose, and the shoe cares about whatever mud weight will actually be in the annulus once the kill mud weight is circulated — not the mud weight that was in the hole when the kick was taken. Recalculating MAASP against the kill mud weight, not the original mud weight, is what tells you whether the planned kill mud weight itself is safe for the shoe.',
  },
];

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/calculators/mamw#app",
  "name": "MAMW Calculator: Maximum Allowable Mud Weight & New MAASP",
  "url": "https://rigfloorhq.com/calculators/mamw",
  "description": "Free MAMW calculator: maximum allowable mud weight from your LOT/FIT test and shoe TVD, plus new MAASP once a kill mud weight is set.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Drilling engineering calculator",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'en' });

---
<BaseLayout
  title="MAMW Calculator: Maximum Allowable Mud Weight & New MAASP"
  description="Free MAMW calculator: maximum allowable mud weight from your LOT/FIT test and shoe TVD, plus new MAASP once a kill mud weight is set."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'MAMW', href: '/calculators/mamw' }]}
  lang="en"
  alternateHref="/es/calculators/mamw"
>
  <Nav slot="nav" lang="en" alternateHref="/es/calculators/mamw" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>MAMW <span>Calculator</span></h1>
    <p class="page-hero-sub">Maximum Allowable Mud Weight restates your shoe's LOT/FIT limit as an equivalent mud weight, then uses it to work out the new MAASP once a kill mud weight is set.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🧭 Maximum Allowable Mud Weight</div>
          <div class="input-row">
            <div class="input-group">
              <label for="mamw-mw">Current Mud Weight (ppg)</label>
              <input type="number" id="mamw-mw" value="9.4" step="0.1">
            </div>
            <div class="input-group">
              <label for="mamw-lp">LOT/FIT Pressure (psi)</label>
              <input type="number" id="mamw-lp" value="415" step="1">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="mamw-tvd">Shoe TVD (ft)</label>
              <input type="number" id="mamw-tvd" value="6108" step="1">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">MAMW</span><span class="output-value" id="out-mamw">—</span></div>
          </div>
        </div>

        <div class="calc-box mt-24">
          <div class="calc-title">🧭 New MAASP With Kill Mud Weight</div>
          <div class="input-row">
            <div class="input-group">
              <label for="mamw-killmw">Kill Mud Weight (ppg)</label>
              <input type="number" id="mamw-killmw" value="11.5" step="0.1">
            </div>
            <div class="input-group">
              <label for="mamw-tvd2">Shoe TVD (ft)</label>
              <input type="number" id="mamw-tvd2" value="10000" step="1">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="mamw-mamw2">MAMW (ppg)</label>
              <input type="number" id="mamw-mamw2" value="12.54" step="0.01">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">New MAASP</span><span class="output-value" id="out-newmaasp">—</span></div>
          </div>
        </div>

        <div class="danger-box mt-24" style="max-width:700px;">
          <strong>This is a reference tool, not an operational authority.</strong> Real shoe limits used during well control belong to your certified well control supervisor, working from the actual LOT/FIT recorded on this well and your company's approved procedures.
        </div>
      </div>

      <div class="prose">
        <h2>The Formulas Used</h2>
        <dl class="formula-block">
          <dt class="formula-label">Maximum Allowable Mud Weight</dt>
          <dd class="formula-eq"><code>MAMW = Current MW + [LOT/FIT Pressure ÷ (0.052 × Shoe TVD)]</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">New MAASP With Kill Mud Weight</dt>
          <dd class="formula-eq"><code>New MAASP = (MAMW − Kill Mud Weight) × 0.052 × Shoe TVD</code></dd>
          <dd class="formula-note">Both mud weights in ppg, shoe TVD in feet, MAASP and LOT/FIT pressure in psi.</dd>
        </dl>

        <div class="note-box">
          <strong id="worked-example">Worked example:</strong> 9.4 ppg current mud weight, 415 psi LOT/FIT pressure, shoe at 6,108 ft TVD.<br />
          MAMW = 9.4 + [415 ÷ (0.052 × 6,108)] = 9.4 + 1.31 = <span class="highlight">10.71 ppg</span>.<br />
          Separately, checking an 11.5 ppg kill mud weight against a 12.54 ppg MAMW at 10,000 ft TVD: New MAASP = (12.54 − 11.5) × 0.052 × 10,000 = <span class="highlight">541 psi</span> of margin still left at that shoe.
        </div>

        <h3>Where This Fits</h3>
        <p>MAMW and <a href="/calculators/maasp">MAASP</a> come from the same <a href="/drilling/leak-off-test">LOT/FIT test</a> and describe the identical shoe limit, just in different units — one as an equivalent mud weight, one as a live surface pressure. Once a kick is confirmed and a kill mud weight is chosen on the <a href="/calculators/kill-sheet">kill sheet calculator</a>, the second box here answers the real operational question: is that kill mud weight actually safe for this shoe, and if not, how much surface pressure is left before it isn't? A negative or very small New MAASP means the planned kill mud weight is close to or past the shoe's real limit, which calls for the well control supervisor's attention before pumping starts, not after.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p set:html={item.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <SourcesStandards lang="en" ids={['api53', 'cfr250g', 'iwcf', 'iadcWellsharp']} />
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/mamw.js" defer></script>
