---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { reviewedByJabin } from '../../lib/person.js';
import { calculatorWebPage } from '../../lib/techarticle.js';

const faq = [
  {
    q: 'Does this formula use measured depth or true vertical depth?',
    a: "True vertical depth, always. Hydrostatic pressure depends on the vertical height of the fluid column above a point, not how much pipe or hole it took to get there — in a deviated or horizontal well, measured depth (MD) is longer than TVD, and plugging MD into this formula overstates the real pressure.",
  },
  {
    q: 'Why is the constant 0.052 instead of a rounder number?',
    a: 'It comes from exact unit geometry, not a convenient approximation: a US gallon is 231 cubic inches, so a one-foot column over one square inch holds 1728 ÷ 231 ÷ 144 = 0.0519481 gallons. The industry rounds that to 0.052 for field use, which is accurate enough for most purposes — see the full derivation linked below if the extra precision matters for a specific calculation.',
  },
  {
    q: 'What does it mean if hydrostatic pressure comes out higher than fracture pressure?',
    a: "That's the critical overbalanced condition this calculator flags — mud pressure has crossed the point where the formation itself breaks down, so fluid starts going into the formation instead of returning to surface (lost circulation), and the apparent pressure control is false. Treat it as urgent: stop and reassess mud weight against actual LOT/FIT data rather than continuing to drill on an assumed gradient.",
  },
];

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/calculators/hydrostatic#app",
  "name": "Hydrostatic Pressure Calculator for Drilling",
  "url": "https://rigfloorhq.com/calculators/hydrostatic",
  "description": "Free hydrostatic pressure calculator. Enter mud weight and TVD for instant psi, with pore and fracture gradients for a safe or unsafe status.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Drilling engineering calculator",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'en', reviewedBy: reviewedByJabin(), lastReviewed: '2026-10-15' });
---
<BaseLayout
  title="Hydrostatic Pressure Calculator for Drilling"
  description="Free hydrostatic pressure calculator. Enter mud weight and TVD for instant psi, with pore and fracture gradients for a safe or unsafe status."
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'Hydrostatic Pressure', href: '/calculators/hydrostatic' }]}
  lang="en"
  extraJsonLd={[webAppLd, webPageLd]}
  alternateHref="/es/calculators/hydrostatic"
>
  <Nav slot="nav" lang="en" alternateHref="/es/calculators/hydrostatic" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>Hydrostatic <span>Pressure Calculator</span></h1>
    <p class="page-hero-sub">Uses the standard formula HP = 0.052 × MW × TVD. Compares your result against pore and fracture pressure to flag kick or lost-circulation risk.</p>
    <p style="font-size:13px;color:var(--fog);margin-top:8px;">Reviewed for accuracy by <a href="/about/jabin-travis" style="color:var(--amber);">Jabin Travis</a>, IADC WellSharp-certified driller.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">⚙ Hydrostatic Pressure</div>

          <div class="input-row">
            <div class="input-group">
              <label for="mw">Mud Weight (ppg)</label>
              <input type="number" id="mw" placeholder="e.g. 12.0" step="0.1" min="7" max="22">
            </div>
            <div class="input-group">
              <label for="tvd">True Vertical Depth (ft)</label>
              <input type="number" id="tvd" placeholder="e.g. 10000" step="100" min="100">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="ppg_input">Pore Pressure Gradient (psi/ft)</label>
              <input type="number" id="ppg_input" placeholder="e.g. 0.433" step="0.001" min="0.3" max="1.0">
            </div>
            <div class="input-group">
              <label for="fg_input">Fracture Gradient (psi/ft)</label>
              <input type="number" id="fg_input" placeholder="e.g. 0.78" step="0.001" min="0.4" max="1.2">
            </div>
          </div>

          <div class="calc-output visible" aria-live="polite" id="hydro-output">
            <div class="output-line"><span class="output-label">Hydrostatic Pressure</span><span class="output-value" id="out-hp">—</span></div>
            <div class="output-line"><span class="output-label">Pore Pressure</span><span class="output-value" id="out-pp">—</span></div>
            <div class="output-line"><span class="output-label">Fracture Pressure</span><span class="output-value" id="out-fp">—</span></div>
            <div class="output-line"><span class="output-label">Overbalance</span><span class="output-value" id="out-ob">—</span></div>
            <div class="output-line" style="border-bottom:none;"><span class="output-label">Drilling Status</span><span id="out-status">—</span></div>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Not sure what to enter?</strong> Freshwater pore pressure gradient ≈ <span class="highlight">0.433 psi/ft</span>. Seawater ≈ <span class="highlight">0.445 psi/ft</span>. A typical fracture gradient in normally pressured formations runs <span class="highlight">0.7–0.85 psi/ft</span> but varies significantly by basin and depth — always use actual leak-off test (LOT) data for real operations.
        </div>

        <div class="danger-box mt-24" style="max-width:700px;">
          <strong>This is a reference tool, not an operational authority.</strong> Real pore pressure, fracture gradient, and overbalance limits for a live well belong to your drilling engineer and certified well control supervisor, working from actual LOT/FIT and offset data — never set a real mud weight program from this calculator alone.
        </div>
      </div>

      <div class="prose">
        <h2>How This Calculator Works</h2>
        <p>This tool applies the standard hydrostatic pressure formula used throughout the drilling industry:</p>
        <dl class="formula-block">
          <dt class="formula-label">Hydrostatic Pressure</dt>
          <dd class="formula-eq"><code>HP (psi) = 0.052 × MW (ppg) × TVD (ft)</code></dd>
          <dd class="formula-note">0.052 is the unit conversion constant relating pounds per gallon and feet to psi — see <a href="/blog/hydrostatic-pressure-0052-constant">why it never changes between mud types</a> for the full derivation.</dd>
        </dl>
        <p>It then compares your hydrostatic pressure against the pore pressure and fracture pressure at the same depth (calculated from the gradients you enter) to determine whether your mud weight sits safely inside the mud weight window.</p>

        <h3>Reading Your Results</h3>
        <ul>
          <li><strong style="color:var(--safe);">Safe Drilling Window</strong> — hydrostatic pressure is comfortably between pore and fracture pressure.</li>
          <li><strong style="color:var(--caution);">Very Low Overbalance</strong> — under 100 psi margin above pore pressure. Kick risk if pressure fluctuates.</li>
          <li><strong style="color:var(--warn);">High Overbalance</strong> — over 1,500 psi margin. Watch <a href="/calculators/ecd">ECD</a> carefully; risk of formation damage or differential sticking.</li>
          <li><strong style="color:var(--danger);">Underbalanced / Overbalanced (critical)</strong> — hydrostatic pressure has crossed pore or fracture pressure entirely. Immediate review required.</li>
        </ul>

        <h3>Worked Example</h3>
        <p>12.0 ppg mud at 10,000 ft TVD, against a 0.433 psi/ft pore pressure gradient and a 0.75 psi/ft fracture gradient:</p>
        <dl class="formula-block">
          <dt class="formula-label">Hydrostatic Pressure</dt>
          <dd class="formula-eq"><code>HP = 0.052 × 12.0 × 10,000 = 6,240 psi</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Pore Pressure / Fracture Pressure</dt>
          <dd class="formula-eq"><code>PP = 0.433 × 10,000 = 4,330 psi    FP = 0.75 × 10,000 = 7,500 psi</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Overbalance</dt>
          <dd class="formula-eq"><code>6,240 − 4,330 = 1,910 psi</code></dd>
          <dd class="formula-note">Above the 1,500 psi threshold this page uses for "High Overbalance" — comfortably clear of pore pressure, but the margin is now large enough to watch ECD and differential-sticking risk rather than assume it's simply safe.</dd>
        </dl>
        <p>Watching hydrostatic overbalance alongside ECD once pumps are running is <a href="/careers/driller">driller</a>-level monitoring — for pay and the complete job breakdown, see the <a href="/careers/driller">driller career guide</a>.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}

        <p>For full formula derivations and worked examples, see the <a href="/drilling/mud-weight">mud weight and pressure reference page</a>. If you're working through an active kick, use the <a href="/calculators/kill-sheet">kill sheet calculator</a> instead. For the complete reference on hydrostatic pressure itself — pore/fracture pressure, ECD, trip margin, and MAASP all tied together — see the <a href="/pillars/hydrostatic-pressure">hydrostatic pressure pillar page</a>. Need to convert mud weight to a different unit first? Use the <a href="/calculators/mud-weight-converter">mud weight converter</a>.</p>
      </div>
    </div>
    <NewsletterSignup lang="en" />
  </section>
</BaseLayout>

<script is:inline src="/scripts/calculators/hydrostatic.js" defer></script>
