const faq = [
  {
    q: 'What is a ring gasket number?',
    a: 'It is the API 6A/6BX designation stamped on the gasket itself and on the flange’s data plate — "R-24" or "BX-152", for example. The number identifies the exact gasket geometry for one bore size and pressure rating combination, so quoting the number is unambiguous in a way that "the usual one for this flange" is not.',
  },
  {
    q: 'What is the difference between an R gasket and a BX gasket?',
    a: 'An R gasket sits in a flat, symmetrical groove and relies on bolt-up force alone to seal — used on lower pressure classes, generally 2M through 5M. A BX gasket is pressure-energized: wellbore pressure itself pushes the ring tighter against the groove walls, which is why it is used at 10M and above and on virtually all BOP stack connections. The two are not interchangeable even at an overlapping bore size.',
  },
  {
    q: 'How do I find the right ring gasket for my flange?',
    a: 'Match the bore size and pressure rating stamped on the flange’s own data plate against the table. If the data plate is missing or worn, the ring groove dimensions can be measured and cross-checked against API 6A, but ordering from a measured guess rather than a confirmed rating is exactly how a mismatched gasket gets bolted up.',
  },
  {
    q: 'What does "Nut A/F" mean in the table?',
    a: 'Across-flats — the wrench size of the heavy hex nut that fits the stud, per ASME B18.2.2. It is listed because it is the dimension you actually need at the tool box: the stud diameter tells you what nut to order, but A/F tells you what socket or wrench fits it.',
  },
  {
    q: 'Are these dimensions the same for every manufacturer’s flanges?',
    a: 'API 6A standardizes the dimensions specifically so that compliant flanges from different manufacturers bolt up to each other. This table reflects Cameron’s own published figures; other API 6A-compliant manufacturers should match, but always verify against the specific flange’s data plate before ordering studs or gaskets.',
  },
  {
    q: 'Does this table apply to wellhead housings and spools too?',
    a: 'Wellhead housings, spools and BOP stack connections in this bore and pressure range generally use the same API 6A/6BX flange system, so the table applies. It does not cover clamp hub or other non-flanged connection types, which use a different sealing arrangement entirely.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Rendered server-side so the full chart is present and crawlable without
// JS. The filter script only toggles row visibility, it never writes content.
const bores = [...new Set(FLANGE_DATA.map((r) => r[0]))];
const pressures = [...new Set(FLANGE_DATA.map((r) => r[1]))].sort((a, b) => parseInt(a) - parseInt(b));
---
<BaseLayout
  title="Flange & Ring Gasket Lookup Chart"
  description="API 6A/6BX flange bore and pressure rating to ring gasket number, stud count, stud size and flange OD — Cameron's published dimensions, filterable."
  jsonLd={jsonLd}
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'Flange & Ring Gasket', href: '/calculators/flange-ring-gasket' }]}
  lang="en"
>
  {/* No alternateHref: there is no Spanish version of this page, so BaseLayout
      emits no hreflang at all rather than declaring an alternate that does not
      reciprocate. The Nav switcher still goes somewhere sensible. */}
  <Nav slot="nav" lang="en" alternateHref="/es/calculators" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>Flange & Ring Gasket <span>Lookup</span></h1>
    <p class="page-hero-sub">API 6A/6BX bore size and pressure rating to ring gasket number, stud count, stud length and diameter, and flange OD. Filter it down to one bore or one rating, or browse the whole chart.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🔩 Flange & Ring Gasket Lookup</div>
          <div class="input-row">
            <div class="input-group">
              <label for="fl-bore">Filter by Bore Size</label>
              <select id="fl-bore">
                <option value="">All bore sizes</option>
                {bores.map((b) => <option value={b}>{b}</option>)}
              </select>
            </div>
            <div class="input-group">
              <label for="fl-press">Filter by Pressure Rating</label>
              <select id="fl-press">
                <option value="">All ratings</option>
                {pressures.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
          </div>
          <div class="table-wrap mt-24">
            <table id="fl-table">
              <thead>
                <tr><th>Bore</th><th>Rating</th><th>Ring Gasket</th><th>Studs</th><th>Stud Length</th><th>Stud Dia.</th><th>Nut A/F</th><th>Flange OD</th></tr>
              </thead>
              <tbody>
                {FLANGE_DATA.map((r) => (
                  <tr data-bore={r[0]} data-press={r[1]}>
                    <td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td><td>{r[4]}</td><td>{r[5]}</td><td>{r[6]}</td><td>{r[7]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Reference only.</strong> Confirm bore size and pressure rating against the flange's own data plate before ordering studs or gaskets. This is a lookup tool, not a substitute for the equipment's certified documentation.
        </div>
      </div>

      <div class="prose">
        <h2>Reading the Chart</h2>
        <p>Every row is one bore-and-rating combination, because a flange's ring gasket, stud count, and stud size are all fixed the moment those two numbers are set — there's no independent choice to make once you know the bore and the pressure class.</p>
        <p><strong>Ring gasket number</strong> is what you order: an "R" number is a plain gasket seated in a flat groove, used up through 5M. A "BX" number is pressure-energized — wellbore pressure helps hold it sealed rather than working against it — and is standard at 10M and above, including virtually every BOP stack connection.</p>
        <p><strong>Studs, stud length and stud diameter</strong> are the physical bolt-up. <strong>Nut A/F</strong> is the width-across-flats for the matching heavy hex nut per ASME B18.2.2 — the number that tells you what socket to bring, not just what to order.</p>

        <h2 id="why-it-matters">Why This Matters on the Floor</h2>
        <p>Nippling up or down a BOP stack, changing a spool, or reconnecting a wellhead flange all come down to the same question: does the gasket, stud, and nut set actually match the bore and rating stamped on the flange. Getting a ring gasket number wrong doesn't always fail obviously — a close but incorrect BX number can look seated and still not hold at test pressure, which is exactly why the pressure test exists as a separate check from the visual one.</p>
        <p>For the stack this most often applies to, see <a href="/equipment/bop">how a BOP stack is arranged</a> and where these flanged connections sit in it. Bit and drill string connections use a completely different threaded system — see the <a href="/calculators/bit-torque">bit thread and make-up torque lookup</a> for that side of it.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The table is fully rendered server-side; this only shows/hides rows,
  // it never writes content, so the chart works identically with JS off.
  const boreSel = document.getElementById('fl-bore') as HTMLSelectElement | null;
  const pressSel = document.getElementById('fl-press') as HTMLSelectElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#fl-table tbody tr'));

  function applyFilter() {
    const bore = boreSel?.value ?? '';
    const press = pressSel?.value ?? '';
    rows.forEach((row) => {
      const matches = (!bore || row.dataset.bore === bore) && (!press || row.dataset.press === press);
      row.style.display = matches ? '' : 'none';
    });
  }

  boreSel?.addEventListener('change', applyFilter);
  pressSel?.addEventListener('change', applyFilter);
</script>
