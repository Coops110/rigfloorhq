---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SourcesStandards from '../../components/SourcesStandards.astro';
import CalculatorDisclaimer from '../../components/CalculatorDisclaimer.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { calculatorWebPage } from '../../lib/techarticle.js';

const faq = [
  {
    q: 'Why are there three different buoyed-weight numbers instead of one?',
    a: 'Each covers a different downhole condition. Open-ended pipe (drill pipe, tubing run empty and flowing through) just applies the buoyancy factor to the air weight. Closed-ended pipe with nothing inside it — a plugged joint, a run-in tool — displaces its full outside diameter with nothing pushing back from inside, so it floats more and weighs less than the open-ended case. Different fluid inside versus in the annulus (common in completions, where a lighter packer fluid sits inside tubing against heavier annulus fluid) needs both diameters and both fluid weights, since the two fluids are pushing back with different force.',
  },
  {
    q: 'Why do the open-ended and different-fluid answers come out close but not identical?',
    a: 'The open-ended formula uses a theoretical buoyancy factor based on steel\'s own density (1 − MW/65.5). The closed-ended and different-fluid formulas instead work directly off the pipe\'s actual OD and ID — real cross-sectional area, not an assumed steel density. They agree closely because they\'re describing the same physics, but they aren\'t forced to match exactly, and the geometry-based numbers are the more precise ones when the actual OD/ID are known.',
  },
  {
    q: 'Does this replace the simple buoyancy factor used elsewhere on the site (ton-mile, drilling formulas)?',
    a: 'No — that one (BF = 1 − MW/65.5) is specifically for open-ended drill pipe weight in a single fluid, which is the common drilling case and still the right tool for that job. This page covers the completions-side variants: closed-ended pipe and two different fluids on either side of the pipe wall, situations that come up in workovers and completions more than routine drilling.',
  },
];



const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/calculators/buoyancy#app",
  "name": "Buoyancy & Tubular Weight Calculator",
  "url": "https://rigfloorhq.com/calculators/buoyancy",
  "description": "Buoyancy factor and buoyed pipe weight for open-ended pipe, closed-ended pipe, and pipe with different fluid inside versus in the annulus.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Drilling engineering calculator",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'en' });

---
<BaseLayout
  title="Buoyancy & Tubular Weight Calculator"
  description="Buoyancy factor and buoyed pipe weight for open-ended pipe, closed-ended pipe, and pipe with different fluid inside versus in the annulus."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculators', href: '/calculators' }, { label: 'Buoyancy', href: '/calculators/buoyancy' }]}
  lang="en"
  alternateHref="/es/calculators/buoyancy"
>
  <Nav slot="nav" lang="en" alternateHref="/es/calculators/buoyancy" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculator</div>
    <h1>Buoyancy &amp; Tubular <span>Weight</span></h1>
    <p class="page-hero-sub">Buoyed pipe weight for open-ended pipe, closed-ended pipe, and pipe carrying a different fluid inside than what's in the annulus.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">⚓ Pipe &amp; Fluids</div>
          <div class="input-row">
            <div class="input-group">
              <label for="wair">Pipe Weight, Air (lb/ft)</label>
              <input type="number" id="wair" value="19.5" step="0.1">
            </div>
            <div class="input-group">
              <label for="od">Pipe OD (in)</label>
              <input type="number" id="od" value="5.0" step="0.01">
            </div>
            <div class="input-group">
              <label for="id">Pipe ID (in)</label>
              <input type="number" id="id" value="4.276" step="0.001">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="fwa">Fluid Weight, Annulus (ppg)</label>
              <input type="number" id="fwa" value="10" step="0.1">
            </div>
            <div class="input-group">
              <label for="fwi">Fluid Weight, Inside Pipe (ppg)</label>
              <input type="number" id="fwi" value="10" step="0.1">
            </div>
          </div>

          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line"><span class="output-label">Buoyancy Factor (steel, annulus fluid)</span><span class="output-value" id="out-bf">—</span></div>
            <div class="output-line headline"><span class="output-label">Buoyed Weight — Open-Ended</span><span class="output-value" id="out-open">—</span></div>
            <div class="output-line headline"><span class="output-label">Buoyed Weight — Closed-Ended, No Fluid Inside</span><span class="output-value" id="out-closed">—</span></div>
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Buoyed Weight — Different Fluid In/Out</span><span class="output-value" id="out-diff">—</span></div>
          </div>
        </div>

        <CalculatorDisclaimer lang="en" context="Use actual pipe OD/ID from the tally book and confirmed fluid weights for a real string-weight calculation, not catalog nominal values." />
      </div>

      <div class="prose">
        <h2>The Formulas Used</h2>
        <dl class="formula-block">
          <dt class="formula-label">Buoyancy Factor</dt>
          <dd class="formula-eq"><code>BF = 1 − (Fluid Weight ÷ 65.5)</code></dd>
          <dd class="formula-note">Some references use 65.4 for steel density instead of 65.5 — the difference is under a tenth of a percent. This site uses 65.5 everywhere for consistency; see the <a href="/calculators/formulas-cheat-sheet#buoyancy">drilling formulas cheat sheet</a> for the note on why.</dd>
        </dl>
        <dl class="formula-block">
          <dt class="formula-label">Buoyed Weight — Open-Ended Pipe</dt>
          <dd class="formula-eq"><code>W = Weight (air) × BF</code></dd>
        </dl>
        <dl class="formula-block">
          <dt class="formula-label">Buoyed Weight — Closed-Ended, No Fluid Inside</dt>
          <dd class="formula-eq"><code>W = Weight (air) − [(OD² × Fluid Weight) ÷ 24.5]</code></dd>
        </dl>
        <dl class="formula-block">
          <dt class="formula-label">Buoyed Weight — Different Fluid Inside vs. Annulus</dt>
          <dd class="formula-eq"><code>W = Weight (air) + [(ID² × Fluid Weight, inside) ÷ 24.5] − [(OD² × Fluid Weight, annulus) ÷ 24.5]</code></dd>
          <dd class="formula-note">Per the WellSharp / IWCF field-units formula sheet, buoyed weight of tubulars section.</dd>
        </dl>

        <p>For the simple open-ended case applied to a full drill string's ton-mile figure, see the <a href="/calculators/ton-mile">ton-mile calculator</a>. Neutral point and where to keep drill collars in compression are on the <a href="/calculators/formulas-cheat-sheet#buoyancy">drilling formulas cheat sheet</a>.</p>

        <h3>Worked Example</h3>
        <p>19.5 lb/ft pipe, 5.0 in OD, 4.276 in ID, 10 ppg in the annulus:</p>
        <dl class="formula-block">
          <dt class="formula-label">Buoyancy Factor</dt>
          <dd class="formula-eq"><code>1 − (10 ÷ 65.5) = 0.8473</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Open-Ended Buoyed Weight</dt>
          <dd class="formula-eq"><code>19.5 × 0.8473 = 16.52 lb/ft</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Closed-Ended, No Fluid Inside</dt>
          <dd class="formula-eq"><code>19.5 − [(5.0² × 10) ÷ 24.5] = 9.30 lb/ft</code></dd>
          <dd class="formula-note">Nearly 7 lb/ft lighter than the open-ended case — a closed end displaces its full OD with nothing pushing back from inside.</dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Different Fluid In/Out — 9.0 ppg Packer Fluid Inside, 10 ppg Annulus</dt>
          <dd class="formula-eq"><code>19.5 + [(4.276² × 9.0) ÷ 24.5] − [(5.0² × 10) ÷ 24.5] = 16.01 lb/ft</code></dd>
          <dd class="formula-note">Close to the open-ended figure here because the two fluid weights are similar — the gap widens as the inside/annulus fluid weights diverge further.</dd>
        </dl>

        <h2>Watch: Why the Same Pipe Weighs Two Different Amounts</h2>
        <VideoEmbed
          videoId="DbnH4G8ZZow"
          title="Why does the same pipe weigh two different amounts?"
          description="Open-ended or closed-ended changes your buoyed pipe weight by pounds per foot, not ounces. Same pipe, same mud, two real numbers. Free calculator, runs in your browser — rigfloorhq.com/calculators/buoyancy"
          uploadDate="2026-10-20T01:04:19-07:00"
          duration="PT0M33S"
          thumbnailUrl="https://i.ytimg.com/vi/DbnH4G8ZZow/hqdefault.jpg"
          lang="en"
        />

        <p>Knowing the real hook load after buoyancy, not the string's dry weight, is what gets watched closely during a trip — pay and the full derrickhand job picture are in the <a href="/careers/derrickhand">career guide</a>.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SourcesStandards lang="en" ids={['api7g', 'api5ct']} />
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/buoyancy.js" defer></script>
