---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const faq = [
  {
    q: 'What is hydrostatic pressure in drilling?',
    a: 'The pressure exerted by the vertical column of drilling fluid standing in the wellbore, caused by its own weight. It increases with depth and with mud weight, and it\'s the primary barrier holding back formation fluid until the well is actually cased and cemented.',
  },
  {
    q: 'What is the hydrostatic pressure formula?',
    a: 'P = 0.052 × Mud Weight (ppg) × TVD (ft), where P is in psi. 0.052 is a fixed unit-conversion constant, not a property of the mud — see the full derivation linked below.',
  },
  {
    q: 'What happens if hydrostatic pressure is too low?',
    a: 'If hydrostatic pressure drops below formation pressure, formation fluid can enter the wellbore — a kick. Left unchecked, that can progress to a blowout. This is why mud weight is chosen to sit above pore pressure with a safety margin, and why trip margin and swab/surge effects matter during pipe movement.',
  },
  {
    q: 'What happens if hydrostatic pressure is too high?',
    a: 'If hydrostatic pressure exceeds the formation\'s fracture pressure, the formation can crack and start taking fluid — lost circulation. This is the upper boundary of the mud weight window, and it\'s why mud weight isn\'t simply maximized for safety margin against kicks.',
  },
  {
    q: 'Why does hydrostatic pressure use TVD and not measured depth?',
    a: 'Hydrostatic pressure comes from the vertical height of the fluid column, not the total length of pipe or hole. In a vertical well TVD and measured depth are the same number, but in a deviated, horizontal, or extended-reach well they diverge significantly — feeding measured depth into the formula overstates pressure, sometimes badly.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": "Hydrostatic Pressure in Drilling: The Complete Reference",
      "description": "What hydrostatic pressure is, the formula behind it, how it relates to pore and fracture pressure and the mud weight window, and why TVD — not measured depth — is what actually drives it.",
      "about": "Hydrostatic pressure in drilling fluid"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<BaseLayout
  title="Hydrostatic Pressure in Drilling: The Complete Reference"
  description="What hydrostatic pressure actually is, the P = 0.052 × MW × TVD formula, how it relates to pore and fracture pressure, and why TVD — not measured depth — is what drives it."
  breadcrumbs={[{ label: 'Hydrostatic Pressure', href: '/pillars/hydrostatic-pressure' }]}
  jsonLd={jsonLd}
  lang="en"
>
  <Nav slot="nav" lang="en" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Core Reference</div>
    <h1>Hydrostatic <span>Pressure</span></h1>
    <p class="page-hero-sub">The single most load-bearing concept in well control: the pressure a column of drilling fluid exerts just by sitting in the hole, and why everything from mud weight selection to kick detection comes back to it.</p>
    <div class="page-meta">
      <a href="/calculators/hydrostatic" class="btn btn-primary" style="margin-top:8px;">Open the Hydrostatic Pressure Calculator</a>
    </div>
  </div>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="what-it-is">What Hydrostatic Pressure Actually Is</h2>
      <p>Every fluid exerts pressure just by having weight and sitting in a column — the deeper you go, the more fluid is stacked above you, and the more pressure it exerts. A drilled wellbore full of mud is exactly that: a column of fluid, and the pressure at the bottom of it is the drilling fluid's hydrostatic pressure. It isn't caused by pumping, circulation, or anything dynamic — it's there the instant the fluid is in the hole, whether the pumps are running or shut down entirely.</p>
      <p>This matters because hydrostatic pressure is the <strong>primary barrier</strong> in well control — the first and most basic thing standing between the wellbore and an uncontrolled influx of formation fluid, before any mechanical barrier like a BOP ever comes into play. Get the mud weight wrong, and the barrier is wrong before a single valve gets touched.</p>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">The Formula</div>
    <h2 class="section-title">P = 0.052 × MW <span>× TVD</span></h2>
    <p style="color:var(--fog);max-width:700px;margin-bottom:24px;">Three variables, one constant. Change any of the three inputs and the pressure changes predictably — there's no hidden complexity once you know what each term means.</p>

    <div class="formula-block" style="max-width:640px;">
      <div class="formula-label">Hydrostatic Pressure</div>
      <div class="formula-eq">P (psi) = 0.052 × Mud Weight (ppg) × TVD (ft)</div>
      <div class="formula-note">0.052 is a fixed unit-conversion constant — it's identical for every mud type. See <a href="/blog/hydrostatic-pressure-0052-constant" style="color:var(--amber);">why it never changes</a> for the full derivation from first principles.</div>
    </div>

    <div class="card-grid mt-24">
      <div class="card">
        <h3>Mud Weight (ppg)</h3>
        <p>The one variable you actually control day to day. Heavier mud means more hydrostatic pressure at the same depth — see the <a href="/drilling/mud-weight">mud weight guide</a> for how it's chosen and adjusted in the field.</p>
      </div>
      <div class="card">
        <h3>True Vertical Depth (ft)</h3>
        <p>Not measured depth. In a vertical well the two are the same; in a deviated or horizontal well they diverge sharply, and only the vertical height of the column generates pressure — see the TVD vs. MD breakdown on the <a href="/pillars/advanced-well-control-and-hydrostatics">Advanced Well Control &amp; Hydrostatics reference</a>.</p>
      </div>
      <div class="card">
        <h3>Run the Numbers</h3>
        <p>The <a href="/calculators/hydrostatic">hydrostatic pressure calculator</a> runs this formula live and compares your result against pore and fracture pressure automatically, so you don't have to do the comparison by hand.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">The Window</div>
    <h2 class="section-title">Pore Pressure, Fracture Pressure, <span>and the Window Between</span></h2>
    <div class="two-col">
      <div class="prose">
        <p>Hydrostatic pressure doesn't exist in isolation — it has to sit between two formation limits, and both failure directions are real, expensive problems:</p>
        <ul>
          <li><strong style="color:var(--white);">Too low, below pore pressure:</strong> formation fluid enters the wellbore — a kick. Left unchecked, this can progress toward a blowout.</li>
          <li><strong style="color:var(--white);">Too high, above fracture pressure:</strong> the formation itself cracks and starts taking fluid — lost circulation, which can snowball into its own control problem.</li>
        </ul>
        <p>The gap between those two limits at any given depth is the <strong>mud weight window</strong> — the safe range a driller has to keep mud weight inside. In some formations that window is wide and forgiving; in others, especially in deep or depleted reservoirs, it can be narrow enough that small errors in either direction cause a real problem. Map the whole window for a well with the <a href="/calculators/mud-weight-window">mud weight window calculator</a>.</p>
      </div>
      <div class="card" style="border:1px solid var(--iron);border-radius:4px;">
        <h3>When the Barrier Already Failed</h3>
        <p>If hydrostatic pressure has already dropped below formation pressure and a kick is underway, the <a href="/calculators/kill-sheet">kill sheet calculator</a> works out the kill mud weight and the full pressure schedule needed to regain control. The <a href="/pillars/advanced-well-control-and-hydrostatics">Advanced Well Control &amp; Hydrostatics reference</a> covers the Driller's Method and Wait and Weight kill procedures in full.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Beyond Static</div>
    <h2 class="section-title">Where This Gets <span>More Complicated</span></h2>
    <p style="color:var(--fog);max-width:740px;margin-bottom:24px;">Static hydrostatic pressure from the formula above is the foundation, but three real field effects push the actual bottomhole pressure away from that static number.</p>

    <div class="card-grid grid-3">
      <div class="card">
        <h3>Circulating: ECD</h3>
        <p>Once pumps are on, friction from the moving fluid adds to the static hydrostatic pressure — Equivalent Circulating Density. In narrow mud weight windows this added pressure can be the difference between a safe circulating bottomhole pressure and one that fractures the formation. Run it on the <a href="/calculators/ecd">ECD calculator</a>.</p>
      </div>
      <div class="card">
        <h3>Tripping: Swab and Surge</h3>
        <p>Pulling pipe out of the hole can momentarily swab bottomhole pressure down below static; running pipe in can surge it up. Trip margin is the extra mud weight carried specifically to protect against the swab side of this — see the <a href="/calculators/trip-margin">trip margin calculator</a>.</p>
      </div>
      <div class="card">
        <h3>Shoe Limits: MAASP</h3>
        <p>The casing shoe has its own fracture limit, independent of the open-hole formation further down. Maximum Allowable Annular Surface Pressure translates that shoe limit into a live surface-pressure number a crew can actually watch — see the <a href="/calculators/maasp">MAASP calculator</a> and the related <a href="/calculators/kick-tolerance">kick tolerance calculator</a>.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">FAQ</div>
    <h2 class="section-title">Frequently Asked <span>Questions</span></h2>
    <div class="accordion">
      {faq.map((item, i) => (
        <div class="acc-item">
          <button class="acc-header"><h3>{item.q}</h3><span class="acc-arrow">▼</span></button>
          <div class="acc-body"><p set:html={item.a} /></div>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="note-box" style="max-width:800px;margin:0 auto 32px;text-align:center;">
      <strong>This page is the foundation.</strong> For the supervisor- and engineer-level material built on top of it — kill methods, regional context, and the full formula set — continue to <a href="/pillars/advanced-well-control-and-hydrostatics" style="color:var(--amber);">Advanced Well Control &amp; Hydrostatics</a>.
    </div>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href="/calculators/hydrostatic" class="btn btn-primary">Hydrostatic Pressure Calculator</a>
      <a href="/calculators" class="btn btn-outline">All Drilling Calculators</a>
    </div>
  </section>
</BaseLayout>

<script>
function toggleAcc(btn: HTMLElement) {
  const body = btn.nextElementSibling as HTMLElement;
  const arrow = btn.querySelector('.acc-arrow') as HTMLElement;
  const isOpen = body.classList.contains('open');
  document.querySelectorAll('.acc-body').forEach(b => b.classList.remove('open'));
  document.querySelectorAll('.acc-arrow').forEach(a => (a as HTMLElement).style.transform = '');
  if (!isOpen) {
    body.classList.add('open');
    arrow.style.transform = 'rotate(180deg)';
  }
}
document.querySelectorAll('.acc-header').forEach(btn => {
  btn.addEventListener('click', () => toggleAcc(btn as HTMLElement));
});
</script>
