---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import QuizTopicInteractive from '../../components/QuizTopicInteractive.astro';
import quizData from '../../lib/data/well-control-quiz.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Shut-In Conditions';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: 'Is this quiz officially affiliated with IWCF or IADC?',
    a: "No. The questions cover the same ground tested in IWCF and IADC WellSharp well control certification exams, but this quiz isn't produced, endorsed, or affiliated with either body, and passing it doesn't substitute for accredited certification.",
  },
  {
    q: 'What formula does kill mud weight actually use?',
    a: "KMW = current mud weight + (SIDPP ÷ (0.052 × TVD)). SIDPP, not SICP, is the input, because it reflects the gap between the drillstring's own hydrostatic pressure and true formation pressure without the influx's gradient in the way.",
  },
  {
    q: 'Why SIDPP and not SICP for this calculation?',
    a: "The drillstring never sees the kick fluid — it's still full of the original mud. SICP is read through the annulus, which does contain the influx, so it reflects both formation pressure and the influx's own (unknown) gradient. SIDPP gives a cleaner read on formation pressure alone.",
  },
];

const breadcrumbs = [
  { label: 'Well Control Quiz', href: '/well-control-quiz' },
  { label: 'Shut-In Conditions', href: '/well-control-quiz/shut-in-conditions' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
  "acceptedAnswer": {
    "@type": "Answer",
    "text": `${q.correctAnswer}. ${q.choices[q.correctAnswer]}`,
  },
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/well-control-quiz/shut-in-conditions#webpage",
  "name": "Shut-In Conditions — Well Control Quiz",
  "url": "https://rigfloorhq.com/well-control-quiz/shut-in-conditions",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Calculating kill mud weight from SIDPP, current mud weight, and TVD after shut-in",
  "inLanguage": "en",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Shut-In Conditions Well Control Quiz — 25 Practice Questions"
  description="25 kill mud weight practice questions from real SIDPP, mud weight, and TVD shut-in data. Free, take it live, instant scoring and explanations."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="en"
  alternateHref="/es/well-control-quiz/condiciones-de-cierre"
>
  <Nav slot="nav" lang="en" alternateHref="/es/well-control-quiz/condiciones-de-cierre" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Well Control Quiz — Shut-In Conditions</div>
    <h1>Shut-In Conditions <span>Quiz</span></h1>
    <p class="page-hero-sub">25 practice questions working out kill mud weight from real shut-in data — SIDPP, current mud weight, and well depth, the exact numbers a real shut-in casing pressure gauge and drillpipe gauge would show.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="what-this-covers">What This Topic Covers</h2>
        <p>Once a well is shut in, the two gauge readings — SIDPP and SICP — have to turn into an actual kill mud weight before anything else happens. This topic tests that one calculation repeatedly, with both MD/TVD given separately (so you have to use the right one) and some problems that ask you to work backward from a target kill weight to find the missing input instead. The live <a href="/calculators/kill-sheet">kill sheet calculator</a> runs this exact math, and for worked word-problem versions with full shut-in scenarios, see the <a href="/well-control-quiz/kill-sheet-practice">kill sheet practice problems</a>.</p>

        <h2 id="sample-questions">Sample Questions</h2>
        <p>Three real questions from the 25-question pool, so you know what you're getting into before starting. Answers aren't shown here — take the live quiz below for scoring and explanations.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <details class="acc-item mt-24">
          <summary class="acc-header">See all {questions.length} questions in this topic<span class="acc-arrow">▼</span></summary>
          <div class="acc-body">
            {questions.map((q, i) => (
              <div style="margin-bottom:18px;">
                <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
                <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
                  {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                    <li>{letter}. {text}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>

        <h2 id="take-the-quiz">Take the Quiz</h2>
        <QuizTopicInteractive topicSlug="shut-in-conditions" topicName={TOPIC} topicIcon="🔒" questions={questions} />

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">On This Page</div>
          <a href="#what-this-covers">What This Covers</a>
          <a href="#sample-questions">Sample Questions</a>
          <a href="#take-the-quiz">Take the Quiz</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Work the Math Yourself</h3>
          <p style="margin-bottom:12px;">Run real SIDPP, mud weight, and TVD numbers through the live calculator.</p>
          <a href="/calculators/kill-sheet" class="card-link">Kill Sheet Calculator →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>More Quiz Topics</h3>
          <a href="/well-control-quiz" class="card-link">→ All 8 Topics</a><br><br>
          <a href="/well-control-quiz/warning-signs-and-shut-in" class="card-link">→ Warning Signs and Shut-In</a><br><br>
          <a href="/well-control-quiz/volumes-and-maasp" class="card-link">→ Volumes and MAASP</a><br><br>
          <a href="/well-control-quiz/kill-sheet-practice" class="card-link">→ Kill Sheet Word Problems</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
