---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import QuizTopicInteractive from '../../components/QuizTopicInteractive.astro';
import quizData from '../../lib/data/well-control-quiz.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Subsea Questions';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: 'Is this quiz officially affiliated with IWCF or IADC?',
    a: "No. The questions cover the same ground tested in IWCF and IADC WellSharp well control certification exams, but this quiz isn't produced, endorsed, or affiliated with either body, and passing it doesn't substitute for accredited certification.",
  },
  {
    q: 'Why does removing the riser change bottom-hole pressure?',
    a: "The riser carries mud from the rig floor down to the seabed, adding a long column of mud-weight hydrostatic pressure above the BOP. Without it, that same vertical distance is instead filled with seawater, which has a lower, fixed gradient than most drilling mud — so BHP drops by the difference between the two gradients over that interval.",
  },
  {
    q: "What's different about a subsea well's pressure picture versus a land well?",
    a: "A subsea well has an extra fluid column — seawater, from the rig floor down to the seabed — on top of the mud column from the seabed to TVD, plus an air gap between the rig floor and sea level. Land and shallow-water wells skip the seawater-gradient and riser-margin calculations this topic tests entirely.",
  },
];

const breadcrumbs = [
  { label: 'Well Control Quiz', href: '/well-control-quiz' },
  { label: 'Subsea Questions', href: '/well-control-quiz/subsea-questions' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/well-control-quiz/subsea-questions#webpage",
  "name": "Subsea Questions — Well Control Quiz",
  "url": "https://rigfloorhq.com/well-control-quiz/subsea-questions",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Riser margin and bottom-hole pressure effects specific to subsea and deepwater wells",
  "inLanguage": "en",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Subsea Questions Well Control Quiz — 25 Practice Questions"
  description="25 subsea and deepwater well control practice questions: seawater depth, air gap, and riser-disconnect pressure effects. Free, take it live."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="en"
  alternateHref="/es/well-control-quiz/preguntas-submarinas"
>
  <Nav slot="nav" lang="en" alternateHref="/es/well-control-quiz/preguntas-submarinas" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Well Control Quiz — Subsea Questions</div>
    <h1>Subsea <span>Questions</span> Quiz</h1>
    <p class="page-hero-sub">25 practice questions specific to subsea and deepwater wells — seawater depth, gradient, air gap, and what actually happens to bottom-hole pressure if the riser disconnects.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="what-this-covers">What This Topic Covers</h2>
        <p>A subsea well's pressure picture has an extra fluid column land and shallow-water wells don't: seawater, from the rig floor down to the seabed, at its own lower, fixed gradient. These questions work through that extra column — seawater depth and gradient, air gap, and the real pressure consequence if the riser comes off the BOP mid-operation, which removes that entire mud-filled column and replaces it with seawater at once. See the live <a href="/calculators/riser-margin">riser margin calculator</a> for the exact math these questions test.</p>

        <h2 id="sample-questions">Sample Questions</h2>
        <p>Three real questions from the 25-question pool, so you know what you're getting into before starting. Answers aren't shown here — take the live quiz below for scoring and explanations.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <h2 id="take-the-quiz">Take the Quiz</h2>
        <QuizTopicInteractive topicSlug="subsea-questions" topicName={TOPIC} topicIcon="🌊" questions={questions} />

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">On This Page</div>
          <a href="#what-this-covers">What This Covers</a>
          <a href="#sample-questions">Sample Questions</a>
          <a href="#take-the-quiz">Take the Quiz</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Work the Math Yourself</h3>
          <p style="margin-bottom:12px;">Run real seawater depth, gradient, and air gap numbers through the live calculator.</p>
          <a href="/calculators/riser-margin" class="card-link">Riser Margin Calculator →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>More Quiz Topics</h3>
          <a href="/well-control-quiz" class="card-link">→ All 8 Topics</a><br><br>
          <a href="/well-control-quiz/some-tricky-stuff" class="card-link">→ Some Tricky Stuff</a><br><br>
          <a href="/careers/toolpusher" class="card-link">→ How to Become a Toolpusher</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
