---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import QuizTopicInteractive from '../../components/QuizTopicInteractive.astro';
import quizData from '../../lib/data/well-control-quiz.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Warning Signs and Shut-In';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: 'Is this quiz officially affiliated with IWCF or IADC?',
    a: "No. The questions cover the same ground tested in IWCF and IADC WellSharp well control certification exams, but this quiz isn't produced, endorsed, or affiliated with either body, and passing it doesn't substitute for accredited certification.",
  },
  {
    q: "What's the single most reliable warning sign a well is kicking?",
    a: "An unexplained pit-volume gain — mud coming back out of the well faster than it's being pumped in, with no change on the surface to account for it. Flow rate and ROP changes can suggest a kick too, but pit gain is the hardest signal to explain away with anything other than an influx.",
  },
  {
    q: 'What does this topic assume I already know?',
    a: "The basics from the Basic Knowledge topic — what SIDPP and SICP measure, and how pit gain behaves. This topic builds on that to test whether you recognize the warning signs themselves and know the correct flow-check and shut-in response once one shows up.",
  },
];

const breadcrumbs = [
  { label: 'Well Control Quiz', href: '/well-control-quiz' },
  { label: 'Warning Signs and Shut-In', href: '/well-control-quiz/warning-signs-and-shut-in' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/well-control-quiz/warning-signs-and-shut-in#webpage",
  "name": "Warning Signs and Shut-In — Well Control Quiz",
  "url": "https://rigfloorhq.com/well-control-quiz/warning-signs-and-shut-in",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Kick warning signs and the correct flow-check and shut-in response",
  "inLanguage": "en",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Warning Signs and Shut-In Well Control Quiz — 25 Practice Questions"
  description="25 practice questions on kick warning signs, flow checks, and when and how to shut in. Free, take it live, instant scoring and explanations."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="en"
  alternateHref="/es/well-control-quiz/warning-signs-and-shut-in"
>
  <Nav slot="nav" lang="en" alternateHref="/es/well-control-quiz/warning-signs-and-shut-in" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Well Control Quiz — Warning Signs</div>
    <h1>Warning Signs and <span>Shut-In</span> Quiz</h1>
    <p class="page-hero-sub">25 practice questions on recognizing an actual kick in progress — pit gain, flow-rate changes, and trip-tank discrepancies — and the correct flow-check and shut-in response once one shows up.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="what-this-covers">What This Topic Covers</h2>
        <p>Spotting a kick early is mostly about not explaining away a real signal. These questions cover the warning signs themselves — pit gain, a flow rate that doesn't match pump rate, reduced drilling torque, and the specific case of a trip-tank mismatch while pulling out of hole — plus what the correct response actually is once one appears: flow-check first, shut in if the well confirms flowing. See the full <a href="/blog/five-warning-signs-of-a-kick">five warning signs of a kick</a> breakdown and the <a href="/drilling/well-control">well control reference page</a> for the procedures these questions test.</p>

        <h2 id="sample-questions">Sample Questions</h2>
        <p>Three real questions from the 25-question pool, so you know what you're getting into before starting. Answers aren't shown here — take the live quiz below for scoring and explanations.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <h2 id="take-the-quiz">Take the Quiz</h2>
        <QuizTopicInteractive topicSlug="warning-signs-and-shut-in" topicName={TOPIC} topicIcon="🚨" questions={questions} />

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">On This Page</div>
          <a href="#what-this-covers">What This Covers</a>
          <a href="#sample-questions">Sample Questions</a>
          <a href="#take-the-quiz">Take the Quiz</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Go Deeper</h3>
          <p style="margin-bottom:12px;">The full procedure these questions are built around, step by step.</p>
          <a href="/drilling/well-control" class="card-link">Well Control Reference →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>More Quiz Topics</h3>
          <a href="/well-control-quiz" class="card-link">→ All 8 Topics</a><br><br>
          <a href="/well-control-quiz/basic-knowledge" class="card-link">→ Basic Knowledge</a><br><br>
          <a href="/well-control-quiz/shut-in-conditions" class="card-link">→ Shut-In Conditions</a><br><br>
          <a href="/blog/five-warning-signs-of-a-kick" class="card-link">→ Five Warning Signs of a Kick</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
