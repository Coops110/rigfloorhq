---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import QuizTopicInteractive from '../../components/QuizTopicInteractive.astro';
import quizData from '../../lib/data/well-control-quiz.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Volumes and MAASP';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: 'Is this quiz officially affiliated with IWCF or IADC?',
    a: "No. The questions cover the same ground tested in IWCF and IADC WellSharp well control certification exams, but this quiz isn't produced, endorsed, or affiliated with either body, and passing it doesn't substitute for accredited certification.",
  },
  {
    q: 'What does MAASP actually represent?',
    a: "The maximum surface pressure the casing shoe can take before it breaks down or starts taking losses, at the current mud weight in the hole. It's derived from a real leak-off or formation integrity test, then recalculated every time mud weight changes — it isn't a fixed number for the well.",
  },
  {
    q: 'Why does MAASP shrink as mud weight goes up?',
    a: "A heavier mud column already provides more of the hydrostatic pressure the shoe is holding back, which leaves less surface-pressure margin before the shoe's tested limit is reached. MAASP and mud weight move in opposite directions by design.",
  },
];

const breadcrumbs = [
  { label: 'Well Control Quiz', href: '/well-control-quiz' },
  { label: 'Volumes and MAASP', href: '/well-control-quiz/volumes-and-maasp' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/well-control-quiz/volumes-and-maasp#webpage",
  "name": "Volumes and MAASP — Well Control Quiz",
  "url": "https://rigfloorhq.com/well-control-quiz/volumes-and-maasp",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Calculating MAASP from MAMW, current mud weight, and shoe TVD",
  "inLanguage": "en",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Volumes and MAASP Well Control Quiz — 25 Practice Questions"
  description="25 MAASP practice questions from real MAMW, mud weight, and shoe TVD data. Free, take it live, instant scoring and explanations."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="en"
  alternateHref="/es/well-control-quiz/volumenes-y-maasp"
>
  <Nav slot="nav" lang="en" alternateHref="/es/well-control-quiz/volumenes-y-maasp" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Well Control Quiz — Volumes and MAASP</div>
    <h1>Volumes and <span>MAASP</span> Quiz</h1>
    <p class="page-hero-sub">25 practice questions converting maximum allowable mud weight, current mud weight, and shoe TVD into the real surface-pressure limit the casing shoe can actually take.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="what-this-covers">What This Topic Covers</h2>
        <p>MAASP is the number that tells a crew how much surface pressure is left before the shoe takes losses — and it's recalculated, not looked up once. These questions all work the same relationship: MAASP = (MAMW − current mud weight) × 0.052 × shoe TVD, repeated with different depths and mud weight gaps until the formula stops needing conscious thought. The live <a href="/calculators/maasp">MAASP calculator</a> runs this exact math, and the <a href="/calculators/mamw">MAMW calculator</a> covers the related conversion the other direction.</p>

        <h2 id="sample-questions">Sample Questions</h2>
        <p>Three real questions from the 25-question pool, so you know what you're getting into before starting. Answers aren't shown here — take the live quiz below for scoring and explanations.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <h2 id="take-the-quiz">Take the Quiz</h2>
        <QuizTopicInteractive topicSlug="volumes-and-maasp" topicName={TOPIC} topicIcon="📊" questions={questions} />

        <h2 id="faq">Frequently Asked Questions</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">On This Page</div>
          <a href="#what-this-covers">What This Covers</a>
          <a href="#sample-questions">Sample Questions</a>
          <a href="#take-the-quiz">Take the Quiz</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Work the Math Yourself</h3>
          <p style="margin-bottom:12px;">Run real MAMW, mud weight, and shoe TVD numbers through the live calculator.</p>
          <a href="/calculators/maasp" class="card-link">MAASP Calculator →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>More Quiz Topics</h3>
          <a href="/well-control-quiz" class="card-link">→ All 8 Topics</a><br><br>
          <a href="/well-control-quiz/shut-in-conditions" class="card-link">→ Shut-In Conditions</a><br><br>
          <a href="/well-control-quiz/kill-methods" class="card-link">→ Kill Methods</a><br><br>
          <a href="/calculators/mamw" class="card-link">→ MAMW Calculator</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
