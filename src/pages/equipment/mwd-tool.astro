const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/equipment/mwd-tool.astro',
  path: '/equipment/mwd-tool',
  headline: "MWD Tool: How Measurement While Drilling Works",
  description: "What an MWD tool is, mud pulse telemetry, MWD vs. LWD, where it sits in the BHA, and common failure modes.",
  lang: 'en',
