const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/equipment/fluid-circulation-system.astro',
  path: '/equipment/fluid-circulation-system',
  headline: "Fluid Circulation System: Pumps, Standpipe & Flow",
  description: "How a rig's fluid circulation system works: mud pumps, the standpipe and rotary hose, the full flow path from pits to bit and back, and why pump output matters for hole cleaning.",
