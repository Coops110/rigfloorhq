import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ToolGallery from '../../components/ToolGallery.astro';
import { techArticleSchema } from '../../lib/techarticle.js';
import KeyFacts from '../../components/KeyFacts.astro';


const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/equipment/casing-shoe.astro',
  path: '/equipment/casing-shoe',
  headline: "Casing Shoe: Guide Shoe vs. Float Shoe Explained",
  description: "What a casing shoe is, guide shoe vs. float shoe designs, how it differs from a float sub placed higher in the string, and common failure modes.",
  lang: 'en',
});
---
<BaseLayout
  extraJsonLd={[techArticleJsonLd]}
  title="Casing Shoe: Guide Shoe vs. Float Shoe Explained"
  description="What a casing shoe is, guide shoe vs. float shoe designs, how it differs from a float sub placed higher in the string, and common failure modes."
  breadcrumbs={[{ label: 'Equipment', href: '/equipment' }, { label: 'Casing Shoe', href: '/equipment/casing-shoe' }]}
  lang="en"
  alternateHref="/es/equipment/casing-shoe"
>
  <Nav slot="nav" lang="en" alternateHref="/es/equipment/casing-shoe" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Equipment — Downhole Tools</div>
    <h1>Casing <span>Shoe</span></h1>
    <p class="page-hero-sub">The rounded nose made up on the very bottom of a casing string, guiding it past ledges and ensuring it doesn't hang up on the way into the hole.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <ToolGallery image1="/images/equipment/casing-shoe-1.jpg" image2="/images/equipment/casing-shoe-2.jpg" alt="a generic casing guide shoe" />
      <div class="prose">
        <h2 id="what-it-is">What a Casing Shoe Is</h2>
        <p>A casing shoe is made up on the bottom joint of a casing string before running in hole. Its rounded or tapered nose profile is specifically designed to deflect the string smoothly past doglegs, ledges, and minor wellbore restrictions as it descends, rather than catching on them the way a flat or square pipe end would.</p>
        <p>Two basic types exist, distinguished by what's inside the shoe rather than by the guiding function itself, which both share.</p>

        <KeyFacts
          lang="en"
          rows={[["Where it sits", "On the bottom of the first casing joint; a float collar usually sits one to three joints above it, and the joints between form the shoe track."], ["Types", "Guide shoe (open bore), float shoe (flapper or spring-loaded ball check valve), and reamer shoe for tight or ledged hole."], ["Construction", "Steel body with drillable internals — cement, composite or aluminium nose and valve — so the next bit can drill straight through it."], ["Sizes", "Made for every API casing size, from 4-1/2\" production casing to 20\" and larger conductor and surface strings."], ["After drill-out", "A formation integrity test or leak-off test is normally run just below the shoe before drilling the next section."]]}
          standards={["api10f", "api5ct"]}
        />

        <h2 id="guide-vs-float">Guide Shoe vs. Float Shoe</h2>
        <p>A <strong>guide shoe</strong> is purely mechanical — an open bore with the guiding nose profile, allowing fluid to flow freely in both directions through it as the string runs in and cement is later pumped through during the cement job. It adds nothing but the shape.</p>
        <p>A <strong>float shoe</strong> adds a check-valve element — a flapper or ball-and-seat design — at the same bottom position. That valve still allows fluid to be pumped down through the shoe (necessary for the later cement job) but prevents flow from coming back up into the casing, reducing the chance of the string floating as it's run and avoiding a U-tube effect that can complicate running the string in a controlled, weighted manner.</p>

        <h2 id="when-used">When Each Is Chosen</h2>
        <ul>
          <li><strong>Guide shoe</strong> when the primary concern is simply getting the string to bottom cleanly, with no particular need to control backflow during running.</li>
          <li><strong>Float shoe</strong> when running the string with a controlled fill level is important — common on longer or deviated strings where an uncontrolled U-tube effect during running could complicate well control or string handling.</li>
        </ul>

        <h2 id="failure-modes">Common Failure Modes</h2>
        <ul>
          <li><strong>Valve seat fouling</strong> on a float shoe, where debris or cuttings lodge in the seat and prevent a full seal, defeating the backflow-prevention function while the guide profile keeps working normally.</li>
          <li><strong>Restriction too severe</strong> for the nose profile to deflect past, requiring the string to be worked, rotated, or the restriction addressed before continuing to run in.</li>
          <li><strong>Shoe damage on a rough trip in</strong>, particularly in a deviated or doglegged wellbore, which can blunt the guiding profile partway down the run.</li>
        </ul>

        <h2 id="vs-float-sub">Casing Shoe vs. Float Sub</h2>
        <p>A casing shoe and a <a href="/equipment/float-sub">float sub</a> can perform a nearly identical check-valve function, but at different positions in the string. The casing shoe sits at the absolute bottom, made up on the last joint, combining the valve with the guiding nose. A float sub is placed further up — one or more joints above bottom — when the job specifically calls for the valve function at that higher position rather than at the very bottom of the string. Running casing correctly to bottom with the right shoe is <a href="/careers/roughneck">roughneck</a> and driller work together on the floor — the <a href="/careers/roughneck">roughneck career guide</a> covers pay and the real day-to-day job.</p>

      </div>

      <div>
        <div class="toc">
          <div class="toc-title">On This Page</div>
          <a href="#what-it-is">What It Is</a>
          <a href="#key-facts">Key Facts</a>
          <a href="#guide-vs-float">Guide vs. Float Shoe</a>
          <a href="#when-used">When Each Is Chosen</a>
          <a href="#failure-modes">Failure Modes</a>
          <a href="#vs-float-sub">vs. Float Sub</a>
        </div>
        <div class="note-box mt-24">
          <strong>Reference only.</strong> Valve design and pressure ratings vary by manufacturer and model — always confirm against the actual tool's spec sheet before relying on any figure here for a real job.
        </div>
        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Related Reading</h3>
          <a href="/equipment/float-sub" class="card-link">→ Float Sub</a><br><br>
          <a href="/equipment/mule-shoe" class="card-link">→ Mule Shoe</a><br><br>
          <a href="/equipment/centralizer" class="card-link">→ Centralizer</a><br><br>
          <a href="/drilling/casing" class="card-link">→ Casing Design Explained</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
