import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { techArticleSchema } from '../../lib/techarticle.js';
import KeyFacts from '../../components/KeyFacts.astro';


const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/equipment/mud-pit-system.astro',
  path: '/equipment/mud-pit-system',
  headline: "Mud Pit / Solids Control System: Shakers, Desanders",
  description: "How a rig's solids control system works: shale shakers, desanders and desilters, degassers, and why drilling fluid has to be processed before it can be reused.",
  lang: 'en',
