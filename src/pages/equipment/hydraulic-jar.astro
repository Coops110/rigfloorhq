const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/equipment/hydraulic-jar.astro',
  path: '/equipment/hydraulic-jar',
  headline: "Hydraulic Jar: How Drilling Jars Deliver Impact to Free",
  description: "What a hydraulic jar is, up jar vs. down jar, how a jar accelerator stores extra energy, common failure modes, and how it differs from a safety joint.",
