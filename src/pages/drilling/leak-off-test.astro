          <a href="/drilling/well-control" class="card-link">→ Well Control Procedures Hub</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Frequently Asked Questions</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
          <p set:html={item.a} />
        </div>
      ))}
    </div>
  </section>

  <SourcesStandards lang="en" ids={['api53', 'cfr250g']} />
</BaseLayout>
