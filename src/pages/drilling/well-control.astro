import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SourcesStandards from '../../components/SourcesStandards.astro';
import { techArticleSchema } from '../../lib/techarticle.js';

const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/drilling/well-control.astro',
  path: '/drilling/well-control',
  headline: 'Well Control & Kicks — Recognition, Shut-In, Kill Procedures',
  description: "Complete well control reference: kick recognition signs, shut-in procedures, the driller's method vs wait-and-weight, and kill sheet calculations.",
  lang: 'en',
});
---
<BaseLayout
  title="Well Control & Kicks — Recognition, Shut-In, Kill Procedures"
  description="Complete well control reference: kick recognition signs, shut-in procedures, the driller's method vs wait-and-weight, and kill sheet calculations."
  extraJsonLd={[techArticleJsonLd]}
  breadcrumbs={[{ label: 'Drilling', href: '/drilling' }, { label: 'Well Control', href: '/drilling/well-control' }]}
  lang="en"
  alternateHref="/es/drilling/well-control"
>
  <Nav slot="nav" lang="en" alternateHref="/es/drilling/well-control" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Drilling — Emergency Procedures</div>
    <h1>Well <span>Control</span></h1>
    <p class="page-hero-sub">A kick is an influx of formation fluid into the wellbore because formation pressure has exceeded <a href="/pillars/hydrostatic-pressure" style="color:var(--amber);">hydrostatic pressure</a>. Every crew member must know the warning signs — early detection means a manageable situation.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <h2 class="section-title" style="font-size:28px;">Kick <span>Recognition</span></h2>
        <div class="safety-matrix">
          <div class="safety-item green">
            <h3>✅ Normal — Keep Drilling</h3>
            <p>Steady pit volume. Returns match pump output. Normal gas levels. Stable ROP and torque.</p>
          </div>
          <div class="safety-item yellow">
            <h3>⚠ Warning Signs</h3>
            <p>Any unexplained pit gain, however small. Drilling break. Increase in return flow while pump rate is constant. Hole taking the wrong fill on trips. Any of these means stop and flow check.</p>
          </div>
          <div class="safety-item orange">
            <h3>🔶 Shut In Now</h3>
            <p>Positive flow check: the well flows with pumps off. Any confirmed, unexplained pit gain. Do not wait for the gain to reach a set number of barrels; the smaller the influx when you shut in, the easier the kill. Any positive SIDPP/SICP after shut-in. That pit gain volume also tells you roughly how far the influx has moved up the annulus — see the <a href="/calculators/kick-influx-geometry" style="color:var(--amber);">kick influx geometry calculator</a> for influx length, height and gradient from the gain and hole inclination.</p>
          </div>
          <div class="safety-item red">
            <h3>🚨 Emergency</h3>
            <p>Uncontrolled flow at surface. BOP failure. Evacuate and activate emergency response plan immediately.</p>
          </div>
        </div>

        <div class="danger-box mt-24">
          <strong>Never drill through a suspected kick.</strong> The moment any warning sign appears, stop making hole and pick up off bottom immediately. Hesitation is the single biggest factor that turns a manageable kick into a blowout.
        </div>
      </div>

      <div>
        <h2 class="section-title" style="font-size:28px;">Shut-In <span>Procedure</span></h2>
        <div class="accordion">
          <details class="acc-item">
            <summary class="acc-header">Step 1 — Stop Drilling, Space Out, Flow Check<span class="acc-arrow">▼</span></summary>
            <div class="acc-body"><p>Stop making hole the moment a kick is suspected. Pick up off bottom and space out so a tool joint is clear of the BOP element you will close. Stop the pumps, then flow check: watch the flow line or trip tank for flow with pumps off. If the well flows, or you have any doubt, shut in. Do not keep circulating to "see if it settles".</p></div>
          </details>
          <details class="acc-item">
            <summary class="acc-header">Step 2 — Shut In the Well<span class="acc-arrow">▼</span></summary>
            <div class="acc-body"><p>Follow the shut-in method your company procedure and well-specific bridging document specify. Hard shut-in: with the adjustable choke already closed, close the BOP (annular or ram per procedure), then open the choke line HCR valve so casing pressure reads on the choke panel; the choke itself stays closed. Soft shut-in: open the choke line HCR valve with the choke open, close the BOP, then close the choke. Notify toolpusher and company man immediately.</p></div>
          </details>
          <details class="acc-item">
            <summary class="acc-header">Step 3 — Read Pressures<span class="acc-arrow">▼</span></summary>
            <div class="acc-body"><p>Record stabilised SIDPP and SICP at the interval your company procedure specifies, and log pressures against time. Do not wait a fixed period: if both pressures keep climbing together after they have stabilised, gas is likely migrating and needs managing per procedure. Record SIDPP, SICP, and pit gain volume — your inputs for the kill sheet. Check that pit gain against the well's kick tolerance before deciding the kill can proceed as planned — see the <a href="/calculators/kick-tolerance" style="color:var(--amber);">kick tolerance calculator</a>.</p></div>
          </details>
          <details class="acc-item">
            <summary class="acc-header">Step 4 — Calculate Kill Mud Weight<span class="acc-arrow">▼</span></summary>
            <div class="acc-body"><p>KMW = OMW + (SIDPP ÷ (0.052 × TVD)). Add safety margin per company policy. Calculate ICP and FCP for the kill sheet. Weighting up to that number takes real sacks on location — run it through the <a href="/calculators/barite-required" style="color:var(--amber);">barite required calculator</a>.</p></div>
          </details>
          <details class="acc-item">
            <summary class="acc-header">Step 5 — Kill the Well<span class="acc-arrow">▼</span></summary>
            <div class="acc-body"><p>Driller's Method or Wait-and-Weight — both are valid, follow your company's approved procedure. See comparison below.</p></div>
          </details>
          <details class="acc-item">
            <summary class="acc-header">Step 6 — Verify & Resume<span class="acc-arrow">▼</span></summary>
            <div class="acc-body"><p>Confirm zero pressure and no flow before resuming. Investigate root cause before drilling ahead.</p></div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Kill Methods</div>
    <h2 class="section-title">Driller's Method vs <span>Wait-and-Weight</span></h2>

    <div class="table-wrap">
      <table>
        <thead><tr><th>Method</th><th>Process</th><th>Advantage</th><th>Disadvantage</th></tr></thead>
        <tbody>
          <tr>
            <td>Driller's Method</td>
            <td>Circulate the kick out first at original mud weight while holding casing pressure constant, then weight up and circulate to TD in a second circulation.</td>
            <td>Can begin immediately — no time spent mixing kill mud first</td>
            <td>Two full circulations required; more time on well overall</td>
          </tr>
          <tr>
            <td>Wait-and-Weight (Engineer's Method)</td>
            <td>Prepare kill-weight mud first, then circulate the well in a single stage using the weighted mud.</td>
            <td>Single circulation — often faster overall, less annular pressure exposure</td>
            <td>Requires time to mix sufficient kill mud volume before starting</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p style="color:var(--fog);font-size:13px;margin-top:20px;max-width:700px;">Both methods are industry-accepted and taught in IWCF/IADC well control certification. Which one is used depends on company policy, kick severity, and available kill mud on location. Use the <a href="/calculators/kill-sheet" style="color:var(--amber);">kill sheet calculator</a> to run the actual numbers for either method, or the <a href="/calculators/formulas-cheat-sheet" style="color:var(--amber);">drilling formulas cheat sheet</a> if you are working them out on paper. A third option, bullheading, skips circulating the influx out entirely and instead pumps kill fluid straight down against the formation — a real technique for a plugged string or when circulating isn't possible, with its own surface pressure limits worked out on the <a href="/calculators/bullheading" style="color:var(--amber);">bullheading calculator</a>.</p>

    <div class="note-box mt-24">
      <strong id="worked-example">Worked example — Kill Mud Weight:</strong> Shut in at 10,000 ft TVD on 10.0 ppg original mud weight with 300 psi SIDPP. KMW = 10.0 + (300 ÷ (0.052 × 10,000)) = 10.0 + (300 ÷ 520) = 10.0 + 0.58 = <span class="highlight">10.58 ppg</span>, which rounds up to <span class="highlight">10.6 ppg</span> per IADC WellSharp convention. Run the same numbers through the <a href="/calculators/kill-sheet" style="color:var(--amber);">kill sheet calculator</a> and you'll get the identical figure.
    </div>

    <div class="note-box mt-24">
      <strong>BOP Pressure Checks (Daily):</strong> Accumulator pressure: <span class="highlight">3,000 psi</span> · Manifold pressure: <span class="highlight">1,500 psi</span> · Annular operating: <span class="highlight">700–1,500 psi</span> · Air supply to pumps: <span class="highlight">125 psi</span>. Full detail on the <a href="/equipment/bop" style="color:var(--amber);">BOP equipment page</a>, including the <a href="/equipment/well-protector" style="color:var(--amber);">well protector</a> that sits below it on a subsea stack.
    </div>

    <p style="color:var(--fog);font-size:14px;margin-top:24px;max-width:700px;">Ready to go deeper? The <a href="/pillars/advanced-well-control-and-hydrostatics" style="color:var(--amber);">Advanced Well Control guide</a> covers TVD vs MD, ECD, the volumetric method, managed pressure drilling, and regional considerations for supervisor and engineer-level certification.</p>
  </section>

  <section class="block">
    <div class="section-eyebrow">Go Deeper</div>
