---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SourcesStandards from '../../components/SourcesStandards.astro';
import { techArticleSchema, gitDates } from '../../lib/techarticle.js';

const sourcePath = 'src/pages/drilling/well-control.astro';
const techArticleJsonLd = techArticleSchema({
  sourcePath,
  path: '/drilling/well-control',
  headline: 'Well Control & Kicks — Recognition, Shut-In, Kill Procedures',
  description: "Well control reference: kick causes, detection while drilling and tripping, shut-in, well barriers, the four kill methods and kill sheet calculations.",
