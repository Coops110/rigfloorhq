<style>
  .calc-table {
    width: 100%;
    max-width: 800px;
    border-collapse: collapse;
    margin: 24px 0;
  }
  .calc-table th,
  .calc-table td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(128, 128, 128, 0.25);
  }
  .calc-table th {
    font-weight: 600;
    opacity: 0.75;
    font-size: 0.9em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-formula {
    font-size: 0.9em;
    opacity: 0.8;
  }
</style>