---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const faq = [
  {
    q: '¿Qué es el tiempo de retraso y por qué importa?',
    a: 'El tiempo de retraso es cuánto tarda una muestra de fluido, recortes, o gas en la barrena en llegar a superficie después de entrar al anular. Sin él, un indicio de gas o un cambio de recortes en superficie no puede vincularse a la profundidad que lo produjo — cada correlación de registro de lodo depende de tener el retraso correcto primero.',
  },
  {
    q: '¿Por qué el tipo de bomba cambia la fórmula de rendimiento por embolada?',
    a: 'Una bomba triplex desplaza fluido de un solo lado del pistón por embolada (de acción simple), así que su rendimiento depende solo del área del liner y la longitud de la carrera. Una bomba dúplex desplaza en ambos lados (doble acción), pero el vástago ocupa área de sección transversal de un lado, así que su fórmula resta el área del vástago — omitirlo sobreestima el rendimiento de la dúplex.',
  },
  {
    q: '¿Cuál es la diferencia entre capacidad y desplazamiento?',
    a: 'La capacidad es el volumen dentro de la tubería (usa el ID) — lo que la llena y lo que una bomba tiene que mover para llenarla. El desplazamiento es el volumen de acero que la tubería misma ocupa (usa OD menos ID) — lo que la tubería empuja fuera del camino cuando se corre en un hoyo lleno. Ambos vienen de la misma forma de fórmula, solo con diámetros distintos.',
  },
  {
    q: '¿Por qué medir la eficiencia volumétrica en lugar de asumir 100%?',
    a: 'El desgaste de pistones y válvulas deja que una bomba deslice fluido hacia atrás en parte de cada embolada, así que el rendimiento real siempre está algo por debajo de la cifra teórica — típicamente 95-100% recién revisada, menos a medida que las bombas se desgastan. Como cada número basado en emboladas de esta página escala con el rendimiento de la bomba, una eficiencia asumida se acumula silenciosamente en cada cifra posterior.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Calculadora de Retraso y Volumen de Tubería"
  description="Calculadora gratuita de retraso y volumen: rendimiento de bomba, volúmenes de sarta y anular, emboladas de retraso, y tiempo de retraso — para bombas triplex o dúplex."
  jsonLd={jsonLd}
  breadcrumbs={[{ label: 'Calculadoras', href: '/es/calculators' }, { label: 'Retraso y Volumen', href: '/es/calculators/lag-and-volume' }]}
  lang="es"
  alternateHref="/calculators/lag-and-volume"
>
  <Nav slot="nav" lang="es" alternateHref="/calculators/lag-and-volume" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculadora</div>
    <h1>Retraso de Tubería <span>y Volumen</span></h1>
    <p class="page-hero-sub">Rendimiento de bomba, volúmenes de sarta y anular, y emboladas y tiempo de retraso, tanto bajando a la barrena como subiendo de vuelta a superficie.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">⚙ Bomba</div>
          <div class="input-row">
            <div class="input-group">
              <label for="pumptype">Tipo de Bomba</label>
              <select id="pumptype">
                <option value="triplex">Triplex (acción simple)</option>
                <option value="duplex">Dúplex (doble acción)</option>
              </select>
            </div>
            <div class="input-group">
              <label for="liner">Diámetro de Liner (in)</label>
              <input type="number" id="liner" value="6" step="0.01">
            </div>
            <div class="input-group">
              <label for="stroke">Longitud de Carrera (in)</label>
              <input type="number" id="stroke" value="11" step="0.01">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group" id="rod-field">
              <label for="rod">Diámetro de Vástago (in) — solo dúplex</label>
              <input type="number" id="rod" value="2" step="0.01">
            </div>
            <div class="input-group">
              <label for="eff">Eficiencia Volumétrica (%)</label>
              <input type="number" id="eff" value="97" step="0.1">
            </div>
            <div class="input-group">
              <label for="spm">Velocidad de Bomba (SPM)</label>
              <input type="number" id="spm" value="50">
            </div>
          </div>

          <div class="calc-title" style="margin-top:24px;">🔩 Sarta de Perforación (interna)</div>
          <div class="input-row">
            <div class="input-group">
              <label for="dp-od">OD de Tubería (in)</label>
              <input type="number" id="dp-od" value="5" step="0.001">
            </div>
            <div class="input-group">
              <label for="dp-id">ID de Tubería (in)</label>
              <input type="number" id="dp-id" value="4.276" step="0.001">
            </div>
            <div class="input-group">
              <label for="dp-len">Longitud de Tubería (ft)</label>
              <input type="number" id="dp-len" value="9500">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="bha-od">OD de Lastrabarrenas/BHA (in)</label>
              <input type="number" id="bha-od" value="6.5" step="0.001">
            </div>
            <div class="input-group">
              <label for="bha-id">ID de Lastrabarrenas/BHA (in)</label>
              <input type="number" id="bha-id" value="2.813" step="0.001">
            </div>
            <div class="input-group">
              <label for="bha-len">Longitud de Lastrabarrenas/BHA (ft)</label>
              <input type="number" id="bha-len" value="500">
            </div>
          </div>

          <div class="calc-title" style="margin-top:24px;">⭕ Anular</div>
          <div class="input-row">
            <div class="input-group">
              <label for="hole1">ID de Hoyo/Revestimiento frente a Tubería (in)</label>
              <input type="number" id="hole1" value="8.5" step="0.001">
            </div>
            <div class="input-group">
              <label for="hole1-len">Longitud frente a Tubería (ft)</label>
              <input type="number" id="hole1-len" value="9500">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="hole2">ID de Hoyo frente a Lastrabarrenas/BHA (in)</label>
              <input type="number" id="hole2" value="8.5" step="0.001">
            </div>
            <div class="input-group">
              <label for="hole2-len">Longitud frente a Lastrabarrenas/BHA (ft)</label>
              <input type="number" id="hole2-len" value="500">
            </div>
          </div>

          <div class="calc-output visible" style="margin-top:20px;">
            <div class="output-line headline"><span class="output-label">Rendimiento de Bomba</span><span class="output-value" id="out-output">—</span></div>
            <div class="output-line"><span class="output-label">Tasa de Bomba</span><span class="output-value" id="out-rate">—</span></div>
            <div class="output-line"><span class="output-label">Volumen de Capacidad de Sarta (interno)</span><span class="output-value" id="out-stringcap">—</span></div>
            <div class="output-line"><span class="output-label">Desplazamiento de Acero de Sarta</span><span class="output-value" id="out-stringdisp">—</span></div>
            <div class="output-line"><span class="output-label">Volumen Total Anular</span><span class="output-value" id="out-annvol">—</span></div>
            <div class="output-line"><span class="output-label">Emboladas de Retraso Bajando (a la barrena)</span><span class="output-value" id="out-strokesdown">—</span></div>
            <div class="output-line"><span class="output-label">Emboladas de Retraso Subiendo (fondo hacia arriba)</span><span class="output-value" id="out-strokesup">—</span></div>
            <div class="output-line"><span class="output-label">Tiempo de Retraso Bajando</span><span class="output-value" id="out-timedown">—</span></div>
            <div class="output-line" style="border-bottom:none;"><span class="output-label">Tiempo de Retraso Subiendo (fondo hacia arriba)</span><span class="output-value" id="out-timeup">—</span></div>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Solo referencia.</strong> Mide el rendimiento de bomba y la eficiencia volumétrica contra tu equipo real en lugar de confiar en cifras de placa — una bomba desgastada distorsiona silenciosamente cada número debajo de ella.
        </div>
      </div>

      <div class="prose">
        <h2>Las Fórmulas Usadas</h2>
        <div class="formula-block">
          <div class="formula-label">Rendimiento de Bomba — Triplex</div>
          <div class="formula-eq">Rendimiento (bbl/emb) = 0.000243 × Liner² (in) × Carrera (in) × Eficiencia</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">Rendimiento de Bomba — Dúplex</div>
          <div class="formula-eq">Rendimiento (bbl/emb) = 0.000162 × Carrera × (2 × Liner² − Vástago²) × Eficiencia</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">Capacidad y Desplazamiento</div>
          <div class="formula-eq">Capacidad (bbl/ft) = ID² ÷ 1029.4<br />Desplazamiento (bbl/ft) = (OD² − ID²) ÷ 1029.4</div>
          <div class="formula-note">La capacidad anular usa la misma forma: (ID del hoyo² − OD de tubería²) ÷ 1029.4.</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">Emboladas y Tiempo de Retraso</div>
          <div class="formula-eq">Emboladas = Volumen (bbl) ÷ Rendimiento de Bomba (bbl/emb)<br />Tiempo (min) = Emboladas ÷ SPM</div>
          <div class="formula-note">Bajando usa la capacidad de la sarta. Subiendo (fondo hacia arriba) usa el volumen anular.</div>
        </div>

        <p>Estas son las mismas fórmulas de capacidad y desplazamiento detrás de las cifras de emboladas a la barrena y fondo hacia arriba de la <a href="/es/calculators/kill-sheet">calculadora de hoja de control de pozo</a> — esta página solo las ejecuta para correlación de retraso rutinaria en lugar de una matanza. Si necesitas un tally continuo de profundidad junta por junta en lugar de un volumen de una sola vez, ve la <a href="/es/calculators/drill-pipe-tally">calculadora de tally de tubería</a>.</p>

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script>
  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    const v = parseFloat(el?.value ?? '');
    return isFinite(v) ? v : 0;
  }
  function fmt(n: number, d: number): string {
    if (!isFinite(n)) return '0';
    return n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  function calc() {
    const pumpType = (document.getElementById('pumptype') as HTMLSelectElement).value;
    const rodField = document.getElementById('rod-field') as HTMLElement;
    rodField.style.opacity = pumpType === 'duplex' ? '1' : '0.4';

    const liner = num('liner'), stroke = num('stroke'), rod = num('rod'), eff = num('eff') / 100, spm = num('spm');
    let outputPerStroke = pumpType === 'triplex'
      ? 0.000243 * liner * liner * stroke
      : 0.000162 * stroke * (2 * liner * liner - rod * rod);
    outputPerStroke *= eff;
    const bpm = outputPerStroke * spm;
    const gpm = bpm * 42;

    const dpCap = (num('dp-id') * num('dp-id')) / 1029.4;
    const dpDisp = (num('dp-od') * num('dp-od') - num('dp-id') * num('dp-id')) / 1029.4;
    const bhaCap = (num('bha-id') * num('bha-id')) / 1029.4;
    const bhaDisp = (num('bha-od') * num('bha-od') - num('bha-id') * num('bha-id')) / 1029.4;

    const stringCapVol = dpCap * num('dp-len') + bhaCap * num('bha-len');
    const stringDispVol = dpDisp * num('dp-len') + bhaDisp * num('bha-len');

    const ann1Cap = (num('hole1') * num('hole1') - num('dp-od') * num('dp-od')) / 1029.4;
    const ann2Cap = (num('hole2') * num('hole2') - num('bha-od') * num('bha-od')) / 1029.4;
    const annVol = ann1Cap * num('hole1-len') + ann2Cap * num('hole2-len');

    const strokesDown = outputPerStroke > 0 ? stringCapVol / outputPerStroke : 0;
    const strokesUp = outputPerStroke > 0 ? annVol / outputPerStroke : 0;
    const minutesDown = spm > 0 ? strokesDown / spm : 0;
    const minutesUp = spm > 0 ? strokesUp / spm : 0;

    (document.getElementById('out-output') as HTMLElement).textContent = fmt(outputPerStroke, 4) + ' bbl/embolada';
    (document.getElementById('out-rate') as HTMLElement).textContent = fmt(bpm, 2) + ' bbl/min (' + fmt(gpm, 0) + ' gpm)';
    (document.getElementById('out-stringcap') as HTMLElement).textContent = fmt(stringCapVol, 1) + ' bbls';
    (document.getElementById('out-stringdisp') as HTMLElement).textContent = fmt(stringDispVol, 1) + ' bbls';
    (document.getElementById('out-annvol') as HTMLElement).textContent = fmt(annVol, 1) + ' bbls';
    (document.getElementById('out-strokesdown') as HTMLElement).textContent = fmt(strokesDown, 0) + ' emboladas';
    (document.getElementById('out-strokesup') as HTMLElement).textContent = fmt(strokesUp, 0) + ' emboladas';
    (document.getElementById('out-timedown') as HTMLElement).textContent = fmt(minutesDown, 1) + ' min';
    (document.getElementById('out-timeup') as HTMLElement).textContent = fmt(minutesUp, 1) + ' min';
  }

  document.querySelectorAll('.calc-box input, .calc-box select').forEach((el) => el.addEventListener('input', calc));
  calc();
</script>
