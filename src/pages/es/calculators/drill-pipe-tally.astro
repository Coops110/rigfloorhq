---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const faq = [
  {
    q: '¿Qué es un tally de tubería de perforación y por qué lo lleva la cuadrilla?',
    a: 'Un tally es el registro continuo de cada junta armada en la sarta — su longitud, y la profundidad acumulada después de ella — construido mientras la tubería entra al pozo. Es la fuente de verdad de qué tan profunda está realmente la barrena, ya que el contador de profundidad del perforador puede desviarse pero el tally es una medición física de lo que entró al pozo, junta por junta.',
  },
  {
    q: '¿Por qué importan la capacidad y el desplazamiento más allá de solo conocer la longitud de la sarta?',
    a: 'Ambos alimentan los volúmenes que se vigilan mientras se maniobra. El desplazamiento es cuánto lodo debería perder el pozo al salir el acero (o recibir al entrar), comparar eso contra lo que realmente muestra el tanque de viaje es cómo se detecta una surgencia o una pérdida de circulación durante la maniobra, mucho antes de que se note de cualquier otra forma. La capacidad es lo que llena la sarta al bajar de nuevo, lo cual determina emboladas y tiempo a fondo revuelto cuando se reanuda la perforación.',
  },
  {
    q: '¿Por qué varía la longitud promedio de junta de junta a junta?',
    a: 'La tubería de perforación rango 2 (la más común) corre aproximadamente 30 a 32 pies por junta, pero no hay dos juntas cortadas exactamente a la misma longitud — por eso un tally real se mide y registra junta por junta en lugar de asumirse. La longitud promedio de junta aquí es una cifra de planificación; un tally real siempre usa la longitud medida de cada junta que entró al pozo.',
  },
  {
    q: '¿Cómo se diferencia una parada de una junta, y por qué importa la longitud promedio de parada?',
    a: 'Una junta es un solo tramo de tubería; una parada son dos o tres juntas armadas juntas y enrejadas como una unidad — un thribble rango 2 (tres juntas) comúnmente corre alrededor de 90 a 94 pies. Las paradas, no las juntas, son lo que la cuadrilla realmente enreja y cuenta durante la maniobra, así que el conteo de paradas es la verificación cruzada más rápida contra el tally junta por junta debajo de él.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Calculadora de Tally de Tubería: Capacidad, Desplazamiento y Profundidad"
  description="Calculadora gratuita de tally de tubería de perforación: ingresa DE, DI, longitud de junta y número de juntas para obtener capacidad del pozo, desplazamiento de acero, y una tabla de tally de profundidad acumulada."
  jsonLd={jsonLd}
  breadcrumbs={[{ label: 'Calculadoras', href: '/es/calculators' }, { label: 'Tally de Tubería', href: '/es/calculators/drill-pipe-tally' }]}
  lang="es"
  alternateHref="/calculators/drill-pipe-tally"
>
  <Nav slot="nav" lang="es" alternateHref="/calculators/drill-pipe-tally" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculadora</div>
    <h1>Tally de <span>Tubería de Perforación</span></h1>
    <p class="page-hero-sub">Convierte DE, DI, longitud de junta, y número de juntas de tubería de perforación en capacidad del pozo, desplazamiento de acero, y un tally de profundidad acumulada junta por junta — la misma matemática detrás de un libro de tally físico.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🔩 Especificaciones de Tubería</div>
          <div class="input-row">
            <div class="input-group">
              <label for="dp-od">DE de Tubería (in)</label>
              <input type="number" id="dp-od" value="5" step="0.001">
            </div>
            <div class="input-group">
              <label for="dp-id">DI de Tubería (in)</label>
              <input type="number" id="dp-id" value="4.276" step="0.001">
            </div>
            <div class="input-group">
              <label for="dp-wt">Peso Nominal (lb/ft) — solo referencia</label>
              <input type="number" id="dp-wt" value="19.5" step="0.1">
            </div>
          </div>

          <div class="calc-title" style="margin-top:24px;">📏 Armado de la Sarta</div>
          <div class="input-row">
            <div class="input-group">
              <label for="joint-len">Longitud Promedio de Junta (ft)</label>
              <input type="number" id="joint-len" value="31.2" step="0.1">
            </div>
            <div class="input-group">
              <label for="joint-count">Número de Juntas</label>
              <input type="number" id="joint-count" value="20" step="1" min="1">
            </div>
            <div class="input-group">
              <label for="stand-len">Longitud Promedio de Parada (ft) — opcional</label>
              <input type="number" id="stand-len" value="93.5" step="0.1">
            </div>
          </div>

          <div class="calc-output visible" style="margin-top:20px;">
            <div class="output-line"><span class="output-label">Capacidad</span><span class="output-value" id="out-cap-ft">—</span></div>
            <div class="output-line"><span class="output-label">Desplazamiento</span><span class="output-value" id="out-disp-ft">—</span></div>
            <div class="output-line headline"><span class="output-label">Longitud Total de Sarta</span><span class="output-value" id="out-total-len">—</span></div>
            <div class="output-line"><span class="output-label">Volumen Total de Capacidad</span><span class="output-value" id="out-total-cap">—</span></div>
            <div class="output-line"><span class="output-label">Volumen Total de Desplazamiento</span><span class="output-value" id="out-total-disp">—</span></div>
            <div class="output-line" style="border-bottom:none;"><span class="output-label">Paradas Aprox. en la Sarta</span><span class="output-value" id="out-stands">—</span></div>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Solo referencia.</strong> Un tally real se mide y registra junta por junta mientras la tubería entra al pozo — usa esto para planificar y verificar, no para reemplazar el tally físico.
        </div>

        <h2 style="margin-top:32px;font-size:18px;">Tally Continuo</h2>
        <p style="color:var(--fog);font-size:13px;max-width:700px;margin-bottom:12px;" id="tally-note">Profundidad acumulada, capacidad, y desplazamiento en cada junta, asumiendo que cada junta es igual a la longitud promedio de arriba.</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Junta #</th><th>Profundidad Acum. (ft)</th><th>Capacidad Acum. (bbl)</th><th>Desplazamiento Acum. (bbl)</th></tr>
            </thead>
            <tbody id="tally-body"></tbody>
          </table>
        </div>
      </div>

      <div class="prose">
        <h2>Las Fórmulas Usadas</h2>
        <div class="formula-block">
          <div class="formula-label">Capacidad y Desplazamiento</div>
          <div class="formula-eq">Capacidad (bbl/ft) = DI² ÷ 1029.4<br />Desplazamiento (bbl/ft) = (DE² − DI²) ÷ 1029.4</div>
          <div class="formula-note">Misma forma que la fórmula de capacidad anular en la <a href="/es/calculators/lag-and-volume">calculadora de retraso y volumen</a> — la capacidad usa el diámetro interior, el desplazamiento usa la sección transversal de acero (DE menos DI).</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">Profundidad Acumulada en la Junta N</div>
          <div class="formula-eq">Profundidad = N × Longitud Promedio de Junta</div>
        </div>
        <div class="formula-block">
          <div class="formula-label">Volúmenes Acumulados</div>
          <div class="formula-eq">Capacidad Acumulada = Capacidad/ft × Profundidad<br />Desplazamiento Acumulado = Desplazamiento/ft × Profundidad</div>
        </div>

        <p>Esta calculadora maneja una sección uniforme de tubería — un solo DE/DI/peso a lo largo de la sarta. Una sarta de perforación real usualmente combina tubería de perforación con un BHA o lastrabarrenas más corto y pesado cerca de la barrena, que tienen su propio DE y DI y necesitan su propio paso por las mismas fórmulas. La <a href="/es/calculators/lag-and-volume">calculadora de retraso y volumen</a> ya maneja una sarta de dos secciones (tubería de perforación más BHA) si esa división importa para lo que estás calculando.</p>
        <p>Para las constantes con números resueltos, ve la <a href="/drilling/formulas">hoja de fórmulas de perforación (inglés)</a>.</p>

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script>
  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    const v = parseFloat(el?.value ?? '');
    return isFinite(v) ? v : 0;
  }
  function fmt(n: number, d: number): string {
    if (!isFinite(n)) return '0';
    return n.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  const MAX_ROWS = 25;

  function calc() {
    const od = num('dp-od'), id = num('dp-id');
    const jointLen = num('joint-len'), jointCount = Math.max(0, Math.round(num('joint-count')));
    const standLen = num('stand-len');

    const capPerFt = (id * id) / 1029.4;
    const dispPerFt = (od * od - id * id) / 1029.4;
    const totalLen = jointCount * jointLen;
    const totalCap = capPerFt * totalLen;
    const totalDisp = dispPerFt * totalLen;
    const stands = standLen > 0 ? totalLen / standLen : 0;

    (document.getElementById('out-cap-ft') as HTMLElement).textContent = fmt(capPerFt, 4) + ' bbl/ft';
    (document.getElementById('out-disp-ft') as HTMLElement).textContent = fmt(dispPerFt, 4) + ' bbl/ft';
    (document.getElementById('out-total-len') as HTMLElement).textContent = fmt(totalLen, 1) + ' ft';
    (document.getElementById('out-total-cap') as HTMLElement).textContent = fmt(totalCap, 1) + ' bbls';
    (document.getElementById('out-total-disp') as HTMLElement).textContent = fmt(totalDisp, 1) + ' bbls';
    (document.getElementById('out-stands') as HTMLElement).textContent = stands > 0 ? fmt(stands, 1) + ' paradas' : '—';

    const tbody = document.getElementById('tally-body');
    const note = document.getElementById('tally-note');
    if (tbody) {
      tbody.innerHTML = '';
      if (jointCount > 0 && jointLen > 0) {
        const step = jointCount > MAX_ROWS ? Math.ceil(jointCount / MAX_ROWS) : 1;
        const rows: number[] = [];
        for (let j = step; j <= jointCount; j += step) rows.push(j);
        if (rows.length === 0 || rows[rows.length - 1] !== jointCount) rows.push(jointCount);

        for (const j of rows) {
          const depth = j * jointLen;
          const tr = document.createElement('tr');
          tr.innerHTML =
            '<td>' + j + '</td>' +
            '<td>' + fmt(depth, 1) + '</td>' +
            '<td>' + fmt(capPerFt * depth, 1) + '</td>' +
            '<td>' + fmt(dispPerFt * depth, 1) + '</td>';
          tbody.appendChild(tr);
        }
        if (note) {
          note.textContent = step > 1
            ? 'Profundidad acumulada, capacidad, y desplazamiento en cada junta, asumiendo que cada junta es igual a la longitud promedio de arriba. Mostrando cada intervalo de ' + step + ' juntas (' + rows.length + ' filas) para mantener la tabla legible — la matemática subyacente es continua por junta.'
            : 'Profundidad acumulada, capacidad, y desplazamiento en cada junta, asumiendo que cada junta es igual a la longitud promedio de arriba.';
        }
      }
    }
  }

  document.querySelectorAll('.calc-box input').forEach((el) => el.addEventListener('input', calc));
  calc();
</script>
