---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import CalculatorDisclaimer from '../../../components/CalculatorDisclaimer.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import { calculatorWebPage } from '../../../lib/techarticle.js';

const faq = [
  {
    q: '¿Qué es una tonelada-milla y por qué el desgaste de la línea de perforación se mide en ella?',
    a: 'Una tonelada-milla es una tonelada de carga movida una milla de recorrido — captura tanto qué tan pesada era la carga como qué tan lejos la movió, lo cual juntos impulsan la fatiga en el cable de acero. API RP 9B rastrea tonelada-millas acumuladas contra una clasificación de vida útil de servicio para que la línea se corte y deslice antes de fallar, no después.',
  },
  {
    q: '¿Por qué las tonelada-millas de perforación, coreo, y viaje corto usan multiplicadores diferentes?',
    a: 'Cada una cubre una cantidad distinta de trabajo de viaje redondo. Los viajes de perforación (3×) asumen un viaje redondo completo para cambiar la barrena y regresar. Los viajes de coreo (2×) salen del hoyo más lento y con más cuidado pero no necesitan las mismas conexiones repetidas. Un viaje corto (1×, sin multiplicador) es un viaje redondo parcial, así que recibe la diferencia simple de profundidad a profundidad sin ajuste.',
  },
  {
    q: '¿Por qué el factor de flotación usa 65.5 y no la densidad exacta del acero?',
    a: 'El acero da aproximadamente 65.44 ppg, y 65.5 es la constante redondeada de campo que casi todos usan realmente. La diferencia es menos de una décima de porcentaje, pero vale la pena saberlo si una cifra no reconcilia exactamente con los números propios de una compañía de servicio.',
  },
  {
    q: '¿Las tonelada-millas de asentamiento de revestimiento se calculan igual que un viaje redondo?',
    a: 'No — es un cálculo separado, de un solo sentido, porque correr revestimiento hasta el fondo no es un viaje redondo. Aun así usa la misma lógica de peso flotado, solo aplicada a la sarta de revestimiento que se está corriendo en lugar de la sarta de perforación que se está maniobrando.',
  },
];

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/es/calculators/ton-mile#app",
  "name": "Calculadora de Tonelada-Milla: Vida de Línea de Perforación",
  "url": "https://rigfloorhq.com/es/calculators/ton-mile",
  "description": "Calculadora gratuita de tonelada-milla: viaje redondo, perforación, coreo, viaje corto, y tonelada-millas de asentamiento de revestimiento según API RP 9B / Lapeyrouse.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Calculadora de ingeniería de perforación",
  "operatingSystem": "Cualquiera (navegador web)",
  "browserRequirements": "Requiere JavaScript",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'es' });

---
<BaseLayout
  title="Calculadora de Tonelada-Milla: Vida de Línea de Perforación"
  description="Calculadora gratuita de tonelada-milla: viaje redondo, perforación, coreo, viaje corto, y asentamiento de revestimiento según API RP 9B / Lapeyrouse."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculadoras', href: '/es/calculators' }, { label: 'Tonelada-Milla', href: '/es/calculators/ton-mile' }]}
  lang="es"
  alternateHref="/calculators/ton-mile"
>
  <Nav slot="nav" lang="es" alternateHref="/calculators/ton-mile" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculadora</div>
    <h1>Calculadora de <span>Tonelada-Milla</span></h1>
    <p class="page-hero-sub">Viaje redondo, perforación, coreo, viaje corto, y tonelada-millas de asentamiento de revestimiento para rastrear la vida de servicio de la línea de perforación contra su clasificación API RP 9B.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🎣 Taladro y Sarta</div>
          <div class="input-row">
            <div class="input-group">
              <label for="mw">Peso de Lodo (ppg)</label>
              <input type="number" id="mw" value="9.6" step="0.1">
            </div>
            <div class="input-group">
              <label for="dpwt">Peso de Tubería de Perforación, aire (lb/ft)</label>
              <input type="number" id="dpwt" value="13.3" step="0.1">
            </div>
            <div class="input-group">
              <label for="stand">Longitud Promedio de Parada (ft)</label>
              <input type="number" id="stand" value="90">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="block">Peso del Bloque Viajero (lb)</label>
              <input type="number" id="block" value="15000">
            </div>
            <div class="input-group">
              <label for="dclen">Longitud de Lastrabarrenas (ft)</label>
              <input type="number" id="dclen" value="600">
            </div>
            <div class="input-group">
              <label for="dcwt">Peso de Lastrabarrenas, aire (lb/ft)</label>
              <input type="number" id="dcwt" value="83" step="0.1">
            </div>
          </div>

          <div class="calc-title" style="margin-top:24px;">📏 Viaje Redondo a Dos Profundidades</div>
          <div class="input-row">
            <div class="input-group">
              <label for="deptha">Profundidad A — inicio del intervalo (ft)</label>
              <input type="number" id="deptha" value="8000">
            </div>
            <div class="input-group">
              <label for="depthb">Profundidad B — fin del intervalo (ft)</label>
              <input type="number" id="depthb" value="8500">
            </div>
          </div>

          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line"><span class="output-label">Factor de Flotación</span><span class="output-value" id="out-bf">—</span></div>
            <div class="output-line headline"><span class="output-label">TM Viaje Redondo @ Profundidad A</span><span class="output-value" id="out-rttma">—</span></div>
            <div class="output-line headline"><span class="output-label">TM Viaje Redondo @ Profundidad B</span><span class="output-value" id="out-rttmb">—</span></div>
            <div class="output-line"><span class="output-label">TM Perforación/Conexión (3× dif.)</span><span class="output-value" id="out-drilling">—</span></div>
            <div class="output-line"><span class="output-label">TM Coreo (2× dif.)</span><span class="output-value" id="out-coring">—</span></div>
            <div class="output-line" style="border-bottom:none;"><span class="output-label">TM Viaje Corto (dif. simple)</span><span class="output-value" id="out-shorttrip">—</span></div>
          </div>

          <div class="calc-title" style="margin-top:24px;">🛢 Asentamiento de Revestimiento (cálculo separado, un sentido)</div>
          <div class="input-row">
            <div class="input-group">
              <label for="csgwt">Peso de Revestimiento, flotado (lb/ft)</label>
              <input type="number" id="csgwt" value="40" step="0.1">
            </div>
            <div class="input-group">
              <label for="csgdepth">Profundidad de Revestimiento (ft)</label>
              <input type="number" id="csgdepth" value="8500">
            </div>
            <div class="input-group">
              <label for="csgjoint">Longitud de Una Junta (ft)</label>
              <input type="number" id="csgjoint" value="40">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Tonelada-Millas de Asentamiento</span><span class="output-value" id="out-csgtm">—</span></div>
          </div>
        </div>

        <CalculatorDisclaimer lang="es" context="Rastrea las tonelada-millas acumuladas contra la clasificación real de vida útil de tu línea de perforación y el programa de corte y deslizamiento, no una cifra única de esta página." />
      </div>

      <div class="prose">
        <h2>Las Fórmulas Usadas</h2>
        <dl class="formula-block">
          <dt class="formula-label">Factor de Flotación</dt>
          <dd class="formula-eq"><code>BF = (65.5 − MW) ÷ 65.5</code></dd>
        </dl>
        <dl class="formula-block">
          <dt class="formula-label">Tonelada-Millas de Viaje Redondo</dt>
          <dd class="formula-eq"><code>RTTM = [Wp × D × (Ls + D) + 2D × (2×Wb + Wc)] ÷ (5280 × 2000)</code></dd>
          <dd class="formula-note">Wp = peso flotado de tubería de perforación/ft · D = profundidad · Ls = longitud de parada · Wb = peso del bloque · Wc = peso flotado de lastrabarrenas menos el peso equivalente de tubería de perforación sobre la longitud de los lastrabarrenas. Según API RP 9B / Lapeyrouse.</dd>
        </dl>
        <dl class="formula-block">
          <dt class="formula-label">Tonelada-Millas de Perforación, Coreo y Viaje Corto</dt>
          <dd class="formula-eq"><code>Perforación = 3 × (RTTM en B − RTTM en A)<br />Coreo = 2 × (RTTM en B − RTTM en A)<br />Viaje Corto = RTTM en B − RTTM en A</code></dd>
        </dl>
        <dl class="formula-block">
          <dt class="formula-label">Tonelada-Millas de Asentamiento de Revestimiento</dt>
          <dd class="formula-eq"><code>TM = [Wp × D × (Lj + D) + D × Wb] × 0.5 ÷ (5280 × 2000)</code></dd>
          <dd class="formula-note">Wp = peso flotado de revestimiento/ft · D = profundidad de revestimiento · Lj = longitud de una junta · Wb = peso del bloque.</dd>
        </dl>

        <h3>Ejemplo Resuelto</h3>
        <p>Lodo de 9.6 ppg, tubería de perforación de 13.3 lb/ft, paradas de 90 ft, bloque de 15,000 lb, 600 ft de lastrabarrenas de 83 lb/ft, viaje redondo de 8,000 ft a 8,500 ft:</p>
        <dl class="formula-block">
          <dt class="formula-label">Factor de Flotación</dt>
          <dd class="formula-eq"><code>(65.5 − 9.6) ÷ 65.5 = 0.8534</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Tonelada-Millas de Viaje Redondo en Cada Profundidad</dt>
          <dd class="formula-eq"><code>RTTM a 8,000 ft = 169.10<br />RTTM a 8,500 ft = 184.23</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Tonelada-Millas de Perforación para Este Intervalo de 500 ft</dt>
          <dd class="formula-eq"><code>3 × (184.23 − 169.10) = 45.4 tonelada-millas</code></dd>
          <dd class="formula-note">Un solo viaje redondo de 500 ft a esta profundidad le cuesta a la línea de perforación cerca de 45 tonelada-millas de su clasificación de vida de servicio — la misma cifra que recorre el video de arriba.</dd>
        </dl>

        <p>El factor de flotación aquí usa la misma constante 65.5 que la sección de flotación de la <a href="/es/calculators/formulas-cheat-sheet">hoja de referencia de fórmulas de perforación</a>.</p>

        <h2>Video: Un Viaje, 45 Toneladas-Milla de Desgaste</h2>
        <p style="color:var(--fog);font-size:13px;">Video en inglés del canal de YouTube de RigFloorHQ.</p>
        <VideoEmbed
          videoId="Z2-OjIqilNQ"
          title="One trip, 45 ton-miles of wear"
          description="One 500-foot round trip just cost your drilling line 45 ton-miles. Free calculator tracks drilling, coring, short-trip, and casing ton-miles separately. rigfloorhq.com/calculators/ton-mile"
          uploadDate="2026-10-18T20:03:01-07:00"
          duration="PT0M41S"
          thumbnailUrl="https://i.ytimg.com/vi/Z2-OjIqilNQ/hqdefault.jpg"
          lang="es"
        />

        <p>Llevar el control de los ton-millas acumulados contra la vida útil de servicio de la línea de perforación es trabajo de integridad de equipo que un <a href="/es/careers/toolpusher">toolpusher</a> posee en todo el taladro — ver la guía completa de carrera de toolpusher para lo que implica el rol y cuánto paga.</p>

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/ton-mile-es.js" defer></script>
