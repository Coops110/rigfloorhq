---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import SourcesStandards from '../../../components/SourcesStandards.astro';
import { calculatorWebPage } from '../../../lib/techarticle.js';

const faq = [
  {
    q: '¿Por qué la caída de presión por pie es diferente para tubería seca vs. mojada?',
    a: 'Sacar tubería seca (vacía, sin fluido adentro) solo remueve el volumen propio de acero de la tubería del pozo, así que la caída de nivel de lodo está impulsada por el desplazamiento de acero contra la capacidad total del pozo abierto o revestimiento. Sacar tubería mojada (todavía llena de fluido) también remueve el fluido dentro del diámetro interior de la tubería, así que la caída está impulsada por el desplazamiento de acero más la capacidad interna de la tubería, contra solo la capacidad anular en lugar de la capacidad total del pozo — una caída por pie significativamente diferente, usualmente mayor.',
  },
  {
    q: '¿Por qué mantener el lodo lleno mientras se saca la sarta?',
    a: 'Conforme sale la tubería, el nivel de lodo en el pozo baja, y un nivel de lodo bajando significa presión hidrostática bajando en el fondo del pozo. Si se saca suficiente tubería sin llenar el anular, la presión hidrostática puede caer por debajo de la presión de formación y el pozo empieza a fluir — llenar el pozo con lodo conforme se viaja mantiene la presión hidrostática aproximadamente constante en su lugar.',
  },
];



const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/es/calculators/tripping-pressure-effects#app",
  "name": "Calculadora de Efectos de Presión al Viajar: Tubería Seca, Mojada, Caída de Nivel de Lodo",
  "url": "https://rigfloorhq.com/es/calculators/tripping-pressure-effects",
  "description": "Calculadora gratuita de caída de presión por pie al sacar tubería seca o mojada, y qué tanto baja el nivel de lodo al sacar del pozo sin rellenar.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Calculadora de ingeniería de perforación",
  "operatingSystem": "Cualquiera (navegador web)",
  "browserRequirements": "Requiere JavaScript",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'es' });

---
<BaseLayout
  title="Calculadora de Efectos de Presión al Viajar"
  description="Calculadora gratuita de caída de presión por pie al sacar tubería seca o mojada, y qué tanto baja el nivel de lodo al sacar del pozo sin rellenar."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculadoras', href: '/es/calculators' }, { label: 'Efectos de Presión al Viajar', href: '/es/calculators/tripping-pressure-effects' }]}
  lang="es"
  alternateHref="/calculators/tripping-pressure-effects"
>
  <Nav slot="nav" lang="es" alternateHref="/calculators/tripping-pressure-effects" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculadora</div>
    <h1>Efectos de Presión <span>al Viajar</span></h1>
    <p class="page-hero-sub">Cuánta presión hidrostática se pierde por pie al sacar tubería seca o mojada, y qué tanto baja realmente el nivel de lodo al sacar del pozo sin rellenar.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🧭 Caída de Presión por Pie — Tubería Seca</div>
          <div class="input-row">
            <div class="input-group">
              <label for="tpe-mw">Peso de Lodo (ppg)</label>
              <input type="number" id="tpe-mw" value="11" step="0.1">
            </div>
            <div class="input-group">
              <label for="tpe-sd">Desplazamiento de Acero (bbl/ft)</label>
              <input type="number" id="tpe-sd" value="0.00653" step="0.00001">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="tpe-cc">Capacidad de Revestimiento/Pozo (bbl/ft)</label>
              <input type="number" id="tpe-cc" value="0.1481" step="0.0001">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Caída de Presión — Seca</span><span class="output-value" id="out-dry">—</span></div>
          </div>
        </div>

        <div class="calc-box mt-24">
          <div class="calc-title">🧭 Caída de Presión por Pie — Tubería Mojada</div>
          <div class="input-row">
            <div class="input-group">
              <label for="tpe-mw2">Peso de Lodo (ppg)</label>
              <input type="number" id="tpe-mw2" value="11" step="0.1">
            </div>
            <div class="input-group">
              <label for="tpe-dpc">Capacidad Interna de Tubería de Perforación (bbl/ft)</label>
              <input type="number" id="tpe-dpc" value="0.01776" step="0.00001">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="tpe-ac">Capacidad Anular (bbl/ft)</label>
              <input type="number" id="tpe-ac" value="0.12381" step="0.00001">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Caída de Presión — Mojada</span><span class="output-value" id="out-wet">—</span></div>
          </div>
        </div>

        <div class="calc-box mt-24">
          <div class="calc-title">🧭 Caída de Nivel de Lodo al Sacar (Seca)</div>
          <div class="input-row">
            <div class="input-group">
              <label for="tpe-len">Longitud de Tubulares Sacados (ft)</label>
              <input type="number" id="tpe-len" value="200" step="1">
            </div>
            <div class="input-group">
              <label for="tpe-sd2">Desplazamiento de Acero (bbl/ft)</label>
              <input type="number" id="tpe-sd2" value="0.00653" step="0.00001">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="tpe-cc2">Capacidad de Revestimiento/Riser (bbl/ft)</label>
              <input type="number" id="tpe-cc2" value="0.1481" step="0.0001">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Caída de Nivel de Lodo</span><span class="output-value" id="out-drop">—</span></div>
          </div>
        </div>

        <div class="danger-box mt-24" style="max-width:700px;">
          <strong>Solo referencia.</strong> El margen de viaje real y los volúmenes de relleno durante un viaje real provienen del programa de viaje aprobado por tu empresa y del procedimiento de control de pozo, usando cifras medidas de desplazamiento de acero y capacidad para la sarta y el pozo exactos en uso — no los valores generales aquí presentados.
        </div>
      </div>

      <div class="prose">
        <h2>Las Fórmulas Usadas</h2>
        <dl class="formula-block">
          <dt class="formula-label">Caída de Presión/ft — Tubería Seca</dt>
          <dd class="formula-eq"><code>ΔP/ft = Peso de Lodo × 0.052 × (Desp. de Acero ÷ Capacidad)</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Caída de Presión/ft — Tubería Mojada</dt>
          <dd class="formula-eq"><code>ΔP/ft = Peso de Lodo × 0.052 × [(Desp. de Acero + Capacidad de Tubería) ÷ Capacidad Anular]</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Caída de Nivel de Lodo (Seca)</dt>
          <dd class="formula-eq"><code>Caída = Longitud Sacada × Desp. de Acero ÷ Capacidad</code></dd>
        </dl>

        <h3>Ejemplo Resuelto</h3>
        <p>Lodo de 11 ppg, desplazamiento de acero de 0.00653 bbl/ft, capacidad de pozo de 0.1481 bbl/ft:</p>
        <dl class="formula-block">
          <dt class="formula-label">Caída de Presión/ft — Tubería Seca</dt>
          <dd class="formula-eq"><code>11 × 0.052 × (0.00653 ÷ 0.1481) = 0.0252 psi/ft</code></dd>
        </dl>
        <p>Mismo peso de lodo, capacidad interna de tubería de 0.01776 bbl/ft, capacidad anular de 0.12381 bbl/ft:</p>
        <dl class="formula-block">
          <dt class="formula-label">Caída de Presión/ft — Tubería Mojada</dt>
          <dd class="formula-eq"><code>11 × 0.052 × [(0.00653 + 0.01776) ÷ 0.12381] = 0.1122 psi/ft</code></dd>
          <dd class="formula-note">La tubería mojada pierde presión más de 4 veces más rápido por pie aquí que la seca — el fluido interno que sale con la tubería es la diferencia.</dd>
        </dl>
        <p>Sacando 200 ft de tubería seca con el mismo desplazamiento de acero y capacidad de pozo:</p>
        <dl class="formula-block">
          <dt class="formula-label">Caída de Nivel de Lodo</dt>
          <dd class="formula-eq"><code>200 × 0.00653 ÷ 0.1481 = 8.82 ft</code></dd>
          <dd class="formula-note">Eso es cuánto cae el nivel de lodo en el pozo por cada 200 ft de tubería seca sacada sin reponer — el volumen que la cuadrilla realmente tiene que bombear de vuelta para evitar que la presión hidrostática caiga.</dd>
        </dl>

        <h3>Dónde Encaja Esto</h3>
        <p>Estos tres cálculos son la mecánica detrás del mismo riesgo de swab contra el que planean tanto la <a href="/es/calculators/trip-margin">calculadora de margen de viaje</a> como la <a href="/es/calculators/pipe-pull-margin">calculadora de margen de extracción de tubería seca y mojada</a> — el margen de viaje establece cuánto peso de lodo extra cargar, el margen de extracción dice qué tan lejos puede salir la tubería con seguridad, y esta página calcula la consecuencia real de presión y nivel de lodo de una longitud específica sacada seca o mojada. En un viaje real, la caída de nivel de lodo es lo que le dice a la cuadrilla exactamente cuánto rellenar el anular después de cada parada o conexión para que la presión hidrostática no se desplome conforme sale la tubería. Para el panorama completo de presión estática contra dinámica en el que viven estos números, ver la <a href="/es/pillars/hydrostatic-pressure">guía de presión hidrostática</a>. Rellenar el anular en la cantidad correcta después de cada parada es, en la práctica, trabajo de sistema de lodo del <a href="/es/careers/derrickhand">encuellador</a> — ver la guía completa de carrera de encuellador para lo que implica el rol y cuánto paga.</p>

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SourcesStandards lang="es" ids={['api53', 'iwcf', 'iadcWellsharp']} />
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/tripping-pressure-effects.js" defer></script>
