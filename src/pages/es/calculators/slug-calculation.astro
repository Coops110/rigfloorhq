---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { calculatorWebPage } from '../../../lib/techarticle.js';

const faq = [
  {
    q: '¿Por qué bombear un slug antes de sacar la sarta del pozo?',
    a: 'Un slug es un pequeño volumen de lodo más pesado bombeado a la parte superior de la sarta de perforación antes de viajar, para que una vez que la sarta se rompa y drene en superficie, la tubería salga con una sección seca conocida en lugar de derramar lodo en el piso de perforación en cada conexión. Es una medida de orden y seguridad, no una barrera de control de pozos.',
  },
  {
    q: '¿Por qué bombear un slug causa una ganancia de pileta?',
    a: 'El slug es más pesado que el lodo que ya está en las piletas, así que bombearlo adentro y desplazar un volumen igual de lodo más ligero de vuelta a las piletas — el efecto de U-tubing — se muestra como una ganancia de pileta real y esperada. Confirmar que esta ganancia esperada coincide con lo que predice la calculadora es exactamente cómo una cuadrilla descarta que una surgencia real aparezca en el mismo momento en que se bombea un slug.',
  },
  {
    q: '¿Qué pasa si la ganancia de pileta real no coincide con la cifra predicha?',
    a: 'Una pequeña discrepancia por pérdidas de mezclado o aire atrapado en superficie es normal, pero una ganancia notablemente mayor a la predicha siempre debe tratarse primero como una posible entrada de fluido, no descartarse como una rareza del cálculo — detente y haz una revisión de flujo según el procedimiento de control de pozos antes de continuar el viaje.',
  },
];



const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/es/calculators/slug-calculation#app",
  "name": "Calculadora de Volumen de Slug y Ganancia de Pileta",
  "url": "https://rigfloorhq.com/es/calculators/slug-calculation",
  "description": "Calculadora gratuita para el volumen de slug necesario para una longitud deseada de tubería seca, y la ganancia de pileta esperada al bombear ese slug.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Calculadora de ingeniería de perforación",
  "operatingSystem": "Cualquiera (navegador web)",
  "browserRequirements": "Requiere JavaScript",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const webPageLd = calculatorWebPage(webAppLd, { lang: 'es' });

---
<BaseLayout
  title="Calculadora de Volumen de Slug y Ganancia de Pileta"
  description="Calculadora gratuita para el volumen de slug necesario para una longitud deseada de tubería seca, y la ganancia de pileta esperada al bombear ese slug."
  extraJsonLd={[webAppLd, webPageLd]}
  breadcrumbs={[{ label: 'Calculadoras', href: '/es/calculators' }, { label: 'Cálculo de Slug', href: '/es/calculators/slug-calculation' }]}
  lang="es"
  alternateHref="/calculators/slug-calculation"
>
  <Nav slot="nav" lang="es" alternateHref="/calculators/slug-calculation" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Calculadora</div>
    <h1>Volumen de Slug y <span>Ganancia de Pileta</span></h1>
    <p class="page-hero-sub">El volumen de slug necesario para una longitud deseada de tubería seca antes de viajar, y la ganancia de pileta que ese slug causará una vez bombeado.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🧭 Volumen de Slug</div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-len">Longitud Deseada de Tubería Seca (ft)</label>
              <input type="number" id="slug-len" value="255.75" step="0.01">
            </div>
            <div class="input-group">
              <label for="slug-cap">Capacidad de Tubería de Perforación (bbl/ft)</label>
              <input type="number" id="slug-cap" value="0.0207" step="0.0001">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-mw">Peso de Lodo (ppg)</label>
              <input type="number" id="slug-mw" value="10.2" step="0.1">
            </div>
            <div class="input-group">
              <label for="slug-sw">Peso del Slug (ppg)</label>
              <input type="number" id="slug-sw" value="12" step="0.1">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Volumen de Slug</span><span class="output-value" id="out-slugvol">—</span></div>
          </div>
        </div>

        <div class="calc-box mt-24">
          <div class="calc-title">🧭 Ganancia de Pileta por U-Tubing</div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-vol2">Volumen de Slug (bbl)</label>
              <input type="number" id="slug-vol2" value="30" step="0.1">
            </div>
            <div class="input-group">
              <label for="slug-mw2">Peso de Lodo (ppg)</label>
              <input type="number" id="slug-mw2" value="10" step="0.1">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="slug-sw2">Peso del Slug (ppg)</label>
              <input type="number" id="slug-sw2" value="11.3" step="0.1">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Ganancia de Pileta Esperada</span><span class="output-value" id="out-pitgain">—</span></div>
          </div>
        </div>

        <div class="note-box mt-24" style="max-width:700px;">
          <strong>Solo de referencia.</strong> Esto asume un slug limpio y completamente desplazado. El retraso real del equipo de superficie, el aire atrapado y las pérdidas de mezclado significan que una ganancia real debe leerse como una revisión de cordura contra esta cifra, no como un sustituto exacto de vigilar las piletas durante el trabajo.
        </div>
      </div>

      <div class="prose">
        <h2>Las Fórmulas Usadas</h2>
        <dl class="formula-block">
          <dt class="formula-label">Volumen de Slug</dt>
          <dd class="formula-eq"><code>V = (Longitud × Capacidad de Tubería × Peso de Lodo) ÷ (Peso de Slug − Peso de Lodo)</code></dd>
        </dl>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Ganancia de Pileta por U-Tubing del Slug</dt>
          <dd class="formula-eq"><code>Ganancia de Pileta = Volumen de Slug × (Peso de Slug − Peso de Lodo) ÷ Peso de Lodo</code></dd>
        </dl>

        <h3>Ejemplo Resuelto</h3>
        <p>Bombeando un slug de 12.0 ppg a una sarta que carga lodo de 10.0 ppg, buscando 200 ft de tubería seca con tubería de perforación de 5" 19.5 lb/ft (capacidad 0.01776 bbl/ft):</p>
        <dl class="formula-block">
          <dt class="formula-label">Volumen de Slug</dt>
          <dd class="formula-eq"><code>V = (200 × 0.01776 × 10.0) ÷ (12.0 − 10.0) = 35.52 ÷ 2 = 17.76 bbl</code></dd>
        </dl>
        <p>Usando ese mismo volumen de slug de 17.76 bbl en la fórmula de ganancia de pileta:</p>
        <dl class="formula-block mt-24">
          <dt class="formula-label">Ganancia de Pileta por U-Tubing del Slug</dt>
          <dd class="formula-eq"><code>Ganancia de Pileta = 17.76 × (12.0 − 10.0) ÷ 10.0 = 17.76 × 0.2 = 3.55 bbl</code></dd>
          <dd class="formula-note">La cuadrilla espera ver aproximadamente 3.55 bbl de ganancia de pileta justo después de bombear — el número contra el cual se revisa la lectura real del nivel de pileta.</dd>
        </dl>

        <h3>Dónde Encaja Esto</h3>
        <p>La cifra de volumen de slug alimenta directamente al cálculo de ganancia de pileta — bombea el volumen de slug de la primera caja, luego usa esa misma cifra en la segunda caja para saber exactamente cuánta ganancia de pileta esperar solo del efecto de U-tubing. Ese número esperado es contra lo que una cuadrilla revisa la lectura real de nivel de pileta justo después de bombear un slug, en cualquier viaje, que es también el mismo hábito rutinario de verificación que importa en la discusión más amplia de monitoreo de viajes de la página de <a href="/pillars/stuck-pipe-and-fishing-operations">tubería pegada y operaciones de pesca (inglés)</a> — una ganancia inexplicada más allá de esta cifra predicha es la primera señal real de que algo más está pasando en el pozo al mismo tiempo. Para el peso de lodo del lado swab que la mayoría de los viajes también cargan, ver la <a href="/es/calculators/trip-margin">calculadora de margen de viaje</a>, y para la teoría hidrostática detrás de por qué reacciona el nivel de pileta, ver la <a href="/es/pillars/hydrostatic-pressure">guía de presión hidrostática</a>.</p>

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/slug-calculation.js" defer></script>
