---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import QuizTopicInteractive from '../../../components/QuizTopicInteractive.astro';
import quizData from '../../../lib/data/well-control-quiz-es.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Métodos de Matanza';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: '¿Este quiz está afiliado oficialmente a IWCF o IADC?',
    a: 'No. Las preguntas cubren el mismo terreno que se evalúa en los exámenes de certificación de control de pozos IWCF e IADC WellSharp, pero este quiz no está producido, avalado ni afiliado a ninguno de los dos organismos, y aprobarlo no sustituye una certificación acreditada.',
  },
  {
    q: '¿Cuál es la diferencia central entre el Método del Perforador y Esperar y Densificar?',
    a: 'El Método del Perforador circula la surgencia hacia afuera primero, al peso de lodo original, luego circula una segunda vez con el peso de lodo de matanza más pesado — dos circulaciones completas. Esperar y Densificar espera a que el peso de lodo de matanza esté listo primero, luego lo circula hacia adentro mientras simultáneamente remueve la surgencia — una circulación, pero con una espera antes de empezar.',
  },
  {
    q: '¿Por qué se comporta diferente el volumen de pileta una vez que el gas llega al estrangulador?',
    a: 'El gas se expande bruscamente conforme se acerca a superficie y a menor presión, así que la ganancia de pileta se acelera aunque no esté entrando nada nuevo al pozo — el mismo volumen de surgencia simplemente ocupa mucho más espacio cerca de superficie que en el fondo. Los operadores de estrangulador tienen que anticipar esto, no reaccionar después del hecho.',
  },
];

const breadcrumbs = [
  { label: 'Cuestionario de Control de Pozos', href: '/es/well-control-quiz' },
  { label: 'Métodos de Matanza', href: '/es/well-control-quiz/metodos-de-matanza' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/es/well-control-quiz/metodos-de-matanza#webpage",
  "name": "Métodos de Matanza — Cuestionario de Control de Pozos",
  "url": "https://rigfloorhq.com/es/well-control-quiz/metodos-de-matanza",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Procedimientos del Método del Perforador y Esperar y Densificar, y cómo se comporta el volumen de pileta en cada uno",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/es#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Cuestionario de Métodos de Matanza — 25 Preguntas"
  description="25 preguntas de práctica sobre el Método del Perforador, Esperar y Densificar, y cómo se comporta realmente el volumen de pileta en cada uno. Gratis."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="es"
  alternateHref="/well-control-quiz/kill-methods"
>
  <Nav slot="nav" lang="es" alternateHref="/well-control-quiz/kill-methods" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Cuestionario — Métodos de Matanza</div>
    <h1>Cuestionario de <span>Métodos de Matanza</span></h1>
    <p class="page-hero-sub">25 preguntas de práctica sobre los procedimientos del Método del Perforador y Esperar y Densificar — qué pasa realmente con el volumen de pileta, la presión de bomba, y la posición del estrangulador en cada etapa de cada método.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="que-cubre-este-tema">Qué Cubre Este Tema</h2>
        <p>Saber el peso de lodo de matanza es solo la mitad del trabajo — una cuadrilla también tiene que saber qué se supone que está pasando en el estrangulador y las piletas en cada etapa de la circulación, para que una desviación real se detecte en lugar de asumirse normal. Estas preguntas recorren el Método del Perforador y Esperar y Densificar etapa por etapa: qué hace el volumen de pileta conforme el gas se acerca al estrangulador, cómo se supone que la presión de bomba siga entre ICP y FCP, y dónde divergen los pasos distintos de cada método. Ver la <a href="/es/pillars/well-kill-methods">guía completa de Métodos para Matar un Pozo</a> para los procedimientos completos que evalúan estas preguntas.</p>

        <h2 id="preguntas-de-muestra">Preguntas de Muestra</h2>
        <p>Tres preguntas reales del banco de 25, para que veas en qué te estás metiendo antes de empezar. Las respuestas no se muestran aquí — toma el cuestionario en vivo abajo para la calificación y las explicaciones.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <details class="acc-item mt-24">
          <summary class="acc-header">Ver las {questions.length} preguntas de este tema<span class="acc-arrow">▼</span></summary>
          <div class="acc-body">
            {questions.map((q, i) => (
              <div style="margin-bottom:18px;">
                <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
                <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
                  {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                    <li>{letter}. {text}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>

        <h2 id="realiza-el-cuestionario">Realiza el Cuestionario</h2>
        <QuizTopicInteractive
          topicSlug="metodos-de-matanza"
          topicName={TOPIC}
          topicIcon="🛑"
          questions={questions}
          startLabel="Comenzar →"
          noteText="Nada de lo que ingreses se guarda, se envía a ningún lugar ni se almacena — recargar la página lo borra todo."
          scriptSrc="/scripts/well-control-quiz-es.js"
        />

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">En Esta Página</div>
          <a href="#que-cubre-este-tema">Qué Cubre</a>
          <a href="#preguntas-de-muestra">Preguntas de Muestra</a>
          <a href="#realiza-el-cuestionario">Realiza el Cuestionario</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Profundiza Más</h3>
          <p style="margin-bottom:12px;">Los procedimientos completos paso a paso sobre los que se construyen estas preguntas.</p>
          <a href="/es/pillars/well-kill-methods" class="card-link">Guía de Métodos para Matar un Pozo →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>Más Temas del Cuestionario</h3>
          <a href="/es/well-control-quiz" class="card-link">→ Los 8 Temas</a><br><br>
          <a href="/es/well-control-quiz/volumenes-y-maasp" class="card-link">→ Volúmenes y MAASP</a><br><br>
          <a href="/es/well-control-quiz/preguntas-dificiles" class="card-link">→ Preguntas Difíciles</a><br><br>
          <a href="/es/calculators/kill-sheet" class="card-link">→ Calculadora de Hoja de Control</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
