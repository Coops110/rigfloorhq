---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import QuizTopicInteractive from '../../../components/QuizTopicInteractive.astro';
import quizData from '../../../lib/data/well-control-quiz-es.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Presión Básica';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: '¿Este quiz está afiliado oficialmente a IWCF o IADC?',
    a: 'No. Las preguntas cubren el mismo terreno que se evalúa en los exámenes de certificación de control de pozos IWCF e IADC WellSharp, pero este quiz no está producido, avalado ni afiliado a ninguno de los dos organismos, y aprobarlo no sustituye una certificación acreditada.',
  },
  {
    q: '¿Qué fórmula evalúan realmente estas preguntas?',
    a: 'Presión hidrostática = peso de lodo (ppg) × 0.052 × profundidad vertical verdadera (ft). Cada pregunta de este tema es una variación de meter números reales en esa única fórmula, incluyendo algunas que piden resolver para la profundidad o el peso de lodo en lugar de la presión.',
  },
  {
    q: '¿Por qué importa el TVD en lugar de la profundidad medida?',
    a: 'La presión hidrostática viene de la altura vertical de la columna de fluido, no de cuánta tubería u hoyo existe a lo largo de una trayectoria direccional. En un pozo vertical, TVD y profundidad medida son el mismo número; en un pozo desviado u horizontal divergen, y usar la profundidad medida en esta fórmula sobreestima la presión real.',
  },
];

const breadcrumbs = [
  { label: 'Cuestionario de Control de Pozos', href: '/es/well-control-quiz' },
  { label: 'Presión Básica', href: '/es/well-control-quiz/presion-basica' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/es/well-control-quiz/presion-basica#webpage",
  "name": "Presión Básica — Cuestionario de Control de Pozos",
  "url": "https://rigfloorhq.com/es/well-control-quiz/presion-basica",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Cálculo de presión hidrostática desde peso de lodo y profundidad vertical verdadera",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Cuestionario de Presión Básica de Control de Pozos — 25 Preguntas"
  description="25 preguntas de práctica de presión hidrostática: peso de lodo, TVD, y la constante 0.052. Gratis, en vivo, calificación y explicaciones instantáneas."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="es"
  alternateHref="/well-control-quiz/basic-pressure"
>
  <Nav slot="nav" lang="es" alternateHref="/well-control-quiz/basic-pressure" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Cuestionario — Presión Básica</div>
    <h1>Cuestionario de <span>Presión Básica</span></h1>
    <p class="page-hero-sub">25 preguntas de práctica sobre presión hidrostática — convertir peso de lodo y profundidad vertical verdadera en una cifra real de psi, y trabajar la misma fórmula al revés para resolver profundidad o peso de lodo en su lugar.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="que-cubre-este-tema">Qué Cubre Este Tema</h2>
        <p>La presión hidrostática es el número contra el que se revisa todo lo demás en control de pozos — presión de formación, MAASP, peso de lodo de matanza, todo empieza con peso de lodo × 0.052 × TVD. Este tema trabaja esa única fórmula desde todos los ángulos: problemas directos de presión a profundidad, algunos que dan la presión y piden el peso de lodo o la profundidad faltante en su lugar, y suficiente repetición para que la constante y las unidades dejen de requerir pensar conscientemente. Ver la <a href="/es/calculators/hydrostatic">calculadora de presión hidrostática</a> completa para la versión en vivo de esta misma matemática.</p>

        <h2 id="preguntas-de-muestra">Preguntas de Muestra</h2>
        <p>Tres preguntas reales del banco de 25, para que veas en qué te estás metiendo antes de empezar. Las respuestas no se muestran aquí — toma el cuestionario en vivo abajo para la calificación y las explicaciones.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <details class="acc-item mt-24">
          <summary class="acc-header">Ver las {questions.length} preguntas de este tema<span class="acc-arrow">▼</span></summary>
          <div class="acc-body">
            {questions.map((q, i) => (
              <div style="margin-bottom:18px;">
                <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
                <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
                  {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                    <li>{letter}. {text}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>

        <h2 id="realiza-el-cuestionario">Realiza el Cuestionario</h2>
        <QuizTopicInteractive
          topicSlug="presion-basica"
          topicName={TOPIC}
          topicIcon="⚙"
          questions={questions}
          startLabel="Comenzar →"
          noteText="Nada de lo que ingreses se guarda, se envía a ningún lugar ni se almacena — recargar la página lo borra todo."
          scriptSrc="/scripts/well-control-quiz-es.js"
        />

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">En Esta Página</div>
          <a href="#que-cubre-este-tema">Qué Cubre</a>
          <a href="#preguntas-de-muestra">Preguntas de Muestra</a>
          <a href="#realiza-el-cuestionario">Realiza el Cuestionario</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Resuelve las Matemáticas Tú Mismo</h3>
          <p style="margin-bottom:12px;">Corre la fórmula exacta que estas preguntas evalúan con tus propios números.</p>
          <a href="/es/calculators/hydrostatic" class="card-link">Calculadora de Presión Hidrostática →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>Más Temas del Cuestionario</h3>
          <a href="/es/well-control-quiz" class="card-link">→ Los 8 Temas</a><br><br>
          <a href="/es/well-control-quiz/conocimientos-basicos" class="card-link">→ Conocimientos Básicos</a><br><br>
          <a href="/es/well-control-quiz/volumenes-y-maasp" class="card-link">→ Volúmenes y MAASP</a><br><br>
          <a href="/es/pillars/hydrostatic-pressure" class="card-link">→ Pilar de Presión Hidrostática</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
