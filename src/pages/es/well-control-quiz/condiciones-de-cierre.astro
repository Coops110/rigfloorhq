---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import QuizTopicInteractive from '../../../components/QuizTopicInteractive.astro';
import quizData from '../../../lib/data/well-control-quiz-es.json';

type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const allQuestions = quizData as Question[];
const TOPIC = 'Condiciones de Cierre';
const questions = allQuestions.filter((q) => q.topic === TOPIC);
const samples = questions.slice(0, 3);

const faq = [
  {
    q: '¿Este quiz está afiliado oficialmente a IWCF o IADC?',
    a: 'No. Las preguntas cubren el mismo terreno que se evalúa en los exámenes de certificación de control de pozos IWCF e IADC WellSharp, pero este quiz no está producido, avalado ni afiliado a ninguno de los dos organismos, y aprobarlo no sustituye una certificación acreditada.',
  },
  {
    q: '¿Qué fórmula usa realmente el peso de lodo de matanza?',
    a: 'KMW = peso de lodo actual + (SIDPP ÷ (0.052 × TVD)). SIDPP, no SICP, es la entrada, porque refleja la diferencia entre la presión hidrostática de la sarta misma y la presión de formación real sin el gradiente del influjo de por medio.',
  },
  {
    q: '¿Por qué SIDPP y no SICP para este cálculo?',
    a: 'La sarta de perforación nunca ve el fluido de la surgencia — sigue llena del lodo original. SICP se lee a través del anular, que sí contiene el influjo, así que refleja tanto la presión de formación como el gradiente (desconocido) del influjo mismo. SIDPP da una lectura más limpia de la presión de formación sola.',
  },
];

const breadcrumbs = [
  { label: 'Cuestionario de Control de Pozos', href: '/es/well-control-quiz' },
  { label: 'Condiciones de Cierre', href: '/es/well-control-quiz/condiciones-de-cierre' },
];

const questionLd = samples.map((q) => ({
  "@type": "Question",
  "name": q.question,
  "suggestedAnswer": Object.entries(q.choices).filter(([, t]) => t).map(([letter, text]) => ({
    "@type": "Answer",
    "text": `${letter}. ${text}`,
  })),
  "acceptedAnswer": {
    "@type": "Answer",
    "text": `${q.correctAnswer}. ${q.choices[q.correctAnswer]}`,
  },
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/es/well-control-quiz/condiciones-de-cierre#webpage",
  "name": "Condiciones de Cierre — Cuestionario de Control de Pozos",
  "url": "https://rigfloorhq.com/es/well-control-quiz/condiciones-de-cierre",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Cálculo de peso de lodo de matanza desde SIDPP, peso de lodo actual, y TVD tras el cierre",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/es#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": questionLd,
};
---
<BaseLayout
  title="Cuestionario de Condiciones de Cierre — 25 Preguntas"
  description="25 preguntas de práctica de peso de lodo de matanza con datos reales de SIDPP, peso de lodo, y TVD. Gratis, en vivo, calificación instantánea."
  breadcrumbs={breadcrumbs}
  jsonLd={quizLd}
  lang="es"
  alternateHref="/well-control-quiz/shut-in-conditions"
>
  <Nav slot="nav" lang="es" alternateHref="/well-control-quiz/shut-in-conditions" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Cuestionario — Condiciones de Cierre</div>
    <h1>Cuestionario de <span>Condiciones de Cierre</span></h1>
    <p class="page-hero-sub">25 preguntas de práctica calculando el peso de lodo de matanza a partir de datos reales de cierre — SIDPP, peso de lodo actual, y profundidad del pozo, las cifras exactas que mostraría un manómetro real de cierre.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="que-cubre-este-tema">Qué Cubre Este Tema</h2>
        <p>Una vez que el pozo está cerrado, las dos lecturas de manómetro — SIDPP y SICP — tienen que convertirse en un peso de lodo de matanza real antes de que pase cualquier otra cosa. Este tema evalúa ese cálculo repetidamente, con MD/TVD dados por separado (así que tienes que usar el correcto) y algunos problemas que piden trabajar hacia atrás desde un peso de matanza objetivo para encontrar la entrada faltante. La <a href="/es/calculators/kill-sheet">calculadora de hoja de control de pozo</a> en vivo corre esta misma matemática, y para versiones de problemas de palabras resueltos con escenarios completos de cierre, ver los <a href="/es/well-control-quiz/kill-sheet-practice">problemas de práctica de hoja de control</a>.</p>

        <h2 id="preguntas-de-muestra">Preguntas de Muestra</h2>
        <p>Tres preguntas reales del banco de 25, para que veas en qué te estás metiendo antes de empezar. Las respuestas no se muestran aquí — toma el cuestionario en vivo abajo para la calificación y las explicaciones.</p>
        {samples.map((q, i) => (
          <div style="margin-bottom:18px;">
            <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
            <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
              {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                <li>{letter}. {text}</li>
              ))}
            </ul>
          </div>
        ))}

        <details class="acc-item mt-24">
          <summary class="acc-header">Ver las {questions.length} preguntas de este tema<span class="acc-arrow">▼</span></summary>
          <div class="acc-body">
            {questions.map((q, i) => (
              <div style="margin-bottom:18px;">
                <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{i + 1}. {q.question}</p>
                <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
                  {Object.entries(q.choices).filter(([, text]) => text).map(([letter, text]) => (
                    <li>{letter}. {text}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>

        <h2 id="realiza-el-cuestionario">Realiza el Cuestionario</h2>
        <QuizTopicInteractive
          topicSlug="condiciones-de-cierre"
          topicName={TOPIC}
          topicIcon="🔒"
          questions={questions}
          startLabel="Comenzar →"
          noteText="Nada de lo que ingreses se guarda, se envía a ningún lugar ni se almacena — recargar la página lo borra todo."
          scriptSrc="/scripts/well-control-quiz-es.js"
        />

        <h2 id="faq">Preguntas Frecuentes</h2>
        {faq.map((item) => (
          <div style="margin-bottom:18px;">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">En Esta Página</div>
          <a href="#que-cubre-este-tema">Qué Cubre</a>
          <a href="#preguntas-de-muestra">Preguntas de Muestra</a>
          <a href="#realiza-el-cuestionario">Realiza el Cuestionario</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Resuelve las Matemáticas Tú Mismo</h3>
          <p style="margin-bottom:12px;">Corre números reales de SIDPP, peso de lodo, y TVD por la calculadora en vivo.</p>
          <a href="/es/calculators/kill-sheet" class="card-link">Calculadora de Hoja de Control →</a>
        </div>

        <div class="card" style="margin-top:1px;border:1px solid var(--iron);border-radius:0 0 4px 4px;">
          <h3>Más Temas del Cuestionario</h3>
          <a href="/es/well-control-quiz" class="card-link">→ Los 8 Temas</a><br><br>
          <a href="/es/well-control-quiz/senales-de-advertencia-y-cierre" class="card-link">→ Señales de Advertencia y Cierre</a><br><br>
          <a href="/es/well-control-quiz/volumenes-y-maasp" class="card-link">→ Volúmenes y MAASP</a><br><br>
          <a href="/es/well-control-quiz/kill-sheet-practice" class="card-link">→ Problemas de Hoja de Control</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
