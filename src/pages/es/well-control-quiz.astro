---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import quizData from '../../lib/data/well-control-quiz-es.json';

// 200 preguntas de práctica de control de pozos en 8 temas. Traducción del
// mismo banco de preguntas genérico (sin rig, pozo o empresa) usado en la
// versión en inglés.
type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const questions = quizData as Question[];

const faq = [
  {
    q: '¿Este quiz está afiliado oficialmente a IWCF o IADC?',
    a: 'No. Las preguntas cubren el mismo terreno que se evalúa en los exámenes de certificación de control de pozos IWCF e IADC WellSharp, pero este quiz no está producido, avalado ni afiliado a ninguno de los dos organismos, y aprobarlo no sustituye una certificación acreditada. Trátalo como práctica y autoevaluación antes o junto con una capacitación real, no como un reemplazo de ella.',
  },
  {
    q: '¿Hay una nota mínima para aprobar?',
    a: 'No hay un corte fijo — esto no es un examen calificado. Cada tema muestra tu puntaje sobre el total de preguntas de ese tema al final, además de una revisión completa de cada pregunta con la respuesta correcta y su explicación, para que veas exactamente dónde estás débil en lugar de solo una etiqueta de aprobado/reprobado.',
  },
  {
    q: '¿Puedo repetir un tema, y me saldrán las mismas preguntas?',
    a: 'Sí, repite cualquier tema las veces que quieras. Las preguntas se mezclan cada vez que empiezas un tema, así que el orden cambia, aunque el banco de preguntas de ese tema sigue siendo el mismo — está pensado para práctica repetida hasta que el material se fije, no para un intento único.',
  },
  {
    q: '¿Necesito crear una cuenta o instalar algo?',
    a: 'No. No hay registro, no hay inicio de sesión, y no hay nada que instalar. Elige un tema y carga de inmediato en el navegador. Como dice la nota arriba, nada de lo que ingreses se guarda ni se envía a ningún lugar — recargar la página borra tu progreso, lo que también significa que no hay cuenta donde perder ese progreso.',
  },
];

const topicOrder = [
  'Conocimientos Básicos',
  'Presión Básica',
  'Señales de Advertencia y Cierre',
  'Condiciones de Cierre',
  'Volúmenes y MAASP',
  'Métodos de Matanza',
  'Preguntas Difíciles',
  'Preguntas Submarinas',
];

const topicIcons: Record<string, string> = {
  'Conocimientos Básicos': '📘',
  'Presión Básica': '⚙',
  'Señales de Advertencia y Cierre': '🚨',
  'Condiciones de Cierre': '🔒',
  'Volúmenes y MAASP': '📊',
  'Métodos de Matanza': '🛑',
  'Preguntas Difíciles': '🧠',
  'Preguntas Submarinas': '🌊',
};

function slugify(topic: string) {
  return topic.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const topics = topicOrder.map((topic) => ({
  name: topic,
  slug: slugify(topic),
  icon: topicIcons[topic] ?? '❓',
  questions: questions.filter((q) => q.topic === topic),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource"],
  "name": "Cuestionario de Control de Pozos: 200 Preguntas de Práctica",
  "url": "https://rigfloorhq.com/es/well-control-quiz",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Principios de control de pozos para cuadrillas de perforación",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
};
---
<BaseLayout
  title="Cuestionario de Control de Pozos: 200 Preguntas de Práctica"
  description="200 preguntas de práctica de control de pozos en 8 temas: presión, señales de advertencia de surgencia, cierre, MAASP, métodos de matanza, submarino y más."
  breadcrumbs={[{ label: 'Cuestionario de Control de Pozos', href: '/es/well-control-quiz' }]}
  jsonLd={quizLd}
  lang="es"
  alternateHref="/well-control-quiz"
>
  <Nav slot="nav" lang="es" alternateHref="/well-control-quiz" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Referencia — Práctica</div>
    <h1>Cuestionario de Control de <span>Pozos</span></h1>
    <p class="page-hero-sub">200 preguntas de práctica en 8 temas, el mismo terreno cubierto por las certificaciones de control de pozos IWCF e IADC. Elige un tema abajo y realízalo en vivo — una pregunta a la vez, puntaje real al final.</p>
  </div>

  <section class="block">
    <div class="section-eyebrow">Ponte a Prueba</div>
    <h2 class="section-title">Realiza el <span>Cuestionario</span></h2>
    <div class="card-grid" id="quiz-picker">
      {topics.map((t) => (
        <div class="card quiz-pick-btn" data-topic-slug={t.slug} role="button" tabindex="0">
          <span class="card-icon">{t.icon}</span>
          <h3>{t.name}</h3>
          <p>{t.questions.length} preguntas, mezcladas cada vez.</p>
          <span class="card-link">Comenzar →</span>
        </div>
      ))}
    </div>

    <div class="quiz-interactive-main hidden" id="quiz-interactive-main"></div>

    <div class="note-box mt-24">
      <strong>Solo práctica, no es un examen certificado.</strong> Estas preguntas cubren el mismo terreno que los exámenes de control de pozos IWCF e IADC pero no están afiliadas a ninguno de los dos organismos y no sustituyen una certificación acreditada. Nada de lo que ingreses se guarda, se envía a ningún lugar ni se almacena — recargar la página lo borra todo.
    </div>
  </section>

  {/* Solo datos de preguntas, nada visible como contenido de la página — el
      cuestionario perdería sentido si las respuestas estuvieran a la vista. */}
  {topics.map((t) => (
    <script type="application/json" class="quiz-data" data-topic-slug={t.slug} set:html={JSON.stringify(t.questions)} />
  ))}

  <section class="block">
    <div class="prose">
      <p>Resolver estos cálculos tú mismo primero vale más que leer la explicación en frío — la <a href="/es/calculators/kill-sheet">calculadora de hoja de control de pozo</a> usa las mismas matemáticas que estas preguntas evalúan.</p>
      <p>Para las explicaciones completas detrás de estos temas, ver la <a href="/es/drilling/well-control">referencia de control de pozos</a> y la <a href="/es/pillars/advanced-well-control-and-hydrostatics">guía de Control de Pozos Avanzado</a>. Cada sección arriba se complementa con una lectura más profunda: <a href="/es/blog/well-control-basics">fundamentos de control de pozos para cuadrillas nuevas</a>, <a href="/es/blog/five-warning-signs-of-a-kick">cinco señales de advertencia de una surgencia</a>, <a href="/es/blog/shut-in-pressure-behavior-explained">comportamiento de la presión de cierre</a>, <a href="/es/blog/drillers-method-wait-and-weight-mixups">confusiones de Método del Perforador y Wait and Weight</a>, y <a href="/es/blog/pit-volumes-maasp-math-mistakes">errores de matemáticas de volúmenes de pileta y MAASP</a>.</p>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">FAQ</div>
    <h2 class="section-title">Preguntas Sobre <span>el Quiz</span></h2>
    <div class="accordion" style="max-width:820px;">
      {faq.map((item) => (
        <details class="acc-item">
          <summary class="acc-header">{item.q}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Global, no scoped: la UI interactiva del cuestionario (.qi-*) la crea JS
     del lado del cliente después de cargar la página, así que el scoping de
     estilos de Astro en build-time nunca la alcanza. */
  .quiz-pick-btn { cursor: pointer; text-align: left; }
  .quiz-pick-btn:hover { border-color: var(--amber); }
  .quiz-pick-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .quiz-interactive-main.active {
    background: var(--steel);
    border: 1px solid var(--amber);
    border-radius: 8px;
    padding: 28px;
    margin-top: 28px;
  }

  .hidden { display: none !important; }

  .qi-progress { font-family: var(--mono); font-size: 11px; color: var(--fog); margin-bottom: 12px; }
  .qi-text { font-weight: 600; color: var(--white); margin-bottom: 16px; font-size: 18px; }
  .qi-choice {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--ink);
    border: 1px solid var(--iron);
    color: var(--mist);
    padding: 12px 16px;
    margin-bottom: 8px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
  }
  .qi-choice:hover:not(:disabled) { border-color: var(--amber); }
  .qi-choice:disabled { cursor: default; }
  .qi-choice.right { border-color: #4ade80; background: rgba(74, 222, 128, 0.12); color: var(--white); }
  .qi-choice.wrong { border-color: var(--danger); background: rgba(239, 68, 68, 0.12); color: var(--white); }
  .qi-explain { font-size: 13px; color: var(--fog); margin: 14px 0; padding-top: 14px; border-top: 1px solid var(--iron); }
  .qi-score-big { font-size: 2.4em; font-weight: 700; text-align: center; color: var(--white); margin: 10px 0; }
  .qi-score-sub { text-align: center; color: var(--fog); margin-bottom: 20px; }
  .qi-topic-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); margin-bottom: 8px; }

  .qi-review { margin: 24px 0; border-top: 1px solid var(--iron); padding-top: 20px; }
  .qi-review-title { font-weight: 600; color: var(--white); margin-bottom: 14px; }
  .qi-review-item { background: var(--ink); border: 1px solid var(--iron); border-radius: 6px; padding: 16px 18px; margin-bottom: 10px; }
  .qi-review-item.wrong { border-color: rgba(239, 68, 68, 0.4); }
  .qi-review-q { font-weight: 600; color: var(--white); margin-bottom: 8px; font-size: 14px; }
  .qi-review-your { font-size: 13px; margin-bottom: 4px; }
  .qi-review-your.wrong { color: var(--danger); }
  .qi-review-your.right { color: #4ade80; }
  .qi-review-correct { font-size: 13px; color: #4ade80; margin-bottom: 8px; }
  .qi-review-explain { font-size: 13px; color: var(--fog); }
</style>

<script is:inline src="/scripts/well-control-quiz-es.js" defer></script>
