---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import quizData from '../../lib/data/well-control-quiz-es.json';

// 200 preguntas de práctica de control de pozos en 8 temas. Traducción del
// mismo banco de preguntas genérico (sin rig, pozo o empresa) usado en la
// versión en inglés.
type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const questions = quizData as Question[];

const faq = [
  {
    q: '¿Este quiz está afiliado oficialmente a IWCF o IADC?',
    a: 'No. Las preguntas cubren el mismo terreno que se evalúa en los exámenes de certificación de control de pozos IWCF e IADC WellSharp, pero este quiz no está producido, avalado ni afiliado a ninguno de los dos organismos, y aprobarlo no sustituye una certificación acreditada. Trátalo como práctica y autoevaluación antes o junto con una capacitación real, no como un reemplazo de ella.',
  },
  {
    q: '¿Hay una nota mínima para aprobar?',
    a: 'No hay un corte fijo — esto no es un examen calificado. Cada tema muestra tu puntaje sobre el total de preguntas de ese tema al final, además de una revisión completa de cada pregunta con la respuesta correcta y su explicación, para que veas exactamente dónde estás débil en lugar de solo una etiqueta de aprobado/reprobado.',
  },
  {
    q: '¿Puedo repetir un tema, y me saldrán las mismas preguntas?',
    a: 'Sí, repite cualquier tema las veces que quieras. Las preguntas se mezclan cada vez que empiezas un tema, así que el orden cambia, aunque el banco de preguntas de ese tema sigue siendo el mismo — está pensado para práctica repetida hasta que el material se fije, no para un intento único.',
  },
  {
    q: '¿Necesito crear una cuenta o instalar algo?',
    a: 'No. No hay registro, no hay inicio de sesión, y no hay nada que instalar. Elige un tema y carga de inmediato en el navegador. Como dice la nota arriba, nada de lo que ingreses se guarda ni se envía a ningún lugar — recargar la página borra tu progreso, lo que también significa que no hay cuenta donde perder ese progreso.',
  },
];

const topicOrder = [
  'Conocimientos Básicos',
  'Presión Básica',
  'Señales de Advertencia y Cierre',
  'Condiciones de Cierre',
  'Volúmenes y MAASP',
  'Métodos de Matanza',
  'Preguntas Difíciles',
  'Preguntas Submarinas',
];

const topicIcons: Record<string, string> = {
  'Conocimientos Básicos': '📘',
  'Presión Básica': '⚙',
  'Señales de Advertencia y Cierre': '🚨',
  'Condiciones de Cierre': '🔒',
  'Volúmenes y MAASP': '📊',
  'Métodos de Matanza': '🛑',
  'Preguntas Difíciles': '🧠',
  'Preguntas Submarinas': '🌊',
};

function slugify(topic: string) {
  return topic.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const topics = topicOrder.map((topic) => ({
  name: topic,
  slug: slugify(topic),
  icon: topicIcons[topic] ?? '❓',
  questions: questions.filter((q) => q.topic === topic),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource", "Quiz"],
  "@id": "https://rigfloorhq.com/es/well-control-quiz#webpage",
  "name": "Examen de Práctica de Control de Pozos",
  "url": "https://rigfloorhq.com/es/well-control-quiz",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Principios de control de pozos para cuadrillas de perforación",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/es#website" },
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
  "hasPart": topics.map((t) => ({
    "@type": "Quiz",
    "@id": `https://rigfloorhq.com/es/well-control-quiz/${t.slug}#webpage`,
    "name": `${t.name} — Cuestionario de Control de Pozos`,
    "url": `https://rigfloorhq.com/es/well-control-quiz/${t.slug}`,
  })),
};
---
<BaseLayout
  title="Examen de Práctica de Control de Pozos"
  description="200 preguntas de práctica de control de pozos en 8 temas: presión, señales de advertencia de surgencia, cierre, MAASP, métodos de matanza, submarino y más."
  breadcrumbs={[{ label: 'Cuestionario de Control de Pozos', href: '/es/well-control-quiz' }]}
  jsonLd={quizLd}
  lang="es"
  alternateHref="/well-control-quiz"
>
  <Nav slot="nav" lang="es" alternateHref="/well-control-quiz" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Referencia — Práctica</div>
    <h1>Cuestionario de Control de <span>Pozos</span></h1>
    <p class="page-hero-sub">200 preguntas de práctica en 8 temas, el mismo terreno cubierto por las certificaciones de control de pozos IWCF e IADC. Elige un tema abajo y realízalo en vivo — una pregunta a la vez, puntaje real al final.</p>
  </div>

  <section class="block">
    <div class="section-eyebrow">Ponte a Prueba</div>
    <h2 class="section-title">Realiza el <span>Cuestionario</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">Cada tema ahora tiene su propia página dedicada con el cuestionario interactivo en vivo, un resumen corto de lo que cubre, y preguntas de muestra por adelantado — elige un tema abajo.</p>
    <div class="card-grid" id="quiz-picker">
      {topics.map((t) => (
        <a href={`/es/well-control-quiz/${t.slug}`} class="card">
          <span class="card-icon">{t.icon}</span>
          <h3>{t.name}</h3>
          <p>{t.questions.length} preguntas, mezcladas cada vez.</p>
          <span class="card-link">Realiza el Cuestionario →</span>
        </a>
      ))}
    </div>

    <div class="note-box mt-24">
      <strong>Solo práctica, no es un examen certificado.</strong> Estas preguntas cubren el mismo terreno que los exámenes de control de pozos IWCF e IADC pero no están afiliadas a ninguno de los dos organismos y no sustituyen una certificación acreditada. Nada de lo que ingreses se guarda, se envía a ningún lugar ni se almacena — recargar la página lo borra todo.
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Vista Previa</div>
    <h2 class="section-title">Preguntas de <span>Muestra</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">Tres preguntas reales de cada tema, para que veas en qué te estás metiendo antes de empezar el cuestionario interactivo completo de arriba. Las respuestas no se muestran aquí — toma el cuestionario en vivo para la calificación y las explicaciones.</p>
    <div class="accordion" style="max-width:820px;">
      {topics.map((t) => (
        <details class="acc-item">
          <summary class="acc-header">{t.icon} {t.name}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body">
            {t.questions.slice(0, 3).map((q) => (
              <div style="margin-bottom:16px;">
                <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{q.question}</p>
                <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
                  {Object.entries(q.choices).map(([letter, text]) => (
                    <li>{letter}. {text}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="prose">
      <p>Resolver estos cálculos tú mismo primero vale más que leer la explicación en frío — la <a href="/es/calculators/kill-sheet">calculadora de hoja de control de pozo</a> usa las mismas matemáticas que estas preguntas evalúan. Para cuatro problemas completos de hoja de control de pozo resueltos con datos de cierre dados en lugar de opción múltiple, ver los <a href="/es/well-control-quiz/kill-sheet-practice">problemas de práctica de hoja de control</a>.</p>
      <p>Para las explicaciones completas detrás de estos temas, ver la <a href="/es/drilling/well-control">referencia de control de pozos</a> y la <a href="/es/pillars/well-kill-methods">guía de Métodos para Matar un Pozo</a>. Cada sección arriba se complementa con una lectura más profunda: <a href="/es/blog/well-control-basics">fundamentos de control de pozos para cuadrillas nuevas</a>, <a href="/es/blog/five-warning-signs-of-a-kick">cinco señales de advertencia de una surgencia</a>, <a href="/es/blog/shut-in-pressure-behavior-explained">comportamiento de la presión de cierre</a>, <a href="/es/blog/drillers-method-wait-and-weight-mixups">confusiones de Método del Perforador y Wait and Weight</a>, y <a href="/es/blog/pit-volumes-maasp-math-mistakes">errores de matemáticas de volúmenes de pileta y MAASP</a>.</p>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Certificación</div>
    <h2 class="section-title">Dónde Encaja en la <span>Escalera IWCF</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">Este cuestionario cubre teoría y matemáticas de los cuatro niveles de control de pozos de IWCF — no está atado a un solo nivel. Para dónde encaja cada nivel realmente en una carrera de taladro, ver <a href="/es/pillars/rig-floor-leadership" style="color:var(--amber);">Liderazgo en el Piso de Perforación</a> y el desglose completo de <a href="/es/careers/certifications" style="color:var(--amber);">certificaciones</a>. Si tu taladro usa IADC WellSharp en lugar de IWCF, ver <a href="/es/careers/iwcf-vs-iadc-wellsharp" style="color:var(--amber);">IWCF vs IADC WellSharp</a> para cómo se corresponden estos mismos niveles.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Nivel</th><th>Para Quién Es</th><th>Qué Cubre</th><th>Renovación</th></tr></thead>
        <tbody>
          <tr><td>1 — Conciencia</td><td>Cualquier personal del taladro</td><td>Principios fundamentales de control de pozos y conciencia sobre prevención de reventones</td><td>—</td></tr>
          <tr><td>2 — Introductorio</td><td>Equipo de operaciones en sitio cuya acción o inacción puede influir en el control de pozos, p. ej. asistente de perforador, encuellador</td><td>Control de pozos básico de perforación y evaluación de control de pozos</td><td>5 años</td></tr>
          <tr><td>3 — Perforador</td><td>El operador del equipo que tiene que actuar para prevenir o responder a un incidente de control de pozos, p. ej. perforador</td><td>Procedimientos de cierre, detección de surgencias, escenarios de control de pozos con simulador</td><td>2 años</td></tr>
          <tr><td>4 — Supervisor</td><td>La persona que supervisa que las acciones correctas realmente se lleven a cabo, p. ej. toolpusher, OIM, company man</td><td>Técnica avanzada y toma de decisiones de emergencia bajo presión</td><td>2 años</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">FAQ</div>
    <h2 class="section-title">Preguntas Sobre <span>el Quiz</span></h2>
    <div class="accordion" style="max-width:820px;">
      {faq.map((item) => (
        <details class="acc-item">
          <summary class="acc-header">{item.q}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
