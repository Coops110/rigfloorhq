import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { techArticleSchema } from '../../../lib/techarticle.js';
import KeyFacts from '../../../components/KeyFacts.astro';


const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/es/equipment/fluid-circulation-system.astro',
  path: '/es/equipment/fluid-circulation-system',
  headline: "Sistema de Circulación de Fluido: Bombas de Lodo, Standpipe",
  description: "Cómo funciona el sistema de circulación de fluido de un taladro: bombas de lodo, el standpipe y la manguera rotaria.",
  lang: 'es',
});
---
<BaseLayout
  extraJsonLd={[techArticleJsonLd]}
  title="Sistema de Circulación de Fluido: Bombas de Lodo, Standpipe"
  description="Cómo funciona el sistema de circulación de fluido de un taladro: bombas de lodo, el standpipe y la manguera rotaria."
  breadcrumbs={[{ label: 'Equipo', href: '/es/equipment' }, { label: 'Sistema de Circulación de Fluido', href: '/es/equipment/fluid-circulation-system' }]}
  lang="es"
  alternateHref="/equipment/fluid-circulation-system"
>
  <Nav slot="nav" lang="es" alternateHref="/equipment/fluid-circulation-system" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Equipo — Sistemas Principales</div>
    <h1>Sistema de Circulación <span>de Fluido</span></h1>
    <p class="page-hero-sub">Las bombas de lodo y la trayectoria de flujo que transportan los recortes a superficie, enfrían la barrena, y contienen la presión de la formación — todo con el mismo fluido, moviéndose por el mismo circuito.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="what-it-is">Qué Hace el Sistema de Circulación</h2>
        <p>La circulación está haciendo tres trabajos simultáneamente, con el mismo fluido en el mismo circuito: transportar los recortes hacia arriba por el espacio anular y alejarlos de la barrena para que el pozo siga avanzando, enfriar y lubricar la barrena y la sarta contra la fricción de la perforación, y aplicar la presión hidrostática que contiene la presión de la formación — la base entera del control primario de pozos. Todo en este sistema existe para mantener ese único fluido moviéndose de forma confiable por toda su trayectoria.</p>

        <KeyFacts
          lang="es"
          rows={[["Bombas de lodo", "Bombas triplex de pistón de simple acción; dos o tres por taladro es lo común, de aproximadamente 1,000 a 2,200 hp cada una (1,600 hp es un tamaño muy común)."], ["Presión nominal", "Módulos de fluido comúnmente de 5,000 psi en taladros de tierra y 7,500 psi en taladros profundos y costa afuera."], ["Camisas", "Intercambiables, de unas 5\" a 7-1/2\" de diámetro — una camisa más chica da más presión y menos volumen por embolada."], ["Recorrido del fluido", "Piletas → bombas → standpipe → manguera rotaria → top drive o kelly → sarta → barrena → espacio anular → línea de flujo → control de sólidos → piletas."], ["Líneas de superficie", "Standpipe, manguera rotaria y manifold clasificados para la presión máxima de las bombas, protegidos por una válvula de alivio en cada bomba."]]}
          standards={["api7k"]}
        />

        <h2 id="pumps">Bombas de Lodo</h2>
        <p>Las bombas son la fuente de poder del sistema — bombas de desplazamiento positivo reciprocantes que empujan el fluido de perforación a la presión y tasa que un trabajo dado necesita. La mayoría de los taladros modernos usan <strong>bombas triplex</strong> (tres cilindros, de acción simple), que producen un flujo más suave y continuo que el diseño <strong>dúplex</strong> más antiguo (dos cilindros, de doble acción) con partes móviles menos numerosas y más ligeras para una producción dada — una ventaja real a las presiones y tasas de flujo más altas que la perforación moderna rutinariamente requiere. Las bombas dúplex todavía se encuentran en algunos taladros más antiguos o pequeños, pero el triplex es el estándar en todo lo construido en décadas recientes.</p>
        <p>La producción real de una bomba — el volumen que mueve por minuto a una tasa de embolada dada — es una cifra directa y calculable, no solo una clasificación en una placa; ve la <a href="/es/calculators/pump-pressure-adjustment">calculadora de ajuste de presión de bomba</a> para cómo cambia la producción con la tasa de embolada y el peso del lodo.</p>

        <h2 id="flow-path">La Trayectoria Completa de Flujo</h2>
        <p>El fluido sale de las <strong>piletas de lodo</strong>, entra a la bomba, y se empuja hacia arriba por un <strong>standpipe</strong> rígido montado en la torre. De ahí pasa por una <strong>manguera rotaria</strong> flexible (o por el paso de fluido interno propio de un top drive, en un taladro con top drive — ve el <a href="/es/equipment/rotating-system">sistema rotatorio</a>) hacia la parte superior de la <a href="/es/equipment/drill-string">sarta de perforación</a>, viaja toda la longitud de la sarta, y sale por las <a href="/es/calculators/bit-hydraulics">boquillas de la barrena</a> en el fondo. De ahí da vuelta y viaja de regreso hacia arriba por el <strong>espacio anular</strong> — el espacio entre la sarta y la pared del pozo — llevando los recortes con él, hasta que llega a superficie por la <strong>línea de retorno</strong> y alimenta directamente al <a href="/es/equipment/mud-pit-system">sistema de control de sólidos</a> antes de volver a las piletas para ser bombeado de nuevo. Ese recorrido tiene un tiempo real y calculable — ver la <a href="/es/calculators/lag-and-volume">calculadora de lag y volumen</a> para el volumen de la sarta y del espacio anular, y cuántas bolsadas y minutos tarda una muestra del fondo en llegar a las zarandas.</p>

        <h2 id="pressure-flow">Presión, Tasa de Flujo, y Limpieza del Pozo</h2>
        <p>La bomba tiene que entregar suficiente tasa de flujo para transportar los recortes a superficie a una <a href="/es/calculators/annular-velocity">velocidad anular</a> funcional para el tamaño de pozo y sistema de lodo específicos en uso — una tasa de flujo demasiado baja para el pozo deja que los recortes se asienten de nuevo en lugar de llegar a superficie, una causa mecánica directa de empaque y tubería pegada. Al mismo tiempo, la presión de la bomba está limitada por la propia clasificación de presión del sistema y por cuánta de esa presión se está perdiendo en fricción en lugar de llegar realmente a la barrena — ve <a href="/es/calculators/bit-hydraulics">hidráulica de barrena</a> para lo que está pasando justo en la cara de la barrena una vez que el flujo llega ahí.</p>

      </div>

      <div>
        <div class="toc">
          <div class="toc-title">En Esta Página</div>
