---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import { techArticleSchema } from '../../../lib/techarticle.js';
import SourcesStandards from '../../../components/SourcesStandards.astro';

const faq = [
  {
    q: "¿Qué es una abrazadera de seguridad, y cuándo se usa?",
    a: "Una abrazadera de seguridad (safety clamp) es una abrazadera mecánica que se coloca alrededor del cuerpo de la tubería justo debajo de una junta, actuando como respaldo que detiene la sarta de caer si los elevadores o la araña pierden su agarre inesperadamente. No carga peso durante la operación normal — las llaves, cuñas y elevadores hacen el trabajo real descrito en esta página — pero es práctica estándar en muchos taladros durante momentos específicos de mayor riesgo, como manejar una sola junta en el catwalk o correr casing, donde una caída no planeada tiene una consecuencia peor que el paso extra de colocar la abrazadera.",
  },
  {
    q: "¿Cuál es la diferencia real entre llaves manuales y un iron roughneck?",
    a: "Las llaves manuales dependen de que la cuadrilla aplique torque tirando de una línea de llave enrollada en el cathead, con un segundo juego de llaves sosteniendo fija la junta inferior — el valor de torque depende de la técnica y el tacto de la cuadrilla. Un iron roughneck es una sola unidad hidráulica que gira la conexión y luego aplica un valor de torque preciso y preestablecido automáticamente, eliminando tanto el tirón manual como la decisión sobre cuánto torque realmente se aplicó. El trabajo mecánico es idéntico en ambos casos; lo que cambia es la consistencia y dónde están las manos de la cuadrilla durante el momento de mayor riesgo de pellizco del ciclo.",
  },
  {
    q: "¿Cuáles son los diferentes tipos de elevadores, y por qué importa cuál hay en el taladro?",
    a: "Los tipos comunes son elevadores de puerta lateral (side-door, se abren por el lado, el tipo de propósito general más común), elevadores de traba central (center-latch, traban al frente al centro, usados a menudo en sartas más grandes o pesadas), elevadores tipo cuña (slip-type, sujetan el cuerpo de la tubería directamente con cuñas internas en lugar de trabar debajo de un resalte de junta, usados donde la geometría de la conexión no se presta a una traba estándar), y elevadores de junta sencilla (single-joint, dimensionados para manejar una junta a la vez en lugar de una parada completa, usados en el catwalk o para operaciones especializadas de junta sencilla). Cada uno está clasificado y dimensionado para un rango específico de tubería y carga — usar el tipo de elevador equivocado para la sarta en mano es un peligro de manejo real, no solo un desajuste de conveniencia.",
  },
  {
    q: "¿Por qué las cuñas tienen que dimensionarse al diámetro exacto de la tubería en lugar de un rango general?",
    a: "Una cuña sujeta por acción de cuña — los segmentos cónicos muerden más fuerte mientras el peso de la sarta tira hacia abajo — y ese mecanismo solo funciona correctamente cuando los segmentos coinciden de cerca con el diámetro exterior real de la tubería. Una cuña dimensionada demasiado grande no asentará ni mordera correctamente; una demasiado pequeña puede dañar el cuerpo de la tubería o no soportar la carga clasificada. Es la misma disciplina de dimensionamiento que requieren los <a href=\"/es/equipment/bop#arietes\">arietes de tubería de un stack de BOP</a> por la misma razón subyacente — un agarre mecánico construido alrededor de un diámetro específico no funciona como un ajuste holgado para un tamaño cercano.",
  },
];

const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/es/equipment/rig-floor-tools.astro',
  path: '/es/equipment/rig-floor-tools',
  headline: "Herramientas Manuales del Piso de Perforación: Llaves, Cuñas, Elevadores y Spinner",
  description: "Las herramientas manuales centrales usadas para armar y desarmar conexiones de tubería de perforación en el piso del taladro — llaves, iron roughneck, cuñas, elevadores, y la llave de giro — qué hace cada una y cómo trabajan juntas.",
  lang: 'es',
});
---
<BaseLayout
  extraJsonLd={[techArticleJsonLd]}
  title="Herramientas del Piso: Llaves, Cuñas y Elevadores"
  description="Las herramientas centrales para armar y desarmar conexiones en el piso del taladro — llaves, iron roughneck, cuñas, elevadores y la llave de giro — explicadas."
  breadcrumbs={[{ label: 'Equipo', href: '/es/equipment' }, { label: 'Herramientas del Piso', href: '/es/equipment/rig-floor-tools' }]}
  lang="es"
  alternateHref="/equipment/rig-floor-tools"
>
  <Nav slot="nav" lang="es" alternateHref="/equipment/rig-floor-tools" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Equipo — Piso de Perforación</div>
    <h1>Herramientas Manuales <span>del Piso de Perforación</span></h1>
    <p class="page-hero-sub">Cada conexión armada o desarmada en el piso de perforación pasa por el mismo puñado de herramientas. Esto es lo que hace cada una, y cómo las usa realmente una cuadrilla de roughnecks juntas para correr tubería.</p>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="para-que-sirven">Para Qué Sirven</h2>
        <p>Las herramientas del piso de perforación son las herramientas manuales y unidades mecanizadas que usa una cuadrilla para sujetar, girar, aplicar torque y sostener la tubería de perforación cada vez que se arma o desarma una conexión mientras se corre una sarta dentro o fuera del pozo. Correr una sarta dentro o fuera del pozo significa armar o desarmar una conexión roscada en cada parada, cientos de veces durante la vida de un pozo. Las herramientas de esta página son las que usa una cuadrilla de <a href="/es/careers/roughneck">roughneck</a> para sujetar, girar, aplicar torque, y sostener la tubería de forma segura a través de ese ciclo — ninguna hace algo por sí sola; trabajan en una secuencia fija cada vez que se maneja una conexión.</p>

        <KeyFacts
          lang="es"
          rows={[["Herramientas centrales", "Llaves (o iron roughneck), cuñas, elevadores, llave de giro o kelly spinner."], ["Trabajo principal", "Sujetar, girar, aplicar torque y sostener la tubería durante cada conexión armada o desarmada."], ["Quién las opera", "La cuadrilla del piso de perforación (roughnecks), bajo la dirección del perforador desde la consola."], ["Manual vs mecanizado", "Las llaves y cuñas manuales son la configuración tradicional; un iron roughneck mecaniza el armado/desarmado y se ha vuelto estándar en la mayoría de los taladros modernos."]]}
        />

        <h2 id="llaves">Llaves (Tongs)</h2>
        <p>Las llaves sujetan el cuerpo de la tubería y aplican el torque rotacional que arma o desarma una conexión roscada. Los pisos de perforación tradicionales usan dos juegos — un par de llaves manuales, una sosteniendo fija la junta inferior mientras la otra aplica torque a la junta superior — operadas a mano con la cuadrilla tirando de una línea de llave — un cable enrollado alrededor del cathead, un carrete giratorio en el malacate que suministra la fuerza de tiro — para apalancamiento. Este es trabajo físicamente exigente y repetitivo, y es una de las razones principales por las que los primeros meses de un roughneck son tanto sobre desarrollar la fuerza y técnica específicas que requiere este trabajo como sobre aprender el equipo en sí.</p>
        <p>Un <strong>iron roughneck</strong> mecaniza el mismo trabajo: una unidad única accionada hidráulicamente que gira la tubería y luego aplica torque preciso y medido al valor exacto que requiere la conexión, sin que un miembro de la cuadrilla tenga que tirar físicamente de las líneas de llave. Se ha vuelto el estándar en la mayoría de los taladros modernos en tierra y costa afuera porque es más rápido y más seguro a la vez — el torque se aplica consistentemente a especificación en lugar de al tacto, y saca las manos del área de mayor riesgo de punto de pellizco en el piso durante el armado y desarmado.</p>

        <h2 id="cunas">Cuñas (Slips)</h2>
        <p>Las cuñas son insertos dentados en forma de cuña que se asientan en la mesa rotaria (o en una araña de casing/tubing para esas sartas) y sujetan el cuerpo de la tubería para sostener todo el peso de la sarta colgando en el pozo una vez que se libera de los elevadores. Funcionan puramente por acción de cuña: el peso de la sarta tirando hacia abajo empuja los segmentos cónicos de la cuña más apretados contra la tubería, lo que significa que el agarre se vuelve más fuerte exactamente cuando se necesita, bajo carga — no es algo que pueda aflojarse por sí solo a mitad de una conexión.</p>
        <p>Las cuñas se dimensionan al diámetro y peso específico de la tubería que se corre, de la misma forma en que un <a href="/es/equipment/bop#arietes">ariete de tubería</a> se dimensiona a un diámetro de tubería. Una cuña mal emparejada no asentará correctamente o no soportará la carga para la que está clasificada, lo cual es un peligro de manejo serio en lugar de un inconveniente menor.</p>

        <h2 id="elevadores">Elevadores</h2>
        <p>Los elevadores son el conjunto de sujeción articulado que se traba alrededor de la tubería justo debajo del resalte de una junta (el hombro más grueso en cada extremo de tubería) y se conecta hacia arriba al bloque viajero vía bridas, permitiendo que el sistema de izaje levante y baje toda la sarta. Donde las cuñas sostienen la sarta estacionaria en la mesa rotaria, los elevadores son los que realmente la mueven — subiendo una parada nueva a posición para armar, o bajando la sarta para asentarla de vuelta en las cuñas una vez que se desarma una conexión.</p>
        <p>El intercambio entre los dos es el ritmo central de viajar tubería: los elevadores bajan la sarta hasta que su peso se transfiere a las cuñas, se desarma o arma la conexión, luego los elevadores traban la siguiente junta y el ciclo se repite. Cada viaje dentro o fuera del pozo es esta misma secuencia, corrida tantas veces como lo requiera la longitud de la sarta.</p>
        <p>Los elevadores vienen en varios tipos distintos, emparejados a la sarta y al trabajo en lugar de ser intercambiables:</p>
        <ul>
          <li><strong>Elevadores de puerta lateral (side-door)</strong> se abren por el lado para trabar alrededor de la tubería — el tipo de propósito general más común en una sarta de tubería de perforación.</li>
          <li><strong>Elevadores de traba central (center-latch)</strong> traban al frente al centro del cuerpo en cambio, un diseño más adecuado para sartas más grandes o pesadas donde la geometría de bisagra de un side-door es menos práctica.</li>
          <li><strong>Elevadores tipo cuña (slip-type)</strong> sujetan el cuerpo de la tubería directamente con segmentos de cuña internos en lugar de trabar debajo del resalte de una junta, usados donde la geometría de la conexión no se presta a una traba estándar — en tubing o ciertas sartas de workover, por ejemplo.</li>
          <li><strong>Elevadores de junta sencilla (single-joint)</strong> están dimensionados para manejar una junta a la vez en lugar de una parada multi-junta completa, usados en el catwalk o para manejo especializado de junta sencilla en lugar de operaciones principales de viaje.</li>
        </ul>
        <p>Igual que las cuñas, cada tipo de elevador está clasificado y dimensionado para un rango específico de tubería y carga — usar el tipo equivocado para la sarta en mano es un peligro de manejo, no una compensación de conveniencia.</p>

        <h2 id="abrazaderas-de-seguridad">Abrazaderas de Seguridad</h2>
        <p>Una abrazadera de seguridad es una abrazadera mecánica colocada alrededor del cuerpo de la tubería justo debajo de una junta, sin cargar peso durante la operación normal pero lista para detener la sarta de caer si los elevadores o una araña pierden su agarre inesperadamente. Es un respaldo, no una herramienta principal — las llaves, cuñas y elevadores hacen el trabajo real de sujetar, girar y sostener descrito arriba — pero es práctica estándar en muchos taladros en momentos específicos de mayor riesgo: manejar una sola junta en el catwalk, correr casing, o cualquier operación donde una caída no planeada tiene una consecuencia peor que lo que cuesta el paso extra de colocar la abrazadera. Trata una abrazadera de seguridad como un seguro barato contra un modo de falla específico, no como equipo redundante que ralentiza el trabajo sin razón.</p>

        <h2 id="cunas-de-potencia-iron-roughneck">Cuñas de Potencia e Iron Roughneck</h2>
        <p>Las <strong>cuñas de potencia (power slips)</strong> son cuñas accionadas hidráulicamente que se colocan y liberan automáticamente en lugar de requerir que un miembro de la cuadrilla coloque y retire físicamente las cuñas manuales a mano en la mesa rotaria. Sacan otro par de manos de la zona de punto de pellizco alrededor de la mesa rotaria durante cada ciclo de conexión, la misma lógica de seguridad detrás de la mecanización de las llaves por el iron roughneck. En un taladro moderno equipado con ambos, cuñas de potencia e iron roughneck, una conexión puede armarse o desarmarse con las manos de la cuadrilla lejos de los componentes rotatorios y de sujeción durante casi todo el ciclo — las llaves y cuñas manuales todavía existen y todavía funcionan con el mismo principio mecánico descrito arriba, pero la tendencia en taladros de construcción nueva es mecanizar cada parte de este ciclo que no requiera estrictamente una mano humana sobre la tubería.</p>

        <h2 id="llave-de-giro">Llave de Giro y Kelly Spinner</h2>
        <p>Antes de que las llaves puedan aplicar torque real, una conexión tiene que girarse primero hasta un ajuste apretado a mano — enroscando la junta lo suficiente para que la llave luego pueda aplicar el torque final y medido sin cruzar la rosca. Una <strong>llave de giro</strong> (o un power tong puesto en modo de giro en taladros modernos) hace este giro rápido accionado hidráulicamente, reemplazando el método más antiguo de girar la tubería a mano con una llave de cadena.</p>
        <p>Un <strong>kelly spinner</strong> es una herramienta relacionada pero distinta que se encuentra en taladros que todavía usan un kelly y mesa rotaria convencionales en lugar de un top drive — se monta en la parte superior del kelly mismo y gira el kelly hacia la conexión debajo de él. En un <a href="/es/equipment/rotating-system">taladro con top drive</a>, el propio motor del top drive realiza esta función directamente, que es una de varias razones por las que los taladros con top drive necesitan menos herramientas de piso separadas que un taladro de kelly convencional.</p>

        <h2 id="como-trabajan-juntas">Cómo Trabajan Juntas: Armando una Conexión</h2>
        <ol>
          <li><strong>La sarta ya está asentada en las cuñas</strong>, sostenida en la mesa rotaria con todo su peso desde el ciclo anterior.</li>
          <li><strong>Los elevadores bajan la parada nueva</strong>, alineando el extremo pin con el extremo caja de la junta estacionaria sostenida en las cuñas debajo.</li>
          <li><strong>La llave de giro o la función de giro del iron roughneck se engancha</strong>, enroscando la conexión apretada a mano sin cruzar la rosca.</li>
          <li><strong>Las llaves (o la función de torque del iron roughneck) aplican el torque final de armado</strong> al valor exacto especificado para esa conexión — un torque insuficiente arriesga que la junta se afloje en el fondo, un torque excesivo arriesga dañar las roscas. La sarta permanece sostenida en las cuñas durante todo este paso.</li>
          <li><strong>Los elevadores toman el peso de la sarta</strong> y las cuñas se liberan, dejando que la sarta ya extendida baje más dentro del pozo.</li>
          <li><strong>Las cuñas se reasientan</strong> alrededor de la sarta en su nueva posición; los elevadores se liberan y suben para trabar la siguiente parada, y el ciclo se repite.</li>
        </ol>
        <p>Desarmar una conexión mientras se viaja fuera del pozo corre la secuencia idéntica en reversa. Cada una de estas herramientas existe porque una conexión tiene que ser sujetada, girada, torqueada, y sostenida como cuatro trabajos mecánicos genuinamente separados — ninguna herramienta sola en el piso hace más de uno de ellos.</p>

        <div class="note-box">
          <strong>Solo referencia.</strong> Las especificaciones de torque, clasificaciones de cuñas, y capacidades de elevadores varían por fabricante, tamaño de tubería, y tipo de conexión — siempre confirma contra la tabla de torque real de tu taladro y las hojas de especificación de equipo antes de confiar en cualquier cifra para un trabajo real.
        </div>
      </div>

      <div>
