---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

// Same sync caveat as the English hub (src/pages/equipment/index.astro):
// hand-extracted from the card grid below, update both if a card changes.
const equipmentItems = [
  { href: '/equipment/rig-types', title: 'Tipos de Taladros de Perforación' },
  { href: '/equipment/drill-string', title: 'La Sarta de Perforación' },
  { href: '/equipment/bop', title: 'Preventores de Reventones' },
  { href: '/equipment/accumulator', title: 'Prueba Funcional y Simulacro del Acumulador' },
  { href: '/equipment/bridge-plug', title: 'Tapón Puente' },
  { href: '/equipment/casing-cutter', title: 'Cortador de Revestimiento' },
  { href: '/equipment/cement-retainer', title: 'Retenedor de Cemento' },
  { href: '/equipment/crossover-sub', title: 'Sub de Cruce' },
  { href: '/equipment/float-sub', title: 'Sub Flotador' },
  { href: '/equipment/under-reamer', title: 'Escariador Bajo Restricción' },
  { href: '/equipment/stabilizer', title: 'Estabilizador' },
  { href: '/equipment/reversing-tool', title: 'Herramienta de Reversa' },
  { href: '/equipment/hydraulic-jar', title: 'Martillo Hidráulico' },
  { href: '/equipment/section-mill', title: 'Fresa de Sección' },
  { href: '/equipment/window-mill', title: 'Fresa de Ventana' },
  { href: '/equipment/safety-joint', title: 'Junta de Seguridad' },
  { href: '/equipment/mwd-tool', title: 'Herramienta MWD' },
  { href: '/equipment/packer', title: 'Empacador' },
  { href: '/equipment/whipstock', title: 'Whipstock' },
  { href: '/equipment/liner-hanger', title: 'Colgador de Liner' },
  { href: '/equipment/sliding-sleeve', title: 'Camisa Deslizante' },
  { href: '/equipment/burr-mill', title: 'Fresa de Rebaba' },
  { href: '/equipment/nmdc-pony-nmdc', title: 'NMDC / Pony NMDC' },
  { href: '/equipment/lifting-sub', title: 'Sub de Izaje' },
  { href: '/equipment/pup-joint', title: 'Junta Pup' },
  { href: '/equipment/positive-displacement-mud-motor', title: 'Motor de Lodo de Desplazamiento Positivo' },
  { href: '/equipment/scssv', title: 'Válvula SCSSV' },
  { href: '/equipment/gas-lift-mandrel', title: 'Mandril de Levantamiento por Gas' },
  { href: '/equipment/blast-joint', title: 'Junta de Impacto' },
  { href: '/equipment/tcp-gun', title: 'Cañón TCP' },
  { href: '/equipment/tubing-plug', title: 'Tapón de Tubería' },
  { href: '/equipment/casing-patch', title: 'Parche de Revestimiento' },
  { href: '/equipment/landing-nipple', title: 'Niple de Asiento' },
  { href: '/equipment/on-off-tool', title: 'Herramienta On-Off' },
  { href: '/equipment/casing-shoe', title: 'Zapata de Revestimiento' },
  { href: '/equipment/centralizer', title: 'Centralizador de Revestimiento' },
  { href: '/equipment/mule-shoe', title: 'Zapata Mula' },
  { href: '/equipment/bull-nose-plug', title: 'Tapón de Nariz de Toro' },
  { href: '/equipment/jetting-tool', title: 'Herramienta de Chorro' },
  { href: '/equipment/expandable-sand-screen', title: 'Malla Expandible de Control de Arena' },
  { href: '/equipment/casing-roller-dressing-tool', title: 'Rodillo de Revestimiento / Dresado' },
  { href: '/equipment/wash-pipe', title: 'Tubería de Lavado' },
  { href: '/equipment/well-protector', title: 'Protector de Pozo' },
  { href: '/equipment/fishing-swivel', title: 'Unión de Pesca' },
  { href: '/equipment/bumper-sub', title: 'Sub de Golpe' },
  { href: '/equipment/sabs-dabs', title: 'SABS vs. DABS' },
  { href: '/equipment/power-swivel', title: 'Power Swivel' },
  { href: '/equipment/hydraulic-set-retainer-packer', title: 'Empacador de Retención Hidráulico' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://rigfloorhq.com/es/equipment#webpage",
  "name": "Referencia de Equipo de Taladro",
  "description": "Referencia completa del equipo de taladros petroleros: tipos de taladro, la sarta de perforación, preventores de reventones.",
  "url": "https://rigfloorhq.com/es/equipment",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": equipmentItems.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://rigfloorhq.com/es${item.href}`,
      "name": item.title,
    })),
  },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
};
---
<BaseLayout
  title="Equipo de Taladro — Tipos de Taladro, Sarta de Perforación"
  description="Referencia completa del equipo de taladros petroleros: tipos de taladro, la sarta de perforación, preventores de reventones."
  breadcrumbs={[{ label: 'Equipo', href: '/es/equipment' }]}
  jsonLd={jsonLd}
  lang="es"
  alternateHref="/equipment"
>
  <Nav slot="nav" lang="es" alternateHref="/equipment" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">02 — Equipo</div>
    <h1>Equipo del <span>Taladro</span></h1>
    <p class="page-hero-sub">Cada sistema mecánico central en un taladro de perforación, desde el taladro mismo hasta la barrena miles de pies debajo.</p>
  </div>

  <section class="block">
    <h2 class="sr-only">Guías de equipo</h2>
    <div class="card-grid">
      <a class="card" href="/es/equipment/rig-types">
        <span class="card-icon">🏗️</span>
        <h3>Tipos de Taladros de Perforación</h3>
        <p>Taladros terrestres, jack-ups, semisumergibles, buques de perforación, plataformas y barcazas comparados con especificaciones y tarifas diarias.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/drill-string">
        <span class="card-icon">🔩</span>
        <h3>La Sarta de Perforación</h3>
        <p>Cada componente desde el top drive hasta la barrena — tubería de perforación, lastrabarrenas, BHA, herramientas MWD, y tipos de barrena.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/bop">
        <span class="card-icon">🔒</span>
        <h3>Preventores de Reventones</h3>
        <p>Cómo un stack de BOP sella el pozo — preventores anulares, arietes, clasificaciones de presión, y requisitos de prueba.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/accumulator">
        <span class="card-icon">🧯</span>
        <h3>Prueba Funcional y Simulacro del Acumulador</h3>
        <p>Presión inicial, tiempo de apertura/cierre por componente contra API STD 53, tiempo de recarga, y secciones del reporte de simulacro.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/bridge-plug">
        <picture>
          <source type="image/avif" srcset="/images/equipment/bridge-plug-1.avif" />
          <source type="image/webp" srcset="/images/equipment/bridge-plug-1.webp" />
          <img class="card-thumb" src="/images/equipment/bridge-plug-1.jpg" width="800" height="800" alt="Tapón Puente" loading="lazy" />
        </picture>
        <h3>Tapón Puente</h3>
        <p>Perforable vs. recuperable, asentamiento a cable vs. mecánico, clasificaciones de presión/temperatura, fallas comunes, y en qué se diferencia de un retenedor de cemento.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/casing-cutter">
        <picture>
          <source type="image/avif" srcset="/images/equipment/casing-cutter-1.avif" />
          <source type="image/webp" srcset="/images/equipment/casing-cutter-1.webp" />
          <img class="card-thumb" src="/images/equipment/casing-cutter-1.jpg" width="1264" height="1264" alt="Cortador de Revestimiento" loading="lazy" />
        </picture>
        <h3>Cortador de Revestimiento</h3>
        <p>Corte mecánico vs. químico, corrida y accionamiento, clasificaciones genéricas, fallas comunes, y en qué se diferencia de una fresa de sección.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/cement-retainer">
        <picture>
          <source type="image/avif" srcset="/images/equipment/cement-retainer-1.avif" />
          <source type="image/webp" srcset="/images/equipment/cement-retainer-1.webp" />
          <img class="card-thumb" src="/images/equipment/cement-retainer-1.jpg" width="1264" height="1264" alt="Retenedor de Cemento" loading="lazy" />
        </picture>
        <h3>Retenedor de Cemento</h3>
        <p>Cómo funciona la válvula de paso durante un trabajo de squeeze, perforable vs. recuperable, y en qué se diferencia de un tapón puente.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/crossover-sub">
        <picture>
          <source type="image/avif" srcset="/images/equipment/crossover-sub-1.avif" />
          <source type="image/webp" srcset="/images/equipment/crossover-sub-1.webp" />
          <img class="card-thumb" src="/images/equipment/crossover-sub-1.jpg" width="1264" height="1264" alt="Sub de Cruce" loading="lazy" />
        </picture>
        <h3>Sub de Cruce</h3>
        <p>Unir distintos tipos y diámetros de rosca en una sarta, el punto de falla del hombro cónico, y en qué se diferencia de un sub de barrena.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/float-sub">
        <picture>
          <source type="image/avif" srcset="/images/equipment/float-sub-1.avif" />
          <source type="image/webp" srcset="/images/equipment/float-sub-1.webp" />
          <img class="card-thumb" src="/images/equipment/float-sub-1.jpg" width="1264" height="1264" alt="Sub Flotador" loading="lazy" />
        </picture>
        <h3>Sub Flotador</h3>
        <p>Cómo su válvula de charnela o de bola y asiento detiene el contraflujo, y en qué se diferencia de una zapata o collar flotador.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/under-reamer">
        <picture>
          <source type="image/avif" srcset="/images/equipment/under-reamer-1.avif" />
          <source type="image/webp" srcset="/images/equipment/under-reamer-1.webp" />
          <img class="card-thumb" src="/images/equipment/under-reamer-1.jpg" width="1264" height="1264" alt="Escariador Bajo Restricción" loading="lazy" />
        </picture>
        <h3>Escariador Bajo Restricción</h3>
        <p>Brazos que se pliegan para pasar una restricción y se extienden para cortar más ancho, accionamiento hidráulico vs. mecánico, fallas comunes, y en qué se diferencia de un ensanchador de agujero.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/stabilizer">
        <picture>
          <source type="image/avif" srcset="/images/equipment/stabilizer-1.avif" />
          <source type="image/webp" srcset="/images/equipment/stabilizer-1.webp" />
          <img class="card-thumb" src="/images/equipment/stabilizer-1.jpg" width="1264" height="1264" alt="Estabilizador" loading="lazy" />
        </picture>
        <h3>Estabilizador</h3>
        <p>Ubicación de sarta vs. cerca de la barrena vs. rodillos-escariadores, aleta recta vs. espiral, fallas comunes, y en qué se diferencia de un escariador bajo restricción.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/reversing-tool">
        <picture>
          <source type="image/avif" srcset="/images/equipment/reversing-tool-1.avif" />
          <source type="image/webp" srcset="/images/equipment/reversing-tool-1.webp" />
          <img class="card-thumb" src="/images/equipment/reversing-tool-1.jpg" width="1264" height="1264" alt="Herramienta de Reversa" loading="lazy" />
        </picture>
        <h3>Herramienta de Reversa</h3>
        <p>Cómo la circulación inversa sube chatarra y escombros por la sarta, activación de puertos, fallas comunes, y en qué se diferencia de un sub flotador.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/hydraulic-jar">
        <picture>
          <source type="image/avif" srcset="/images/equipment/hydraulic-jar-1.avif" />
          <source type="image/webp" srcset="/images/equipment/hydraulic-jar-1.webp" />
          <img class="card-thumb" src="/images/equipment/hydraulic-jar-1.jpg" width="1264" height="1264" alt="Martillo Hidráulico" loading="lazy" />
        </picture>
        <h3>Martillo Hidráulico</h3>
        <p>Martillo ascendente vs. descendente, cómo un acelerador de martillo almacena energía extra, fallas comunes, y en qué se diferencia de una junta de seguridad.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/section-mill">
        <picture>
          <source type="image/avif" srcset="/images/equipment/section-mill-1.avif" />
          <source type="image/webp" srcset="/images/equipment/section-mill-1.webp" />
          <img class="card-thumb" src="/images/equipment/section-mill-1.jpg" width="1264" height="1264" alt="Fresa de Sección" loading="lazy" />
        </picture>
        <h3>Fresa de Sección</h3>
        <p>Fresas de un viaje vs. dos viajes, manejo de virutas, clasificaciones genéricas, fallas comunes, y en qué se diferencia de un cortador de revestimiento.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/window-mill">
        <picture>
          <source type="image/avif" srcset="/images/equipment/window-mill-1.avif" />
          <source type="image/webp" srcset="/images/equipment/window-mill-1.webp" />
          <img class="card-thumb" src="/images/equipment/window-mill-1.jpg" width="1264" height="1264" alt="Fresa de Ventana" loading="lazy" />
        </picture>
        <h3>Fresa de Ventana</h3>
        <p>La secuencia de fresa inicial/ventana/cónica, asentamiento y orientación del whipstock, fallas comunes, y en qué se diferencia de una fresa de sección.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/safety-joint">
        <picture>
          <source type="image/avif" srcset="/images/equipment/safety-joint-1.avif" />
          <source type="image/webp" srcset="/images/equipment/safety-joint-1.webp" />
          <img class="card-thumb" src="/images/equipment/safety-joint-1.jpg" width="1264" height="1264" alt="Junta de Seguridad" loading="lazy" />
        </picture>
        <h3>Junta de Seguridad</h3>
        <p>Diseños de liberación mecánica vs. hidráulica, dónde se ubica en una sarta de pesca o de liner, y fallas comunes.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/mwd-tool">
        <picture>
          <source type="image/avif" srcset="/images/equipment/mwd-tool-1.avif" />
          <source type="image/webp" srcset="/images/equipment/mwd-tool-1.webp" />
          <img class="card-thumb" src="/images/equipment/mwd-tool-1.jpg" width="1264" height="1264" alt="Herramienta MWD" loading="lazy" />
        </picture>
        <h3>Herramienta MWD</h3>
        <p>Telemetría de pulsos de lodo, MWD vs. LWD, dónde se ubica en el BHA, y fallas comunes.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/packer">
        <picture>
          <source type="image/avif" srcset="/images/equipment/packer-1.avif" />
          <source type="image/webp" srcset="/images/equipment/packer-1.webp" />
          <img class="card-thumb" src="/images/equipment/packer-1.jpg" width="1264" height="1264" alt="Empacador" loading="lazy" />
        </picture>
        <h3>Empacador</h3>
        <p>Permanente vs. recuperable, el receptáculo de orificio pulido, y en qué se diferencia de un tapón puente.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/whipstock">
        <picture>
          <source type="image/avif" srcset="/images/equipment/whipstock-1.avif" />
          <source type="image/webp" srcset="/images/equipment/whipstock-1.webp" />
          <img class="card-thumb" src="/images/equipment/whipstock-1.jpg" width="1264" height="1264" alt="Whipstock" loading="lazy" />
        </picture>
        <h3>Whipstock</h3>
        <p>Cómo su cara cóncava desvía una fresa de ventana hacia la pared del revestimiento, el pilot lug, y la orientación antes de fresar.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/liner-hanger">
        <picture>
          <source type="image/avif" srcset="/images/equipment/liner-hanger-1.avif" />
          <source type="image/webp" srcset="/images/equipment/liner-hanger-1.webp" />
          <img class="card-thumb" src="/images/equipment/liner-hanger-1.jpg" width="1264" height="1264" alt="Colgador de Liner" loading="lazy" />
        </picture>
        <h3>Colgador de Liner</h3>
        <p>Por qué se corre un liner en lugar de revestimiento completo, cómo los slips cargan su peso, y el empacador de tope del liner.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/sliding-sleeve">
        <picture>
          <source type="image/avif" srcset="/images/equipment/sliding-sleeve-1.avif" />
          <source type="image/webp" srcset="/images/equipment/sliding-sleeve-1.webp" />
          <img class="card-thumb" src="/images/equipment/sliding-sleeve-1.jpg" width="1024" height="1024" alt="Camisa Deslizante" loading="lazy" />
        </picture>
        <h3>Camisa Deslizante</h3>
        <p>Operación de la herramienta de desplazamiento, aislamiento zonal y usos de circulación, y fallas comunes.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/burr-mill">
        <picture>
          <source type="image/avif" srcset="/images/equipment/burr-mill-1.avif" />
          <source type="image/webp" srcset="/images/equipment/burr-mill-1.webp" />
          <img class="card-thumb" src="/images/equipment/burr-mill-1.jpg" width="1024" height="1024" alt="Fresa de Rebaba" loading="lazy" />
        </picture>
        <h3>Fresa de Rebaba</h3>
        <p>Dresa de bordes filosos tras un corte o fresado previo, y en qué se diferencia de una fresa de sección.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/nmdc-pony-nmdc">
        <picture>
          <source type="image/avif" srcset="/images/equipment/nmdc-pony-nmdc-1.avif" />
          <source type="image/webp" srcset="/images/equipment/nmdc-pony-nmdc-1.webp" />
          <img class="card-thumb" src="/images/equipment/nmdc-pony-nmdc-1.jpg" width="1024" height="1024" alt="NMDC / Pony NMDC" loading="lazy" />
        </picture>
        <h3>NMDC / Pony NMDC</h3>
        <p>Por qué las herramientas MWD necesitan espaciado no magnético, cómo se calcula, y qué pasa cuando está mal.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/lifting-sub">
        <picture>
          <source type="image/avif" srcset="/images/equipment/lifting-sub-1.avif" />
          <source type="image/webp" srcset="/images/equipment/lifting-sub-1.webp" />
          <img class="card-thumb" src="/images/equipment/lifting-sub-1.jpg" width="1024" height="1024" alt="Sub de Izaje" loading="lazy" />
        </picture>
        <h3>Sub de Izaje</h3>
        <p>Un accesorio de manejo, no una herramienta de fondo — en qué se diferencia de un sub de cruce.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/pup-joint">
        <picture>
          <source type="image/avif" srcset="/images/equipment/pup-joint-1.avif" />
          <source type="image/webp" srcset="/images/equipment/pup-joint-1.webp" />
          <img class="card-thumb" src="/images/equipment/pup-joint-1.jpg" width="1024" height="1024" alt="Junta Pup" loading="lazy" />
        </picture>
        <h3>Junta Pup</h3>
        <p>Espaciado preciso de sarta con la misma rosca y diámetro, y en qué se diferencia de un sub de cruce.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/positive-displacement-mud-motor">
        <picture>
          <source type="image/avif" srcset="/images/equipment/positive-displacement-mud-motor-1.avif" />
          <source type="image/webp" srcset="/images/equipment/positive-displacement-mud-motor-1.webp" />
          <img class="card-thumb" src="/images/equipment/positive-displacement-mud-motor-1.jpg" width="1024" height="1024" alt="Motor de Lodo de Desplazamiento Positivo" loading="lazy" />
        </picture>
        <h3>Motor de Lodo de Desplazamiento Positivo</h3>
        <p>Cómo el principio Moineau convierte flujo de fluido en rotación de barrena, deslizar vs. rotar.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/scssv">
        <picture>
          <source type="image/avif" srcset="/images/equipment/scssv-1.avif" />
          <source type="image/webp" srcset="/images/equipment/scssv-1.webp" />
          <img class="card-thumb" src="/images/equipment/scssv-1.jpg" width="1024" height="1024" alt="Válvula SCSSV" loading="lazy" />
        </picture>
        <h3>Válvula SCSSV</h3>
        <p>A prueba de fallas por diseño, requisitos regulatorios, y fallas comunes.</p>
        <span class="card-link">Leer Más →</span>
      </a>
      <a class="card" href="/es/equipment/gas-lift-mandrel">
        <picture>
          <source type="image/avif" srcset="/images/equipment/gas-lift-mandrel-1.avif" />
          <source type="image/webp" srcset="/images/equipment/gas-lift-mandrel-1.webp" />
