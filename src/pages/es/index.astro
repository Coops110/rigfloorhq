---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const faq = [
  {
    q: '¿Qué es RigFloorHQ?',
    a: 'Un sitio de referencia gratuito e independiente sobre el trabajo en el piso de perforación petrolera y de gas — carreras desde roustabout hasta toolpusher, las matemáticas de presión detrás del control de pozos, referencia de perforación y equipo, y soldadura de taladro. Sin publicidad ni contenido pagado, y no lo opera ningún contratista ni operadora. Ver la <a href="/es/about">página de quiénes somos</a> para saber quién lo escribe y revisa.',
  },
  {
    q: '¿Necesito experiencia para trabajar en un taladro petrolero?',
    a: 'No. El ayudante de patio (roustabout) es el punto de entrada estándar, y la mayoría de los operadores capacitan en el trabajo en lugar de exigir experiencia previa — lo que sí buscan es buena condición física, un historial limpio de drogas y alcohol, y la disposición a trabajar turnos de 12 horas en condiciones duras. Ver <a href="/es/careers/roustabout">cómo convertirte en roustabout</a> para el proceso real de contratación.',
  },
  {
    q: '¿Las calculadoras y el quiz son realmente gratis?',
    a: 'Sí, sin registro, sin muro de pago, sin pedir tu correo. Las <a href="/es/calculators">calculadoras</a> usan las mismas fórmulas enseñadas en la certificación de control de pozos IWCF/IADC, y el <a href="/es/well-control-quiz">quiz de 200 preguntas</a> cubre el mismo terreno para practicar. Ambos existen para que una persona en el campo pueda verificar números reales sin buscar en un libro de texto.',
  },
  {
    q: '¿Esto es certificación o capacitación oficial?',
    a: 'No. Este es material de referencia y de práctica, no un curso acreditado de IWCF o IADC, y completar algo en este sitio no otorga ninguna certificación. La certificación real se obtiene a través de un proveedor de capacitación acreditado — este sitio existe para ayudarte a entender el material antes de esa capacitación y repasarlo después.',
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://rigfloorhq.com/es#website",
  "name": "RigFloorHQ",
  "url": "https://rigfloorhq.com/es",
  "description": "La referencia completa del campo petrolero y de gas para perforación, soldadura, control de pozos y carreras profesionales.",
  "inLanguage": "es",
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};
---
<BaseLayout
  title="RigFloorHQ — La Referencia Completa del Campo Petrolero"
  description="Todo sobre trabajar en un taladro petrolero: trayectorias desde roustabout hasta toolpusher, calculadoras de presión de perforación."
  jsonLd={jsonLd}
  lang="es"
  alternateHref="/"
>
  <Nav slot="nav" lang="es" alternateHref="/" />
  <Footer slot="footer" lang="es" />

  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>

    <div class="hero-eyebrow">⚙ Referencia de Campo — Perforación · Soldadura · Control de Pozos · Carreras</div>
    <h1>Todo <br>Sobre el <span>Taladro.</span></h1>
    <p class="hero-sub">Desde tu primer día como ayudante de patio (roustabout) hasta manejar tu propia hoja de control de pozo — la referencia técnica y profesional completa para operaciones petroleras y de gas.</p>

    <div class="hero-stats">
      <div class="stat"><span class="stat-num">1,900+</span><span class="stat-label">Taladros activos en el mundo</span></div>
      <div class="stat"><span class="stat-num">$50K</span><span class="stat-label">Salario inicial / año (USD)</span></div>
      <div class="stat"><span class="stat-num">0.052</span><span class="stat-label">Constante hidrostática</span></div>
      <div class="stat"><span class="stat-num">10–15</span><span class="stat-label">Años a Toolpusher</span></div>
    </div>

    <div class="hero-cta">
      <a href="/es/careers" class="btn btn-primary">Cómo Conseguir Trabajo</a>
      <a href="/es/calculators" class="btn btn-outline">Abrir Calculadoras</a>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Empieza Aquí</div>
    <h2 class="section-title">Elige Tu <span>Camino</span></h2>
    <div class="card-grid">
      <div class="card">
        <span class="card-icon">🪜</span>
        <h3>Nuevo en la Industria</h3>
        <p>No se necesita experiencia. Aprende los roles, la jerarquía y exactamente lo que se necesita para conseguir tu primer trabajo como roustabout.</p>
        <a href="/es/careers" class="card-link">Cómo Empezar en el Piso de Perforación →</a>
      </div>
      <div class="card">
        <span class="card-icon">🧮</span>
        <h3>Trabajador Activo del Taladro</h3>
        <p>Realiza cálculos reales de presión hidrostática, peso de lodo y hoja de control de pozo. Fórmulas explicadas como te las explicaría un perforador.</p>
        <a href="/es/calculators" class="card-link">Abrir Calculadoras →</a>
      </div>
      <div class="card">
        <span class="card-icon">🎓</span>
        <h3>Ingeniero o Supervisor</h3>
        <p>Referencia técnica profunda sobre predicción de presión de poro, ECD, diseño de revestimiento y teoría de control de pozos.</p>
        <a href="/es/drilling" class="card-link">Referencia de Perforación →</a>
      </div>
      <div class="card">
        <span class="card-icon">🔥</span>
        <h3>Soldador / Oficios</h3>
        <p>Todos los procesos de soldadura usados en un taladro, las certificaciones que importan, y la trayectoria profesional de soldador junior a CWI.</p>
        <a href="/es/welding" class="card-link">Guía de Soldadura de Taladro →</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">FAQ</div>
    <h2 class="section-title">Antes de <span>Empezar</span></h2>
    <div class="accordion" style="max-width:820px;">
      {faq.map((item) => (
        <details class="acc-item">
          <summary class="acc-header">{item.q}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body"><p set:html={item.a} /></div>
        </details>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Explora</div>
    <h2 class="section-title">Biblioteca de <span>Referencia</span></h2>
    <div class="related-links">
      <a href="/es/careers" class="related-link"><div class="rl-label">Carreras</div><div class="rl-title">Roles y Jerarquía</div></a>
      <a href="/es/equipment" class="related-link"><div class="rl-label">Equipo</div><div class="rl-title">Equipo del Taladro</div></a>
      <a href="/es/drilling" class="related-link"><div class="rl-label">Perforación</div><div class="rl-title">Cómo Funciona la Perforación</div></a>
      <a href="/es/calculators" class="related-link"><div class="rl-label">Herramientas</div><div class="rl-title">Calculadoras de Perforación</div></a>
      <a href="/es/welding" class="related-link"><div class="rl-label">Soldadura</div><div class="rl-title">Soldadura de Taladro</div></a>
      <a href="/es/safety" class="related-link"><div class="rl-label">Seguridad</div><div class="rl-title">Seguridad y EPP</div></a>
      <a href="/es/blog" class="related-link"><div class="rl-label">Blog</div><div class="rl-title">Notas de Campo</div></a>
      <a href="/es/glossary" class="related-link"><div class="rl-label">Referencia</div><div class="rl-title">Glosario Completo</div></a>
    </div>
  </section>
</BaseLayout>
