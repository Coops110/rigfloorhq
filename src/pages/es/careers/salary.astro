---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { techArticleSchema, gitDates } from '../../../lib/techarticle.js';

const techArticleJsonLd = techArticleSchema({
  sourcePath: 'src/pages/es/careers/salary.astro',
  path: '/es/careers/salary',
  headline: 'Guía Salarial de Taladros Petroleros 2026 — Cada Rol',
  description: 'Datos salariales reales de 2026 para cada posición en taladros petroleros: roustabout, roughneck, encuellador, perforador, toolpusher, soldador.',
  lang: 'es',
});

const faq = [
  {
    q: '¿Cuál es el trabajo mejor pagado en un taladro petrolero?',
    a: 'Company man, con $150,000 a más de $300,000 al año — es el representante del propio operador en el sitio y tiene la autoridad final sobre el programa del pozo. OIM/gerente de taladro ($150,000–$280,000+) y toolpusher ($90,000–$180,000) son los roles mejor pagados dentro del contratista de perforación, ya que ambos cargan con la responsabilidad operativa de todo el taladro en lugar de una sola cuadrilla.',
  },
  {
    q: '¿Se necesita experiencia para empezar a trabajar en un taladro petrolero?',
    a: 'No. Roustabout es el punto de entrada estándar y no requiere experiencia previa en taladros — solo condición física y disposición para aprender. Paga lo menos en el taladro ($38,000–$60,000) precisamente porque no exige certificación ni una habilidad especializada todavía.',
  },
  {
    q: '¿Cuánto más paga costa afuera que en tierra?',
    a: 'Alrededor de 30–40% más por el mismo rol, más alojamiento y comida gratis durante el turno y una rotación libre extendida (comúnmente 14/14 o 28/28) — ver la comparación costa afuera vs. tierra arriba para el ejemplo completo de roughneck.',
  },
  {
    q: '¿El pago de un taladro petrolero es igual a la tarifa por hora anunciada en una oferta de empleo?',
    a: 'No directamente. La mayoría de las ofertas anuncian una tarifa por hora contra un turno de 12 horas, y el total anual real depende del horario de rotación (un patrón 14/14 y uno 21/21 con la misma tarifa por hora producen totales anuales muy distintos). Algunos roles también cargan un per diem separado sobre el salario. Siempre compara totales anualizados, nunca solo tarifas por hora.',
  },
  {
    q: '¿Por qué dos personas en el mismo puesto ganan diferente?',
    a: 'La región y la actividad de la cuenca, el trabajo por contrato de tarifa diaria frente al empleo de planta con beneficios, y en qué punto del ciclo de materias primas se está, mueven la cifra más que el título del puesto — ver Leyendo las Cifras abajo para el desglose completo.',
  },
];

const lastUpdated = gitDates('src/pages/es/careers/salary.astro').dateModified;
const lastUpdatedLabel = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---
<BaseLayout
  title="Guía Salarial de Taladros Petroleros 2026 — Cada Rol"
  description="Datos salariales reales de 2026 para cada posición en taladros petroleros: roustabout, roughneck, encuellador, perforador, toolpusher, soldador."
  extraJsonLd={[techArticleJsonLd]}
  breadcrumbs={[{ label: 'Carreras', href: '/es/careers' }, { label: 'Guía Salarial', href: '/es/careers/salary' }]}
  lang="es"
  alternateHref="/careers/salary"
>
  <Nav slot="nav" lang="es" alternateHref="/careers/salary" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Carreras — Compensación</div>
    <h1>Guía Salarial de <span>Taladros Petroleros</span></h1>
    <p class="page-hero-sub">Cuánto paga realmente cada posición en 2026, y por qué costa afuera consistentemente paga más que el rol equivalente en tierra.</p>
    {lastUpdatedLabel && <p style="color:var(--fog);font-size:13px;margin-top:8px;">Actualizado el {lastUpdatedLabel}</p>}
  </div>

  <section class="block">
    <div class="note-box" style="max-width:800px;">
      <strong>Respuesta corta:</strong> La paga en taladros petroleros va de unos $38,000 al año para un roustabout inicial a más de $300,000 para un company man; la mayoría de manos experimentadas gana entre $70,000 y $120,000. Costa afuera paga 30–40% más que en tierra, y el BLS confirma que los toolpushers ganan $124,100 al año.
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Por Posición</div>
    <h2 class="section-title">Rangos Salariales <span>2026</span></h2>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Posición</th><th>Inicial / Bajo</th><th>Típico</th><th>Senior / Alto</th><th>Notas</th></tr>
        </thead>
        <tbody>
          <tr><td>Roustabout</td><td>$38,000</td><td>$50,000</td><td>$60,000</td><td>No se requiere experiencia. Ver <a href="/es/careers/roustabout" style="color:var(--amber);">guía de roustabout</a></td></tr>
          <tr><td>Roughneck / Floorhand</td><td>$45,000</td><td>$70,000</td><td>$82,000+</td><td>Típicamente 1–3 años de experiencia. Ver <a href="/es/careers/roughneck" style="color:var(--amber);">guía de roughneck</a></td></tr>
          <tr><td>Encuellador (Derrickhand)</td><td>$55,000</td><td>$75,000</td><td>$90,000</td><td>Trabaja en altura, responsabilidad del sistema de lodo</td></tr>
          <tr><td>Asistente de Perforador</td><td>$60,000</td><td>$78,000</td><td>$95,000</td><td>Se requiere IWCF Nivel 2</td></tr>
          <tr><td>Perforador</td><td>$70,000</td><td>$95,000</td><td>$120,000</td><td>Se requiere IWCF Nivel 3 / Perforador</td></tr>
          <tr><td>Toolpusher</td><td>$90,000</td><td>$130,000</td><td>$180,000</td><td>Administra toda la operación del taladro</td></tr>
          <tr><td>OIM / Gerente de Taladro</td><td>$150,000</td><td>$210,000</td><td>$280,000+</td><td>Rol operativo más alto en la instalación</td></tr>
          <tr><td>Ingeniero de Lodo</td><td>$80,000</td><td>$105,000</td><td>$140,000</td><td>Empleado por compañía de servicio</td></tr>
          <tr><td>Perforador Direccional</td><td>$100,000</td><td>$150,000</td><td>$200,000+</td><td>Especialización MWD/LWD</td></tr>
          <tr><td>Geólogo de Sitio de Pozo</td><td>$80,000</td><td>$115,000</td><td>$160,000</td><td>Se requiere título en geología</td></tr>
          <tr><td>Oficial de HSE / Seguridad</td><td>$65,000</td><td>$85,000</td><td>$110,000</td><td>NEBOSH u OSHA 30</td></tr>
          <tr><td>Soldador de Taladro (Junior)</td><td>$45,000</td><td>$55,000</td><td>$65,000</td><td>Ver <a href="/es/welding" style="color:var(--amber);">guía completa de soldadura</a></td></tr>
          <tr><td>Soldador de Taladro (Senior)</td><td>$90,000</td><td>$110,000</td><td>$130,000</td><td>Soldadura de tubería en todas las posiciones</td></tr>
          <tr><td>Soldador Submarino</td><td>$60,000</td><td>$100,000</td><td>$150,000+</td><td>Más pago por profundidad/saturación</td></tr>
          <tr><td>Company Man</td><td>$150,000</td><td>$220,000</td><td>$300,000+</td><td>Representante del operador</td></tr>
        </tbody>
      </table>
    </div>

    <div class="note-box">
      <strong>Nota sobre las cifras:</strong> Esta tabla es una estimación editorial propia de RigFloorHQ, compilada de ofertas de empleo, listados de reclutadores, y discusión salarial de la industria durante 2025-2026, no una sola encuesta con nombre. No tiene una fuente independiente, a diferencia de la tabla gubernamental de abajo, que existe exactamente para eso: úsala como la verificación cruzada real y citable frente a esta. El pago real varía significativamente según la región, el empleador, el tipo de taladro, y las condiciones del mercado. Las tarifas en el Golfo de México, Mar del Norte, y Medio Oriente tienden a estar en el extremo más alto; las tarifas de taladros terrestres en cuencas más lentas son más bajas.
    </div>
  </section>

  <section class="block" id="bls-wage-data">
    <div class="section-eyebrow">Datos Gubernamentales</div>
    <h2 class="section-title">Salarios Oficiales de BLS, <span>por Rol y Estado</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">La tabla anterior es una estimación compilada de la industria. Como verificación cruzada independiente, esto es lo que reporta la propia encuesta de Estadísticas de Empleo y Salarios Ocupacionales (OEWS) de la Oficina de Estadísticas Laborales de EE. UU. (BLS) para los roles principales de extracción de petróleo y gas — datos salariales reales del gobierno, no un agregado de terceros.</p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Ocupación BLS</th><th>Salario Medio Anual Nacional</th><th>Rol Más Cercano en Esta Página</th></tr>
        </thead>
        <tbody>
          <tr><td>Roustabouts</td><td>$49,040</td><td>Roustabout</td></tr>
          <tr><td>Operadores de Perforación Rotaria</td><td>$73,780</td><td>Perforador</td></tr>
          <tr><td>Operadores de Torre (Derrick)</td><td>$74,890</td><td>Encuellador</td></tr>
          <tr><td>Operadores de Unidad de Servicio</td><td>$72,740</td><td>Asistente de Perforador</td></tr>
          <tr><td>Bombeadores de Cabezal de Pozo</td><td>$74,000</td><td>Operador de campo/producción</td></tr>
          <tr><td>Ingenieros Petroleros</td><td>$169,280</td><td>Perforador Direccional / roles de ingeniería</td></tr>
          <tr><td>Supervisores de Primera Línea de Oficios de Construcción y Trabajadores de Extracción</td><td>$124,100</td><td>Toolpusher</td></tr>
          <tr><td>Gerentes Generales y de Operaciones</td><td>$194,910</td><td>OIM / Gerente de Taladro</td></tr>
        </tbody>
      </table>
    </div>
    <p style="color:var(--fog);font-size:13px;max-width:760px;margin-top:10px;">Fuente: <a href="https://www.bls.gov/opub/mlr/2026/article/occupational-employment-and-wages-in-oil-and-gas-industries-may-2024.htm" style="color:var(--amber);">Estadísticas de Empleo y Salarios Ocupacionales de BLS, mayo de 2024, Monthly Labor Review</a>. La industria de extracción de petróleo y gas en su conjunto tuvo un salario medio anual de $114,750 en todas las ocupaciones en esta encuesta, el segmento de mayor pago de la propia industria petrolera y de gas más amplia según el BLS.</p>

    <h3 style="font-family:var(--cond);font-weight:700;font-size:18px;text-transform:uppercase;color:var(--white);letter-spacing:0.04em;margin:28px 0 14px;">Dónde Paga Más: Operadores de Torre por Estado</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Estado</th><th>Salario Medio Anual</th></tr>
        </thead>
        <tbody>
          <tr><td>Alaska</td><td>$76,070</td></tr>
          <tr><td>Pensilvania</td><td>$75,280</td></tr>
          <tr><td>Dakota del Norte</td><td>$67,850</td></tr>
          <tr><td>Wyoming</td><td>$61,510</td></tr>
          <tr><td>Virginia Occidental</td><td>$60,430</td></tr>
        </tbody>
      </table>
    </div>
    <p style="color:var(--fog);font-size:13px;max-width:760px;margin-top:10px;">Fuente: <a href="https://www.bls.gov/oes/2023/may/oes475011.htm" style="color:var(--amber);">BLS OEWS, mayo de 2023</a>, el último año en que el BLS publicó el desglose estatal de esta ocupación en su formato de resumen individual. Las publicaciones estatales más recientes del BLS (hasta mayo de 2025) existen solo como hojas de cálculo completas que no hemos verificado línea por línea contra esta tabla, así que este sigue siendo el desglose estatal más reciente que podemos verificar y citar directamente. Son promedios estatales en todos los empleadores del estado, así que un operador o taladro específico será diferente; esto es una muestra de la dispersión real detrás del promedio nacional de $58,330, no un piso y techo literal (otros estados caen tanto arriba como abajo de este rango). Los estados con más taladros activos no son los mismos que pagan más: Texas ($57,400) y Oklahoma ($55,310) quedan por debajo de cada estado en la tabla de arriba a pesar de tener muchos más taladros activos, ya que sus totales incluyen una mezcla mucho mayor de operaciones pequeñas de baja actividad junto a sus cuencas de mayor intensidad.</p>
  </section>

  <section class="block" id="offshore-vs-onshore">
    <div class="section-eyebrow">Comparación</div>
    <h2 class="section-title">Costa Afuera vs. <span>Tierra</span></h2>

    <div class="two-col">
      <div class="prose">
        <p>Los roles costa afuera pagan <strong>30–40% más</strong> que la posición equivalente en tierra. La prima compensa varias compensaciones reales:</p>
        <ul>
          <li><strong>Aislamiento:</strong> Vives en la instalación durante toda la rotación, lejos de la familia y la vida normal.</li>
          <li><strong>Horario de rotación:</strong> Los patrones comunes son 14 días trabajando / 14 libres, o 28/28 para aguas profundas. Trabajas períodos largos, luego tienes tiempo libre extendido — una verdadera compensación de estilo de vida, no solo una diferencia salarial.</li>
          <li><strong>Perfil de riesgo:</strong> El transporte en helicóptero, condiciones marinas, y entornos de trabajo en espacios confinados conllevan riesgos diferentes a las operaciones terrestres.</li>
          <li><strong>Condiciones físicas:</strong> No puedes salir del sitio durante tu turno. Clima, estado del mar, y alojamiento confinado durante semanas seguidas.</li>
        </ul>
        <p>A cambio, los trabajadores costa afuera típicamente reciben alojamiento y comida gratis durante el turno (lo que significa que la mayor parte de tu salario es ingreso disponible), más el tiempo libre extendido que proporciona una rotación 14/14 o 28/28 — efectivamente 26 semanas del año libres en un horario 28/28.</p>
      </div>

      <div>
        <h3 style="font-family:var(--cond);font-weight:700;font-size:18px;text-transform:uppercase;color:var(--white);letter-spacing:0.04em;margin-bottom:16px;">Ejemplo: Comparación de Salario de Roughneck</h3>
        <div style="display:flex;flex-direction:column;gap:1px;background:var(--iron);border:1px solid var(--iron);">
          <div style="background:var(--steel);padding:18px 20px;display:flex;justify-content:space-between;">
            <span style="font-size:13px;color:var(--fog);">Roughneck en Tierra</span>
            <span class="mono" style="font-family:var(--mono);color:var(--white);">$70,000/año</span>
          </div>
          <div style="background:var(--steel);padding:18px 20px;display:flex;justify-content:space-between;">
            <span style="font-size:13px;color:var(--fog);">Roughneck Costa Afuera</span>
            <span style="font-family:var(--mono);color:var(--amber);">$91,000–$98,000/año</span>
          </div>
          <div style="background:var(--iron);padding:18px 20px;display:flex;justify-content:space-between;">
            <span style="font-size:13px;color:var(--mist);font-weight:600;">Prima</span>
            <span style="font-family:var(--mono);color:var(--safe);">+30–40%</span>
          </div>
        </div>

        <div class="note-box" style="margin-top:24px;">
          <strong>¿Cuál es la mejor opción para ti?</strong> Si tienes obligaciones familiares en casa y prefieres una rutina diaria, el trabajo en tierra con horarios locales predecibles puede convenirte mejor. Si puedes manejar tiempo extendido lejos y quieres maximizar ahorros, el salario más alto de costa afuera más los bloques extendidos de tiempo libre es difícil de superar financieramente.
        </div>

        <p style="color:var(--fog);font-size:13px;max-width:420px;margin-top:16px;"><strong>Nota sobre esta cifra:</strong> la prima costa afuera del 30-40% es una estimación editorial propia de RigFloorHQ, compilada de ofertas de empleo y discusión salarial de la industria. No proviene de una sola encuesta gubernamental o industrial con nombre; el BLS no desglosa el pago costa afuera frente a tierra por separado para estas ocupaciones.</p>
      </div>
    </div>
  </section>

  <section class="block" id="hourly-per-diem">
    <div class="section-eyebrow">Estructura de Pago</div>
    <h2 class="section-title">Tarifas por Hora <span>y Per Diem</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">La mayoría de las cifras arriba son totales anuales, pero el pago del taladro en realidad se construye sobre una tarifa por hora contra un turno de 12 horas, más — para algunos roles — una asignación diaria separada. Convertir el pago anual a una cifra por hora usando un año estándar equivalente a tiempo completo de 2,080 horas da una base aproximada y comparable, pero no es la tarifa de contrato real: los turnos y rotaciones reales corren más o menos horas que esa base, que es exactamente por qué el total anual, no la cifra por hora sola, es lo que realmente llega al banco.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Posición</th><th>Típico Anual</th><th>≈ Por Hora (÷2,080 hrs)</th></tr></thead>
        <tbody>
          <tr><td>Roustabout</td><td>$50,000</td><td>≈ $24/hr</td></tr>
          <tr><td>Roughneck / Floorhand</td><td>$70,000</td><td>≈ $34/hr</td></tr>
          <tr><td>Encuellador</td><td>$75,000</td><td>≈ $36/hr</td></tr>
          <tr><td>Perforador</td><td>$95,000</td><td>≈ $46/hr</td></tr>
        </tbody>
      </table>
    </div>
    <p style="color:var(--fog);max-width:760px;margin-top:16px;">Muchos contratistas terrestres también pagan un <strong>per diem</strong> — una asignación diaria fija, típicamente en el rango de $75–$150, que cubre comida y alojamiento mientras se está lejos de casa — además del salario, separado de la tarifa por hora y usualmente no gravable. Los roles costa afuera generalmente no llevan per diem, porque el alojamiento y comida en la instalación ya se proporciona gratis durante todo el turno, lo cual es parte de por qué la prima de pago costa afuera arriba subestima la brecha real en ingreso disponible.</p>
  </section>

  <section class="block">
    <div class="section-eyebrow">Leyendo las Cifras</div>
    <h2 class="section-title">Por Qué Dos Trabajadores en el Mismo Rol <span>Ganan Diferente</span></h2>
    <p style="color:var(--fog);max-width:740px;margin-bottom:24px;">Los rangos publicados ocultan la mayor parte de lo que determina un recibo de pago real. Cuatro factores mueven la cifra más que el título del puesto.</p>

    <div class="card-grid grid-2">
      <div class="card">
        <h3>Horas, no tarifa</h3>
        <p>La mayoría del pago en el taladro es por hora contra un turno de 12 horas, así que el ingreso bruto sigue los días trabajados tanto como la tarifa. Una rotación 14/14 y una rotación 21/21 con tarifas por hora idénticas producen totales anuales muy distintos. Compara cifras anualizadas, nunca solo tarifas por hora.</p>
      </div>
      <div class="card">
        <h3>Tarifa diaria vs. planta</h3>
        <p>Las manos de contrato y agencia a menudo muestran una tarifa anunciada más alta que tiene que cubrir el tiempo sin pago entre turnos, el seguro y la pensión. Una tarifa de planta más baja con licencia pagada y beneficios puede valer más a lo largo de un año. No son cifras comparables tal como se publican.</p>
      </div>
      <div class="card">
        <h3>Región y cuenca</h3>
        <p>Las tarifas siguen la actividad local y el costo de vida, y se mueven con el conteo de taladros activos. El mismo rol en una cuenca activa durante un auge y en una tranquila durante una caída puede diferir por un margen amplio — por eso cualquier rango publicado es una fotografía, no una tarifa fija.</p>
      </div>
      <div class="card">
        <h3>Ciclo de materias primas</h3>
        <p>Esta industria es cíclica, y el pago sigue a la actividad de perforación con un retraso. Los rangos compilados durante un alza sobreestiman lo que está disponible en una caída. Trata cada cifra de esta página, y de cualquier otra, como específica de su periodo.</p>
      </div>
    </div>

    <div class="note-box mt-24" style="max-width:800px;">
      <strong>Lo que realmente sube tu tarifa.</strong> Las certificaciones que ya tienes antes de que se exijan, un historial de seguridad limpio, y continuidad con un solo contratista. Saltar de taladro en taladro por un pequeño aumento de tarifa reinicia repetidamente la confianza que impulsa la promoción — la compensación se cubre en <a href="/es/blog/roustabout-to-driller-timeline" style="color:var(--amber);">de roustabout a perforador</a>. Qué certificaciones se pagan solas está en la <a href="/es/careers/certifications" style="color:var(--amber);">página de certificaciones</a>, y cómo encajan los saltos de salario de perforador a toolpusher y a OIM en la escalera de supervisión está en la <a href="/es/pillars/rig-floor-leadership" style="color:var(--amber);">guía de liderazgo en el piso de perforación</a>.
    </div>

    <p style="color:var(--fog);font-size:13px;max-width:800px;margin-top:20px;">Estas cifras son rangos indicativos compilados con fines orientativos, no ofertas, cotizaciones ni una guía de lo que paga cualquier empleador específico. Verifica contra las ofertas de empleo actuales y tu propio contrato antes de tomar una decisión financiera.</p>
  </section>

  <section class="block">
    <div class="section-eyebrow">FAQ</div>
    <h2 class="section-title">Preguntas <span>Frecuentes</span></h2>
    <div class="accordion">
      {faq.map((item) => (
        <details class="acc-item">
          <summary class="acc-header">{item.q}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
