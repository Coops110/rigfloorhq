// Article for this career guide. Dates come from git via the same map the
// sitemap uses, so dateModified always equals this URL's sitemap lastmod;
// author and publisher are the Organization @id (see src/lib/techarticle.js).
const jsonLd = articleSchema({
  sourcePath: 'src/pages/es/careers/roustabout.astro',
  path: '/es/careers/roustabout',
  headline: "Cómo Convertirte en Roustabout: Guía de Inicio",
  description: "Guía paso a paso para convertirte en roustabout de taladro petrolero con cero experiencia: requisitos, salario, y cómo conseguir que te contraten.",
