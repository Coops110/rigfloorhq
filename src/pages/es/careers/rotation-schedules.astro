---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { articleSchema } from '../../../lib/techarticle.js';

const jsonLd = articleSchema({
  sourcePath: 'src/pages/es/careers/rotation-schedules.astro',
  path: '/es/careers/rotation-schedules',
  headline: "Horarios de Rotación en Taladros Explicados: 14/14, 21/21, 28/28",
  description: "Qué significan realmente hitch y rotación, los patrones comunes costa afuera y en tierra, y una calculadora para convertir una rotación y tarifa por hora en pago anual real y días libres.",
  lang: 'es',
  extra: { mainEntityOfPage: { "@id": "https://rigfloorhq.com/es/careers/rotation-schedules#webpage" } },
});

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://rigfloorhq.com/es/careers/rotation-schedules#webpage",
  "url": "https://rigfloorhq.com/es/careers/rotation-schedules",
  "name": "Horarios de Rotación en Taladros Explicados: 14/14, 21/21, 28/28",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/es#website" },
  "mainEntity": { "@id": "https://rigfloorhq.com/es/careers/rotation-schedules#article" },
};

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/es/careers/rotation-schedules#app",
  "name": "Calculadora de Pago y Días de Rotación",
  "url": "https://rigfloorhq.com/es/careers/rotation-schedules",
  "description": "Convierte un horario de rotación, tarifa por hora y viático en días trabajados al año, días libres y pago total.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Calculadora de planificación de carrera",
  "operatingSystem": "Cualquiera (navegador web)",
  "browserRequirements": "Requiere JavaScript",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const faq = [
  {
    q: "¿Qué significa realmente una rotación '14/14'?",
    a: "14 días en el sitio trabajando, seguidos de 14 días libres en casa — los dos números siempre son días en, luego días fuera, no horas ni semanas. Un 'hitch' es un período de trabajo; algunas empresas cuentan el día de viaje como parte del hitch, otras no, así que confirma qué convención usa un contratista específico antes de comparar ofertas.",
  },
  {
    q: "¿Por qué las rotaciones costa afuera son más largas que las de tierra?",
    a: "Las cuadrillas costa afuera no pueden simplemente manejar a casa al final de un turno — llegar y salir de una instalación significa un vuelo o un barco, así que el período de trabajo se extiende más para que ese costo y disrupción de viaje valgan la pena, compensado por un bloque igualmente más largo de tiempo libre. Los taladros en tierra cerca de la base de una cuadrilla pueden correr rotaciones más cortas, o incluso un traslado diario, porque no hay barrera de viaje que amortizar.",
  },
  {
    q: "¿Una rotación más larga significa más pago total?",
    a: "No por sí sola. El pago anual es la tarifa por hora multiplicada por las horas realmente trabajadas, y cada patrón de rotación estándar trabaja la misma fracción del año: mitad trabajando, mitad libre, tanto en 28/28 como en 14/14 — así que a la misma tarifa por hora, los totales anuales terminan siendo prácticamente iguales. Lo que realmente compra una rotación más larga es bloques ininterrumpidos más grandes de tiempo libre, no más dinero, por lo cual la comparación real es el ajuste de estilo de vida, no el pago.",
  },
  {
    q: "¿El viático está incluido en el pago costa afuera?",
    a: "Usualmente no como una línea separada, porque la comida y el alojamiento en la instalación son gratuitos durante el hitch — la prima de aislamiento que los trabajadores en tierra reciben vía viático está en cambio incorporada en una tarifa por hora o por día costa afuera más alta. Las cuadrillas en tierra que trabajan lejos de su base suelen ver un viático diario independiente sobre el salario, comúnmente en el rango de $75-150/día, ya que cubren su propia comida y alojamiento durante el hitch.",
  },
  {
    q: "¿Qué significa una rotación '2/2' o '2/3' del Mar del Norte en el Reino Unido?",
    a: "La misma notación de días en, días fuera que en el resto del mundo, solo con bloques más cortos: 2 semanas costa afuera seguidas de 2 semanas en casa (2/2), o 2 semanas en seguidas de 3 semanas fuera (2/3). Los turnos de dos semanas son el patrón estándar del Mar del Norte del Reino Unido, en contraste con los bloques de 21/21 y 28/28 más comunes en instalaciones de aguas profundas más alejadas de una base. El turno más corto del Mar del Norte refleja un vuelo de helicóptero comparativamente corto hasta una base en tierra del Reino Unido o Noruega, en lugar del viaje de varios días que implica un destino remoto de aguas profundas.",
  },
];
---
<BaseLayout
  title="Horarios de Rotación en Taladros: 14/14, 21/21, 28/28"
  description="Qué significan hitch y rotación, los patrones comunes costa afuera y en tierra, y una calculadora que convierte rotación y tarifa por hora en pago anual real."
  extraJsonLd={[webPageLd, webAppLd]}
  jsonLd={jsonLd}
  breadcrumbs={[{ label: 'Carreras', href: '/es/careers' }, { label: 'Horarios de Rotación', href: '/es/careers/rotation-schedules' }]}
  lang="es"
  alternateHref="/careers/rotation-schedules"
>
  <Nav slot="nav" lang="es" alternateHref="/careers/rotation-schedules" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Carreras</div>
    <h1>Horarios de <span>Rotación</span></h1>
    <p class="page-hero-sub">14/14, 21/21, 28/28 — los dos números significan días en, luego días fuera. Qué cuesta y qué da realmente cada patrón, y una calculadora para convertir un horario y una tarifa en números anuales reales.</p>
    <div class="page-meta">
      <span class="page-meta-item">Patrones comunes: <strong>14/14, 21/21, 28/28</strong></span>
      <span class="page-meta-item">Turno estándar: <strong>12 horas</strong></span>
    </div>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🎯 Calculadora de Pago y Días de Rotación</div>
          <div class="input-row">
            <div class="input-group">
              <label for="days-on">Días En</label>
              <input type="number" id="days-on" value="14">
            </div>
            <div class="input-group">
              <label for="days-off">Días Fuera</label>
              <input type="number" id="days-off" value="14">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="hourly-rate">Tarifa por Hora ($)</label>
              <input type="number" id="hourly-rate" value="28" step="0.5">
            </div>
            <div class="input-group">
              <label for="per-diem">Viático ($/día, 0 si alojamiento es gratis)</label>
              <input type="number" id="per-diem" value="0" step="5">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line"><span class="output-label">Ciclo de Rotación</span><span class="output-value" id="out-cycle">—</span></div>
            <div class="output-line"><span class="output-label">Días Trabajados al Año</span><span class="output-value" id="out-days-worked">—</span></div>
            <div class="output-line"><span class="output-label">Días Libres al Año</span><span class="output-value" id="out-days-off">—</span></div>
            <div class="output-line"><span class="output-label">Horas Trabajadas al Año</span><span class="output-value" id="out-hours">—</span></div>
            <div class="output-line"><span class="output-label">Pago Base</span><span class="output-value" id="out-base">—</span></div>
            <div class="output-line"><span class="output-label">Viático Total</span><span class="output-value" id="out-perdiem">—</span></div>
            <div class="output-line headline"><span class="output-label">Pago Anual Total</span><span class="output-value" id="out-total">—</span></div>
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">Tarifa Equivalente FTE</span><span class="output-value" id="out-fte">—</span></div>
          </div>
        </div>
        <div class="note-box mt-24">
          <strong>Por qué "equivalente FTE" y no solo la tarifa por hora.</strong> Un año laboral estándar de 2,080 horas (40 hrs/semana × 52 semanas) es la base usada en toda la <a href="/es/careers/salary">guía de salarios</a> para convertir el pago anual en una cifra por hora comparable — no es la tarifa real del contrato, que corre contra el turno de 12 horas en cambio.
        </div>
      </div>

      <div class="prose">
        <h2 id="que-significan-los-numeros">Qué Significan Realmente los Números</h2>
        <p>Un horario de rotación se escribe con dos números: días en, luego días fuera. 14/14 significa 14 días en el sitio trabajando, luego 14 días en casa. El período de trabajo se llama "hitch" — algunas empresas cuentan el día de viaje hacia y desde el sitio como parte del hitch, otras no, lo cual vale la pena confirmar antes de comparar dos ofertas que se ven idénticas en papel. Cada día trabajado durante un hitch suele ser un turno completo de 12 horas, no un turno estándar de 8 horas, que es la base que usan tanto esta calculadora como la <a href="/es/careers/salary">guía de salarios</a>.</p>

        <h2 id="patrones-comunes">Los Patrones Comunes</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Patrón</th><th>Entorno Típico</th><th>Por Qué</th></tr></thead>
            <tbody>
              <tr><td>7/7 o traslado diario</td><td>En tierra, cuadrilla vive cerca del taladro</td><td>No hay barrera de viaje que amortizar — los ciclos cortos son prácticos</td></tr>
              <tr><td>14/14</td><td>En tierra (cuadrillas de larga distancia) y costa afuera estándar</td><td>El patrón más común en toda la industria; equilibra el costo de viaje contra el tiempo fuera</td></tr>
              <tr><td>21/21</td><td>Costa afuera, algunos destinos internacionales</td><td>Bloques más largos para compensar un traslado más difícil o costoso al sitio</td></tr>
              <tr><td>28/28</td><td>Aguas profundas y costa afuera internacional remota</td><td>El viaje a una instalación remota o de aguas profundas es suficientemente costoso como para que los bloques en/fuera se extiendan al máximo aquí</td></tr>
            </tbody>
          </table>
        </div>
        <p>Ninguno de estos son reglas fijas — el horario de un contratista específico depende de la instalación, la cuenca y el contrato con el operador. Ver la <a href="/es/careers/salary#offshore-vs-onshore">comparación de pago costa afuera vs en tierra</a> para cómo interactúan estos patrones con la prima de pago que llevan los roles costa afuera, y la <a href="/es/careers/offshore-vs-land-rig-jobs">comparación completa de trabajos costa afuera vs tierra</a> para el resto de lo que difiere más allá de la rotación y el pago.</p>

        <h2 id="convenciones-regionales">Convenciones Regionales y Notación</h2>
        <p>La notación de días en/días fuera es universal, pero cuál patrón específico es estándar, y cómo se escribe, cambia según la región. El <strong>Mar del Norte del Reino Unido</strong> comúnmente corre turnos más cortos de dos semanas, escritos como "2/2" o "2/3" (2 semanas en, luego 2 o 3 semanas fuera) en lugar de la abreviatura 14/14 usada en otros lugares — mismo significado, convención distinta, y un vuelo de helicóptero comparativamente corto hasta una base en tierra del Reino Unido o Noruega es parte de por qué el turno mismo puede seguir siendo más corto que el de un destino remoto de aguas profundas. El trabajo costa afuera del <strong>Golfo de México</strong> comúnmente corre 14/14, igual al patrón más amplio ya cubierto arriba. Los contratos en tierra en partes del <strong>Medio Oriente</strong>, particularmente para cuadrillas en asignación internacional de largo plazo lejos de su país de origen en lugar de traslado local diario, más comúnmente corren turnos extendidos con bloques de licencia correspondientemente más largos, más cercanos en forma a una rotación costa afuera de aguas profundas que a un horario doméstico en tierra — la distancia de viaje internacional hace ahí el mismo trabajo que hace para las cuadrillas costa afuera, aunque el taladro mismo esté en tierra. Siempre confirma la notación y convención específica que usa un reclutador o contratista dado en lugar de asumir que coincide con la abreviatura de tu región de origen.</p>

        <h2 id="mas-larga-no-es-mas-pago">Una Rotación Más Larga No Es Más Pago — Es Más Tiempo Libre</h2>
        <p>El pago anual viene de las horas realmente trabajadas multiplicadas por la tarifa por hora, y cada patrón de rotación estándar trabaja la misma fracción del año: mitad en, mitad fuera. Un horario 28/28 y uno 14/14 a la misma tarifa por hora producen un total anual esencialmente igual, porque ambos trabajan exactamente la mitad de los días del año. Lo que cambia es la forma del tiempo libre — un trabajador en 28/28 obtiene cuatro semanas ininterrumpidas de una vez en lugar de dos, lo cual en un destino de aguas profundas con viajes costosos suele ser todo el punto. Usa la calculadora de arriba para comprobar esto directamente: cambia días en y fuera manteniendo la proporción aproximadamente constante y observa que el pago anual total apenas se mueve.</p>

        <h2 id="viatico-vs-alojamiento-gratis">Viático vs. Alojamiento Gratis</h2>
        <p>Los roles costa afuera casi nunca llevan una línea separada de viático, porque la comida y el alojamiento en la instalación se proveen gratis durante el hitch — casi todo el salario costa afuera es ingreso disponible precisamente por eso. Las cuadrillas en tierra que trabajan lejos de su base suelen ver un viático en cambio, comúnmente en el rango de $75-150/día, ya que cubren su propia comida y alojamiento. Pon el viático en $0 en la calculadora de arriba para un escenario costa afuera con alojamiento gratis, o ingresa una cifra diaria real para una comparación de cuadrilla en tierra lejos de casa.</p>

        <div class="note-box">
          <strong>Compara totales anualizados, nunca solo la tarifa por hora.</strong> Como cubre la <a href="/es/careers/salary#hourly-per-diem">sección de conversión por hora de la guía de salarios</a>, dos puestos con la misma tarifa por hora anunciada pero diferente rotación pueden producir un pago anual real muy distinto — siempre corre ambos por la misma matemática de días trabajados antes de decidir.
        </div>

        <h2 id="patrones-de-turno">Patrones de Turno Dentro de un Hitch: Día, Noche y Rotativo</h2>
        <p>El patrón de rotación (14/14, 21/21, 28/28) responde "cuánto dura el hitch". Una pregunta separada es qué turno de 12 horas realmente trabajas una vez que estás en el sitio, porque la mayoría de los taladros corren dos cuadrillas completas para cubrir las 24 horas: una cuadrilla de día (comúnmente 6am-6pm, o la convención local equivalente del taladro) y una cuadrilla de noche (las 12 horas opuestas), cada una trabajando la duración completa del hitch en su turno asignado. Algunos contratistas corren una asignación fija — una mano se queda en días o noches durante todo su tiempo en ese taladro — mientras que otros rotan las cuadrillas entre turno de día y de noche según su propio calendario, comúnmente intercambiando al inicio de un nuevo hitch en lugar de a mitad del hitch, específicamente para no alterar los ciclos de sueño más de una vez por rotación.</p>
        <p>El turno de noche conlleva un costo real de fatiga más allá de "está oscuro" — la disrupción circadiana afecta el estado de alerta justo en el tipo de trabajo repetitivo y de alto riesgo (viajes de tubería, conexiones, vigilancia de control de pozos) que este sitio cubre en el <a href="/es/drilling/well-control">centro de procedimientos de control de pozos</a> y la <a href="/es/equipment/rig-floor-tools">guía de herramientas del piso de perforación</a>. Las cuadrillas y supervisores que manejan un turno de noche toman esto en serio por una buena razón: una surgencia o un peligro de equipo no se vuelve menos peligroso porque ocurra a las 3am del día 11 de un hitch de 14 días, y la propia capacitación de seguridad y los procedimientos de relevo de turno de la mayoría de las empresas están construidos alrededor de esa realidad en lugar de tratar los turnos de día y de noche como intercambiables en la práctica.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Preguntas Frecuentes</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/rotation-schedules.js" defer></script>
