import { reviewedByJabin } from '../../../lib/person.js';

// Article for this career guide. Dates come from git via the same map the
// sitemap uses, so dateModified always equals this URL's sitemap lastmod;
// author and publisher are the Organization @id (see src/lib/techarticle.js).
// reviewedBy is a WebPage property in schema.org, so it sits on this page's
// WebPage node, which the Article names as its mainEntityOfPage.
const jsonLd = articleSchema({
  sourcePath: 'src/pages/es/careers/toolpusher.astro',
  path: '/es/careers/toolpusher',
  headline: "Cómo Convertirte en Toolpusher",
  description: "La trayectoria de perforador a toolpusher: qué implica realmente el rol, la certificación IADC WellSharp Supervisor que requiere, y el salario.",
  lang: 'es',
  extra: { mainEntityOfPage: { "@id": "https://rigfloorhq.com/es/careers/toolpusher#webpage" } },
});

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://rigfloorhq.com/es/careers/toolpusher#webpage",
  "url": "https://rigfloorhq.com/es/careers/toolpusher",
  "name": "Cómo Convertirte en Toolpusher — Trayectoria y Requisitos",
  "inLanguage": "es",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "mainEntity": { "@id": "https://rigfloorhq.com/es/careers/toolpusher#article" },
  "reviewedBy": reviewedByJabin(),
  "lastReviewed": "2026-10-15",
};

---
<BaseLayout
  title="Cómo Convertirte en Toolpusher — Trayectoria y Requisitos"
  description="La trayectoria de perforador a toolpusher: qué implica realmente el rol, la certificación IADC WellSharp Supervisor que requiere, y el salario."
  breadcrumbs={[{ label: 'Carreras', href: '/es/careers' }, { label: 'Toolpusher', href: '/es/careers/toolpusher' }]}
  jsonLd={jsonLd}
  extraJsonLd={[webPageLd]}
  lang="es"
  alternateHref="/careers/toolpusher"
>
  <Nav slot="nav" lang="es" alternateHref="/careers/toolpusher" />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Carreras — Supervisión Senior</div>
    <h1>Cómo Convertirte en <span>Toolpusher</span></h1>
    <p class="page-hero-sub">La máxima autoridad operativa en sitio del taladro para el contratista de perforación. Aquí está lo que realmente implica el trabajo, el cronograma realista desde perforador, y la certificación que lo condiciona.</p>
    <div class="page-meta">
      <span class="page-meta-item">Salario: <strong>$90K–$180K/año</strong></span>
      <span class="page-meta-item">Cronograma: <strong>14–20+ años desde el inicio</strong></span>
      <span class="page-meta-item">Requerido: <strong>IWCF Nivel 4 / WellSharp Supervisor</strong></span>
    </div>
  </div>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="salario-de-toolpusher-por-region">Salario de Toolpusher por Región</h2>
      <p>Si llegaste aquí buscando específicamente el salario de toolpusher: aquí está el número primero, desglosado por región, antes del resto de la descripción del trabajo.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Región</th><th>Por Hora</th><th>Anual (típico)</th><th>Fuente</th></tr>
          </thead>
          <tbody>
            <tr><td>Estados Unidos (media nacional)</td><td>~$60/hr</td><td>$124,100</td><td>BLS, mayo 2024 (First-Line Supervisors, Construction Trades &amp; Extraction)</td></tr>
            <tr><td>Canadá (mediana)</td><td>$50.00/hr</td><td>Mín. $31.50 – Máx. $79.33/hr</td><td>Government of Canada Job Bank</td></tr>
            <tr><td>Costa afuera (Golfo de México y similares)</td><td>30–40% sobre tierra</td><td>~$162,000–$252,000</td><td>Agregado de la industria, relativo a tierra</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:13px;color:var(--fog);">Cifra de EE.UU. de las <a href="https://www.bls.gov/opub/mlr/2026/article/occupational-employment-and-wages-in-oil-and-gas-industries-may-2024.htm" style="color:var(--amber);">BLS Occupational Employment and Wage Statistics, mayo 2024</a> (misma publicación que cita la <a href="/es/careers/salary#bls-wage-data">guía salarial completa</a>; BLS no tiene un código específico para "toolpusher", así que la ocupación más cercana es su categoría más amplia de supervisores de primera línea de construcción/extracción). Cifra de Canadá del <a href="https://www.jobbank.gc.ca/marketreport/wages-occupation/21760/ca" style="color:var(--amber);">reporte salarial de Toolpusher — Offshore Drilling Rig del Government of Canada Job Bank</a>. La cifra costa afuera es un rango calculado sobre la <a href="/es/careers/salary#offshore-vs-onshore">prima costa afuera del 30-40%</a> que documenta la guía salarial completa, no una encuesta independiente.</p>
    </div>
  </section>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="que-hace-un-toolpusher">Qué Hace un Toolpusher</h2>
        <p>Un toolpusher supervisa todo el taladro para el contratista de perforación: cada cuadrilla, cada turno, todo el equipo. Mientras un perforador maneja una consola para un turno, un toolpusher es responsable del taladro las 24 horas: programa cuadrillas, coordina mantenimiento, maneja el equipo y la cadena de suministro de repuestos, y actúa como el punto de contacto principal entre el taladro y la propia gerencia del contratista de perforación en tierra o de vuelta en el patio.</p>
        <p>Día a día, eso significa recorrer el taladro, revisar los parámetros y reportes de perforación de cada turno de cada perforador, aprobar los procedimientos antes de que se ejecuten, y ser la persona a la que llaman primero cuando algo sale mal a las 3 a.m., no para manejar la consola él mismo, sino para decidir cómo responde el taladro.</p>

        <h2 id="toolpusher-vs-perforador">Toolpusher vs. Perforador: Qué Cambia Realmente</h2>
        <p>La autoridad del perforador es real pero está limitada a su propio turno y su propia cuadrilla. La autoridad del toolpusher abarca cada turno y cada cuadrilla del taladro, además del equipo y la logística que lo mantienen funcionando entre pozos. Es menos manos en los controles y más decisión y coordinación: el trabajo pasa de ejecutar procedimientos de control de pozos a aprobarlos y manejar a las personas que los ejecutan.</p>

        <h2 id="la-trayectoria-realista-hacia-toolpusher">La Trayectoria Realista hacia Toolpusher</h2>
        <div class="career-path" style="margin-top:24px;">
          <div class="career-step">
            <h3>Perforador <span class="inline-badge badge-mid">Año 7–10</span></h3>
            <p>Maneja la consola de forma independiente en múltiples pozos y formaciones. Ver la <a href="/es/careers/driller">guía completa de perforador</a> para esta etapa.</p>
          </div>
          <div class="career-step">
            <h3>Perforador Senior / Nocturno <span class="inline-badge badge-mid">Año 10–12</span></h3>
            <p>Asume coordinación informal entre turnos, a menudo actuando como suplente del toolpusher durante su tiempo fuera del taladro. Comienza el entrenamiento IWCF Nivel 4 / WellSharp Supervisor.</p>
          </div>
          <div class="career-step">
            <h3>Toolpusher Asistente <span class="inline-badge badge-senior">Año 12–14</span></h3>
            <p>Un rol de aprendiz directo en taladros más grandes: sigue de cerca todo el alcance de responsabilidad del toolpusher antes de asumirlo de forma independiente.</p>
          </div>
          <div class="career-step">
            <h3>Toolpusher <span class="inline-badge badge-senior">Año 14–20+</span></h3>
            <p>Autoridad operativa total sobre el taladro para el contratista de perforación. Se requiere IWCF Nivel 4 o IADC WellSharp Supervisor.</p>
          </div>
        </div>

        <div class="note-box" style="max-width:640px;">
          <strong id="ejemplo-practico">Ejemplo práctico:</strong> encadenando los rangos de cada etapa, un perforador que llega a la consola en el año 7 está, de forma realista, viendo senior/night driller entre el año 10 y 12, toolpusher asistente alrededor del año 12 a 14, y un puesto de toolpusher aterrizando en algún punto del año 14 a 20+ de experiencia total en campo. Los rangos se superponen porque las etapas no tienen una duración fija: alguien que avanza rápido, llega a senior driller a los 7 años y completa toolpusher asistente en dos años puede estar dirigiendo un taladro para el año 14, mientras que alguien que progresa en el extremo más lento de cada rango está más cerca del año 20. De cualquier forma, no hay atajo que evite la certificación: <a href="#la-certificacion-que-lo-condiciona">IWCF Nivel 4 o IADC WellSharp Supervisor</a> debe estar en mano antes de que cambie el título, sin importar qué tan rápido se sumen los años.
        </div>

        <h2 id="la-certificacion-que-lo-condiciona">La Certificación Que lo Condiciona</h2>
        <p>Todo operador requiere certificación de control de pozos a nivel supervisor antes de entregar la autoridad de un toolpusher: <strong>IWCF Nivel 4</strong> o el nivel equivalente <strong>IADC WellSharp Supervisor</strong>. Se ubica un nivel por encima de la certificación IWCF Nivel 3 / WellSharp Driller que necesita un perforador, y cubre el control de pozos desde una perspectiva de gestión y aprobación de decisiones en lugar de ejecución directa. Ver el desglose completo en la <a href="/es/careers/certifications">página de certificaciones</a>, o la escalera en la que se ubica en <a href="/es/pillars/rig-floor-leadership">Liderazgo en el Piso de Perforación</a>.</p>

        <div class="note-box">
          <strong>Revisado por un supervisor en activo:</strong> Jabin Travis, quien <a href="/es/about/jabin-travis">revisa nuestro contenido crítico de seguridad</a>, tiene la certificación IADC WellSharp Supervisor. Su lectura: el paso de perforador a toolpusher tiene menos que ver con conocimiento técnico nuevo y más con confiar en tu propio criterio bajo presión en situaciones que no puedes ensayar del todo. La certificación demuestra competencia, pero el ascenso en sí se gana con un historial que los operadores realmente han visto.
        </div>

        <h2 id="que-viene-despues-de-toolpusher">Qué Viene Después de Toolpusher</h2>
        <p>El siguiente escalón es <strong>OIM (Gerente de Instalación Costa Afuera)</strong> o gerente de taladro en tierra: el rol operativo máximo en toda la instalación, no solo en la parte del contratista de perforación. Ver la <a href="/es/careers/oim-rig-manager">guía de OIM / Gerente de Taladro</a> para lo que cambia en ese nivel.</p>
      </div>

      <div>
        <div class="toc">
          <div class="toc-title">En Esta Página</div>
          <a href="#salario-de-toolpusher-por-region">Salario por Región</a>
          <a href="#que-hace-un-toolpusher">Qué Hace un Toolpusher</a>
          <a href="#toolpusher-vs-perforador">Toolpusher vs. Perforador</a>
          <a href="#la-trayectoria-realista-hacia-toolpusher">Trayectoria hacia Toolpusher</a>
          <a href="#la-certificacion-que-lo-condiciona">Certificación Requerida</a>
          <a href="#que-viene-despues-de-toolpusher">Qué Viene Después</a>
        </div>
        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Lectura Relacionada</h3>
          <a href="/es/pillars/rig-floor-leadership" class="card-link">→ Liderazgo en el Piso de Perforación: La Escalera Completa</a><br><br>
