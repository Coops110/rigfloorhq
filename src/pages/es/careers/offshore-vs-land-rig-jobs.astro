          <a href="#el-trabajo-en-si">El Trabajo en Sí</a>
          <a href="#estilo-de-vida-y-rotacion">Estilo de Vida y Rotación</a>
          <a href="#perfil-de-seguridad">Perfil de Seguridad</a>
          <a href="#faq">Preguntas Frecuentes</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Lectura Relacionada</h3>
          <a href="/es/careers/salary" class="card-link">→ Guía Completa de Pago: Costa Afuera vs Tierra</a><br><br>
          <a href="/es/careers/rotation-schedules" class="card-link">→ Guía y Calculadora de Horarios de Rotación</a><br><br>
          <a href="/es/equipment/rig-types" class="card-link">→ Los Seis Tipos de Taladro Comparados</a><br><br>
          <a href="/es/careers/certifications" class="card-link">→ Guía Completa de Certificaciones</a><br><br>
          <a href="/es/careers/roustabout" class="card-link">→ Cómo Convertirte en Roustabout</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Preguntas Frecuentes</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  <SourcesStandards lang="es" ids={['iwcf', 'iadcWellsharp']} />
</BaseLayout>
