---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import DiagramEmbed from '../../../components/DiagramEmbed.astro';
import SourcesStandards from '../../../components/SourcesStandards.astro';
import { JABIN_PERSON_ID, reviewedByJabin, authorChrisCooper } from '../../../lib/person.js';
import { gitDates } from '../../../lib/techarticle.js';

export async function getStaticPaths() {
  const posts = await getCollection('blogEs', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}

const siteUrl = 'https://rigfloorhq.com';
const postUrl = `${siteUrl}/es/blog/${post.id}`;
// See the English route for why SVG cannot be the share image, and for why
// the no-custom-image case is undefined rather than '/og-default.png' —
// BaseLayout resolves the generated es-blog-<slug>.png from the URL path.
const isRaster = (p: string) => /\.(png|jpe?g|webp)$/i.test(p);
const shareImage = post.data.image && isRaster(post.data.image) ? post.data.image : undefined;
// JSON-LD needs a concrete URL regardless (it isn't resolved by BaseLayout),
// so mirror the same fallback chain here rather than leaving it undefined.
const jsonLdImage = shareImage || `/og/es-blog-${post.id}.png`;

// Same pattern as the English template (src/pages/blog/[slug].astro). See
// its comment for the isJabin vs reviewedByJabin distinction, and for why
// the non-Jabin byline references the real Organization node by @id instead
// of fabricating a second one. Same stable Person @id regardless of
// language, per src/lib/person.js.
const isJabin = post.data.author === 'Jabin Travis';
const authorEntity = isJabin
  ? {
      "@type": "Person",
      "@id": JABIN_PERSON_ID,
      "name": "Jabin Travis",
      "jobTitle": "Drilling Operations Supervisor",
    }
  : authorChrisCooper();

// Same git-derived dates every Article/TechArticle page uses (src/lib/techarticle.js).
// See the English route (src/pages/blog/[slug].astro) for the full rationale.
const dates = gitDates(`src/content/blog-es/${post.id}.md`);
const resolvedModifiedDate = post.data.modifiedDate || dates.dateModified || post.data.publishDate;
const resolvedPublishedDate = dates.datePublished || post.data.publishDate;

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": resolvedPublishedDate,
  "dateModified": resolvedModifiedDate,
  "author": authorEntity,
  "publisher": { "@id": `${siteUrl}/#organization` },
  "image": `${siteUrl}${jsonLdImage}`,
  "inLanguage": "es",
  // reviewedBy belongs on WebPage per schema.org, not BlogPosting — see the
  // English route for the full note. Folded into mainEntityOfPage here.
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl,
    ...(post.data.reviewedByJabin ? { "reviewedBy": reviewedByJabin(), "lastReviewed": post.data.reviewedDate } : {}),
  },
};

const jsonLd = blogPosting;

// Post filenames match exactly between the English and Spanish collections,
// so the English equivalent URL can be derived directly from the same id.
const englishEquivalent = `/blog/${post.id}`;
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={`/es/blog/${post.id}`}
  breadcrumbs={[{ label: 'Blog', href: '/es/blog' }, { label: post.data.title, href: `/es/blog/${post.id}` }]}
  articleTag={true}
  publishDate={resolvedPublishedDate}
  modifiedDate={resolvedModifiedDate}
  jsonLd={jsonLd}
  ogImage={shareImage}
  lang="es"
  alternateHref={englishEquivalent}
  noindex={post.data.noindex}
>
  <Nav slot="nav" lang="es" alternateHref={englishEquivalent} />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Blog — {post.data.category}</div>
    <h1>{post.data.title}</h1>
    <p class="page-hero-sub">{post.data.description}</p>
    <div class="page-meta">
      <span class="page-meta-item">Por <strong><a href={isJabin ? '/es/about/jabin-travis' : '/es/about/chris-cooper'}>{post.data.author}</a></strong></span>
      <span class="page-meta-item">{formatDate(post.data.publishDate)}</span>
      {post.data.tags.length > 0 && (
        <span class="page-meta-item">{post.data.tags.join(' · ')}</span>
      )}
    </div>
  </div>

  <section class="block">
    <div class="prose blog-content">
      <Content />

      {post.data.diagrams.length > 0 && (
        <>
          <h2>Reutilizar los diagramas</h2>
          {post.data.diagrams.map((d) => (
            <DiagramEmbed src={d.src} alt={d.alt} title={d.title} pagePath={`/es/blog/${post.id}`} lang="es" />
          ))}
        </>
      )}
    </div>

    <div class="note-box mt-40" style="max-width:700px;">
      <strong>¿Quieres más como esto?</strong> Explora todos los artículos en el <a href="/es/blog" style="color:var(--amber);">índice del blog</a>, o regresa a la <a href="/es" style="color:var(--amber);">biblioteca de referencia principal</a>.
    </div>
  </section>

  {post.data.sources.length > 0 && (
    <SourcesStandards lang="es" ids={post.data.sources} />
  )}
</BaseLayout>
