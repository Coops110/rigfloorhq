---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import DiagramEmbed from '../../../components/DiagramEmbed.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blogEs', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
}

const siteUrl = 'https://rigfloorhq.com';
const postUrl = `${siteUrl}/es/blog/${post.id}`;
// See the English route for why SVG cannot be the share image.
const isRaster = (p: string) => /\.(png|jpe?g|webp)$/i.test(p);
const shareImage = post.data.image && isRaster(post.data.image) ? post.data.image : '/og-default.png';

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.publishDate,
  "dateModified": post.data.modifiedDate || post.data.publishDate,
  "author": { "@type": "Organization", "name": post.data.author },
  "publisher": {
    "@type": "Organization",
    "name": "RigFloorHQ",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.svg` },
  },
  "image": `${siteUrl}${shareImage}`,
  "inLanguage": "es",
  "mainEntityOfPage": { "@type": "WebPage", "@id": postUrl },
};

const faqPage = post.data.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
} : null;

const jsonLd = faqPage ? { "@context": "https://schema.org", "@graph": [blogPosting, faqPage] } : blogPosting;

// Post filenames match exactly between the English and Spanish collections,
// so the English equivalent URL can be derived directly from the same id.
const englishEquivalent = `/blog/${post.id}`;
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={`/es/blog/${post.id}`}
  breadcrumbs={[{ label: 'Blog', href: '/es/blog' }, { label: post.data.title, href: `/es/blog/${post.id}` }]}
  articleTag={true}
  publishDate={post.data.publishDate}
  modifiedDate={post.data.modifiedDate}
  jsonLd={jsonLd}
  ogImage={shareImage}
  lang="es"
  alternateHref={englishEquivalent}
  noindex={post.data.noindex}
>
  <Nav slot="nav" lang="es" alternateHref={englishEquivalent} />
  <Footer slot="footer" lang="es" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Blog — {post.data.category}</div>
    <h1>{post.data.title}</h1>
    <p class="page-hero-sub">{post.data.description}</p>
    <div class="page-meta">
      <span class="page-meta-item">Por <strong>{post.data.author}</strong></span>
      <span class="page-meta-item">{formatDate(post.data.publishDate)}</span>
      {post.data.tags.length > 0 && (
        <span class="page-meta-item">{post.data.tags.join(' · ')}</span>
      )}
    </div>
  </div>

  <section class="block">
    <div class="prose blog-content">
      <Content />

      {post.data.diagrams.length > 0 && (
        <>
          <h2>Reutilizar los diagramas</h2>
          {post.data.diagrams.map((d) => (
            <DiagramEmbed src={d.src} alt={d.alt} title={d.title} pagePath={`/es/blog/${post.id}`} lang="es" />
          ))}
        </>
      )}
    </div>

    <div class="note-box mt-40" style="max-width:700px;">
      <strong>¿Quieres más como esto?</strong> Explora todos los artículos en el <a href="/es/blog" style="color:var(--amber);">índice del blog</a>, o regresa a la <a href="/es" style="color:var(--amber);">biblioteca de referencia principal</a>.
    </div>
  </section>
</BaseLayout>
