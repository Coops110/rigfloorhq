<BaseLayout
  title="Pesca y Tubería Pegada: De Diagnóstico a Recuperación"
  description="Por qué se pega la tubería, cómo distinguir la pega diferencial de la mecánica antes de actuar, y qué herramientas de pesca siguen después."
  breadcrumbs={[{ label: 'Guías Pilar', href: '/es/pillars' }, { label: 'Pesca y Tubería Pegada', href: '/es/pillars/stuck-pipe-and-fishing-operations' }]}
