        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Preguntas Frecuentes</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
