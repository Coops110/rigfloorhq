          <a href="/es/equipment/bop" class="card-link">→ Guía de Equipo BOP</a><br><br>
          <a href="/es/pillars/well-kill-methods" class="card-link">→ Guía de Métodos para Matar un Pozo</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Preguntas Frecuentes</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
          <p set:html={item.a} />
        </div>
      ))}
    </div>
  </section>

  <SourcesStandards lang="es" ids={['api53', 'api59', 'cfr250g']} />
</BaseLayout>
