  sourcePath: 'src/pages/es/drilling/shut-in-procedures.astro',
  path: '/es/drilling/shut-in-procedures',
  headline: "Cierre Duro vs Cierre Suave: Procedimientos Paso a Paso",
  description: "La secuencia real de pasos para el cierre duro y el cierre suave, qué preventor cierra primero en cada uno, y por qué una empresa elige uno sobre el otro para un pozo dado.",
  lang: 'es',
  extra: { mainEntityOfPage: { "@id": "https://rigfloorhq.com/es/drilling/shut-in-procedures#webpage" } },
