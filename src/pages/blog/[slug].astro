---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import DiagramEmbed from '../../components/DiagramEmbed.astro';
import SourcesStandards from '../../components/SourcesStandards.astro';
import { JABIN_PERSON_ID, reviewedByJabin } from '../../lib/person.js';
import { gitDates } from '../../lib/techarticle.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const siteUrl = 'https://rigfloorhq.com';
const postUrl = `${siteUrl}/blog/${post.id}`;
// Social scrapers and Google's structured data guidance both want a raster
// image — SVG og:image renders as no preview at all on Facebook, LinkedIn and
// X, which is worse than the generic fallback. Inline SVG diagrams in the body
// are fine; they just cannot serve as the share image.
const isRaster = (p: string) => /\.(png|jpe?g|webp)$/i.test(p);
// undefined (not '/og-default.png') when there's no custom image, so
// BaseLayout's own path-based auto-detection picks up the generated
// blog-<slug>.png from scripts/generate-og-images.mjs instead.
const shareImage = post.data.image && isRaster(post.data.image) ? post.data.image : undefined;
// JSON-LD needs a concrete URL regardless (it isn't resolved by BaseLayout),
// so mirror the same fallback chain here rather than leaving it undefined.
const jsonLdImage = shareImage || `/og/blog-${post.id}.png`;

// isJabin: he wrote the post himself (e.g. a firsthand account), so he's the
// author entity. reviewedByJabin: someone else wrote it, but he checked it
// for technical accuracy: a separate reviewedBy field, not authorship.
// Both reference the same stable Person @id from src/lib/person.js rather
// than typing out his name/jobTitle again here, so his full record (bio,
// credentials) only has to be correct in one place: the profile page itself.
// The non-Jabin byline ("RigFloorHQ Team") is this same site's own
// organization, not a separate entity, so it references the one real
// Organization node (BaseLayout.astro) by @id instead of fabricating a
// second, disconnected Organization node with only a name string.
const isJabin = post.data.author === 'Jabin Travis';
const authorEntity = isJabin
  ? {
      "@type": "Person",
      "@id": JABIN_PERSON_ID,
      "name": "Jabin Travis",
      "jobTitle": "Drilling Operations Supervisor",
    }
  : { "@id": `${siteUrl}/#organization` };

// Same git-derived dates every Article/TechArticle page uses (src/lib/techarticle.js):
// dateModified is the last commit that actually touched this post's own content
// file, not a static frontmatter value that never moves after publishing.
// modifiedDate frontmatter (when an author sets it) still wins, so an explicit
// editorial date is never silently overridden; publishDate frontmatter is the
// fallback when git history can't resolve the file (shallow clone).
const dates = gitDates(`src/content/blog/${post.id}.md`);
const resolvedModifiedDate = post.data.modifiedDate || dates.dateModified || post.data.publishDate;
const resolvedPublishedDate = dates.datePublished || post.data.publishDate;

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": resolvedPublishedDate,
  "dateModified": resolvedModifiedDate,
  "author": authorEntity,
  "publisher": { "@id": `${siteUrl}/#organization` },
  "image": `${siteUrl}${jsonLdImage}`,
  "inLanguage": "en",
  // Tells search engines which URL this markup describes, so the article is
  // not attributed to the listing page it was crawled from. reviewedBy
  // belongs here too, per schema.org — it's a WebPage property, not
  // BlogPosting — so it's folded into this node rather than sitting on the
  // BlogPosting itself.
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl,
    ...(post.data.reviewedByJabin ? { "reviewedBy": reviewedByJabin() } : {}),
  },
};

const jsonLd = blogPosting;

// Only link to a specific Spanish post if a real translation with a matching
// filename exists. When there is none, the switcher falls back to the Spanish
// blog hub, but no hreflang is declared — the hub is not a translation of this
// post, and a non-reciprocal annotation would be ignored anyway.
const spanishPosts = await getCollection('blogEs', ({ data }) => !data.draft);
const hasSpanishVersion = spanishPosts.some(p => p.id === post.id);
const alternateUrl = hasSpanishVersion ? `/es/blog/${post.id}` : undefined;
const switcherUrl = hasSpanishVersion ? `/es/blog/${post.id}` : '/es/blog';
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={`/blog/${post.id}`}
  breadcrumbs={[{ label: 'Blog', href: '/blog' }, { label: post.data.title, href: `/blog/${post.id}` }]}
  articleTag={true}
  publishDate={resolvedPublishedDate}
  modifiedDate={resolvedModifiedDate}
  jsonLd={jsonLd}
  ogImage={shareImage}
  lang="en"
  alternateHref={alternateUrl}
  noindex={post.data.noindex}
>
  <Nav slot="nav" lang="en" alternateHref={switcherUrl} />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Blog — {post.data.category}</div>
    <h1>{post.data.title}</h1>
    <p class="page-hero-sub">{post.data.description}</p>
    <div class="page-meta">
      <span class="page-meta-item">By <strong>{post.data.author}</strong></span>
      <span class="page-meta-item">{formatDate(post.data.publishDate)}</span>
      {post.data.tags.length > 0 && (
        <span class="page-meta-item">{post.data.tags.join(' · ')}</span>
      )}
    </div>
  </div>

  <section class="block">
    <div class="prose blog-content">
      <Content />

      {post.data.diagrams.length > 0 && (
        <>
          <h2>Reuse the diagrams</h2>
          {post.data.diagrams.map((d) => (
            <DiagramEmbed src={d.src} alt={d.alt} title={d.title} pagePath={`/blog/${post.id}`} lang="en" />
          ))}
        </>
      )}
    </div>

    <div class="note-box mt-40" style="max-width:700px;">
      <strong>Want more like this?</strong> Browse all posts on the <a href="/blog" style="color:var(--amber);">blog index</a>, or head back to the <a href="/" style="color:var(--amber);">main reference library</a>.
    </div>
  </section>

  {post.data.sources.length > 0 && (
    <SourcesStandards lang="en" ids={post.data.sources} />
  )}
</BaseLayout>
