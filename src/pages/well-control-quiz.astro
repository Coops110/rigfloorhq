---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import quizData from '../lib/data/well-control-quiz.json';

const faq = [
  {
    q: 'Is this quiz officially affiliated with IWCF or IADC?',
    a: "No. The questions cover the same ground tested in IWCF and IADC WellSharp well control certification exams, but this quiz isn't produced, endorsed, or affiliated with either body, and passing it doesn't substitute for accredited certification. Treat it as practice and self-assessment before or alongside real training, not a replacement for it.",
  },
  {
    q: 'Is there a passing score?',
    a: "No fixed cutoff — this isn't a graded exam. Each topic shows your score out of that topic's question count at the end, plus a full review of every question with the correct answer and explanation, so you can see exactly where you're weak rather than just a pass/fail label.",
  },
  {
    q: 'Can I retake a topic, and will I get the same questions?',
    a: "Yes, retake any topic as many times as you want. Questions shuffle each time you start a topic, so the order changes, though the question pool for that topic itself stays the same — it's meant for repeated practice until the material sticks, not a one-shot test.",
  },
  {
    q: 'Do I need to create an account or install anything?',
    a: "No. There's no signup, no login, and nothing to install. Pick a topic and it loads in the browser immediately. As the note above states, nothing you enter is saved or sent anywhere — reloading the page clears your progress, which also means there's no account to lose progress from.",
  },
];

// 200 well control practice questions across 8 topics. Generic theory and
// numbers only — no rig, well, or company reference anywhere in the source
// data, verified before this page was built.
type Question = {
  id: number;
  question: string;
  choices: Record<string, string>;
  correctAnswer: string;
  explanation: string;
  topic: string;
};

const questions = quizData as Question[];

const topicOrder = [
  'Basic Knowledge',
  'Basic Pressure',
  'Warning Signs and Shut-In',
  'Shut-In Conditions',
  'Volumes and MAASP',
  'Kill Methods',
  'Some Tricky Stuff',
  'Subsea Questions',
];

const topicIcons: Record<string, string> = {
  'Basic Knowledge': '📘',
  'Basic Pressure': '⚙',
  'Warning Signs and Shut-In': '🚨',
  'Shut-In Conditions': '🔒',
  'Volumes and MAASP': '📊',
  'Kill Methods': '🛑',
  'Some Tricky Stuff': '🧠',
  'Subsea Questions': '🌊',
};

function slugify(topic: string) {
  return topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

const topics = topicOrder.map((topic) => ({
  name: topic,
  slug: slugify(topic),
  icon: topicIcons[topic] ?? '❓',
  questions: questions.filter((q) => q.topic === topic),
}));

const quizLd = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "LearningResource"],
  "name": "Well Control Practice Test",
  "url": "https://rigfloorhq.com/well-control-quiz",
  "learningResourceType": "Practice quiz",
  "educationalUse": "assessment",
  "teaches": "Well control principles for drilling crews",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "publisher": { "@id": "https://rigfloorhq.com/#organization" },
};
---
<BaseLayout
  title="Well Control Practice Test"
  description="200 well control practice questions across 8 topics: pressure, kick warning signs, shut-in, MAASP, kill methods, subsea, and more — take each live."
  breadcrumbs={[{ label: 'Well Control Quiz', href: '/well-control-quiz' }]}
  jsonLd={quizLd}
  lang="en"
  alternateHref="/es/well-control-quiz"
>
  <Nav slot="nav" lang="en" alternateHref="/es/well-control-quiz" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Reference — Practice</div>
    <h1>Well Control <span>Quiz</span></h1>
    <p class="page-hero-sub">200 practice questions across 8 topics, the same ground covered by IWCF and IADC well control certification. Pick a topic below and take it live — one question at a time, real score at the end.</p>
  </div>

  <section class="block">
    <div class="section-eyebrow">Test Yourself</div>
    <h2 class="section-title">Take the <span>Quiz</span></h2>
    <div class="card-grid" id="quiz-picker">
      {topics.map((t) => (
        <div class="card quiz-pick-btn" data-topic-slug={t.slug} role="button" tabindex="0">
          <span class="card-icon">{t.icon}</span>
          <h3>{t.name}</h3>
          <p>{t.questions.length} questions, shuffled each time.</p>
          <span class="card-link">Start Quiz →</span>
        </div>
      ))}
    </div>

    <div class="quiz-interactive-main hidden" id="quiz-interactive-main"></div>

    <div class="note-box mt-24">
      <strong>Practice only, not a certified exam.</strong> These questions cover the same ground as IWCF and IADC well control exams but are not affiliated with either body and do not substitute for accredited certification. Nothing you enter is saved, sent anywhere, or stored — reloading the page clears it.
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Preview</div>
    <h2 class="section-title">Sample <span>Questions</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">Three real questions from each topic, so you can see what you're actually getting into before starting the full interactive quiz above. Answers aren't shown here — take the live quiz for scoring and explanations.</p>
    <div class="accordion" style="max-width:820px;">
      {topics.map((t) => (
        <details class="acc-item">
          <summary class="acc-header">{t.icon} {t.name}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body">
            {t.questions.slice(0, 3).map((q) => (
              <div style="margin-bottom:16px;">
                <p style="color:var(--white);font-weight:600;margin-bottom:6px;">{q.question}</p>
                <ul style="margin:0;padding-left:20px;color:var(--fog);font-size:13px;line-height:1.7;">
                  {Object.entries(q.choices).map(([letter, text]) => (
                    <li>{letter}. {text}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  {/* Question data only, nothing visible or readable as page content — the
      quiz would be pointless if the answers sat in plain view on the page
      itself. Rendered per-topic so the picker above can load one topic at a
      time without shipping all 200 questions into a single blob. */}
  {topics.map((t) => (
    <script type="application/json" class="quiz-data" data-topic-slug={t.slug} set:html={JSON.stringify(t.questions)} />
  ))}

  <section class="block">
    <div class="prose">
      <p>Working these calculations out yourself first is worth more than reading the explanation cold — the <a href="/calculators/kill-sheet">kill sheet calculator</a> and <a href="/calculators/formulas-cheat-sheet">drilling formulas cheat sheet</a> run the same math these questions test.</p>
      <p>For the full explanations behind these topics, see the <a href="/drilling/well-control">well control reference</a> and the <a href="/pillars/well-kill-methods">Well Kill Methods guide</a>. Each section above pairs with a deeper read: <a href="/blog/well-control-basics">well control basics for new crews</a>, <a href="/blog/five-warning-signs-of-a-kick">five warning signs of a kick</a>, <a href="/blog/shut-in-pressure-behavior-explained">shut-in pressure behavior</a>, <a href="/blog/drillers-method-wait-and-weight-mixups">Driller's Method and Wait and Weight: 20 Exam Questions</a>, <a href="/blog/volumetric-kill-real-story">a real volumetric kill</a>, <a href="/blog/well-control-curveball-scenarios">well control curveball scenarios</a>, and <a href="/blog/pit-volumes-maasp-math-mistakes">pit volumes and MAASP math mistakes</a>.</p>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">Certification</div>
    <h2 class="section-title">Where This Sits in the <span>IWCF Ladder</span></h2>
    <p style="color:var(--fog);max-width:760px;margin-bottom:20px;">This quiz covers theory and math across all four IWCF well control tiers — it isn't tied to one level. For where each tier actually fits in a rig career, see <a href="/pillars/rig-floor-leadership" style="color:var(--amber);">Rig Floor Leadership</a> and the full <a href="/careers/certifications" style="color:var(--amber);">certifications breakdown</a>.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Level</th><th>Who It's For</th><th>What It Covers</th><th>Renewal</th></tr></thead>
        <tbody>
          <tr><td>1 — Awareness</td><td>Any rig personnel</td><td>Foundational well control principles and blowout prevention awareness</td><td>—</td></tr>
          <tr><td>2 — Introductory</td><td>Well-site operations team whose action or inaction can influence well control, e.g. assistant driller, derrickhand</td><td>Basic drilling well control and well control assessment</td><td>5 years</td></tr>
          <tr><td>3 — Driller</td><td>The equipment operator who has to act to prevent or respond to a well control incident, e.g. driller</td><td>Shut-in procedures, kick detection, simulator-based well control scenarios</td><td>2 years</td></tr>
          <tr><td>4 — Supervisor</td><td>The person with oversight that the correct actions are actually carried out, e.g. toolpusher, OIM, company man</td><td>Advanced technique and emergency decision-making under pressure</td><td>2 years</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <div class="section-eyebrow">FAQ</div>
    <h2 class="section-title">Quiz <span>Questions</span></h2>
    <div class="accordion" style="max-width:820px;">
      {faq.map((item) => (
        <details class="acc-item">
          <summary class="acc-header">{item.q}<span class="acc-arrow">▼</span></summary>
          <div class="acc-body"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Global, not scoped: the interactive quiz UI (.qi-*) is built by
     client-side JS after the page loads, so Astro's build-time style
     scoping never reaches it. Scoped rules here would silently no-op on
     every dynamically created element and ship as unstyled default HTML. */
  .quiz-pick-btn { cursor: pointer; text-align: left; }
  .quiz-pick-btn:hover { border-color: var(--amber); }
  .quiz-pick-btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  .quiz-interactive-main.active {
    background: var(--steel);
    border: 1px solid var(--amber);
    border-radius: 8px;
    padding: 28px;
    margin-top: 28px;
  }

  .hidden { display: none !important; }

  .qi-progress { font-family: var(--mono); font-size: 11px; color: var(--fog); margin-bottom: 12px; }
  .qi-text { font-weight: 600; color: var(--white); margin-bottom: 16px; font-size: 18px; }
  .qi-choice {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--ink);
    border: 1px solid var(--iron);
    color: var(--mist);
    padding: 12px 16px;
    margin-bottom: 8px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
  }
  .qi-choice:hover:not(:disabled) { border-color: var(--amber); }
  .qi-choice:disabled { cursor: default; }
  .qi-choice.right { border-color: #4ade80; background: rgba(74, 222, 128, 0.12); color: var(--white); }
  .qi-choice.wrong { border-color: var(--danger); background: rgba(239, 68, 68, 0.12); color: var(--white); }
  .qi-explain { font-size: 13px; color: var(--fog); margin: 14px 0; padding-top: 14px; border-top: 1px solid var(--iron); }
  .qi-score-big { font-size: 2.4em; font-weight: 700; text-align: center; color: var(--white); margin: 10px 0; }
  .qi-score-sub { text-align: center; color: var(--fog); margin-bottom: 20px; }
  .qi-topic-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--amber); margin-bottom: 8px; }

  .qi-review { margin: 24px 0; border-top: 1px solid var(--iron); padding-top: 20px; }
  .qi-review-title { font-weight: 600; color: var(--white); margin-bottom: 14px; }
  .qi-review-item { background: var(--ink); border: 1px solid var(--iron); border-radius: 6px; padding: 16px 18px; margin-bottom: 10px; }
  .qi-review-item.wrong { border-color: rgba(239, 68, 68, 0.4); }
  .qi-review-q { font-weight: 600; color: var(--white); margin-bottom: 8px; font-size: 14px; }
  .qi-review-your { font-size: 13px; margin-bottom: 4px; }
  .qi-review-your.wrong { color: var(--danger); }
  .qi-review-your.right { color: #4ade80; }
  .qi-review-correct { font-size: 13px; color: #4ade80; margin-bottom: 8px; }
  .qi-review-explain { font-size: 13px; color: var(--fog); }
</style>

<script is:inline src="/scripts/well-control-quiz.js" defer></script>
