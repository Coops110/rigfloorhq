---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, LEGAL, GA_ID } from '../lib/site.js';

// The whole page branches on this. With no measurement ID the site genuinely
// sets nothing, and saying so is both true and a better position than a
// boilerplate cookie table. Paste an ID into site.js and this page rewrites
// itself to describe what is actually set.
const analytics = Boolean(GA_ID);

const cookies = [
  {
    name: 'rigfloorhq_consent_v1',
    type: 'Strictly necessary',
    purpose:
      "Remembers whether you accepted or declined analytics cookies, so you aren't asked on every page. Stored in your browser's local storage; contains only your choice and its date.",
    expiry: 'Until you clear your browser storage',
  },
  {
    name: '_ga',
    type: 'Analytics',
    purpose:
      'Google Analytics. Distinguishes one visitor from another so we can count unique visitors rather than raw page loads. Only set if you accept.',
    expiry: '2 years',
  },
  {
    name: `_ga_${GA_ID.replace(/^G-/, '')}`,
    type: 'Analytics',
    purpose:
      'Google Analytics. Keeps session state so one visit is not counted as many. Only set if you accept.',
    expiry: '2 years',
  },
];
---
<BaseLayout
  title="Cookie Policy"
  description={analytics
    ? 'What cookies RigFloorHQ sets, why, and how to change or withdraw your choice at any time.'
    : 'RigFloorHQ sets no cookies and stores nothing in your browser. This page explains exactly what that means and how to verify it yourself.'}
  breadcrumbs={[{ label: 'Cookie Policy', href: '/cookies' }]}
  lang="en"
  alternateHref="/es/cookies"
>
  <Nav slot="nav" lang="en" alternateHref="/es/cookies" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Legal</div>
    <h1>Cookie <span>Policy</span></h1>
    <p class="page-hero-sub">
      {analytics
        ? 'What we set, why, and how to change your mind at any time.'
        : 'This site does not use cookies. Here is what that means, and how to check it yourself.'}
    </p>
    <div class="page-meta">
      <span class="page-meta-item">Last updated <strong>{LEGAL.lastUpdated}</strong></span>
    </div>
  </div>

  <section class="block">
    <div class="prose">
      {analytics ? (
        <>
          <div class="note-box">
            <strong>The short version.</strong> We set one small analytics cookie set, and
            only if you accept. Decline and nothing non-essential is stored — the site works
            exactly the same. You can change your mind at any time using
            <strong> Cookie settings</strong> in the footer.
          </div>

          <h2>What a cookie is</h2>
          <p>
            A cookie is a small file a website asks your browser to store, so it can
            recognise your browser on a later page or a later visit. Related technologies —
            local storage, session storage and pixels — do much the same job by different
            means.
          </p>

          <h2>What we set</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Name</th><th>Type</th><th>Purpose</th><th>Expires</th></tr>
              </thead>
              <tbody>
                {cookies.map((c) => (
                  <tr>
                    <td><span class="highlight">{c.name}</span></td>
                    <td>{c.type}</td>
                    <td>{c.purpose}</td>
                    <td>{c.expiry}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            We use no functionality or advertising cookies, and we are not part of any ad
            network. Analytics tells us which pages are read; it does not tell us who you
            are, and we do not attempt to find out.
          </p>

          <h2>Your choice</h2>
          <p>
            We ask before setting anything optional. Until you accept, Google Analytics
            receives only an anonymous, cookieless signal that a page was viewed, with
            nothing stored on your device.
          </p>
          <p>
            Decline and no analytics cookies are set, and any existing ones are actively
            deleted rather than merely ignored. Accept and you can still withdraw later:
            the <strong>Cookie settings</strong> link in the footer reopens the banner, and
            declining clears the cookies at that point.
          </p>
          <div class="note-box">
            <strong>Declining costs you nothing.</strong> There is no reduced-functionality
            version of this site, no nag on later visits, and nothing gated behind consent.
          </div>
        </>
      ) : (
        <>
          <div class="note-box">
            <strong>{SITE.name} sets no cookies.</strong> Not necessary ones, not analytics
            ones, not advertising ones. Nothing is written to your browser's cookie store,
            local storage or session storage. That is also why you have never seen a cookie
            banner here.
          </div>

          <h2>What a cookie is</h2>
          <p>
            A cookie is a small file a website asks your browser to store, so it can
            recognise your browser on a later page or a later visit. Related technologies —
            local storage, session storage, pixels and fingerprinting — do much the same job
            by different means. Together they are how most of the web remembers who you are.
          </p>

          <h2>What we use</h2>
          <p>
            None of it. There is no cookie table on this page because there are no cookies
            to list. Specifically, this site does not use:
          </p>
          <ul>
            <li><strong>Strictly necessary cookies</strong> — we have no logins, baskets or preferences to remember, so none are needed;</li>
            <li><strong>Analytics cookies</strong> — we run no analytics product at all, so we do not know how many people visit or which pages they read;</li>
            <li><strong>Functionality cookies</strong> — the language switch works by linking to a different URL, not by storing a preference;</li>
            <li><strong>Advertising or targeting cookies</strong> — we carry no advertising and are not part of any ad network;</li>
            <li><strong>Local or session storage</strong> — the calculators run entirely in the page and keep nothing once you navigate away.</li>
          </ul>

          <h2>Why there is no cookie banner</h2>
          <p>
            Under UK and EU rules a site must obtain consent before storing anything on your
            device that is not strictly necessary. We store nothing, so there is nothing to
            ask you about. A banner here would be theatre.
          </p>
          <p>
            It also means there is no consent choice for you to manage, change or withdraw —
            a "cookie settings" link would have nothing to control.
          </p>
        </>
      )}

      <h2>Third-party requests</h2>
      <p>
        Our pages load typefaces from Google Fonts. Google receives your IP address and
        browser details in order to serve the font files. Google states it does not set
        cookies on the Google Fonts service, but the request itself is a transfer of data to
        a third party and we would rather name it than leave it out. This is covered in more
        detail in our <a href="/privacy">Privacy Policy</a>.
      </p>
      <p>
        {analytics
          ? 'Beyond fonts and the analytics described above, our pages make no third-party requests — no ad calls, no embedded video, no social widgets, no maps.'
          : 'Beyond fonts, our pages make no third-party requests — no analytics beacons, no ad calls, no embedded video, no social widgets, no maps.'}
      </p>

      <h2>Check it yourself</h2>
      <p>
        You do not have to take our word for any of this. In your browser, press
        <span class="highlight">F12</span> to open developer tools, then look at the
        <strong>Application</strong> tab (Chrome and Edge) or <strong>Storage</strong> tab
        (Firefox). The <strong>Network</strong> tab will show you every request the page
        makes.
      </p>
      <div class="note-box">
        {analytics ? (
          <><strong>Worth knowing.</strong> If you decline and still find a <span class="highlight">_ga</span> cookie set by this domain, that is a bug — please tell us at <a href={`mailto:${LEGAL.contactEmail}`}>{LEGAL.contactEmail}</a>.</>
        ) : (
          <><strong>Worth knowing.</strong> If you ever find a cookie set by this domain, that is a bug or a change we failed to document — either way we want to hear about it at <a href={`mailto:${LEGAL.contactEmail}`}>{LEGAL.contactEmail}</a>.</>
        )}
      </div>

      <h2>If this changes</h2>
      <p>
        {analytics
          ? 'If we add any further tracking technology, we will update this table, update the Privacy Policy, and ask for your consent again before anything new is stored. Nothing will be switched on quietly.'
          : 'If we ever add analytics or advertising, we will update this page with a full table of what is set and why, update the Privacy Policy, and put a proper consent banner in place before anything non-essential is stored. Nothing will be switched on quietly.'}
      </p>

      <p style="font-size:13px;">
        See also our <a href="/privacy">Privacy Policy</a>,
        <a href="/terms">Terms of Service</a> and <a href="/about">About</a> page.
      </p>
    </div>
  </section>
</BaseLayout>
