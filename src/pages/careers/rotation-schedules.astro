---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { articleSchema } from '../../lib/techarticle.js';

const jsonLd = articleSchema({
  sourcePath: 'src/pages/careers/rotation-schedules.astro',
  path: '/careers/rotation-schedules',
  headline: "Rig Rotation Schedules Explained: 14/14, 21/21, 28/28",
  description: "What hitch and rotation actually mean, the common offshore and onshore patterns, and a calculator to convert a rotation and hourly rate into real annual pay and days off.",
  lang: 'en',
  extra: { mainEntityOfPage: { "@id": "https://rigfloorhq.com/careers/rotation-schedules#webpage" } },
});

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://rigfloorhq.com/careers/rotation-schedules#webpage",
  "url": "https://rigfloorhq.com/careers/rotation-schedules",
  "name": "Rig Rotation Schedules Explained: 14/14, 21/21, 28/28",
  "inLanguage": "en",
  "isPartOf": { "@id": "https://rigfloorhq.com/#website" },
  "mainEntity": { "@id": "https://rigfloorhq.com/careers/rotation-schedules#article" },
};

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": "https://rigfloorhq.com/careers/rotation-schedules#app",
  "name": "Rotation Pay & Days Calculator",
  "url": "https://rigfloorhq.com/careers/rotation-schedules",
  "mainEntityOfPage": { "@id": "https://rigfloorhq.com/careers/rotation-schedules#webpage" },
  "description": "Convert a rotation schedule, hourly rate, and per diem into annual days worked, days off, and total pay.",
  "applicationCategory": "UtilitiesApplication",
  "applicationSubCategory": "Career planning calculator",
  "operatingSystem": "Any (web browser)",
  "browserRequirements": "Requires JavaScript",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@id": "https://rigfloorhq.com/#organization" }
};

const faq = [
  {
    q: "What does a '14/14' rotation actually mean?",
    a: "14 days on location working, followed by 14 days off at home — the two numbers are always days on, then days off, not hours or weeks. A 'hitch' is one on-period; some companies count the travel day as part of the hitch, others don't, so confirm which convention a specific contractor uses before comparing offers.",
  },
  {
    q: "Why do offshore rotations run longer than onshore ones?",
    a: "Offshore crews can't just drive home at the end of a tour — getting to and from an installation means a flight or boat, so the on-period is stretched longer to make that travel cost and disruption worth it, matched by a correspondingly longer block of time off. Onshore rigs near a crew's home base can run shorter rotations, or even a daily commute, because there's no travel barrier to amortize.",
  },
  {
    q: "Does a longer rotation mean more total pay?",
    a: "Not by itself. Annual pay is hourly rate times hours actually worked, and a 28/28 schedule works the same fraction of the year as a 14/14 schedule (half, in both cases) — so at the same hourly rate, the annual totals land close to the same. What a longer rotation actually buys is bigger uninterrupted blocks of time off, not more money, which is why the real comparison is lifestyle fit, not pay.",
  },
  {
    q: "Is per diem included in offshore pay?",
    a: "Usually not as a separate line item, because room and board on the installation itself is free during the hitch — the isolation premium onshore workers get via per diem is instead baked into a higher offshore hourly or day rate. Onshore crews working away from home more commonly see a standalone daily per diem on top of wages, commonly in the $75-150/day range, since they're paying for their own food and lodging during the hitch.",
  },
  {
    q: "What does a UK North Sea '2/2' or '2/3' rotation mean?",
    a: "Same days-on, days-off notation as everywhere else, just shorter blocks: 2 weeks offshore followed by 2 weeks at home (2/2), or 2 weeks on followed by 3 weeks off (2/3). Two-week tours are the standard UK North Sea pattern, in contrast to the 21/21 and 28/28 blocks more common on deepwater installations further from a home base — the shorter North Sea tour reflects a comparatively short helicopter hop to UK or Norwegian shore bases rather than the multi-day travel a remote deepwater posting involves.",
  },
];
---
<BaseLayout
  title="Rig Rotation Schedules Explained: 14/14, 21/21, 28/28"
  description="What hitch and rotation mean, the common offshore and onshore patterns, and a calculator converting rotation and hourly rate into real annual pay."
  extraJsonLd={[webPageLd, webAppLd]}
  jsonLd={jsonLd}
  breadcrumbs={[{ label: 'Careers', href: '/careers' }, { label: 'Rotation Schedules', href: '/careers/rotation-schedules' }]}
  lang="en"
  alternateHref="/es/careers/rotation-schedules"
>
  <Nav slot="nav" lang="en" alternateHref="/es/careers/rotation-schedules" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Careers</div>
    <h1>Rig Rotation <span>Schedules</span></h1>
    <p class="page-hero-sub">14/14, 21/21, 28/28 — the two numbers mean days on, then days off. What each pattern actually costs and gives back, and a calculator to turn a schedule and rate into real annual numbers.</p>
    <div class="page-meta">
      <span class="page-meta-item">Common patterns: <strong>14/14, 21/21, 28/28</strong></span>
      <span class="page-meta-item">Standard tour: <strong>12 hours</strong></span>
    </div>
  </div>

  <section class="block">
    <div class="two-col">
      <div>
        <div class="calc-box">
          <div class="calc-title">🎯 Rotation Pay &amp; Days Calculator</div>
          <div class="input-row">
            <div class="input-group">
              <label for="days-on">Days On</label>
              <input type="number" id="days-on" value="14">
            </div>
            <div class="input-group">
              <label for="days-off">Days Off</label>
              <input type="number" id="days-off" value="14">
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="hourly-rate">Hourly Rate ($)</label>
              <input type="number" id="hourly-rate" value="28" step="0.5">
            </div>
            <div class="input-group">
              <label for="per-diem">Per Diem ($/day, 0 if free room &amp; board)</label>
              <input type="number" id="per-diem" value="0" step="5">
            </div>
          </div>
          <div class="calc-output visible" aria-live="polite" style="margin-top:16px;">
            <div class="output-line"><span class="output-label">Rotation Cycle</span><span class="output-value" id="out-cycle">—</span></div>
            <div class="output-line"><span class="output-label">Days Worked per Year</span><span class="output-value" id="out-days-worked">—</span></div>
            <div class="output-line"><span class="output-label">Days Off per Year</span><span class="output-value" id="out-days-off">—</span></div>
            <div class="output-line"><span class="output-label">Hours Worked per Year</span><span class="output-value" id="out-hours">—</span></div>
            <div class="output-line"><span class="output-label">Base Pay</span><span class="output-value" id="out-base">—</span></div>
            <div class="output-line"><span class="output-label">Per Diem Total</span><span class="output-value" id="out-perdiem">—</span></div>
            <div class="output-line headline"><span class="output-label">Total Annual Pay</span><span class="output-value" id="out-total">—</span></div>
            <div class="output-line headline" style="border-bottom:none;"><span class="output-label">FTE-Equivalent Rate</span><span class="output-value" id="out-fte">—</span></div>
          </div>
        </div>
        <div class="note-box mt-24">
          <strong>Why "FTE-equivalent" and not just the hourly rate.</strong> A standard 2,080-hour work year (40 hrs/week × 52 weeks) is the baseline used throughout the <a href="/careers/salary">salary guide</a> to convert annual pay into a comparable hourly figure — it is not the actual contract rate, which runs against the 12-hour tour instead.
        </div>
      </div>

      <div class="prose">
        <h2 id="what-the-numbers-mean">What the Numbers Actually Mean</h2>
        <p>A rotation schedule is written as two numbers: days on, then days off. 14/14 means 14 days on location working, then 14 days at home. The on-period is called a "hitch" — some companies count the travel day to and from location as part of the hitch, others don't, which is worth confirming before comparing two offers that look identical on paper. Every day worked during a hitch is typically a full 12-hour tour, not a standard 8-hour shift, which is the baseline this calculator and the <a href="/careers/salary">salary guide</a> both use.</p>

        <h2 id="common-patterns">The Common Patterns</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Pattern</th><th>Typical Setting</th><th>Why</th></tr></thead>
            <tbody>
              <tr><td>7/7 or daily commute</td><td>Onshore, crew lives near the rig</td><td>No travel barrier to amortize — shorter cycles are practical</td></tr>
              <tr><td>14/14</td><td>Onshore (longer-haul crews) and standard offshore</td><td>The most common pattern industry-wide; balances travel cost against time away</td></tr>
              <tr><td>21/21</td><td>Offshore, some international postings</td><td>Longer blocks to offset a harder or more expensive commute to location</td></tr>
              <tr><td>28/28</td><td>Deepwater and remote international offshore</td><td>Travel to a remote or deepwater installation is expensive enough that the on/off blocks stretch furthest here</td></tr>
            </tbody>
          </table>
        </div>
        <p>None of these are fixed rules — a specific contractor's schedule depends on the installation, the basin, and the contract with the operator. See the <a href="/careers/salary#offshore-vs-onshore">offshore vs onshore pay comparison</a> for how these patterns interact with the pay premium offshore roles carry, and the full <a href="/careers/offshore-vs-land-rig-jobs">offshore vs land rig jobs comparison</a> for the rest of what differs beyond rotation and pay.</p>

        <h2 id="regional-conventions">Regional Conventions and Notation</h2>
        <p>The days-on/days-off notation is universal, but which specific pattern is standard, and how it's written, shifts by region. The <strong>UK North Sea</strong> commonly runs shorter two-week tours, written as "2/2" or "2/3" (2 weeks on, then 2 or 3 weeks off) rather than the 14/14 shorthand used elsewhere — same meaning, different convention, and a comparatively short helicopter hop to a UK or Norwegian shore base is part of why the tour itself can stay shorter than a remote deepwater posting's. <strong>Gulf of Mexico</strong> offshore work commonly runs 14/14, matching the broader pattern already covered above. Land contracts in parts of the <strong>Middle East</strong>, particularly for crews on long-term international assignment away from their home country rather than commuting locally, more commonly run extended tours with correspondingly longer blocks of leave, closer in shape to a deepwater offshore rotation than to a domestic land schedule — the international travel distance is doing the same work there that it does for offshore crews, even though the rig itself is on land. Always confirm the specific notation and convention a given recruiter or contractor uses rather than assuming it matches your home region's shorthand.</p>

        <h2 id="longer-isnt-more-pay">A Longer Rotation Isn't More Pay — It's More Time Off</h2>
        <p>Annual pay comes from hours actually worked times the hourly rate, and every standard rotation pattern works the same fraction of the year: half on, half off. A 28/28 schedule and a 14/14 schedule at the identical hourly rate produce essentially the same annual total, because both work exactly half of the year's days. What changes is the shape of the time off — a 28/28 worker gets four uninterrupted weeks at a stretch rather than two, which on a deepwater posting with expensive travel is usually the entire point. Use the calculator above to check this directly: change days on and off while holding the ratio roughly constant and watch total annual pay barely move.</p>

        <h2 id="per-diem-vs-free-board">Per Diem vs. Free Room and Board</h2>
        <p>Offshore roles almost never carry a separate per diem line, because food and lodging on the installation are provided for free during the hitch — nearly all of an offshore wage is disposable income for exactly that reason. Onshore crews working away from their home base more commonly see per diem instead, commonly in the $75-150/day range, since they're covering their own food and lodging. Set per diem to $0 in the calculator above for a free-board offshore scenario, or enter a real daily figure for an onshore away-crew comparison.</p>

        <div class="note-box">
          <strong>Compare annualized totals, never hourly rate alone.</strong> As the <a href="/careers/salary#hourly-per-diem">salary guide's hourly conversion section</a> covers, two postings with the same advertised hourly rate but different rotations can produce very different real annual pay — always run both through the same days-worked math before deciding.
        </div>

        <h2 id="shift-patterns">Shift Patterns Within a Hitch: Day, Night and Swing</h2>
        <p>The rotation pattern (14/14, 21/21, 28/28) answers "how long is the hitch." A separate question is which 12-hour tour you're actually standing once you're on location, because most rigs run two full crews to cover the clock around the clock: a day crew (commonly 6am-6pm, or the rig's equivalent local convention) and a night crew (the mirrored 12 hours), each working the full length of the hitch on their assigned tour. Some contractors run a fixed assignment — a hand stays on days or nights for the length of their time on that rig — while others "swing" crews between day and night tour on a schedule of their own, commonly swapping at the start of a new hitch rather than mid-hitch, specifically to avoid disrupting sleep cycles more than once per rotation.</p>
        <p>Night tour carries a real fatigue cost beyond just "it's dark out" — circadian disruption affects alertness on exactly the kind of repetitive, hazard-dense work (tripping pipe, connections, well control vigilance) this site covers throughout the <a href="/drilling/well-control">well control procedures hub</a> and the <a href="/equipment/rig-floor-tools">rig floor tools guide</a>. Crews and supervisors managing a night tour take this seriously for good reason: a kick or an equipment hazard doesn't become less dangerous because it happens at 3am on day 11 of a 14-day hitch, and most companies' own safety training and shift-handover procedures are built around that reality rather than treating day and night tours as interchangeable in practice.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Frequently Asked Questions</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .output-line.headline .output-value { color: var(--amber); font-size: 18px; }
</style>

<script is:inline src="/scripts/calculators/rotation-schedules.js" defer></script>
