import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { articleSchema } from '../../lib/techarticle.js';
import { authorChrisCooper } from '../../lib/person.js';

// Article for this career guide. Dates come from git via the same map the
// sitemap uses, so dateModified always equals this URL's sitemap lastmod.
const jsonLd = articleSchema({
  sourcePath: 'src/pages/careers/company-man.astro',
  path: '/careers/company-man',
  headline: "What Does a Company Man Do? — Career Path & Requirements",
  description: "What a company man actually does, how the role differs from a toolpusher or OIM, the path into it, what it actually pays as a day-rate consultant, and how to get hired.",
  lang: 'en',
  extra: { author: authorChrisCooper() },
});

const faq = [
  {
    q: 'Is a company man an employee of the oil company?',
    a: "Usually not directly. Most work as independent day-rate consultants placed with the operator through a specialty staffing agency, not as salaried operator staff — though a smaller number are direct operator employees on a salary-plus-bonus structure.",
  },
  {
    q: 'How much does a company man actually make per year?',
    a: "It depends heavily on billable days, not a fixed salary, since most are day-rate consultants. At a published $900-$1,900/day range across experience levels and 180-220 billable days a year, that works out to roughly $162,500-$417,500 annually — see the earnings section above for the sourced breakdown.",
  },
  {
    q: 'What experience do you need to become a company man?',
    a: "Operators typically require 10-15+ years of real drilling operations or engineering experience before handing someone sole authority over a well program, plus IWCF Level 4 / IADC WellSharp Supervisor well control certification — well beyond what's required for a contractor-side toolpusher role.",
  },
  {
    q: 'Can you become a company man without an engineering degree?',
    a: "Yes, via the field-up route — experienced drillers and toolpushers who move to the operator side on the strength of real well experience, not a degree. The engineering route is the other common path, not the only one.",
  },
];
---
<BaseLayout
  jsonLd={jsonLd}
  title="What Does a Company Man Do? — Career Path & Requirements"
  description="What a company man actually does, how the role differs from a toolpusher or OIM, the path into it, what it actually pays as a day-rate consultant, and how to get hired."
  breadcrumbs={[{ label: 'Careers', href: '/careers' }, { label: 'Company Man', href: '/careers/company-man' }]}
  lang="en"
  alternateHref="/es/careers/company-man"
>
  <Nav slot="nav" lang="en" alternateHref="/es/careers/company-man" />
  <Footer slot="footer" lang="en" />

  <div class="page-hero">
    <div class="page-hero-eyebrow">Careers — Operator Side</div>
    <h1>What Does a <span>Company Man</span> Do?</h1>
    <p class="page-hero-sub">The operator's representative on location, with final say over the well program. A genuinely different career track from the drilling-contractor supervisory roles it's constantly confused with.</p>
    <div class="page-meta">
      <span class="page-meta-item">By <strong><a href="/about/chris-cooper">Chris Cooper</a></strong></span>
      <span class="page-meta-item">Pay: <strong>$900–$1,900/day as a consultant (~$162K–$417K/yr)</strong></span>
      <span class="page-meta-item">Timeline: <strong>15+ years, often via engineering</strong></span>
      <span class="page-meta-item">Employer: <strong>The Operator, Not the Contractor</strong></span>
    </div>
  </div>

  <section class="block">
    <div class="two-col">
      <div class="prose">
        <h2 id="what-a-company-man-does">What a Company Man Does</h2>
        <p>The company man is the on-site representative of the operator — the oil company that owns the well and is paying for everything happening on it. Every other role covered in this section, from roughneck through OIM, works for the drilling contractor hired to physically drill the well. The company man works for the client funding that contract, and holds final authority over the well program itself: what gets drilled, to what depth, with what casing and cement design, and what happens when something unexpected turns up downhole.</p>
        <p>Day to day, that means reviewing drilling reports and logs against the well plan, approving or rejecting procedures proposed by the toolpusher or OIM, authorizing any deviation from the program, and managing the relationship with every service company on location (mud, cementing, wireline, directional drilling) on the operator's behalf. When a real decision has to be made about the well itself — not the rig, the well — the company man makes it.</p>

        <h2 id="company-man-vs-toolpusher-vs-oim">Company Man vs. Toolpusher vs. OIM</h2>
        <p>This is the single most confused set of titles on a rig, because all three work on location together daily. The distinction is employer and scope, not seniority:</p>
        <ul>
          <li><strong>Toolpusher</strong> — works for the drilling contractor, runs the rig and its crews. See the <a href="/careers/toolpusher">toolpusher guide</a>.</li>
          <li><strong>OIM / Rig Manager</strong> — works for the contractor or installation owner, commands the entire installation. See the <a href="/careers/oim-rig-manager">OIM / Rig Manager guide</a>.</li>
          <li><strong>Company Man</strong> — works for the operator, owns the well program and the final decision on it.</li>
        </ul>
        <p>A toolpusher can tell the company man a procedure is unsafe or impractical for the rig to execute. The company man can tell the toolpusher the well program requires it anyway. Neither outranks the other in the usual sense — they represent different interests that have to be reconciled on every well, which is exactly why clear communication between these roles is treated as a core professional skill, not a soft one.</p>

        <h2 id="how-people-get-here">How People Get Here</h2>
        <p>Unlike the driller-to-toolpusher-to-OIM ladder, there's no single standard path into a company man role. Two real routes exist side by side:</p>
        <div class="career-path" style="margin-top:24px;">
          <div class="career-step">
            <h3>Field-Up Route</h3>
            <p>Experienced drillers or toolpushers move to the operator side, trading contractor-side rig operations knowledge for well-program authority. Common where deep field experience is valued as much as formal engineering training.</p>
          </div>
          <div class="career-step">
            <h3>Engineering Route</h3>
            <p>Petroleum or drilling engineers move into a company man / drilling supervisor role after years in an operator's engineering or operations group, bringing well-planning and subsurface knowledge rather than rig-floor experience first.</p>
          </div>
        </div>
        <p>Both routes converge on the same core requirement: enough real well experience, from either side of the fence, to make the program-level calls that actually hold up when something goes wrong 2,000 feet underground.</p>

        <h2 id="earnings">Earnings: the Day-Rate Consultant Model</h2>
        <p>Most company men aren't salaried operator employees — they work as independent day-rate consultants, placed with an operator through a specialty drilling-consultant staffing agency rather than hired directly. That 1099-contractor structure, not the job title, is what produces the wide pay range on this page: income is the day rate multiplied by actual billable days worked, not a fixed annual salary, and it comes with minimal or no benefits since the consultant is not an employee of either the operator or the agency placing them.</p>
        <p>Published day rates run roughly <strong>$900–$1,900 a day</strong> across experience levels — entry-level consultants typically see $900–$1,150/day, mid-career $1,200–$1,500/day, and senior consultants $1,600–$1,900/day. Annualized against a realistic 180–220 billable days a year, that works out to roughly <strong>$162,500–$417,500</strong>, which is why this page's own range at the top of the article runs as wide as it does. A smaller number of company men are direct operator staff employees instead of day-rate contractors, typically on a salary-plus-bonus structure similar to an in-house drilling engineer; that path trades the day-rate upside for steadier income and real benefits.</p>
        <p style="color:var(--fog);font-size:13px;max-width:760px;margin-top:10px;">Source: <a href="https://www.rigzone.com/insights/salary-1/how-much-does-a-drilling-consultant-earn-annually-51" style="color:var(--amber);">Rigzone, "How much does a drilling consultant earn annually?"</a>. Day rates vary by basin, well complexity and the commodity cycle — see the <a href="/careers/salary">salary guide</a>'s note on why every published range here is a snapshot, not a rate card.</p>

        <h2 id="what-operators-require">What Operators Require</h2>
        <p>Because the company man carries final authority over the well program with no one above them on location to check that judgment in the moment, operators screen for this role differently than for a contractor-side supervisory job:</p>
        <ul>
          <li><strong>Deep, program-level experience</strong> — typically 10-15+ years in drilling operations or engineering before an operator will hand someone sole authority over a well program, well beyond the field-experience threshold for a contractor-side toolpusher.</li>
          <li><strong>IWCF Level 4 / IADC WellSharp Supervisor</strong> well control competency, the same bar as a toolpusher or OIM, since approving well control procedures in real time is squarely part of the role. See the full ladder at <a href="/pillars/rig-floor-leadership">Rig Floor Leadership</a> and the certification breakdown at <a href="/careers/certifications">certifications</a>.</li>
          <li><strong>A clean HSE and incident record.</strong> Operators check references from prior wells directly, not just a resume, since a bad call on a well program is the operator's liability, not the staffing agency's.</li>
          <li><strong>Independent-contractor insurance</strong> — day-rate consultants typically carry their own professional liability coverage, since they are not covered under either the operator's or the drilling contractor's employee policies.</li>
          <li><strong>No guaranteed term.</strong> A day-rate consulting assignment is renewed well by well, or dropped, based on performance — there is no tenure protection equivalent to staff employment.</li>
        </ul>

        <h2 id="how-company-men-get-hired">How Company Men Get Hired</h2>
        <p>Hiring runs through a different channel than the driller-to-toolpusher-to-OIM ladder's usual promote-from-within path:</p>
        <ul>
          <li><strong>Through a drilling-consultant staffing agency.</strong> Most day-rate company men are placed by a specialty agency that maintains a roster of experienced consultants and contracts them out to operators well by well — the agency, not the operator, is who a consultant applies to and is paid through.</li>
          <li><strong>Direct operator hire, for the staff-employee path.</strong> Operators hiring a company man as a salaried staff position recruit the same way they hire other engineering or operations staff — directly, through the operator's own HR process, usually from within their engineering or drilling-operations group.</li>
        </ul>
        <p>Both routes still require the field-up or engineering background covered above — the agency or operator is screening for the same judgment and experience either way, just hiring for it through a different structure.</p>

        <h2 id="faq">Frequently Asked Questions</h2>
        <div class="accordion">
          {faq.map((item) => (
            <details class="acc-item">
              <summary class="acc-header">{item.q}<span class="acc-arrow">▼</span></summary>
              <div class="acc-body"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>

      <div>
