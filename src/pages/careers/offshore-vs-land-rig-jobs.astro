          <a href="#safety-profile">Safety Profile</a>
          <a href="#faq">FAQ</a>
        </div>

        <div class="card" style="margin-top:20px;border:1px solid var(--iron);border-radius:4px;">
          <h3>Related Reading</h3>
          <a href="/careers/salary" class="card-link">→ Full Pay Guide: Offshore vs Onshore</a><br><br>
          <a href="/careers/rotation-schedules" class="card-link">→ Rotation Schedules Guide &amp; Calculator</a><br><br>
          <a href="/equipment/rig-types" class="card-link">→ The Six Rig Types Compared</a><br><br>
          <a href="/careers/certifications" class="card-link">→ Full Certifications Guide</a><br><br>
          <a href="/careers/roustabout" class="card-link">→ How to Become a Roustabout</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="prose" style="max-width:820px;">
      <h2 id="faq">Frequently Asked Questions</h2>
      {faq.map((item) => (
        <div style="margin-bottom:18px;">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </div>
  </section>

  <SourcesStandards lang="en" ids={['iwcf', 'iadcWellsharp']} />
</BaseLayout>
