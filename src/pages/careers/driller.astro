  sourcePath: 'src/pages/careers/driller.astro',
  path: '/careers/driller',
  headline: "How to Become a Driller — Career Path & IWCF Requirements",
  description: "The complete path from roughneck to driller: IWCF well control certifications, timeline, salary, and what the job actually involves at the console.",
  lang: 'en',
