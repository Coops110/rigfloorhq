const faq = [
  {
    q: "Is a derrickhand the same thing as a 'DFO' on a job posting?",
    a: "Yes. \"Drilling Fluid Operator\" (DFO) is the formal job-posting title several contractors and staffing agencies use for the exact same role — monkey board work during tripping plus day-to-day mud system responsibility. If a posting lists DFO duties (mud properties, shale shakers, solids control) alongside monkey board or derrick work, it's the derrickhand job under a different name, not a separate position.",
  },
  {
    q: "Do derrickhands work on workover rigs too, or only drilling rigs?",
    a: "The role exists on workover rigs, but the equipment and title shift. A workover rig's derrickman typically works from a tubing board rather than a drilling rig's monkey board, racking tubing joints into a rod basket or tubing board rack instead of a fingerboard, since workover strings are usually tubing or smaller-diameter pipe rather than full drill pipe stands. The core skill — guiding pipe at height during tripping — carries over directly; the specific rack hardware and pipe size don't.",
  },
  {
    q: "How much does a derrickhand make per hour?",
    a: "Job postings often quote derrickhand pay hourly rather than as an annual salary. Converted to the same 2,080-hour FTE-equivalent basis the full <a href=\"/careers/salary#hourly-per-diem\">salary guide</a> uses for comparison, the $55,000-$90,000 annual range works out to roughly $26-$43/hr, centered around $36/hr at the $75,000 typical figure — though the real contract rate is paid against a 12-hour tour, not a standard 40-hour week, so a job posting's advertised hourly number by itself doesn't translate directly into that annual figure without knowing the rotation.",
  },
  {
    q: "Do you need IWCF certification to become a derrickhand, or just to get promoted from it?",
    a: "Neither, strictly — no certification is required to hold the derrickhand title itself. In practice, most hands are already working on IWCF Level 2 (or the equivalent WellSharp Introductory tier) by the time they're promoted into this role, because it's the clearest signal to a toolpusher that someone is building toward assistant driller rather than treating derrickhand as a ceiling. See <a href=\"/careers/iwcf-vs-iadc-wellsharp\">IWCF vs IADC WellSharp</a> for how the two certification bodies' tiers line up.",
  },
];

const jsonLd = articleSchema({
