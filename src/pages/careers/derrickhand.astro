  "@id": "https://rigfloorhq.com/careers/derrickhand#webpage",
  "url": "https://rigfloorhq.com/careers/derrickhand",
  "name": "What Does a Derrickhand Do? Job, Pay and How to Get There",
  "inLanguage": "en",
