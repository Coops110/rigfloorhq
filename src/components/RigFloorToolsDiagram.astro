---
// Shows how tongs, slips and elevators sit relative to each other around a
// single connection at the rotary table — the "core rhythm of tripping
// pipe" the page's own Elevators section describes in prose (elevators
// lower the string onto the slips, the connection breaks or makes up with
// tongs, elevators latch the next joint). Same inline-SVG pattern as the
// other diagram components. Added 2026-10-21 for the "none of the 9 pages
// added 10-20 has an image" audit finding.
export interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

const t = lang === 'es'
  ? {
      title: 'Posición de tenazas, cuñas y elevadores alrededor de una conexión',
      desc: 'Vista lateral de la mesa rotaria con una sarta de tubería pasando por ella. Las cuñas se asientan dentro de la mesa rotaria y sujetan el cuerpo de la tubería por acción de cuña, soportando el peso de la sarta. Los elevadores se enganchan debajo del upset de una junta de herramienta, arriba de las cuñas, y se conectan al bloque viajero para subir o bajar la sarta. Las tenazas agarran el cuerpo de la tubería en el punto de conexión, entre las cuñas y los elevadores, para aplicar el torque que hace o deshace la conexión.',
      travelingBlock: 'Bloque Viajero',
      elevators: 'Elevadores',
      toolJoint: 'Upset de Junta de Herramienta',
      tongs: 'Tenazas',
      rotaryTable: 'Mesa Rotaria',
      slips: 'Cuñas',
      caption: 'Los elevadores bajan la sarta hasta que su peso pasa a las cuñas; las tenazas hacen o deshacen la conexión; los elevadores engancha la siguiente junta. Ese ciclo se repite en cada tramo de viaje. No está a escala.',
    }
  : {
      title: 'How tongs, slips and elevators sit around a single connection',
      desc: "Side view of the rotary table with a drill string running through it. Slips sit inside the rotary table and grip the pipe body by wedging action, carrying the string's weight. Elevators latch below a tool joint's upset, above the slips, and connect up to the traveling block to raise or lower the string. Tongs grip the pipe body at the connection point, between the slips and the elevators, to apply the torque that makes up or breaks out the connection.",
      travelingBlock: 'Traveling Block',
      elevators: 'Elevators',
      toolJoint: 'Tool Joint Upset',
      tongs: 'Tongs',
      rotaryTable: 'Rotary Table',
      slips: 'Slips',
      caption: "Elevators lower the string until its weight transfers to the slips; tongs make or break the connection; elevators latch the next joint. That cycle repeats on every trip stand. Not to scale.",
    };
---
<figure class="rft-figure">
  <svg class="rft-svg" viewBox="0 0 360 480" role="img" aria-labelledby={`rft-title-${lang} rft-desc-${lang}`} xmlns="http://www.w3.org/2000/svg">
    <title id={`rft-title-${lang}`}>{t.title}</title>
    <desc id={`rft-desc-${lang}`}>{t.desc}</desc>

    <rect class="rft-bg" x="0" y="0" width="360" height="480" rx="6" />

    {/* traveling block at top */}
    <rect class="rft-block" x="150" y="20" width="60" height="30" rx="3" />
    <text class="rft-label" x="220" y="40">{t.travelingBlock}</text>

    {/* bails */}
    <line class="rft-bail" x1="160" y1="50" x2="160" y2="90" />
    <line class="rft-bail" x1="200" y1="50" x2="200" y2="90" />

    {/* elevators */}
    <rect class="rft-elevator" x="148" y="90" width="64" height="26" rx="4" />
    <text class="rft-label" x="220" y="107">{t.elevators}</text>

    {/* pipe through elevators */}
    <rect class="rft-pipe" x="172" y="116" width="16" height="40" />
    {/* tool joint upset right below elevators */}
    <rect class="rft-joint" x="166" y="150" width="28" height="12" rx="2" />
    <text class="rft-label" x="220" y="160">{t.toolJoint}</text>

    {/* tongs gripping below the joint */}
    <rect class="rft-tongs" x="150" y="175" width="26" height="40" rx="4" />
    <rect class="rft-tongs rft-tongs-lower" x="184" y="200" width="26" height="40" rx="4" />
    <text class="rft-label" x="240" y="195">{t.tongs}</text>

    {/* pipe continuing down to the rotary table */}
    <rect class="rft-pipe" x="172" y="215" width="16" height="130" />

    {/* rotary table */}
    <rect class="rft-rotary" x="110" y="345" width="140" height="30" rx="4" />
    <text class="rft-label" x="268" y="365">{t.rotaryTable}</text>

    {/* slips inside the rotary table, gripping the pipe */}
    <polygon class="rft-slips" points="164,345 196,345 186,375 174,375" />
    <text class="rft-label" x="268" y="385">{t.slips}</text>

    {/* pipe continuing down below the rotary table into the hole */}
    <rect class="rft-pipe" x="172" y="375" width="16" height="70" />
  </svg>
  <figcaption class="rft-caption">{t.caption}</figcaption>
</figure>

<style>
  .rft-figure {
    margin: 24px 0 28px;
    max-width: 380px;
  }
  .rft-svg {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--iron);
    border-radius: 6px;
  }
  .rft-bg {
    fill: var(--ink);
  }
  .rft-block {
    fill: var(--steel);
    stroke: var(--mist);
    stroke-width: 1.5;
  }
  .rft-bail {
    stroke: var(--fog);
    stroke-width: 2;
  }
  .rft-elevator {
    fill: rgba(232,160,32,0.18);
    stroke: var(--amber);
    stroke-width: 2;
  }
  .rft-pipe {
    fill: var(--steel);
    stroke: var(--mist);
    stroke-width: 1.2;
  }
  .rft-joint {
    fill: var(--iron);
    stroke: var(--mist);
    stroke-width: 1.2;
  }
  .rft-tongs {
    fill: rgba(240,112,56,0.18);
    stroke: var(--ember);
    stroke-width: 2;
  }
  .rft-tongs-lower {
    fill: rgba(136,146,164,0.18);
    stroke: var(--fog);
  }
  .rft-rotary {
    fill: var(--steel);
    stroke: var(--iron);
    stroke-width: 2;
  }
  .rft-slips {
    fill: rgba(34,197,94,0.18);
    stroke: var(--safe);
    stroke-width: 2;
  }
  .rft-label {
    fill: var(--fog);
    font-family: var(--body);
    font-size: 13px;
  }
  .rft-caption {
    color: var(--fog);
    font-size: 13px;
    margin-top: 8px;
    text-align: center;
  }
</style>
