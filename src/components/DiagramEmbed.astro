---
// ─────────────────────────────────────────────────────────────
//  EMBEDDABLE DIAGRAM
//
//  Offers a copy-paste snippet so other sites can republish a diagram with
//  attribution back to the page it came from. That attribution link is the
//  point — it is a normal editorial credit, not a scheme, and it turns a
//  diagram we have already paid to produce into a standing reason for other
//  people to link here.
//
//  Deliberately no rel="nofollow" and no tracking parameters. This is a
//  genuine credit for genuine reuse. Equally, nothing here obliges anyone to
//  link: the licence line asks for attribution, it does not demand a followed
//  link in exchange for use, which would be a link scheme.
// ─────────────────────────────────────────────────────────────
import { SITE } from '../lib/site.js';

export interface Props {
  src: string;        // absolute path, e.g. /images/blog/foo.svg
  alt: string;        // the same descriptive alt used in the article
  title: string;      // human title for the credit line
  pagePath: string;   // absolute path of the page being credited
  lang?: 'en' | 'es';
}

const { src, alt, title, pagePath, lang = 'en' } = Astro.props as Props;

const origin = SITE.domain.replace(/\/$/, '');
const imgUrl = `${origin}${src}`;
const pageUrl = `${origin}${pagePath}`;

// Built as a single string so what the user copies is exactly what they see.
const snippet =
  `<a href="${pageUrl}">\n` +
  `  <img src="${imgUrl}" alt="${alt}" width="900" style="max-width:100%;height:auto;" />\n` +
  `</a>\n` +
  `<p>Diagram: <a href="${pageUrl}">${title} — ${SITE.name}</a></p>`;

// A slide deck cannot use an HTML snippet, and a toolbox talk is the most
// likely reuse this site will ever get. So the file itself is offered too,
// with a credit line short enough to sit in a slide footer.
//
// Be clear-eyed about the trade: the embed snippet is what earns a link back,
// the download earns none. The snippet therefore stays first and the download
// is framed as the presentation option rather than the default.
const ext = (src.split('.').pop() || '').toUpperCase();
const fileName = src.split('/').pop() || 'diagram';
// Deliberately does not repeat the diagram title. A slide is already showing
// the diagram, so the title is redundant there, and the descriptive titles this
// site uses run to 140+ characters — far too long for a footer. Source and URL
// is what a credit actually needs.
const creditLine = `Source: ${SITE.name} — ${origin.replace(/^https?:\/\//, '')}${pagePath}`;

const t = lang === 'es'
  ? {
      heading: 'Usar este diagrama',
      blurb: 'Puede publicar este diagrama en su propio sitio, presentación o material de formación de forma gratuita. Solo pedimos una atribución con enlace de vuelta.',
      copy: 'Copiar código',
      copied: 'Copiado',
      selected: 'Seleccionado — pulse Ctrl+C',
      manual: 'Seleccione y copie el código si el botón no funciona.',
      creditLabel: 'Línea de crédito para una diapositiva o folleto',
      copyCredit: 'Copiar crédito',
      download: `Descargar ${ext}`,
      downloadNote: 'Para una presentación o charla de seguridad. Conserve el crédito.',
    }
  : {
      heading: 'Use this diagram',
      blurb: 'You are free to republish this diagram on your own site, in a presentation, or in training material. All we ask is a credit linking back.',
      copy: 'Copy embed code',
      copied: 'Copied',
      selected: 'Selected — press Ctrl+C',
      manual: 'Select and copy the code if the button does not work.',
      creditLabel: 'Credit line for a slide or handout',
      copyCredit: 'Copy credit',
      download: `Download ${ext}`,
      downloadNote: 'For a presentation or toolbox talk. Please keep the credit line.',
    };
---
<div class="embed-offer">
  <div class="embed-head">
    <span class="embed-label">{t.heading}</span>
  </div>
  <p class="embed-blurb">{t.blurb}</p>

  <div class="embed-field">
    <textarea class="embed-code" readonly rows="4" spellcheck="false" aria-label={t.heading}>{snippet}</textarea>
    <div class="embed-actions">
      <button type="button" class="embed-copy" data-copied={t.copied} data-selected={t.selected}>{t.copy}</button>
      <span class="embed-manual">{t.manual}</span>
    </div>
  </div>

  <div class="embed-field">
    <label class="embed-sublabel" for={`credit-${fileName}`}>{t.creditLabel}</label>
    <textarea class="embed-code" id={`credit-${fileName}`} readonly rows="2" spellcheck="false">{creditLine}</textarea>
    <div class="embed-actions">
      <button type="button" class="embed-copy embed-copy-alt" data-copied={t.copied} data-selected={t.selected}>{t.copyCredit}</button>
      <a class="embed-download" href={src} download={fileName}>{t.download}</a>
      <span class="embed-manual">{t.downloadNote}</span>
    </div>
  </div>
</div>

<script>
  // Delegated so it works for any number of embed blocks on a page, including
  // ones rendered inside a content collection.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('.embed-copy') as HTMLButtonElement | null;
    if (!btn) return;
    // Scope to the field, not the whole block — there are two textareas now
    // (embed snippet and credit line) and .embed-offer would always find the
    // first one, so the credit button would silently copy the wrong thing.
    const scope = btn.closest('.embed-field') || btn.closest('.embed-offer');
    const box = scope?.querySelector('.embed-code') as HTMLTextAreaElement | null;
    if (!box) return;

    // Every path has to say what happened. The first version selected the text
    // on fallback and changed nothing on the button, so the user saw a
    // highlighted box and had no idea whether it had copied.
    const flash = (msg: string, success: boolean) => {
      if (btn.dataset.busy) return;
      btn.dataset.busy = '1';
      const original = btn.textContent;
      btn.textContent = msg;
      btn.classList.toggle('is-copied', success);
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('is-copied');
        delete btn.dataset.busy;
      }, 2200);
    };

    const copied = () => flash(btn.dataset.copied || 'Copied', true);

    // Selecting the text is the fallback, and it is a real outcome rather than
    // a failure — the user just has to finish the job with the keyboard.
    const selectOnly = () => {
      box.focus();
      box.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      if (ok) copied();
      else flash(btn.dataset.selected || 'Selected — press Ctrl+C', false);
    };

    // writeText needs a secure context AND transient user activation, and can
    // still be refused by permissions policy. Treat rejection as normal.
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(box.value).then(copied).catch(selectOnly);
    } else {
      selectOnly();
    }
  });
</script>

<style>
  .embed-offer {
    border: 1px solid var(--iron);
    border-left: 3px solid var(--ember);
    border-radius: 4px;
    background: var(--steel);
    padding: 16px 18px;
    margin: 22px 0 28px;
  }
  .embed-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember);
  }
  .embed-blurb {
    font-size: 13px;
    line-height: 1.6;
    color: var(--mist);
    margin: 8px 0 12px;
  }
  .embed-code {
    width: 100%;
    background: var(--ink);
    border: 1px solid var(--iron);
    border-radius: 3px;
    color: var(--mist);
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1.6;
    padding: 10px 12px;
    resize: vertical;
    white-space: pre;
    overflow-x: auto;
  }
  .embed-code:focus { outline: 2px solid var(--amber); outline-offset: 1px; }
  .embed-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .embed-copy {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 9px 16px;
    border-radius: 2px;
    cursor: pointer;
    background: var(--rust);
    color: var(--white);
    border: 1px solid var(--rust);
    transition: background 0.15s ease;
  }
  .embed-copy:hover { background: #e05a2a; border-color: #e05a2a; }
  .embed-copy.is-copied { background: var(--safe); border-color: var(--safe); color: var(--ink); }

  /* The credit field is secondary to the embed snippet above it — the snippet
     is what earns a link back, so it keeps the solid button. */
  .embed-field + .embed-field {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--iron);
  }
  .embed-sublabel {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fog);
    margin-bottom: 7px;
  }
  .embed-copy-alt {
    background: transparent;
    color: var(--mist);
    border-color: var(--iron);
  }
  .embed-copy-alt:hover { background: var(--iron); border-color: var(--iron); }
  .embed-copy-alt.is-copied { background: var(--safe); border-color: var(--safe); color: var(--ink); }
  .embed-download {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 9px 16px;
    border-radius: 2px;
    border: 1px solid var(--iron);
    color: var(--mist);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .embed-download:hover, .embed-download:focus-visible {
    border-color: var(--ember);
    color: var(--white);
  }
  .embed-copy:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .embed-manual { font-size: 11.5px; color: var(--fog); }
</style>
