---
// Pilot interactive 3D viewer — poster-image-first, drag-to-rotate only, no auto-spin.
// Geometry is procedurally generated (primitives only, no downloaded mesh/model file),
// built from generic reversing/circulating-sub anatomy, checked against real spec
// sheets and product photos of multi-opening circulation subs from oilfield tool
// manufacturers (generic model names only, no branding/part numbers reproduced):
// a long, slender body — real circulation subs run roughly 10-18x longer than their
// OD, not a stubby 4:1 block — with just 2 large ports 180 degrees apart (spec
// sheets consistently show 2 ports, not a dense ring of many small holes), a single
// raised collar marking the internal shifting-sleeve section, and pin/box thread
// ends that neck down narrower than the body. Not modeled on any specific
// manufacturer's product.
---
<div class="tool3d-wrap" role="img" aria-label="Interactive 3D model of a generic reversing tool — drag to rotate">
  <div class="tool3d-poster" id="tool3d-poster">
    <svg viewBox="0 0 200 200" class="tool3d-poster-icon" aria-hidden="true">
      <rect x="80" y="20" width="40" height="160" rx="4" fill="#3a4148"/>
      <circle cx="70" cy="95" r="7" fill="#1a1c1e"/>
      <circle cx="70" cy="115" r="7" fill="#1a1c1e"/>
      <circle cx="130" cy="95" r="7" fill="#1a1c1e"/>
      <circle cx="130" cy="115" r="7" fill="#1a1c1e"/>
    </svg>
    <div class="tool3d-poster-label">Tap to view 3D model — drag to rotate</div>
  </div>
  <canvas id="tool3d-canvas" class="tool3d-canvas" aria-hidden="true"></canvas>
  <button type="button" class="tool3d-reset" id="tool3d-reset">⟲ Reset View</button>
  <div class="tool3d-fallback" id="tool3d-fallback" hidden>
    3D preview isn't available in this browser — the diagram above and the write-up below cover the same detail.
  </div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.169.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.169.0/examples/jsm/"
  }
}
</script>

<style>
  .tool3d-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 520px;
    min-height: 340px;
    background: radial-gradient(ellipse at 50% 45%, #333c45 0%, #1c2126 45%, #0e1113 100%);
    border: 1px solid var(--iron, #2a2f35);
    border-radius: 6px;
    overflow: hidden;
    cursor: grab;
  }
  .tool3d-wrap:active { cursor: grabbing; }
  .tool3d-poster {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px;
    background: radial-gradient(circle at 50% 40%, #23282d 0%, #14171a 80%);
  }
  .tool3d-poster-icon { width: 96px; height: 96px; }
  .tool3d-poster-label {
    color: #9aa4ad; font-size: 0.85rem; letter-spacing: 0.02em;
  }
  .tool3d-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .tool3d-reset {
    position: absolute; bottom: 14px; right: 14px; z-index: 2; display: none;
    padding: 6px 14px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em;
    color: #e8a020; background: rgba(14, 17, 19, 0.72); border: 1px solid rgba(232, 160, 32, 0.4);
    border-radius: 999px; cursor: pointer;
  }
  .tool3d-reset:hover { background: rgba(14, 17, 19, 0.9); border-color: #e8a020; }
  .tool3d-fallback {
    position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
    padding: 24px; text-align: center; color: #9aa4ad; font-size: 0.9rem;
  }
</style>

<script is:inline>
  const wrap = document.querySelector('.tool3d-wrap');
  const poster = document.getElementById('tool3d-poster');
  const canvas = document.getElementById('tool3d-canvas');
  const fallback = document.getElementById('tool3d-fallback');
  const resetBtn = document.getElementById('tool3d-reset');
  if (!wrap || !poster || !canvas || !fallback || !resetBtn) throw new Error('ReversingTool3D: expected elements missing');

  let started = false;

  async function start() {
    if (started) return;
    started = true;

    const probe = document.createElement('canvas');
    const hasWebGL = !!(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    if (!hasWebGL) {
      poster.style.display = 'none';
      fallback.style.display = 'flex';
      return;
    }

    const THREE = await import('three');
    const { TrackballControls } = await import('three/addons/controls/TrackballControls.js');
    const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

    poster.style.display = 'none';
    canvas.style.display = 'block';
    resetBtn.style.display = 'block';

    const scene = new THREE.Scene();
    scene.background = null;

    // Circulation subs run long and slender (real spec sheets: ~10-18x
    // longer than their OD) — pulled back further than a compact sub like
    // the crossover sub so the full length fits in frame.
    const camera = new THREE.PerspectiveCamera(38, wrap.clientWidth / wrap.clientHeight, 0.1, 100);
    camera.position.set(6.6, 1.98, 6.6);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(wrap.clientWidth, wrap.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const key = new THREE.DirectionalLight(0xfff4e6, 3.4);
    key.position.set(3, 4.5, 2.5);
    const fill = new THREE.DirectionalLight(0x9ecbff, 1.1);
    fill.position.set(-3.5, 1.2, 2);
    const rim = new THREE.DirectionalLight(0xffffff, 2.4);
    rim.position.set(-1, 2.5, -4);
    const kicker = new THREE.PointLight(0xffffff, 1.4, 12);
    kicker.position.set(2, -0.5, 3);
    const ambient = new THREE.HemisphereLight(0x6b7a8c, 0x14100c, 0.9);
    scene.add(key, fill, rim, kicker, ambient);

    // --- Generic reversing/circulating sub, built from primitives ---
    // Anatomy confirmed against real multi-opening circulation sub spec
    // sheets: one long slender body, 2 ports 180 degrees apart at the
    // internal sleeve section (not a dense ring of many small holes), a
    // single raised collar marking that section, and pin/box thread ends
    // narrower than the body. No branded geometry copied.
    const group = new THREE.Group();

    const metal = new THREE.MeshStandardMaterial({ color: 0x9aa4ae, metalness: 0.9, roughness: 0.28 });
    const darkMetal = new THREE.MeshStandardMaterial({ color: 0x5b636b, metalness: 0.85, roughness: 0.35 });
    const bodyMetal = new THREE.MeshStandardMaterial({ color: 0x8b333a, metalness: 0.6, roughness: 0.4 });
    const portMetal = new THREE.MeshStandardMaterial({ color: 0x14171a, metalness: 0.3, roughness: 0.7 });

    const bodyRadius = 0.22;
    const bodyHeight = 4.2;

    // Main body — long and slender, matching real circulation-sub spec
    // sheets (~10-18x longer than their OD).
    const body = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius, bodyRadius, bodyHeight, 28), bodyMetal);
    group.add(body);

    // Top sub — necks down to the exposed pin thread, narrower than the body
    const subLen = 0.5;
    const topSub = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius * 0.68, bodyRadius * 0.92, subLen, 24), metal);
    topSub.position.y = bodyHeight / 2 + subLen / 2;
    group.add(topSub);

    // Bottom sub — mirrored
    const bottomSub = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius * 0.92, bodyRadius * 0.68, subLen, 24), metal);
    bottomSub.position.y = -bodyHeight / 2 - subLen / 2;
    group.add(bottomSub);

    // Two circulation/reverse-out ports, 180 degrees apart, at the internal
    // shifting-sleeve section — matches real spec sheets (2 ports per size),
    // not a dense ring of small holes.
    // Offset by 45 degrees so one port faces the default camera azimuth
    // directly, instead of both ports sitting edge-on and invisible.
    const portRadius = bodyRadius * 0.36;
    for (let i = 0; i < 2; i++) {
      const angle = i * Math.PI + Math.PI / 4;
      const port = new THREE.Mesh(new THREE.CylinderGeometry(portRadius, portRadius, bodyRadius * 0.9, 16), portMetal);
      port.position.set(Math.cos(angle) * bodyRadius, 0, Math.sin(angle) * bodyRadius);
      port.rotation.z = Math.PI / 2;
      port.rotation.y = -angle;
      group.add(port);
    }

    // Single raised collar marking the internal shifting-sleeve section
    const collar = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius * 1.18, bodyRadius * 1.18, 0.3, 28), darkMetal);
    collar.position.y = 0;
    group.add(collar);

    scene.add(group);

    const controls = new TrackballControls(camera, renderer.domElement);
    controls.noZoom = true;
    controls.noPan = true;
    controls.rotateSpeed = 3.2;
    controls.staticMoving = false;
    controls.dynamicDampingFactor = 0.12;
    controls.target.set(0, 0, 0);
    controls.update();
    resetBtn.addEventListener('click', () => controls.reset());

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function onResize() {
      const w = wrap.clientWidth, h = wrap.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      controls.handleResize();
    }
    window.addEventListener('resize', onResize);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
    void reduceMotion;
  }

  poster.addEventListener('click', start, { once: true });
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        // Still requires a tap per the agreed UX spec.
      }
    }
  }, { threshold: 0.4 });
  io.observe(wrap);
</script>
