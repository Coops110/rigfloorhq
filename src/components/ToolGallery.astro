---
// Small click-through image gallery — replaces the earlier hand-coded Three.js
// procedural models, which fell well short of real reference quality on review.
// Two photoreal shots per tool, swapped on click/tap. Not a rotator: independent
// AI-generated angles aren't geometrically consistent frame to frame, so this is
// a curated 2-shot gallery rather than a drag-to-spin viewer.
interface Props {
  image1: string;
  image2: string;
  alt: string;
}
const { image1, image2, alt } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---
<div class="tool-gallery" id={`gallery-${uid}`} role="img" aria-label={alt}>
  <img class="tool-gallery-img active" src={image1} alt={alt} loading="lazy" data-index="0" />
  <img class="tool-gallery-img" src={image2} alt={alt} loading="lazy" data-index="1" />
  <div class="tool-gallery-dots">
    <button type="button" class="tool-gallery-dot active" data-index="0" aria-label="View angle 1"></button>
    <button type="button" class="tool-gallery-dot" data-index="1" aria-label="View angle 2"></button>
  </div>
</div>

<style>
  .tool-gallery {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    background: radial-gradient(ellipse at 50% 45%, #333c45 0%, #1c2126 45%, #0e1113 100%);
    border: 1px solid var(--iron, #2a2f35);
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
  }
  .tool-gallery-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tool-gallery-img.active { opacity: 1; }
  .tool-gallery-dots {
    position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 8px; z-index: 2;
  }
  .tool-gallery-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.5);
    cursor: pointer; padding: 0;
  }
  .tool-gallery-dot.active { background: #e8a020; border-color: #e8a020; }
</style>

<script is:inline define:vars={{ uid }}>
  (function () {
    const root = document.getElementById(`gallery-${uid}`);
    if (!root) return;
    const imgs = root.querySelectorAll('.tool-gallery-img');
    const dots = root.querySelectorAll('.tool-gallery-dot');
    function show(index) {
      imgs.forEach((el) => el.classList.toggle('active', el.dataset.index === String(index)));
      dots.forEach((el) => el.classList.toggle('active', el.dataset.index === String(index)));
    }
    let current = 0;
    root.addEventListener('click', (e) => {
      if (e.target.closest('.tool-gallery-dot')) return;
      current = current === 0 ? 1 : 0;
      show(current);
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        current = Number(dot.dataset.index);
        show(current);
      });
    });
  })();
</script>
