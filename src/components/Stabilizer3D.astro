---
// Pilot interactive 3D viewer — poster-image-first, drag-to-rotate only, no auto-spin.
// Geometry is procedurally generated (primitives only, no downloaded mesh/model file),
// built from generic spiral-blade stabilizer anatomy, checked against real integral
// spiral-blade stabilizer product photos from oilfield tool manufacturers (generic
// model names only, no branding reproduced): a slender mandrel that swells into a
// full-gauge football/barrel-shaped bulge at the blade section (not a constant-
// diameter body with blades merely stuck on its surface), three helical hardfaced
// blades wrapping roughly 270 degrees around that bulge and tapering back down to
// the mandrel at both ends, plus top and bottom tool-joint subs. Not modeled on any
// specific manufacturer's product.
---
<div class="tool3d-wrap" role="img" aria-label="Interactive 3D model of a generic spiral-blade drill string stabilizer — drag to rotate">
  <div class="tool3d-poster" id="tool3d-poster">
    <svg viewBox="0 0 200 200" class="tool3d-poster-icon" aria-hidden="true">
      <rect x="82" y="20" width="36" height="160" rx="4" fill="#3a4148"/>
      <path d="M82 60 Q140 80 82 100 Q140 120 82 140" stroke="#8a94a0" stroke-width="10" fill="none"/>
      <path d="M118 60 Q60 80 118 100 Q60 120 118 140" stroke="#8a94a0" stroke-width="10" fill="none"/>
    </svg>
    <div class="tool3d-poster-label">Tap to view 3D model — drag to rotate</div>
  </div>
  <canvas id="tool3d-canvas" class="tool3d-canvas" aria-hidden="true"></canvas>
  <button type="button" class="tool3d-reset" id="tool3d-reset">⟲ Reset View</button>
  <div class="tool3d-fallback" id="tool3d-fallback" hidden>
    3D preview isn't available in this browser — the diagram above and the write-up below cover the same detail.
  </div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.169.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.169.0/examples/jsm/"
  }
}
</script>

<style>
  .tool3d-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 520px;
    min-height: 340px;
    background: radial-gradient(ellipse at 50% 45%, #333c45 0%, #1c2126 45%, #0e1113 100%);
    border: 1px solid var(--iron, #2a2f35);
    border-radius: 6px;
    overflow: hidden;
    cursor: grab;
  }
  .tool3d-wrap:active { cursor: grabbing; }
  .tool3d-poster {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px;
    background: radial-gradient(circle at 50% 40%, #23282d 0%, #14171a 80%);
  }
  .tool3d-poster-icon { width: 96px; height: 96px; }
  .tool3d-poster-label {
    color: #9aa4ad; font-size: 0.85rem; letter-spacing: 0.02em;
  }
  .tool3d-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .tool3d-reset {
    position: absolute; bottom: 14px; right: 14px; z-index: 2; display: none;
    padding: 6px 14px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em;
    color: #e8a020; background: rgba(14, 17, 19, 0.72); border: 1px solid rgba(232, 160, 32, 0.4);
    border-radius: 999px; cursor: pointer;
  }
  .tool3d-reset:hover { background: rgba(14, 17, 19, 0.9); border-color: #e8a020; }
  .tool3d-fallback {
    position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
    padding: 24px; text-align: center; color: #9aa4ad; font-size: 0.9rem;
  }
</style>

<script is:inline>
  const wrap = document.querySelector('.tool3d-wrap');
  const poster = document.getElementById('tool3d-poster');
  const canvas = document.getElementById('tool3d-canvas');
  const fallback = document.getElementById('tool3d-fallback');
  const resetBtn = document.getElementById('tool3d-reset');
  if (!wrap || !poster || !canvas || !fallback || !resetBtn) throw new Error('Stabilizer3D: expected elements missing');

  let started = false;

  async function start() {
    if (started) return;
    started = true;

    const probe = document.createElement('canvas');
    const hasWebGL = !!(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    if (!hasWebGL) {
      poster.style.display = 'none';
      fallback.style.display = 'flex';
      return;
    }

    const THREE = await import('three');
    const { TrackballControls } = await import('three/addons/controls/TrackballControls.js');
    const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

    poster.style.display = 'none';
    canvas.style.display = 'block';
    resetBtn.style.display = 'block';

    const scene = new THREE.Scene();
    scene.background = null;

    const camera = new THREE.PerspectiveCamera(38, wrap.clientWidth / wrap.clientHeight, 0.1, 100);
    camera.position.set(5.8, 1.74, 5.8);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(wrap.clientWidth, wrap.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const key = new THREE.DirectionalLight(0xfff4e6, 3.4);
    key.position.set(3, 4.5, 2.5);
    const fill = new THREE.DirectionalLight(0x9ecbff, 1.1);
    fill.position.set(-3.5, 1.2, 2);
    const rim = new THREE.DirectionalLight(0xffffff, 2.4);
    rim.position.set(-1, 2.5, -4);
    const kicker = new THREE.PointLight(0xffffff, 1.4, 12);
    kicker.position.set(2, -0.5, 3);
    const ambient = new THREE.HemisphereLight(0x6b7a8c, 0x14100c, 0.9);
    scene.add(key, fill, rim, kicker, ambient);

    // --- Generic spiral-blade stabilizer, built from primitives ---
    // Anatomy confirmed against real integral spiral-blade stabilizer
    // product photos: a slender mandrel that swells into a full-gauge
    // football/barrel bulge at the blade section (the blades and the body
    // between them are both raised well above the mandrel OD — it is not
    // a constant-diameter pipe with blades merely bolted to its surface),
    // three helical blades wrapping ~270 degrees around that bulge and
    // tapering smoothly back down to the mandrel at both ends, plus
    // tapered top/bottom tool-joint subs. No branded geometry copied.
    const group = new THREE.Group();

    const metal = new THREE.MeshStandardMaterial({ color: 0x9aa4ae, metalness: 0.9, roughness: 0.28 });
    const bodyMetal = new THREE.MeshStandardMaterial({ color: 0x8b333a, metalness: 0.6, roughness: 0.4 });
    const hardface = new THREE.MeshStandardMaterial({ color: 0xc7ccd1, metalness: 0.75, roughness: 0.5 });

    const mandrelRadius = 0.16;   // slender pipe OD either side of the blade section
    const valleyRadius = 0.30;    // body OD between blades, at the bulge's widest point
    const tipRadius = 0.44;       // full-gauge blade-crest OD
    const mandrelExt = 1.1;       // straight mandrel length beyond the bulge, each side
    const bulgeHalf = 0.95;       // half-length of the football-shaped bulge/blade zone
    const bulgeLen = bulgeHalf * 2;
    const totalBodyHalf = mandrelExt + bulgeHalf;

    // Smooth bump profile shared by the body bulge and the blade crest —
    // 0 at the ends of the bulge zone (flush with the mandrel), peaking at
    // the midpoint. Reused for both surfaces so the blades visibly rise
    // out of, and settle back into, the swollen body rather than floating
    // above a straight pipe.
    function bump(t) {
      return Math.sin(Math.PI * Math.max(0, Math.min(1, t)));
    }

    // Body — a lathe-revolved profile so the bulge is one continuous
    // surface (no seam between "pipe" and "blade base").
    const profilePoints = [];
    const profileSteps = 48;
    for (let i = 0; i <= profileSteps; i++) {
      const y = -totalBodyHalf + (i / profileSteps) * (2 * totalBodyHalf);
      const withinBulge = Math.abs(y) <= bulgeHalf;
      const t = withinBulge ? (y + bulgeHalf) / bulgeLen : 0;
      const r = withinBulge ? mandrelRadius + (valleyRadius - mandrelRadius) * bump(t) : mandrelRadius;
      profilePoints.push(new THREE.Vector2(Math.max(r, 0.01), y));
    }
    const body = new THREE.Mesh(new THREE.LatheGeometry(profilePoints, 32), bodyMetal);
    group.add(body);

    // Top and bottom tapered tool-joint subs, just past the mandrel ends
    const subLen = 0.4;
    const topSub = new THREE.Mesh(new THREE.CylinderGeometry(mandrelRadius * 0.85, mandrelRadius, subLen, 24), metal);
    topSub.position.y = totalBodyHalf + subLen / 2;
    group.add(topSub);
    const bottomSub = new THREE.Mesh(new THREE.CylinderGeometry(mandrelRadius, mandrelRadius * 0.85, subLen, 24), metal);
    bottomSub.position.y = -totalBodyHalf - subLen / 2;
    group.add(bottomSub);

    // Three helical blades wrapping ~270 degrees around the bulge, each
    // built from stacked short segments that step in rotation and radius
    // as they rise — riding on top of the body's own bulge profile and
    // tapering to zero height at both ends, matching how the blades in
    // real product photos merge smoothly into the mandrel.
    const bladeCount = 3;
    const segments = 24;
    const twistTotal = Math.PI * 1.5; // ~270 degrees, per real spiral-blade stabilizer spec
    for (let b = 0; b < bladeCount; b++) {
      const baseAngle = (b / bladeCount) * Math.PI * 2;
      for (let s = 0; s < segments; s++) {
        const t = s / (segments - 1);
        const y = -bulgeHalf + t * bulgeLen;
        const angle = baseAngle + t * twistTotal;
        const rootHere = mandrelRadius + (valleyRadius - mandrelRadius) * bump(t);
        const tipHere = mandrelRadius + (tipRadius - mandrelRadius) * bump(t);
        const thickness = Math.max(tipHere - rootHere, 0.005);
        const rMid = (rootHere + tipHere) / 2;

        const seg = new THREE.Mesh(new THREE.BoxGeometry(0.14, bulgeLen / segments + 0.01, thickness), bodyMetal);
        seg.position.set(Math.cos(angle) * rMid, y, Math.sin(angle) * rMid);
        seg.rotation.y = -angle;
        group.add(seg);

        // Hardfacing strip along the blade's outer crest
        const face = new THREE.Mesh(new THREE.BoxGeometry(0.045, bulgeLen / segments + 0.01, thickness * 0.35), hardface);
        const rf = tipHere + thickness * 0.05;
        face.position.set(Math.cos(angle) * rf, y, Math.sin(angle) * rf);
        face.rotation.y = -angle;
        group.add(face);
      }
    }

    scene.add(group);

    const controls = new TrackballControls(camera, renderer.domElement);
    controls.noZoom = true;
    controls.noPan = true;
    controls.rotateSpeed = 3.2;
    controls.staticMoving = false;
    controls.dynamicDampingFactor = 0.12;
    controls.target.set(0, 0, 0);
    controls.update();
    resetBtn.addEventListener('click', () => controls.reset());

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function onResize() {
      const w = wrap.clientWidth, h = wrap.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      controls.handleResize();
    }
    window.addEventListener('resize', onResize);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
    void reduceMotion;
  }

  poster.addEventListener('click', start, { once: true });
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        // Still requires a tap per the agreed UX spec.
      }
    }
  }, { threshold: 0.4 });
  io.observe(wrap);
</script>
