---
// Pilot interactive 3D viewer — poster-image-first, drag-to-rotate only, no auto-spin.
// Geometry is procedurally generated (primitives only, no downloaded mesh/model file),
// built from generic under-reamer / hole-opener anatomy, cross-checked against real
// roller-cone underreamer/hole-opener product and field photos (Mills Machine, Bit
// Brokers, drillingmanual.com's "Hole Opener - Variable Arms" reference set): a
// full-gauge body, three short/stout hinged arms carrying LARGE roller-cone cutters
// (proportioned close to body diameter, not undersized) swung down and out to the
// reaming position, a small centered pilot nose below the cutter cluster, and a top
// sub. Arms are built as a vector-aligned cylinder spanning hinge to cutter mount so
// they visibly connect (not a lookAt'd box that leaves a gap). Not modeled on any
// specific manufacturer's product — no branded geometry copied.
---
<div class="tool3d-wrap" role="img" aria-label="Interactive 3D model of a generic under-reamer / hole opener with extended reaming arms — drag to rotate">
  <div class="tool3d-poster" id="tool3d-poster">
    <svg viewBox="0 0 200 200" class="tool3d-poster-icon" aria-hidden="true">
      <rect x="88" y="20" width="24" height="150" rx="4" fill="#3a4148"/>
      <polygon points="88,170 112,170 100,190" fill="#5a6470"/>
      <polygon points="88,90 40,120 55,140 88,118" fill="#8a94a0"/>
      <polygon points="112,90 160,120 145,140 112,118" fill="#8a94a0"/>
      <circle cx="46" cy="130" r="10" fill="#5a6470"/>
      <circle cx="154" cy="130" r="10" fill="#5a6470"/>
    </svg>
    <div class="tool3d-poster-label">Tap to view 3D model — drag to rotate</div>
  </div>
  <canvas id="tool3d-canvas" class="tool3d-canvas" aria-hidden="true"></canvas>
  <button type="button" class="tool3d-reset" id="tool3d-reset">⟲ Reset View</button>
  <div class="tool3d-fallback" id="tool3d-fallback" hidden>
    3D preview isn't available in this browser — the diagram above and the write-up below cover the same detail.
  </div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.169.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.169.0/examples/jsm/"
  }
}
</script>

<style>
  .tool3d-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 520px;
    min-height: 340px;
    background: radial-gradient(ellipse at 50% 45%, #333c45 0%, #1c2126 45%, #0e1113 100%);
    border: 1px solid var(--iron, #2a2f35);
    border-radius: 6px;
    overflow: hidden;
    cursor: grab;
  }
  .tool3d-wrap:active { cursor: grabbing; }
  .tool3d-poster {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px;
    background: radial-gradient(circle at 50% 40%, #23282d 0%, #14171a 80%);
  }
  .tool3d-poster-icon { width: 96px; height: 96px; }
  .tool3d-poster-label {
    color: #9aa4ad; font-size: 0.85rem; letter-spacing: 0.02em;
  }
  .tool3d-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .tool3d-reset {
    position: absolute; bottom: 14px; right: 14px; z-index: 2; display: none;
    padding: 6px 14px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em;
    color: #e8a020; background: rgba(14, 17, 19, 0.72); border: 1px solid rgba(232, 160, 32, 0.4);
    border-radius: 999px; cursor: pointer;
  }
  .tool3d-reset:hover { background: rgba(14, 17, 19, 0.9); border-color: #e8a020; }
  .tool3d-fallback {
    position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
    padding: 24px; text-align: center; color: #9aa4ad; font-size: 0.9rem;
  }
</style>

<script is:inline>
  const wrap = document.querySelector('.tool3d-wrap');
  const poster = document.getElementById('tool3d-poster');
  const canvas = document.getElementById('tool3d-canvas');
  const fallback = document.getElementById('tool3d-fallback');
  const resetBtn = document.getElementById('tool3d-reset');
  if (!wrap || !poster || !canvas || !fallback || !resetBtn) throw new Error('UnderReamer3D: expected elements missing');

  let started = false;

  async function start() {
    if (started) return;
    started = true;

    const probe = document.createElement('canvas');
    const hasWebGL = !!(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    if (!hasWebGL) {
      poster.style.display = 'none';
      fallback.style.display = 'flex';
      return;
    }

    const THREE = await import('three');
    const { TrackballControls } = await import('three/addons/controls/TrackballControls.js');
    const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

    poster.style.display = 'none';
    canvas.style.display = 'block';
    resetBtn.style.display = 'block';

    const scene = new THREE.Scene();
    scene.background = null;

    const camera = new THREE.PerspectiveCamera(38, wrap.clientWidth / wrap.clientHeight, 0.1, 100);
    camera.position.set(6.2, 2.1, 6.2);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(wrap.clientWidth, wrap.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const key = new THREE.DirectionalLight(0xfff4e6, 3.4);
    key.position.set(3, 4.5, 2.5);
    const fill = new THREE.DirectionalLight(0x9ecbff, 1.1);
    fill.position.set(-3.5, 1.2, 2);
    const rim = new THREE.DirectionalLight(0xffffff, 2.4);
    rim.position.set(-1, 2.5, -4);
    const kicker = new THREE.PointLight(0xffffff, 1.4, 12);
    kicker.position.set(2, -0.5, 3);
    const ambient = new THREE.HemisphereLight(0x6b7a8c, 0x14100c, 0.9);
    scene.add(key, fill, rim, kicker, ambient);

    // --- Generic under-reamer / hole opener, built from primitives ---
    // Anatomy cross-checked against real roller-cone underreamer / hole-opener
    // product and field photos (Mills Machine, Bit Brokers, drillingmanual.com's
    // "Hole Opener - Variable Arms" reference set): a full-gauge body sub, three
    // SHORT, STOUT hinged arms (not long thin spider legs) carrying LARGE
    // roller-cone cutters — nearly as large as the body itself — shown swung
    // down and out to the reaming position, a small centered pilot nose below
    // the cutters, and a top sub. Arms are built by spanning an actual vector
    // from hinge point to cutter mount point (quaternion-aligned cylinder),
    // not a lookAt'd box, so the arm visibly connects the two instead of
    // floating disconnected between them. Not modeled on any specific
    // manufacturer's product; no branded geometry copied.
    const group = new THREE.Group();

    const metal = new THREE.MeshStandardMaterial({ color: 0x9aa4ae, metalness: 0.9, roughness: 0.28 });
    const darkMetal = new THREE.MeshStandardMaterial({ color: 0x5b636b, metalness: 0.85, roughness: 0.35 });
    const bodyMetal = new THREE.MeshStandardMaterial({ color: 0x8b333a, metalness: 0.6, roughness: 0.4 });

    const bodyHeight = 2.6;
    const bodyRadius = 0.34;

    // Full-gauge main body
    const body = new THREE.Mesh(new THREE.CylinderGeometry(bodyRadius, bodyRadius, bodyHeight, 28), bodyMetal);
    group.add(body);

    // Top sub (connects to drill string / BHA above)
    const topSub = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.3, 0.42, 24), metal);
    topSub.position.y = bodyHeight / 2 + 0.21;
    group.add(topSub);

    // Three hinged arms, spaced 120° apart, shown swung down and outward to
    // the extended reaming position, each carrying a large roller-cone
    // cutter at its outer end. Hinges sit low on the body, near the bottom
    // rim, matching real hole-opener anatomy (the cutter head clusters below
    // the main body rather than mid-body).
    const armCount = 3;
    const hingeY = -bodyHeight / 2 + 0.35;
    const hingeR = bodyRadius + 0.02;
    const cutterCenterY = -bodyHeight / 2 - 0.55;
    const cutterCenterR = 0.58;
    const cutterRadius = 0.3;
    const cutterHeight = 0.56;
    const upAxis = new THREE.Vector3(0, 1, 0);

    for (let i = 0; i < armCount; i++) {
      const angle = (i / armCount) * Math.PI * 2;
      const armGroup = new THREE.Group();

      const hingePos = new THREE.Vector3(Math.cos(angle) * hingeR, hingeY, Math.sin(angle) * hingeR);
      const cutterPos = new THREE.Vector3(Math.cos(angle) * cutterCenterR, cutterCenterY, Math.sin(angle) * cutterCenterR);
      const dir = cutterPos.clone().sub(hingePos);
      const dist = dir.length();
      dir.normalize();
      const armQuat = new THREE.Quaternion().setFromUnitVectors(upAxis, dir);

      // Hinge block, flush against the body, oriented along the same
      // outward/down direction the arm will travel
      const hinge = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.3, 0.22), darkMetal);
      hinge.position.copy(hingePos);
      hinge.quaternion.copy(armQuat);
      armGroup.add(hinge);

      // Arm — a short, stout tapered blade spanning from the hinge to just
      // past the cutter's mounting face (deliberately covers ~92% of the
      // hinge-to-cutter distance so the cutter's wide base overlaps the arm
      // tip with no visible gap, instead of floating apart from it).
      const armLength = dist * 0.92;
      const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.11, armLength, 10), darkMetal);
      arm.position.copy(hingePos).addScaledVector(dir, armLength / 2);
      arm.quaternion.copy(armQuat);
      armGroup.add(arm);

      // Large roller-cone cutter at the arm's outer tip — wide base toward
      // the arm/journal, tapering to a rounded tip pointing further out and
      // down, matching real tricone-style hole-opener cutters.
      const cutter = new THREE.Mesh(new THREE.ConeGeometry(cutterRadius, cutterHeight, 18), metal);
      cutter.position.copy(cutterPos);
      cutter.quaternion.copy(armQuat);
      armGroup.add(cutter);

      // Two rings of insert teeth around the cutter's cone surface (base
      // ring larger, mid ring smaller, following the cone's taper), added
      // in the cutter's own local space so they rotate with it.
      const toothRings = [
        { yLocal: -cutterHeight * 0.32, rLocal: cutterRadius * 0.78, count: 7 },
        { yLocal: cutterHeight * 0.05, rLocal: cutterRadius * 0.42, count: 6 },
      ];
      for (const ring of toothRings) {
        for (let t = 0; t < ring.count; t++) {
          const tAngle = (t / ring.count) * Math.PI * 2;
          const tooth = new THREE.Mesh(new THREE.ConeGeometry(0.04, 0.1, 6), darkMetal);
          tooth.position.set(Math.cos(tAngle) * ring.rLocal, ring.yLocal, Math.sin(tAngle) * ring.rLocal);
          tooth.rotation.x = Math.PI / 2.1;
          tooth.rotation.z = -tAngle;
          cutter.add(tooth);
        }
      }

      group.add(armGroup);
    }

    // Small centered pilot nose below the cutter cluster, guiding the tool
    // into the hole ahead of the reaming arms
    const nose = new THREE.Mesh(new THREE.ConeGeometry(0.2, 0.4, 20), metal);
    nose.position.y = cutterCenterY - cutterHeight * 0.55;
    group.add(nose);

    // Full-gauge stabilizer pads on the body itself, between the arms
    for (let i = 0; i < armCount; i++) {
      const angle = (i / armCount) * Math.PI * 2 + Math.PI / armCount;
      const pad = new THREE.Mesh(new THREE.BoxGeometry(0.1, 1.3, 0.14), darkMetal);
      pad.position.set(Math.cos(angle) * (bodyRadius + 0.03), -0.25, Math.sin(angle) * (bodyRadius + 0.03));
      pad.lookAt(Math.cos(angle) * 2, -0.25, Math.sin(angle) * 2);
      group.add(pad);
    }

    // The cutter cluster and pilot nose hang well below the body, so the
    // geometry's true vertical center sits below y=0 — shift the whole
    // group up so it's balanced in the fixed camera frame instead of being
    // cropped at the bottom (the single most repeated bug on this project).
    group.position.y = 0.32;

    scene.add(group);

    const controls = new TrackballControls(camera, renderer.domElement);
    controls.noZoom = true;
    controls.noPan = true;
    controls.rotateSpeed = 3.2;
    controls.staticMoving = false;
    controls.dynamicDampingFactor = 0.12;
    controls.target.set(0, 0, 0);
    controls.update();
    resetBtn.addEventListener('click', () => controls.reset());

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function onResize() {
      const w = wrap.clientWidth, h = wrap.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      controls.handleResize();
    }
    window.addEventListener('resize', onResize);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
    void reduceMotion;
  }

  poster.addEventListener('click', start, { once: true });
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        // Still requires a tap per the agreed UX spec.
      }
    }
  }, { threshold: 0.4 });
  io.observe(wrap);
</script>
