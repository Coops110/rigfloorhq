---
// Poster-image-first, drag-to-rotate only, no auto-spin — same interaction
// contract as BridgePlug3D.astro. Geometry is procedurally generated
// (primitives only, no downloaded mesh/model file), built from generic
// window-mill ("watermelon mill") anatomy: mandrel, lens-shaped carbide-dressed
// mill body, starting mill, tapered ramp-following nose. Not modeled on any
// specific manufacturer's product.
---
<div class="tool3d-wrap" role="img" aria-label="Interactive 3D model of a generic window mill — drag to rotate">
  <div class="tool3d-poster" id="tool3d-poster">
    <svg viewBox="0 0 200 200" class="tool3d-poster-icon" aria-hidden="true">
      <rect x="90" y="15" width="20" height="50" rx="3" fill="#3a4148"/>
      <ellipse cx="100" cy="105" rx="34" ry="48" fill="#5a6470"/>
      <polygon points="85,150 115,150 100,180" fill="#3a4148"/>
    </svg>
    <div class="tool3d-poster-label">Tap to view 3D model — drag to rotate</div>
  </div>
  <canvas id="tool3d-canvas" class="tool3d-canvas" aria-hidden="true"></canvas>
  <div class="tool3d-fallback" id="tool3d-fallback" hidden>
    3D preview isn't available in this browser — the diagram above and the write-up below cover the same detail.
  </div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.169.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.169.0/examples/jsm/"
  }
}
</script>

<style>
  .tool3d-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 520px;
    min-height: 340px;
    background: radial-gradient(ellipse at 50% 45%, #333c45 0%, #1c2126 45%, #0e1113 100%);
    border: 1px solid var(--iron, #2a2f35);
    border-radius: 6px;
    overflow: hidden;
    cursor: grab;
  }
  .tool3d-wrap:active { cursor: grabbing; }
  .tool3d-poster {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px;
    background: radial-gradient(circle at 50% 40%, #23282d 0%, #14171a 80%);
  }
  .tool3d-poster-icon { width: 96px; height: 96px; }
  .tool3d-poster-label {
    color: #9aa4ad; font-size: 0.85rem; letter-spacing: 0.02em;
  }
  .tool3d-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .tool3d-fallback {
    position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
    padding: 24px; text-align: center; color: #9aa4ad; font-size: 0.9rem;
  }
</style>

<script is:inline>
  const wrap = document.querySelector('.tool3d-wrap');
  const poster = document.getElementById('tool3d-poster');
  const canvas = document.getElementById('tool3d-canvas');
  const fallback = document.getElementById('tool3d-fallback');
  if (!wrap || !poster || !canvas || !fallback) throw new Error('WindowMill3D: expected elements missing');

  let started = false;

  async function start() {
    if (started) return;
    started = true;

    const probe = document.createElement('canvas');
    const hasWebGL = !!(probe.getContext('webgl') || probe.getContext('experimental-webgl'));
    if (!hasWebGL) {
      poster.style.display = 'none';
      fallback.style.display = 'flex';
      return;
    }

    const THREE = await import('three');
    const { OrbitControls } = await import('three/addons/controls/OrbitControls.js');
    const { RoomEnvironment } = await import('three/addons/environments/RoomEnvironment.js');

    poster.style.display = 'none';
    canvas.style.display = 'block';

    const scene = new THREE.Scene();
    scene.background = null;

    const camera = new THREE.PerspectiveCamera(38, wrap.clientWidth / wrap.clientHeight, 0.1, 100);
    camera.position.set(3.0, 0.9, 3.0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(wrap.clientWidth, wrap.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    // A soft procedural room environment gives the metal real reflections
    // instead of flat, lightless PBR — the single biggest lever for making
    // it read as premium hardware instead of a gray silhouette.
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    // Three-point studio lighting, brighter and warmer than a flat single light.
    const key = new THREE.DirectionalLight(0xfff4e6, 3.4);
    key.position.set(3, 4.5, 2.5);
    const fill = new THREE.DirectionalLight(0x9ecbff, 1.1);
    fill.position.set(-3.5, 1.2, 2);
    const rim = new THREE.DirectionalLight(0xffffff, 2.4);
    rim.position.set(-1, 2.5, -4);
    const kicker = new THREE.PointLight(0xffffff, 1.4, 12);
    kicker.position.set(2, -0.5, 3);
    const ambient = new THREE.HemisphereLight(0x6b7a8c, 0x14100c, 0.9);
    scene.add(key, fill, rim, kicker, ambient);

    // --- Generic window mill ("watermelon mill"), built from primitives ---
    // Anatomy per generic industry reference (mandrel / lens-shaped carbide
    // mill body / starting mill / ramp-following tapered nose) — no branded
    // or company-specific geometry copied.
    const group = new THREE.Group();

    const metal = new THREE.MeshStandardMaterial({ color: 0x9aa4ae, metalness: 0.9, roughness: 0.28 });
    const carbide = new THREE.MeshStandardMaterial({ color: 0x3d3f42, metalness: 0.55, roughness: 0.6 });

    // Mandrel running through the whole assembly
    const mandrel = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 3.0, 24), metal);
    group.add(mandrel);

    // Lens ("watermelon") shaped window mill body — an elongated sphere
    const lens = new THREE.Mesh(new THREE.SphereGeometry(0.5, 32, 24), carbide);
    lens.scale.set(1, 1.3, 1);
    lens.position.y = 0.25;
    group.add(lens);

    // Small starting mill above, which initiates the cut at the top of the
    // whipstock ramp before the larger window mill body follows through
    const starter = new THREE.Mesh(new THREE.ConeGeometry(0.28, 0.5, 24), carbide);
    starter.position.y = 1.2;
    group.add(starter);

    // Tapered nose that rides down the whipstock face and guides the mill
    // laterally into the casing wall
    const nose = new THREE.Mesh(new THREE.ConeGeometry(0.2, 0.5, 24), metal);
    nose.position.y = -1.45;
    group.add(nose);

    // Upper connection sub to work string
    const topSub = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.2, 0.35, 24), metal);
    topSub.position.y = 1.63;
    group.add(topSub);

    scene.add(group);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.enablePan = false;
    controls.enableZoom = false;
    controls.minPolarAngle = Math.PI * 0.18;
    controls.maxPolarAngle = Math.PI * 0.82;
    controls.target.set(0, 0, 0);
    controls.update();

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function onResize() {
      const w = wrap.clientWidth, h = wrap.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    window.addEventListener('resize', onResize);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    // No auto-rotation ever — reduced-motion users get identical behavior to
    // everyone else here since nothing animates without user input.
    animate();
    void reduceMotion;
  }

  // Poster-image-first: only load Three.js and build the scene once the user
  // taps, or the viewer scrolls into view — never on initial page load.
  poster.addEventListener('click', start, { once: true });
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        // Still requires a tap per the agreed UX spec — this just pre-warms
        // nothing; kept as a hook if we later want true scroll-triggered load.
      }
    }
  }, { threshold: 0.4 });
  io.observe(wrap);
</script>
