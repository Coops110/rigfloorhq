{
  "trailingSlash": false,
  "cleanUrls": true,
  "build": {
    "env": {
      "VERCEL_DEEP_CLONE": "true"
    }
  },
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/pillars/advanced-well-control-and-hydrostatics",
      "destination": "/pillars/well-kill-methods",
      "permanent": true
    },
    {
      "source": "/es/pillars/advanced-well-control-and-hydrostatics",
      "destination": "/es/pillars/well-kill-methods",
      "permanent": true
    },
    {
      "source": "/blog/rig-floor-ppe-guide-personal-protective-equipment-for-drilling-operations.html",
      "destination": "/blog/rig-floor-ppe-guide",
      "permanent": true
    },
    {
      "source": "/drilling/formulas",
      "destination": "/calculators/formulas-cheat-sheet",
      "permanent": true
    },
    {
      "source": "/blog/kick-warning-signs-shut-in-mistakes",
      "destination": "/blog/five-warning-signs-of-a-kick",
      "permanent": true
    },
    {
      "source": "/es/blog/kick-warning-signs-shut-in-mistakes",
      "destination": "/es/blog/five-warning-signs-of-a-kick",
      "permanent": true
    },
    {
      "source": "/blog/well-control-basics-common-mistakes",
      "destination": "/blog/well-control-basics",
      "permanent": true
    },
    {
      "source": "/es/blog/well-control-basics-common-mistakes",
      "destination": "/es/blog/well-control-basics",
      "permanent": true
    },
    {
      "source": "/blog/well-control-pressure-concepts-misread",
      "destination": "/blog/shut-in-pressure-behavior-explained",
      "permanent": true
    },
    {
      "source": "/es/blog/well-control-pressure-concepts-misread",
      "destination": "/es/blog/shut-in-pressure-behavior-explained",
      "permanent": true
    },
    {
      "source": "/blog/subsea-well-control-concepts",
      "destination": "/blog/well-control-curveball-scenarios",
      "permanent": true
    },
    {
      "source": "/es/blog/subsea-well-control-concepts",
      "destination": "/es/blog/well-control-curveball-scenarios",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-vsqpZLGrisMaElu7SUdUsEb5tPqyySOafGzvqcwi90Y=' 'sha256-zBXAj3xYmIuhWuiClzeJz6vHUg8jVKrYqRwyFVhe+PY=' 'sha256-CAy8X8yXpAkXCoBVIuNiRbwuK1h4jVQqlQJ3CH3XO+g='; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://www.youtube.com; form-action 'self' https://buttondown.com; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://rigfloorhq.com"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[0-9a-f]{10}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
